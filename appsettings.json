{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5259",
  "Chatbot": {
    "HighRelevanceThreshold": 0.85,
    "AmbiguityScoreMargin": 0.20,
    "AmbiguityRelativeMargin": 0.15,
    "MaxMessageLength": 500,
    "MessagesPerMinute": 15,
    "ConversationRetentionMinutes": 30,
    "MaxConversationStates": 5000,
    "TicketRequestsPer15Minutes": 5,
    "GlobalRequestsPerMinute": 120
  }
}