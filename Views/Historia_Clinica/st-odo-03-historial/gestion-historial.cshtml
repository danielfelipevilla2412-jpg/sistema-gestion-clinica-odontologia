@using System.Text.Json
@using SmileTrack_MVC.Models.ViewModels
@model HistorialPacienteViewModel
@{
    // CAMBIO VISUAL Y ESTRUCTURAL: esta vista se adapta a la misma identidad visual
    // del sistema (tipografía, breadcrumb, encabezado y card de paciente) sin perder
    // la lógica real del historial clínico del proyecto. Además, se deja en estado vacío
    // cuando no existe paciente seleccionado para permitir crear el registro desde cero.
    Layout = "_Layout";
    ViewData["SidebarPartial"] = "_SidebarProfesional";
    ViewData["Title"] = "Formulario de Historia Clínica";

    var odonto = Model.Odontograma ?? new OdontogramaViewModel();
    var pacienteResumen = Model.Paciente ?? new PacienteResumenClinicoViewModel();
    var nombrePaciente = string.IsNullOrWhiteSpace(odonto.PacienteNombre) ? "" : odonto.PacienteNombre;
    var codigoHC = string.IsNullOrWhiteSpace(odonto.CodigoHC) ? "" : odonto.CodigoHC;
    var documentoPaciente = !string.IsNullOrWhiteSpace(pacienteResumen.Documento)
        ? $"{pacienteResumen.TipoDocumento} {pacienteResumen.Documento}"
        : string.Empty;
    var fechaNacimiento = !string.IsNullOrWhiteSpace(odonto.FechaNacimiento) && DateTime.TryParse(odonto.FechaNacimiento, out var fechaNac)
        ? fechaNac
        : (DateTime?)null;
    var edadPaciente = fechaNacimiento is DateTime fechaNacValue
        ? DateTime.Today.Year - fechaNacValue.Year - (fechaNacValue.Date > DateTime.Today.AddYears(-(DateTime.Today.Year - fechaNacValue.Year)) ? 1 : 0)
        : 0;

    var historiaDataJson = JsonSerializer.Serialize(new
    {
        pacienteId = odonto.PacienteId,
        historiaId = odonto.HistoriaId,
        nombre = nombrePaciente,
        codigoHC = codigoHC,
        fechaNacimiento = fechaNacimiento,
        grupoSanguineo = Model.GrupoSanguineo,
        alergias = Model.Alergias,
        medicamentos = Array.Empty<string>(),
        antecedentesMedicos = Model.AntecedentesMedicos,
        motivoConsulta = Model.Formulario.MotivoConsulta,
        enfermedadActual = Model.Formulario.EnfermedadActual,
        habitos = Model.Formulario.Habitos,
        hallazgos = Model.Formulario.Hallazgos,
        odontogramaObservaciones = Model.Formulario.OdontogramaObservaciones,
        examenesComplementarios = Model.Formulario.ExamenesComplementarios,
        diagnosticoPrincipal = Model.Formulario.DiagnosticoPrincipal,
        diagnosticoSecundario = Model.Formulario.DiagnosticoSecundario,
        evolucionClinica = Model.Formulario.EvolucionClinica,
        prescripcion = Model.Formulario.Prescripcion,
        paciente = new
        {
            tipoDocumento = pacienteResumen.TipoDocumento,
            documento = pacienteResumen.Documento,
            genero = pacienteResumen.Genero,
            telefono = pacienteResumen.Telefono,
            correo = pacienteResumen.Correo,
            direccion = pacienteResumen.Direccion,
            ciudad = pacienteResumen.Ciudad,
            contactoEmergencia = pacienteResumen.ContactoEmergencia,
            telefonoEmergencia = pacienteResumen.TelefonoEmergencia
        },
        proximaCita = Model.ProximaCitaFecha is null ? null : new
        {
            fecha = Model.ProximaCitaFecha.Value.ToString("yyyy-MM-ddTHH:mm:ss"),
            profesional = Model.ProximaCitaProfesional
        },
        estadoPersistido = odonto.EstadoPersistido ?? odonto.ObservacionesGenerales,
        notasClinicas = Model.NotasClinicas.Select(n => new
        {
            titulo = n.Titulo,
            fecha = n.Fecha,
            doctor = n.Doctor,
            diagnostico = n.Diagnostico,
            procedimiento = n.Procedimiento,
            proximaCita = n.ProximaCita,
            estado = n.Estado
        }),
        historial = Model.Registros.Select(r => new
        {
            titulo = r.Descripcion,
            fecha = r.Fecha.ToString("yyyy-MM-dd"),
            doctor = r.Doctor,
            diagnostico = "",
            procedimiento = r.Descripcion,
            estado = r.Estado,
            proximaCita = (string?)null
        }),
        lineaDeTiempo = Model.LineaDeTiempo.Select(e => new
        {
            fecha = e.Fecha.ToString("yyyy-MM-ddTHH:mm:ss"),
            categoria = e.Categoria,
            titulo = e.Titulo,
            descripcion = e.Descripcion,
            profesional = e.Profesional,
            estado = e.Estado,
            enlaceDocumento = e.EnlaceDocumento
        })
    });
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-03-historial/gestion-historial.css")" asp-append-version="true" />
}

<main class="main clinical-main" id="main-content">
    @* CAMBIO DE DISEÑO: se estandariza la vista con la misma estructura de encabezado,
       tipografía y proporciones del resto del sistema; también se elimina la información
       predefinida para dejar el formulario listo para editar cuando no hay paciente activo. *@
    <header class="clinical-topbar" data-purpose="top-navigation-bar">
        <div class="clinical-header-left">
            <nav class="clinical-breadcrumb" aria-label="Breadcrumb">
                <span>Odontólogo</span>
                <span class="breadcrumb-divider">›</span>
                <span>Pacientes</span>
            </nav>
        </div>

        <div class="clinical-header-actions">
            <div class="lang-switcher" aria-label="Selector de idioma">
                <button type="button" class="lang-btn active" aria-label="Español">ES</button>
                <button type="button" class="lang-btn" aria-label="English">EN</button>
            </div>
        </div>
    </header>

    <div class="clinical-content-shell">
        <section class="page-hero">
            <div class="page-hero-copy">
                <div class="eyebrow-row">
                    <span class="hero-kicker">Sistema de atención</span>
                </div>
                <h1>Historial Clínico</h1>
                <p>Consulta y registra la información clínica del paciente</p>
            </div>
            <div class="page-hero-actions">
                <button type="button" class="soft-btn">Exportar</button>
                <button type="button" class="primary-btn">Guardar</button>
            </div>
        </section>

        <section class="patient-summary-card empty-patient-card">
            <div class="patient-summary-inner">
                <div class="patient-info-block empty-state-block">
                    <div class="patient-avatar empty-avatar">—</div>
                    <div class="patient-meta">
                        <div class="patient-title-row empty-title-row">
                            <h2>Paciente no seleccionado</h2>
                            <span class="status-pill status-pill--neutral"><span class="status-dot"></span>Sin registro activo</span>
                        </div>
                        <div class="patient-details-row empty-details-row">
                            <span><strong>Documento:</strong> <span class="mono placeholder-line">&nbsp;</span></span>
                            <span><strong>Edad:</strong> <span class="placeholder-line">&nbsp;</span></span>
                            <span><strong>Sexo:</strong> <span class="placeholder-line">&nbsp;</span></span>
                            <span><strong>Grupo:</strong> <span class="placeholder-line">&nbsp;</span></span>
                            <span><strong>Teléfono:</strong> <span class="placeholder-line">&nbsp;</span></span>
                            <span><strong>Email:</strong> <span class="placeholder-line">&nbsp;</span></span>
                        </div>
                    </div>
                </div>
                <div class="patient-summary-actions">
                    <button type="button" class="soft-btn subtle">Buscar paciente</button>
                    <button type="button" class="mini-btn">Nueva historia</button>
                </div>
            </div>
        </section>

        <nav class="clinical-section-tabs" aria-label="Secciones del formulario">
            <span class="tabs-label">Secciones:</span>
            <a href="#sec-anamnesis" class="tab-item active">1. Anamnesis &amp; Motivo</a>
            <a href="#sec-antecedentes" class="tab-item">2. Antecedentes Sistémicos</a>
            <a href="#sec-examen" class="tab-item">3. Odontograma &amp; Hallazgos</a>
            <a href="#sec-diagnostico" class="tab-item">4. Diagnósticos CIE-10 &amp; Evolución</a>
            <a href="#sec-adjuntos" class="tab-item">5. Adjuntos &amp; Consentimiento</a>
        </nav>

        <form class="clinical-form" id="historia-clinica-form" onsubmit="event.preventDefault();">
            @Html.AntiForgeryToken()
            <section class="form-card" id="sec-anamnesis">
                <div class="card-header">
                    <div class="card-head-left">
                        <span class="card-step">1</span>
                        <div>
                            <h2>Anamnesis y Motivo de Consulta</h2>
                            <p>Razón principal de la cita referida por el paciente y sintomatología</p>
                        </div>
                    </div>
                    <span class="required-chip">Campos Obligatorios</span>
                </div>

                <div class="card-body">
                    <div class="field-group">
                        <label for="motivo_consulta">Motivo de la Consulta <span class="required-mark">*</span><small>(Expresado textualmente por el paciente)</small></label>
                        <textarea id="motivo_consulta" rows="2" placeholder="Escribe el motivo principal de la consulta..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="enfermedad_actual">Enfermedad o Padecimiento Actual <span class="required-mark">*</span><small>(Cronología, intensidad de dolor, factores de alivio/agravantes)</small></label>
                        <textarea id="enfermedad_actual" rows="3" placeholder="Describe la enfermedad o padecimiento actual del paciente..."></textarea>
                    </div>

                    <div class="field-group checkbox-group">
                        <label>Síntomas y Signos Principales Referidos</label>
                        <div class="checkbox-grid">
                            <label class="check-option"><input type="checkbox" /> <span>Sensibilidad al frío</span></label>
                            <label class="check-option"><input type="checkbox" /> <span>Dolor al masticar</span></label>
                            <label class="check-option"><input type="checkbox" /> <span>Halitosis</span></label>
                            <label class="check-option"><input type="checkbox" /> <span>Enrojecimiento de encía</span></label>
                            <label class="check-option"><input type="checkbox" /> <span>Fiebre</span></label>
                            <label class="check-option"><input type="checkbox" /> <span>Molestia al frío</span></label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-card" id="sec-antecedentes">
                <div class="card-header">
                    <div class="card-head-left">
                        <span class="card-step" style="background:#0ea5e9;">2</span>
                        <div>
                            <h2>Antecedentes Sistémicos</h2>
                            <p>Antecedentes médicos, hábitos y condiciones relevantes del paciente</p>
                        </div>
                    </div>
                    <span class="required-chip">Revisión</span>
                </div>

                <div class="card-body">
                    <div class="field-group">
                        <label for="antecedentes_medicos">Antecedentes Médicos <small>(Enfermedades, cirugías, tratamientos previos)</small></label>
                        <textarea id="antecedentes_medicos" rows="3" placeholder="Escribe aquí los antecedentes médicos relevantes..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="habitos">Hábitos y Estilo de Vida</label>
                        <textarea id="habitos" rows="3" placeholder="Ej. tabaco, alcohol, bruxismo, higiene oral, dieta..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="alergias">Alergias / Medicamentos</label>
                        <textarea id="alergias" rows="2" placeholder="Registra alergias, medicamentos actuales o intolerancias..."></textarea>
                    </div>
                </div>
            </section>

            <section class="form-card" id="sec-examen">
                <div class="card-header">
                    <div class="card-head-left">
                        <span class="card-step" style="background:#8b5cf6;">3</span>
                        <div>
                            <h2>Examen Clínico y Hallazgos Odontológicos</h2>
                            <p>Odontograma, observaciones, piezas afectadas y exámenes complementarios</p>
                        </div>
                    </div>
                    <span class="required-chip">Examen</span>
                </div>

                <div class="card-body">
                    <div class="field-group">
                        <label for="hallazgos">Hallazgos de Examen</label>
                        <textarea id="hallazgos" rows="3" placeholder="Describe hallazgos clínicos, estado de encías, cavidades, movilidad, mucosa, etc..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="odontograma_observaciones">Observaciones del Odontograma</label>
                        <textarea id="odontograma_observaciones" rows="3" placeholder="Indica piezas afectadas, tratamiento recomendado, restauraciones o cambios observados..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="examenes_complementarios">Exámenes Complementarios</label>
                        <textarea id="examenes_complementarios" rows="2" placeholder="Radiografías, fotos intraorales, estudios adicionales..."></textarea>
                    </div>
                </div>
            </section>

            <section class="form-card" id="sec-diagnostico">
                <div class="card-header">
                    <div class="card-head-left">
                        <span class="card-step" style="background:#4f46e5;">4</span>
                        <div>
                            <h2>Diagnósticos Codificados (CIE-10) y Evolución Clínica</h2>
                            <p>Diagnóstico clínico, evolución y prescripción farmacológica</p>
                        </div>
                    </div>
                    <span class="required-chip">CIE-10 odontología</span>
                </div>

                <div class="card-body">
                    <div class="diagnostic-grid">
                        <div class="field-group">
                            <label for="diagnostico_principal">Diagnóstico Principal (CIE-10) <span class="required-mark">*</span></label>
                            <select id="diagnostico_principal">
                                <option value="">Seleccione un diagnóstico</option>
                                <option>K02.1 - Caries de la dentina</option>
                                <option>K04.4 - Periodontitis apical</option>
                                <option>K05.1 - Gingivitis marginal</option>
                            </select>
                        </div>
                        <div class="field-group">
                            <label for="diagnostico_secundario">Diagnósticos Secundarios / Comorbilidades</label>
                            <input id="diagnostico_secundario" type="text" value="" placeholder="Ej. K05.1 Gingivitis marginal; F45.8 Bruxismo" />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="evolucion_clinica">Nota de Evolución Clínica y Acto Odontológico Realizado <span class="required-mark">*</span></label>
                        <textarea id="evolucion_clinica" rows="3" placeholder="Escribe la evolución clínica y el procedimiento realizado..."></textarea>
                    </div>

                    <div class="field-group">
                        <label for="prescripcion">Prescripción Farmacológica e Instrucciones al Paciente</label>
                        <textarea id="prescripcion" rows="2" placeholder="Escribe la prescripción, indicaciones y plan de manejo..."></textarea>
                    </div>
                </div>
            </section>

            <section class="form-card" id="sec-adjuntos">
                <div class="card-header">
                    <div class="card-head-left">
                        <span class="card-step" style="background:#10b981;">5</span>
                        <div>
                            <h2>Documentación Diagnóstica y Consentimiento Informado</h2>
                            <p>Estudios imagenológicos, fotografías clínicas y validación legal</p>
                        </div>
                    </div>
                    <button type="button" class="mini-btn">+ Adjuntar Nuevo Estudio</button>
                </div>

                <div class="card-body file-area">
                    <div class="file-grid empty-file-grid">
                        <div class="upload-box full-span">
                            <div class="upload-ghost">⇪</div>
                            <strong>Arrastra o selecciona estudios</strong>
                            <span>Radiografías, fotos intraorales o documentos anexos</span>
                        </div>
                    </div>
                </div>
            </section>

            <div class="bottom-form-actions">
                <label class="remember-toggle"><input type="checkbox" /> <span>Autoguardado automático habilitado</span></label>
                <div class="bottom-actions-right">
                    <button type="button" class="soft-btn subtle">Restablecer Valores</button>
                    <button type="submit" class="primary-btn">Guardar Historia Clínica</button>
                </div>
            </div>
        </form>
    </div>

    <div id="holo-tooltip-historial" role="status" aria-live="polite"></div>
</main>

<script>
    window.smiletrackHistoriaData = @Html.Raw(historiaDataJson);
</script>

@section Scripts {
    <script src="@Url.Content("~/js/Historia_Clinica/st-odo-03-historial/gestion-historial.js")" asp-append-version="true"></script>
}