@using System.Text.Json
@using SmileTrack_MVC.Models.ViewModels
@model HistorialPacienteViewModel
@{
    Layout = null;
    var odonto = Model.Odontograma;
    var historiaDataJson = JsonSerializer.Serialize(new
    {
        pacienteId = odonto.PacienteId,
        historiaId = odonto.HistoriaId,
        nombre = odonto.PacienteNombre,
        codigoHC = odonto.CodigoHC,
        fechaNacimiento = odonto.FechaNacimiento,
        grupoSanguineo = Model.GrupoSanguineo,
        alergias = Model.Alergias,
        medicamentos = Array.Empty<string>(), // no existe un campo de medicamentos activos en el esquema actual
        antecedentesMedicos = Model.AntecedentesMedicos,
        estadoPersistido = odonto.ObservacionesGenerales,
        historial = Model.Registros.Select(r => new
        {
            titulo = r.Descripcion,
            fecha = r.Fecha.ToString("yyyy-MM-dd"),
            doctor = r.Doctor,
            diagnostico = "",
            procedimiento = r.Descripcion,
            estado = r.Estado,
            proximaCita = (string?)null
        })
    });
}

﻿<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Historia Clínica</title>
  <meta name="description" content="Consulta y gestiona la historia clínica del paciente en SmileTrack." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-03-historial/gestion-historial.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal, accesibilidad keyboard-first -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }


  <!-- Botón hamburguesa para menú móvil, con atributos ARIA -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header con metadatos accesibles -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Odontólogo</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Historia Clínica</span>
        </nav>
        <h1 class="page-title">Historia Clínica</h1>
        <p class="page-subtitle" id="patientMeta" aria-live="polite">Cargando...</p>
      </div>
      <div class="header-actions">
        <button class="btn-secondary" id="btnNewEntry" aria-label="Crear nueva entrada clínica">+ Nueva entrada</button>
        <button class="btn-primary" id="hcBtn" aria-label="Ver código de historia clínica">🗂 HC-2026-001</button>
      </div>
    </header>

    <!-- Grid Layout -->
    <div class="grid-main">

      <!-- Columna izquierda: Odontograma + Historial -->
      <section class="col-left">

        <!-- Odontograma con role img para screen readers -->
        <div class="card" id="cardOdo">
          <h2 class="card-title" id="odontogramaTitle">Odontograma digital</h2>
          <div id="odontogramaHost" role="img" aria-labelledby="odontogramaTitle"
            aria-label="Odontograma del paciente: vista gráfica de dientes con tratamientos"></div>
        </div>

        <!-- Historial de consultas con aria-live para actualizaciones -->
        <div class="card" id="cardHist">
          <h2 class="card-title" id="historialTitle">Historial de consultas</h2>
          <div id="historialList" aria-live="polite" role="list" aria-labelledby="historialTitle">
            <!-- Skeleton loader inicial para feedback visual -->
            <div class="skeleton-row" aria-hidden="true"></div>
            <div class="skeleton-row" aria-hidden="true"></div>
            <div class="skeleton-row" aria-hidden="true"></div>
          </div>
        </div>

      </section>

      <!-- Columna derecha: Alertas + Formulario -->
      <aside class="col-right" aria-label="Panel lateral">

        <!-- Alerta médica con role alert para anuncio inmediato -->
        <div class="card card-alert" id="alertCard" role="alert" aria-live="assertive" aria-labelledby="alertTitle">
          <h3 id="alertTitle" class="visually-hidden">Alerta médica del paciente</h3>
          <div class="alert-head">
            <span class="alert-emo" aria-hidden="true">🚨</span>
            <span class="alert-label">Alerta médica</span>
          </div>
          <dl class="alert-details">
            <div class="alert-row">
              <dt class="al-key">Alergias:</dt>
              <dd class="al-val red" id="alergias" aria-live="polite">—</dd>
            </div>
            <div class="alert-row">
              <dt class="al-key">Medicamentos:</dt>
              <dd class="al-val" id="medicamentos" aria-live="polite">—</dd>
            </div>
            <div class="alert-row">
              <dt class="al-key">Grupo sanguíneo:</dt>
              <dd class="al-val" id="grupoSang" aria-live="polite">—</dd>
            </div>
          </dl>
        </div>

        <!-- Formulario de nueva entrada con validación accesible -->
        <div class="card" id="cardForm">
          <h2 class="card-title" id="formTitle">Nueva entrada clínica</h2>
          <form id="historialForm" novalidate aria-labelledby="formTitle">
            @Html.AntiForgeryToken()

            <div class="form-group">
              <label class="form-lbl" for="fDiag">Diagnóstico <span class="required" aria-hidden="true">*</span></label>
              <textarea class="form-ctrl" id="fDiag" name="diagnostico" rows="3"
                placeholder="Caries en pieza 12, cara vestibular..." required aria-required="true"
                aria-describedby="diagHelp"></textarea>
              <small id="diagHelp" class="visually-hidden">Describe el diagnóstico clínico del paciente</small>
              <span class="error-message" id="errorDiag" role="alert" aria-live="assertive"></span>
            </div>

            <div class="form-group">
              <label class="form-lbl" for="fProc">Procedimiento <span class="required"
                  aria-hidden="true">*</span></label>
              <input class="form-ctrl" id="fProc" name="procedimiento" type="text"
                placeholder="Obturación con resina compuesta" required aria-required="true" />
              <span class="error-message" id="errorProc" role="alert" aria-live="assertive"></span>
            </div>

            <div class="form-group">
              <label class="form-lbl" for="fCita">Próxima cita sugerida</label>
              <input class="form-ctrl" id="fCita" name="proximaCita" type="date" aria-describedby="citaHelp" />
              <small id="citaHelp" class="form-help">Fecha opcional para seguimiento</small>
            </div>

            <button type="submit" class="btn-primary btn-full" id="btnGuardar"
              aria-label="Guardar entrada clínica del paciente">Guardar entrada clínica</button>
          </form>
        </div>

      </aside>
    </div>

  </main>

  <!-- Mobile bottom nav con aria-label -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">🏠</span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
    <a href="/historia-clinica/st-odo-06-pacientes" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Pacientes</span>
    </a>
    <a href="/historia-clinica/st-odo-03-historial" class="mobile-nav-item active"
      aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional"
      class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👤</span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast para notificaciones accesibles -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .error-message {
      color: var(--danger);
      font-size: .72rem;
      margin-top: 4px;
      display: none;
    }

    .error-message.visible {
      display: block;
    }

    .form-ctrl.error {
      border-color: var(--danger);
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    }
  </style>

  <script>
    window.smiletrackHistoriaData = @Html.Raw(historiaDataJson);
  </script>
  <script src="@Url.Content("~/js/Historia_Clinica/st-odo-03-historial/gestion-historial.js")"></script>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>



  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>

</html>
