@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Carga de Documentos Clínicos";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Historia_Clinica/st-aux-08-documentos-clinicos/documentos-cli.css" asp-append-version="true" />
}

  @Html.AntiForgeryToken()
  @* Yeray (2025) - Fallo 2: la vista no tenía el campo oculto con el pacienteId,
     por lo que el JS lanzaba /data sin parámetro y el servidor devolvía lista
     vacía. ViewData["PacienteId"] ya lo inyecta el controlador — solo faltaba
     exponerlo en el HTML para que documentos-cli.js lo pueda leer. *@
  <input type="hidden" id="pacienteIdInput" value="@(ViewData["PacienteId"]?.ToString() ?? "")" />

  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_auxiliar">Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" aria-current="page" data-i18n="historia.attachments">Carga de documentos</span>
        </nav>
        <h1 class="page-title" data-i18n="historia.attachments">Carga de Documentos Clínicos</h1>
        <p class="page-subtitle">@ViewData["PacienteNombre"] · @ViewData["PacienteCodigoHC"]</p>
      </div>
    </header>

    <!-- Layout -->
    <div class="content-layout">

      <!-- Columna izquierda: Formulario de carga -->
      <div class="content-left">
        <div class="card">
          <h3 class="card-title" data-i18n="historia.add_attachment">Adjuntar nuevo documento</h3>

          <form id="uploadForm" novalidate>
            <div class="form-group">
              <label class="form-label" for="docType" data-i18n="common.document">Tipo de documento <span class="required">*</span></label>
              <div class="select-wrapper">
                <select class="form-select" id="docType" required>
                  <option value="">Seleccionar tipo...</option>
                  <option value="Radiografía panorámica">Radiografía panorámica</option>
                  <option value="Radiografía periapical">Radiografía periapical</option>
                  <option value="Fotografía inicial">Fotografía inicial</option>
                  <option value="Fotografía final">Fotografía final</option>
                  <option value="Examen de coagulación">Examen de coagulación</option>
                  <option value="Consentimiento informado">Consentimiento informado</option>
                  <option value="Historia clínica">Historia clínica</option>
                  <option value="Otro">Otro</option>
                </select>
                <span class="error-message" id="error-docType">Selecciona un tipo</span>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="docDate">Fecha de expedición <span class="required">*</span></label>
              <div class="date-input-wrapper">
                <input type="date" class="form-input" id="docDate" required />
                <span class="date-icon">📅</span>
              </div>
              <span class="error-message" id="error-docDate">Selecciona una fecha</span>
            </div>

            <div class="form-group">
              <label class="form-label" for="docDesc">Descripción</label>
              <input type="text" class="form-input" id="docDesc" placeholder="Descripción del documento..." data-i18n-ph="historia.doc_desc_ph" />
            </div>

            <!-- Drag & Drop -->
            <div class="drop-zone" id="dropZone" role="button" tabindex="0">
              <input type="file" id="fileInput" class="file-input" accept=".jpg,.jpeg,.png,.pdf" />
              <div class="drop-zone-content" id="dropContent">
                <span class="folder-icon">📁</span>
                <p class="drop-text-primary">Arrastra el archivo aquí</p>
                <p class="drop-text-secondary">o haz clic para seleccionar</p>
                <p class="drop-text-formats">JPG, PNG, PDF — Máx. 10MB</p>
              </div>
              <div class="file-preview" id="filePreview" style="display:none;">
                <span class="file-icon" id="fileIcon"></span>
                <div class="file-info">
                  <p class="file-name" id="fileName"></p>
                  <p class="file-size" id="fileSize"></p>
                </div>
                <button type="button" class="file-remove" id="btnRemoveFile">×</button>
              </div>
            </div>

            <button type="submit" class="upload-btn" id="uploadBtn">Subir documento</button>
          </form>
        </div>
      </div>

      <!-- Columna derecha: Lista de documentos -->
      <aside class="content-right">
        <div class="card">
          <h3 class="card-title">Documentos del paciente</h3>
          <div class="docs-list" id="docsList">
            <!-- Los documentos reales del paciente se cargan desde el servidor
                 (ver cargarDocumentos() en documentos-cli.js). -->
          </div>
          <p id="docsEmptyState" class="doc-meta" style="display:none;padding:8px 0;">Este paciente no tiene documentos clínicos cargados todavía.</p>
        </div>
      </aside>

    </div>

  </main>

  <!-- Modal de vista previa -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal">
      <div class="modal-header">
        <div style="display:flex;align-items:center;gap:12px;">
          <span class="modal-icon" id="modalIcon">📄</span>
          <div>
            <p class="modal-name" id="modalTitle"></p>
            <p class="modal-role">Vista previa del documento</p>
          </div>
        </div>
        <button class="modal-close" id="modalCloseBtn">×</button>
      </div>
      <div class="modal-body">
        <div class="modal-doc-placeholder" id="modalPreview">
          <span class="placeholder-icon">📄</span>
          <p class="placeholder-text">Vista previa del documento</p>
          <p class="placeholder-subtext">El archivo se cargará aquí</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="modal-btn modal-btn-secondary" id="modalCloseBtn2">Cerrar</button>
        <button type="button" class="modal-btn modal-btn-primary" id="modalDownloadBtn">⬇ Descargar</button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">space_dashboard</span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-aux-02-agenda-apoyo" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">calendar_month</span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-aux-10-citas-finalizadas" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">check_circle</span>
      <span>Finalizadas</span>
    </a>
    <a href="/perfiles/st-aux-11-perfil-auxiliar" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">person</span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

@section Scripts {
  <script src="~/js/Historia_Clinica/st-aux-08-documentos-clinicos/documentos-cli.js" asp-append-version="true"></script>
}


