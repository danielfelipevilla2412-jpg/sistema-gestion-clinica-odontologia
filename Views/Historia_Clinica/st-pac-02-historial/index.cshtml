@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Text.Json
@using SmileTrack_MVC.Models.ViewModels
@model HistorialPacienteViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Historial Clínico";
    ViewData["Description"] = "Consulta la información registrada por tus profesionales de salud.";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var pacienteAsignado = Model.Odontograma.PacienteId.HasValue;
    var ultimaNota = pacienteAsignado ? Model.NotasClinicas.FirstOrDefault() : null;
    var formulario = pacienteAsignado ? Model.Formulario : new HistoriaFormularioViewModel();
    var hallazgosRegistrados = pacienteAsignado
      ? string.Join("\n", Model.LineaDeTiempo
        .Where(e => e.Categoria.Equals("odontograma", StringComparison.OrdinalIgnoreCase))
        .Select(e => $"{e.Titulo}: {e.Descripcion}"))
      : "";
    var documentosRegistrados = pacienteAsignado
      ? string.Join("\n", Model.LineaDeTiempo
        .Where(e => e.Categoria.Equals("documento", StringComparison.OrdinalIgnoreCase))
        .Select(e => e.Titulo))
      : "";
}

@section Styles {
  <link rel="stylesheet" href="~/css/Historia_Clinica/st-pac-02-historial/styles.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/Historia_Clinica/st-odo-03-historial/gestion-historial.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/shared/perfil-paciente-ui.css" asp-append-version="true" />
}

<!-- ----- MAIN ----- -->
<main class="main clinical-main patient-history-main" id="main-content">
  <div class="clinical-content-shell">
    <header class="page-header patient-history-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="pac_hist.breadcrumb_aria">
          <span data-i18n="common_role_patient">Paciente</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" aria-current="page" data-i18n="pac_hist.breadcrumb_current">Mi historial</span>
        </nav>
        <h1 data-i18n="pac_hist.page_title">Mi Historial Clínico</h1>
        <p class="page-subtitle" data-i18n="pac_hist.page_subtitle">Consulta la información registrada por tus profesionales de salud</p>
      </div>
      <div class="page-header-actions">
        <a class="btn-secondary" id="btnDescargar" href="~/historia-clinica/st-odo-03-historial/exportar-pdf" aria-label="Descargar informe clínico completo" data-i18n-aria-label="pac_hist.btn_download_aria">
          <span class="material-symbols-outlined" aria-hidden="true">download</span> <span data-i18n="pac_hist.btn_download">Descargar informe</span>
        </a>
      </div>
    </header>

    <div data-perfil-paciente-header></div>

    <!-- Sección principal -->
    <section class="agenda-section" aria-label="Contenido de historial" data-i18n-aria-label="pac_hist.agenda_aria">

      <!-- Formulario clínico profesional en modo estrictamente informativo -->
      <nav class="clinical-section-tabs" aria-label="Secciones de la historia clínica" data-i18n-aria-label="pac_hist.sections_aria">
        <span class="tabs-label" data-i18n="pac_hist.tabs_label">Secciones:</span>
        <a href="#sec-anamnesis-paciente" class="tab-item active" data-i18n="pac_hist.tab_anamnesis">1. Anamnesis</a>
        <a href="#sec-antecedentes-paciente" class="tab-item" data-i18n="pac_hist.tab_antecedentes">2. Antecedentes</a>
        <a href="#sec-examen-paciente" class="tab-item" data-i18n="pac_hist.tab_examen">3. Examen clínico</a>
        <a href="#sec-diagnostico-paciente" class="tab-item" data-i18n="pac_hist.tab_diagnostico">4. Diagnósticos</a>
        <a href="#sec-adjuntos-paciente" class="tab-item" data-i18n="pac_hist.tab_adjuntos">5. Documentos</a>
        <a href="#recordsList" class="tab-item" data-i18n="pac_hist.tab_evolucion">Evolución clínica</a>
      </nav>

      <section class="clinical-form clinical-form-readonly" aria-label="Formulario clínico en solo lectura" data-i18n-aria-label="pac_hist.form_aria">

        <section class="readonly-form-card" id="sec-anamnesis-paciente">
          <div class="readonly-card-header"><span class="readonly-step">1</span><div><h3 data-i18n="pac_hist.card_anamnesis_title">Anamnesis y motivo de consulta</h3><p data-i18n="pac_hist.card_anamnesis_sub">Información registrada por el profesional</p></div></div>
          <div class="readonly-fields">
            <div><label data-i18n="pac_hist.field_reason">Motivo de la consulta</label><textarea readonly rows="2">@formulario.MotivoConsulta</textarea></div>
            <div><label data-i18n="pac_hist.field_current_illness">Enfermedad o padecimiento actual</label><textarea readonly rows="3">@formulario.EnfermedadActual</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-antecedentes-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-blue">2</span><div><h3 data-i18n="pac_hist.card_history_title">Antecedentes sistémicos</h3><p data-i18n="pac_hist.card_history_sub">Antecedentes médicos y alertas registrados</p></div></div>
          <div class="readonly-fields">
            <div><label data-i18n="pac_hist.field_medical_history">Antecedentes médicos</label><textarea readonly rows="3">@(pacienteAsignado ? Model.AntecedentesMedicos : "")</textarea></div>
            <div><label data-i18n="pac_hist.field_habits">Hábitos y estilo de vida</label><textarea readonly rows="2">@formulario.Habitos</textarea></div>
            <div><label data-i18n="pac_hist.field_allergies">Alergias / medicamentos</label><textarea readonly rows="2">@(pacienteAsignado ? string.Join(", ", Model.Alergias) : "")</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-examen-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-purple">3</span><div><h3 data-i18n="pac_hist.card_exam_title">Examen clínico y hallazgos odontológicos</h3><p data-i18n="pac_hist.card_exam_sub">Hallazgos registrados durante la atención</p></div></div>
          <div class="readonly-fields">
            <div><label data-i18n="pac_hist.field_findings">Hallazgos de examen</label><textarea readonly rows="3">@formulario.Hallazgos</textarea></div>
            <div><label data-i18n="pac_hist.field_observations">Observaciones clínicas</label><textarea readonly rows="3">@formulario.OdontogramaObservaciones</textarea></div>
            <div><label data-i18n="pac_hist.field_complementary">Exámenes complementarios</label><textarea readonly rows="3">@formulario.ExamenesComplementarios@(string.IsNullOrWhiteSpace(formulario.ExamenesComplementarios) ? documentosRegistrados : "")</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-diagnostico-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-indigo">4</span><div><h3 data-i18n="pac_hist.card_diagnosis_title">Diagnósticos y evolución clínica</h3><p data-i18n="pac_hist.card_diagnosis_sub">Notas clínicas y procedimientos registrados</p></div></div>
          <div class="readonly-fields">
            <div><label data-i18n="pac_hist.field_main_diagnosis">Diagnóstico principal</label><textarea readonly rows="2">@formulario.DiagnosticoPrincipal@(string.IsNullOrWhiteSpace(formulario.DiagnosticoPrincipal) ? (ultimaNota?.Diagnostico ?? "") : "")</textarea></div>
            <div><label data-i18n="pac_hist.field_secondary_diagnosis">Diagnósticos secundarios</label><textarea readonly rows="2">@formulario.DiagnosticoSecundario</textarea></div>
            <div><label data-i18n="pac_hist.field_procedure">Procedimiento realizado</label><textarea readonly rows="2">@(string.IsNullOrWhiteSpace(formulario.EvolucionClinica) ? (ultimaNota?.Procedimiento ?? "") : formulario.EvolucionClinica)</textarea></div>
            <div class="readonly-field-wide"><label data-i18n="pac_hist.field_evolution_note">Nota de evolución clínica</label><textarea readonly rows="3">@formulario.EvolucionClinica</textarea></div>
            <div class="readonly-field-wide"><label data-i18n="pac_hist.field_prescription">Prescripción e instrucciones</label><textarea readonly rows="2">@formulario.Prescripcion</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-adjuntos-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-green">5</span><div><h3 data-i18n="pac_hist.card_documents_title">Documentación diagnóstica y consentimiento</h3><p data-i18n="pac_hist.card_documents_sub">Documentos disponibles en la historia clínica</p></div></div>
          <div class="readonly-document-list">
            @if (pacienteAsignado && !string.IsNullOrWhiteSpace(documentosRegistrados))
            {
              @documentosRegistrados
            }
            else if (pacienteAsignado)
            {
              <span data-i18n="pac_hist.no_documents">No hay documentos registrados.</span>
            }
          </div>
        </section>
      </section>

      <!-- Grid: Historial clínico en solo lectura + Sidebar cards -->
      <section class="history-workspace" aria-labelledby="recordsTitle">
        <header class="history-workspace-header">
          <div><h2 id="recordsTitle" data-i18n="pac_hist.workspace_title">Evolución clínica</h2><p data-i18n="pac_hist.workspace_sub">Registros de atención, notas y documentos en orden cronológico.</p></div>
        </header>
        <div class="content-grid">

        <!-- Columna principal -->
        <div class="col-main">

          <!-- Historial escrito por el equipo profesional. No contiene controles de edición. -->
          <div class="records-list clinical-history-readonly" id="recordsList" role="list" aria-label="Evolución por cita atendida" data-i18n-aria-label="pac_hist.records_aria">
            @if (Model.EvolucionesPorCita.Any())
            {
                foreach (var evolucion in Model.EvolucionesPorCita)
                {
                    <article class="record-card" role="listitem">
                        <div class="record-card-header">
                            <div>
                                <span class="record-type">@evolucion.CodigoHistoria · Cita #@evolucion.CitaId</span>
                                <h3>@evolucion.Servicio</h3>
                            </div>
                            <time datetime="@evolucion.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")">@evolucion.Fecha.ToString("dd MMM yyyy · HH:mm")</time>
                        </div>
                        <div class="record-card-meta">
                            <span><strong data-i18n="pac_hist.professional_label">Profesional:</strong> @evolucion.Profesional</span>
                        </div>
                        <dl class="visit-clinical-details">
                          @if (!string.IsNullOrWhiteSpace(evolucion.MotivoConsulta))
                          {
                            <div><dt data-i18n="pac_hist.dt_reason">Motivo</dt><dd>@evolucion.MotivoConsulta</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.EnfermedadActual))
                          {
                            <div><dt data-i18n="pac_hist.dt_illness">Enfermedad actual</dt><dd>@evolucion.EnfermedadActual</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.AntecedentesMedicos))
                          {
                            <div><dt data-i18n="pac_hist.dt_history">Antecedentes</dt><dd>@evolucion.AntecedentesMedicos</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Habitos))
                          {
                            <div><dt data-i18n="pac_hist.dt_habits">Hábitos</dt><dd>@evolucion.Habitos</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Alergias))
                          {
                            <div><dt data-i18n="pac_hist.dt_allergies">Alergias</dt><dd>@evolucion.Alergias</dd></div>
                          }
                          @if (evolucion.Sintomas.Any())
                          {
                            <div><dt data-i18n="pac_hist.dt_symptoms">Síntomas</dt><dd>@string.Join(", ", evolucion.Sintomas)</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Diagnosticos))
                          {
                            <div><dt data-i18n="pac_hist.dt_diagnosis">Diagnóstico</dt><dd>@evolucion.Diagnosticos</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Hallazgos))
                          {
                            <div><dt data-i18n="pac_hist.dt_findings">Hallazgos</dt><dd>@evolucion.Hallazgos</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.OdontogramaObservaciones))
                          {
                            <div><dt data-i18n="pac_hist.dt_odontogram_obs">Observaciones odontológicas</dt><dd>@evolucion.OdontogramaObservaciones</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.ExamenesComplementarios))
                          {
                            <div><dt data-i18n="pac_hist.dt_tests">Exámenes</dt><dd>@evolucion.ExamenesComplementarios</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.EvolucionClinica))
                          {
                            <div><dt data-i18n="pac_hist.dt_evolution">Evolución</dt><dd>@evolucion.EvolucionClinica</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Procedimientos))
                          {
                            <div><dt data-i18n="pac_hist.dt_procedures">Procedimientos</dt><dd>@evolucion.Procedimientos</dd></div>
                          }
                          @if (!string.IsNullOrWhiteSpace(evolucion.Prescripcion))
                          {
                            <div><dt data-i18n="pac_hist.dt_prescription">Prescripción</dt><dd>@evolucion.Prescripcion</dd></div>
                          }
                        </dl>
                        @if (evolucion.RegistrosRelacionados.Any())
                        {
                            <div class="visit-related-records">
                              @foreach (var registro in evolucion.RegistrosRelacionados)
                              {
                                <p><strong>@registro.Titulo:</strong> @registro.Descripcion</p>
                              }
                            </div>
                        }
                    </article>
                }
            }
            else
            {
                <div class="empty-history" data-i18n="pac_hist.empty_history">Aún no hay citas atendidas con evolución clínica registrada.</div>
            }
            @{
              var eventosSinCita = Model.LineaDeTiempo
                .Where(evento => !evento.CitaId.HasValue
                  && !evento.Categoria.Equals("consulta", StringComparison.OrdinalIgnoreCase))
                .ToList();
            }
            @if (eventosSinCita.Any())
            {
              <section class="unlinked-clinical-records" aria-label="Otros registros clínicos" data-i18n-aria-label="pac_hist.other_records_aria">
                <h3 data-i18n="pac_hist.other_records_title">Otros registros clínicos</h3>
                @foreach (var evento in eventosSinCita)
                {
                  <article class="record-card" role="listitem">
                    <div class="record-card-header">
                      <div><span class="record-type">@evento.Categoria</span><h3>@evento.Titulo</h3></div>
                      <time datetime="@evento.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")">@evento.Fecha.ToString("dd MMM yyyy")</time>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(evento.Descripcion))
                    {
                      <p class="record-description">@evento.Descripcion</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(evento.EnlaceDocumento))
                    {
                      <a class="record-document-link" href="@evento.EnlaceDocumento" target="_blank" rel="noopener" data-i18n="pac_hist.view_document">Ver documento clínico</a>
                    }
                  </article>
                }
              </section>
            }
          </div>

        </div>

        </div>
      </section>
    </section>

    </div>
  </main>

  <!-- MODAL: Detalle de registro -->
  <!-- [MEJORA]: aria-hidden e inert gestionados por JS para accesibilidad -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar modal" data-i18n-aria-label="pac_hist.modal_close_aria">—</button>
      <h2 class="modal-title" id="modalTitle" data-i18n="pac_hist.modal_detail_title">Detalle del Registro</h2>
      <div id="modalContent"></div>
    </div>
  </div>

  <!-- MODAL: Confirmar descarga -->
  <div class="modal-overlay" id="modalDescargar" role="dialog" aria-modal="true" aria-labelledby="descargarTitle"
    aria-hidden="true" inert>
    <div class="modal modal--sm">
      <h2 class="modal-title" id="descargarTitle" data-i18n="pac_hist.modal_download_title">¿Descargar historial?</h2>
      <p class="modal-desc" data-i18n="pac_hist.modal_download_desc">Se generará un PDF con todos tus registros clínicos y documentos disponibles.</p>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarDescarga" data-i18n="pac_hist.btn_back">Volver</button>
        <button class="btn-primary" id="confirmarDescarga" data-i18n="pac_hist.btn_confirm_download">Sí, descargar</button>
      </div>
    </div>
  </div>

@section Scripts {
  <script src="~/js/shared/perfil-paciente-service.js" asp-append-version="true" defer></script>
  <script src="~/js/shared/perfil-paciente-ui.js" asp-append-version="true" defer></script>
}
