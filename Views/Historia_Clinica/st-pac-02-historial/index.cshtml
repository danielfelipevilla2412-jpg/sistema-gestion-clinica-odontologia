﻿@using System.Text.Json
@using SmileTrack_MVC.Models.ViewModels
@model HistorialPacienteViewModel
@{
    Layout = null;
    var pacienteAsignado = Model.Odontograma.PacienteId.HasValue;
    var ultimaNota = pacienteAsignado ? Model.NotasClinicas.FirstOrDefault() : null;
    var formulario = pacienteAsignado ? Model.Formulario : new HistoriaFormularioViewModel();
    var hallazgosRegistrados = pacienteAsignado
      ? string.Join("\n", Model.LineaDeTiempo
        .Where(e => e.Categoria.Equals("odontograma", StringComparison.OrdinalIgnoreCase))
        .Select(e => $"{e.Titulo}: {e.Descripcion}"))
      : "";
    var documentosRegistrados = pacienteAsignado
      ? string.Join("\n", Model.LineaDeTiempo
        .Where(e => e.Categoria.Equals("documento", StringComparison.OrdinalIgnoreCase))
        .Select(e => e.Titulo))
      : "";
}

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Mi Historial Clínico</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/variables.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-pac-02-historial/styles.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-03-historial/gestion-historial.css")" asp-append-version="true" />
  <style>
    @@keyframes scan {
      0% {
        transform: translateY(0);
      }

      100% {
        transform: translateY(900px);
      }
    }

    .hw button {
      transform: none !important;
    }

    .tb {
      font-size: 10px;
      padding: 4px 13px;
      border-radius: 20px;
      border: 1px solid rgba(0, 212, 255, 0.25);
      background: transparent;
      color: rgba(0, 212, 255, 0.5);
      cursor: pointer;
      letter-spacing: 0.03em;
    }

    .tb.active {
      border-color: rgba(0, 212, 255, 0.7);
      background: rgba(0, 212, 255, 0.15);
      color: #00d4ff;
      box-shadow: 0 0 8px rgba(0, 212, 255, 0.2);
    }

    @@media print {
      body { display: block; background: #fff; }
      .sidebar, .hamburger, .overlay, .clinical-topbar, .page-hero-actions,
      .modal-overlay, .toast, .site-footer, .mobile-nav { display: none !important; }
      .patient-history-main, .clinical-content-shell { width: 100%; max-width: none; margin: 0; padding: 0; }
      .page-hero { padding: 0 0 12px; }
      .patient-summary-card, .form-card, .history-workspace, .record-card { box-shadow: none; break-inside: avoid; }
      .clinical-section-tabs { display: none; }
      .readonly-fields textarea { overflow: visible; resize: none; }
      a { color: inherit; text-decoration: none; }
    }
  </style>
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/perfil-paciente-ui.css")" />
</head>

<body>
  <!-- El selector de idioma ya se renderiza desde el layout compartido del sistema. -->

  <!-- [MEJORA]: Skip link para accesibilidad keyboard-first (consistente con st-pac-01) -->
  <a href="#main-content" class="skip-link" data-i18n="common_skip_link">Saltar al contenido principal</a>

  <!-- ----- SIDEBAR UNIFICADO (Activo: Historial) ----- -->
  @{ await Html.RenderPartialAsync("_SidebarPaciente"); }

  <!-- ----- HAMBURGER (mÓvil) ----- -->
  <!-- [MEJORA]: aria-expanded y aria-controls para accesibilidad de menú mÓvil -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
  <!-- [MEJORA]: aria-hidden inicial para overlay -->
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ----- MAIN ----- -->
  <main class="main clinical-main patient-history-main" id="main-content">
    <div class="clinical-content-shell">
      <header class="clinical-topbar" data-purpose="top-navigation-bar">
        <div class="clinical-header-left">
          <nav class="clinical-breadcrumb" aria-label="Ruta de navegación">
            <span data-i18n="common_role_patient">Paciente</span>
            <span class="breadcrumb-divider" aria-hidden="true">›</span>
            <span class="breadcrumb-current" data-i18n="historia.title">Mi historial</span>
          </nav>
        </div>
      </header>

      <section class="page-hero">
        <div class="page-hero-copy">
          <div class="eyebrow-row"><span class="hero-kicker">Historia clínica</span></div>
          <h1>Mi Historial Clínico</h1>
          <p data-i18n="historia.evolution">Consulta la información registrada por tus profesionales de salud</p>
        </div>
        <div class="page-hero-actions">
          <button class="primary-btn" id="btnDescargar" aria-label="Descargar informe clínico completo" data-i18n-aria-label="table.export">
            <span class="material-symbols-outlined" aria-hidden="true">download</span> Descargar informe
          </button>
        </div>
      </section>

      <div data-perfil-paciente-header></div>

    <!-- Sección principal -->
    <section class="agenda-section" aria-label="Contenido de historial">

      <!-- Formulario clínico profesional en modo estrictamente informativo -->
      <nav class="clinical-section-tabs" aria-label="Secciones de la historia clínica">
        <span class="tabs-label">Secciones:</span>
        <a href="#sec-anamnesis-paciente" class="tab-item active">1. Anamnesis</a>
        <a href="#sec-antecedentes-paciente" class="tab-item">2. Antecedentes</a>
        <a href="#sec-examen-paciente" class="tab-item">3. Examen clínico</a>
        <a href="#sec-diagnostico-paciente" class="tab-item">4. Diagnósticos</a>
        <a href="#sec-adjuntos-paciente" class="tab-item">5. Documentos</a>
        <a href="#recordsList" class="tab-item">Evolución clínica</a>
      </nav>

      <section class="clinical-form clinical-form-readonly" aria-label="Formulario clínico en solo lectura">

        <section class="readonly-form-card" id="sec-anamnesis-paciente">
          <div class="readonly-card-header"><span class="readonly-step">1</span><div><h3>Anamnesis y motivo de consulta</h3><p>Información registrada por el profesional</p></div></div>
          <div class="readonly-fields">
            <div><label>Motivo de la consulta</label><textarea readonly rows="2">@formulario.MotivoConsulta</textarea></div>
            <div><label>Enfermedad o padecimiento actual</label><textarea readonly rows="3">@formulario.EnfermedadActual</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-antecedentes-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-blue">2</span><div><h3>Antecedentes sistémicos</h3><p>Antecedentes médicos y alertas registrados</p></div></div>
          <div class="readonly-fields">
            <div><label>Antecedentes médicos</label><textarea readonly rows="3">@(pacienteAsignado ? Model.AntecedentesMedicos : "")</textarea></div>
            <div><label>Hábitos y estilo de vida</label><textarea readonly rows="2">@formulario.Habitos</textarea></div>
            <div><label>Alergias / medicamentos</label><textarea readonly rows="2">@(pacienteAsignado ? string.Join(", ", Model.Alergias) : "")</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-examen-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-purple">3</span><div><h3>Examen clínico y hallazgos odontológicos</h3><p>Hallazgos registrados durante la atención</p></div></div>
          <div class="readonly-fields">
            <div><label>Hallazgos de examen</label><textarea readonly rows="3">@formulario.Hallazgos</textarea></div>
            <div><label>Observaciones clínicas</label><textarea readonly rows="3">@formulario.OdontogramaObservaciones</textarea></div>
            <div><label>Exámenes complementarios</label><textarea readonly rows="3">@formulario.ExamenesComplementarios@(string.IsNullOrWhiteSpace(formulario.ExamenesComplementarios) ? documentosRegistrados : "")</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-diagnostico-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-indigo">4</span><div><h3>Diagnósticos y evolución clínica</h3><p>Notas clínicas y procedimientos registrados</p></div></div>
          <div class="readonly-fields">
            <div><label>Diagnóstico principal</label><textarea readonly rows="2">@formulario.DiagnosticoPrincipal@(string.IsNullOrWhiteSpace(formulario.DiagnosticoPrincipal) ? (ultimaNota?.Diagnostico ?? "") : "")</textarea></div>
            <div><label>Diagnósticos secundarios</label><textarea readonly rows="2">@formulario.DiagnosticoSecundario</textarea></div>
            <div><label>Procedimiento realizado</label><textarea readonly rows="2">@(string.IsNullOrWhiteSpace(formulario.EvolucionClinica) ? (ultimaNota?.Procedimiento ?? "") : formulario.EvolucionClinica)</textarea></div>
            <div class="readonly-field-wide"><label>Nota de evolución clínica</label><textarea readonly rows="3">@formulario.EvolucionClinica</textarea></div>
            <div class="readonly-field-wide"><label>Prescripción e instrucciones</label><textarea readonly rows="2">@formulario.Prescripcion</textarea></div>
          </div>
        </section>

        <section class="readonly-form-card" id="sec-adjuntos-paciente">
          <div class="readonly-card-header"><span class="readonly-step step-green">5</span><div><h3>Documentación diagnóstica y consentimiento</h3><p>Documentos disponibles en la historia clínica</p></div></div>
          <div class="readonly-document-list">@(pacienteAsignado ? (string.IsNullOrWhiteSpace(documentosRegistrados) ? "No hay documentos registrados." : documentosRegistrados) : "")</div>
        </section>
      </section>

      <!-- Grid: Historial clínico en solo lectura + Sidebar cards -->
      <section class="history-workspace" aria-labelledby="recordsTitle">
        <header class="history-workspace-header">
          <div><h2 id="recordsTitle">Evolución clínica</h2><p>Registros de atención, notas y documentos en orden cronológico.</p></div>
        </header>
        <div class="content-grid">

        <!-- Columna principal -->
        <div class="col-main">

          <!-- Historial escrito por el equipo profesional. No contiene controles de edición. -->
          <div class="records-list clinical-history-readonly" id="recordsList" role="list" aria-label="Historial clínico registrado por profesionales">
            @if (Model.LineaDeTiempo.Any())
            {
                foreach (var evento in Model.LineaDeTiempo)
                {
                    <article class="record-card" role="listitem">
                        <div class="record-card-header">
                            <div>
                                <span class="record-type">@evento.Categoria</span>

                                <h3>@evento.Titulo</h3>
                            </div>
                            <time datetime="@evento.Fecha.ToString("yyyy-MM-ddTHH:mm:ss")">@evento.Fecha.ToString("dd MMM yyyy")</time>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(evento.Descripcion))
                        {
                            <p class="record-description">@evento.Descripcion</p>
                        }
                        <div class="record-card-meta">
                            <span><strong>Profesional:</strong> @evento.Profesional</span>
                            <span><strong>Estado:</strong> @evento.Estado</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(evento.EnlaceDocumento))
                        {
                            <a class="record-document-link" href="@evento.EnlaceDocumento" target="_blank" rel="noopener">Ver documento clínico</a>
                        }
                    </article>
                }
            }
            else
            {
                <div class="empty-history">Aún no hay registros clínicos disponibles.</div>
            }
          </div>

        </div>

        </div>
      </section>
    </section>

    </div>
  </main>

  <!-- MODAL: Detalle de registro -->
  <!-- [MEJORA]: aria-hidden e inert gestionados por JS para accesibilidad -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar modal">—</button>
      <h2 class="modal-title" id="modalTitle">Detalle del Registro</h2>
      <div id="modalContent"></div>
    </div>
  </div>

  <!-- MODAL: Confirmar descarga -->
  <div class="modal-overlay" id="modalDescargar" role="dialog" aria-modal="true" aria-labelledby="descargarTitle"
    aria-hidden="true" inert>
    <div class="modal modal--sm">
      <h2 class="modal-title" id="descargarTitle">¿Descargar historial?</h2>
      <p class="modal-desc">Se generará un PDF con todos tus registros clínicos y documentos disponibles.</p>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarDescarga">Volver</button>
        <button class="btn-primary" id="confirmarDescarga">Sí, descargar</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <!-- [MEJORA]: aria-atomic="true" para que lectores anuncien mensaje completo -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">favorite</span>
      <p>— 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>
  <script src="@Url.Content("~/js/shared/perfil-paciente-service.js")"></script>
  <script src="@Url.Content("~/js/shared/perfil-paciente-ui.js")"></script>
  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
  <script src="@Url.Content("~/js/i18n-core.js")"></script>
  <script src="@Url.Content("~/js/i18n.config.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Chatbot.cshtml"); }
  <script>
    document.getElementById('btnDescargar')?.addEventListener('click', () => window.print());
  </script>
</body>

</html>

