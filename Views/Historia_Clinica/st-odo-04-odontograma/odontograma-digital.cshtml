@using System.Text.Json
@using SmileTrack_MVC.Models.ViewModels
@model OdontogramaViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Odontograma Digital FDI";
    ViewData["Description"] = "Visualiza y registra el estado dental con numeración FDI";
    ViewData["UseGestionModulesDesignSystem"] = true;

    @* Yeray (2025) - Se agrega citaId al config JS.
       Si el profesional llegó desde la agenda con ?citaId=N, ese valor llega aquí
       en Model.CitaId. El JS lo lee en config.citaId y lo incluye en el payload de
       /guardar, completando la trazabilidad diente ↔ cita en Registro_Odontograma.
       Si no hay cita activa, citaId es null y el comportamiento es el mismo que antes. *@
    var configJson = JsonSerializer.Serialize(new
    {
        pacienteId        = Model.PacienteId,
        historiaId        = Model.HistoriaId,
        pacienteNombre    = Model.PacienteNombre,
        codigoHC          = Model.CodigoHC,
        fechaNacimiento   = Model.FechaNacimiento,
        profesionalNombre = Model.ProfesionalNombre,
        profesionalCorreo = Model.ProfesionalCorreo,
        estadoPersistido  = Model.ObservacionesGenerales,
        citaId            = Model.CitaId
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/Historia_Clinica/st-odo-04-odontograma/odontograma-digital.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/odontograma-fdi.css" asp-append-version="true" />
}

<!-- ═ ═ ═ ═ ═  MAIN ═ ═ ═ ═ ═  -->
<main class="main professional-odontograma" id="main-content">
    @Html.AntiForgeryToken()

    <!-- HEADER -->
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
                <span data-i18n="common_role_profesional">Odontólogo</span>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" data-i18n="nav.odontogram">Odontograma Digital FDI</span>
            </nav>
            <h1 class="page-title" data-i18n="nav.odontogram">Odontograma Digital FDI</h1>
            <p class="page-subtitle">
                <time datetime="" id="headerDate" aria-live="polite">Cargando fecha…</time> ·
                <span id="patientName" aria-label="Paciente">@Model.PacienteNombre</span> ·
                <span id="patientHC" aria-label="Historia clínica">@Model.CodigoHC</span> ·
                <span id="dentitionType" aria-label="Tipo de dentición">Dentición adulta</span>
            </p>
        </div>
        <div class="page-header-actions">
            <button class="btn-secondary" id="btnMapeo" type="button" aria-label="Ir al odontograma con numeración FDI">
                <span class="material-symbols-outlined" aria-hidden="true">dentistry</span>
                <span>Numeración FDI</span>
            </button>
            <button class="btn-primary" id="btnGuardar" aria-label="Guardar cambios">
                <span class="material-symbols-outlined" aria-hidden="true">save</span>
                <span>Guardar cambios</span>
            </button>
        </div>
    </header>

    <!-- STATS GRID -->
    <section class="stats-grid" aria-label="Resumen de odontograma">
        <div class="stat-card" data-color="green">
            <span class="stat-number" id="stat-sanos" data-target="0" aria-live="polite">0</span>
            <span class="stat-label">Sanos</span>
        </div>
        <div class="stat-card" data-color="orange">
            <span class="stat-number" id="stat-caries" data-target="0" aria-live="polite">0</span>
            <span class="stat-label">Con caries</span>
        </div>
        <div class="stat-card" data-color="purple">
            <span class="stat-number" id="stat-tratamientos" data-target="0" aria-live="polite">0</span>
            <span class="stat-label">Tratados</span>
        </div>
        <div class="stat-card" data-color="blue">
            <span class="stat-number" id="stat-total" data-target="32" aria-live="polite">0</span>
            <span class="stat-label">Total piezas</span>
        </div>
    </section>

    <!-- CONTENT GRID -->
    <div class="content-grid">

        <!-- SECCIÓN IZQUIERDA: ODONTOGRAMA 3D / FDI -->
        <section class="odontograma-section" aria-labelledby="odontograma-title">

            <div class="odontograma-widget" aria-labelledby="odontograma-widget-title">
                <h2 class="widget-title" id="odontograma-widget-title">
                    <span class="material-symbols-outlined" aria-hidden="true">dentistry</span>
                    <span>Odontograma FDI interactivo</span>
                </h2>

                <div class="viewer-wrap">
                    <div id="odontogramaFdiChart" class="odontograma-fdi-chart" role="group" aria-label="Odontograma FDI. Selecciona un diente para registrar su estado clínico." tabindex="-1"></div>
                    <p class="fdi-chart-help">Selecciona una pieza para registrar o consultar su estado. La numeración FDI se guarda junto a la historia clínica.</p>
                </div>

                <!-- Leyenda -->
                <div class="legend" aria-label="Leyenda de estados">
                    <div class="li"><span class="li-dot li-dot--caries"></span>Caries</div>
                    <div class="li"><span class="li-bar li-bar--endodoncia"></span>Endodoncia</div>
                    <div class="li"><span class="li-dot li-dot--sellante"></span>Sellante</div>
                    <div class="li"><span class="li-bar li-bar--placa"></span>Placa</div>
                    <div class="li"><span class="li-dot li-dot--sano"></span>Sano</div>
                </div>
            </div>

            <!-- PANEL DE PIEZA SELECCIONADA -->
            <div class="card card-pieza" id="cardPieza" style="display:none;" aria-labelledby="pieza-title" aria-live="polite">
                <h3 class="card-title" id="pieza-title">
                    <span class="material-symbols-outlined pieza-pin" aria-hidden="true">location_on</span>
                    <span id="piezaTitulo">Pieza seleccionada</span>
                </h3>
                <div class="pieza-estado" id="piezaEstado" role="status"></div>

                <div class="diag-form" id="diagForm">
                    <div class="diag-label">Estado clínico:</div>
                    <div class="estado-btns" id="estadoBtns" role="radiogroup" aria-label="Seleccionar estado clínico"></div>
                    <label class="diag-label" for="obsTa">Observaciones:</label>
                    <textarea class="obs" rows="2" id="obsTa" placeholder="Observaciones clínicas..."></textarea>
                    <div class="diag-actions">
                        <button class="btn-primary" onclick="guardarRegistro()">
                            <span class="material-symbols-outlined" aria-hidden="true">save</span>
                            <span>Actualizar</span>
                        </button>
                        <button class="btn-secondary" onclick="cerrarPanel()">Cancelar</button>
                    </div>
                </div>

                <div class="pieza-hist-title">Historial de cambios</div>
                <div class="pieza-hist" id="piezaHist" role="list" aria-label="Historial"></div>
            </div>

        </section>

        <!-- PANEL DERECHO -->
        <aside class="right-panel" aria-label="Herramientas">

            <div class="widget" aria-labelledby="mods-title">
                <h3 class="widget-title" id="mods-title">
                    <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                    <span>Últimas modificaciones</span>
                </h3>
                <div id="ultimasMods" aria-live="polite" role="list"></div>
            </div>

            <div class="widget" aria-labelledby="acciones-title">
                <h3 class="widget-title" id="acciones-title">
                    <span class="material-symbols-outlined" aria-hidden="true">settings</span>
                    <span>Acciones</span>
                </h3>
                <div class="acciones-list">
                    <button class="estado-btn eb-exportar" onclick="exportarHistorial()">
                        <span class="material-symbols-outlined" aria-hidden="true">download</span>
                        <span>Exportar historial</span>
                    </button>
                </div>
            </div>

        </aside>
    </div>

</main>

<!-- MODAL CONFIRMAR GUARDADO -->
<div class="modal-overlay" id="modalGuardar" role="dialog" aria-modal="true" aria-labelledby="modalGuardarTitle"
     aria-hidden="true" inert>
    <div class="modal modal--sm">
        <button class="modal-close" id="modalGuardarClose" aria-label="Cerrar">×</button>
        <h2 class="modal-title" id="modalGuardarTitle">Confirmar guardado</h2>
        <p class="modal-desc">¿Deseas guardar los cambios realizados en el odontograma?</p>
        <div class="modal-footer">
            <button class="btn-secondary" id="modalGuardarCancel">Cancelar</button>
            <button class="btn-primary" id="modalGuardarConfirm">Sí, guardar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.smiletrackOdontogramaConfig = @Html.Raw(configJson);
    </script>
    <script src="~/js/shared/odontograma-fdi.js" asp-append-version="true" defer></script>
    <script src="~/js/Historia_Clinica/st-odo-04-odontograma/odontograma-digital.js" asp-append-version="true" defer></script>
}
