@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Seguimiento de Tratamientos</title>
  <meta name="description" content="Seguimiento de tratamientos dentales en curso, completados y pausados." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-07-seguimiento-tratamiento/tratamientos.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>
  @{ await Html.RenderPartialAsync("~/Views/shared/_LangSwitcher.cshtml"); }

  <a href="#main-content" class="skip-link" data-i18n="common_skip_link">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }

  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_profesional">Odontólogo</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active" data-i18n="historia.treatment_followup">Seguimiento de Tratamientos</span>
        </nav>
        <h1 class="page-title" data-i18n="historia.treatment_followup">Seguimiento de Tratamientos</h1>
        <p class="page-subtitle" id="pageSub">
          Tratamientos en curso, pausados y completados de tus pacientes
        </p>
      </div>
    </header>

    <section class="plan-editor" aria-labelledby="planEditorTitle">
      <h2 id="planEditorTitle">Agregar tratamiento al plan</h2>
      <form id="planTratamientoForm">
        @Html.AntiForgeryToken()
        <label for="planPaciente">Paciente</label>
        <select id="planPaciente" required>
          <option value="">Selecciona un paciente</option>
        </select>

        <label for="planServicio">Servicio</label>
        <select id="planServicio" required>
          <option value="">Selecciona un servicio</option>
        </select>

        @* Yeray: Permite al profesional definir una proyección manual separada del conteo real de sesiones. *@
        <label for="planSesionesEstimadas">Sesiones estimadas</label>
        <input id="planSesionesEstimadas" type="number" min="0" step="1" value="0" required />

        <label for="planNumeroFdi">Pieza dental permanente FDI (opcional)</label>
        <input id="planNumeroFdi" inputmode="numeric" maxlength="2" placeholder="Ej. 16" />

        <label for="planEstado">Estado</label>
        <select id="planEstado" required>
          <option value="propuesto">Propuesto</option>
          <option value="aprobado">Aprobado</option>
          <option value="en-curso">En curso</option>
          <option value="pausado">Pausado</option>
          <option value="completado">Completado</option>
          <option value="cancelado">Cancelado</option>
        </select>

        <label for="planObservacion">Observación clínica (opcional)</label>
        <textarea id="planObservacion" maxlength="1000" rows="2"></textarea>
        <button type="submit" id="guardarPlanTratamiento">Guardar en el plan</button>
      </form>
    </section>

    @* Yeray: Registra fechas y vínculos opcionales de sesiones, y pide motivo antes de anular un evento. *@
    <dialog id="sessionDialog" class="workflow-dialog" aria-labelledby="sessionDialogTitle">
      <form id="sessionForm" method="dialog">
        @Html.AntiForgeryToken()
        <input id="sessionPlanId" type="hidden" />
        <h2 id="sessionDialogTitle">Registrar sesión realizada</h2>
        <label for="sessionDate">Fecha de sesión</label>
        <input id="sessionDate" type="date" required />
        <label for="sessionCita">Cita relacionada (opcional)</label>
        <select id="sessionCita"><option value="">Sin cita</option></select>
        <label for="sessionNota">Nota clínica relacionada (opcional)</label>
        <select id="sessionNota"><option value="">Sin nota</option></select>
        <div class="workflow-actions">
          <button type="submit" class="btn-primary">Registrar sesión</button>
          <button type="button" class="btn-secondary" data-close-dialog="sessionDialog">Cancelar</button>
        </div>
      </form>
    </dialog>

    <dialog id="annulSessionDialog" class="workflow-dialog" aria-labelledby="annulSessionDialogTitle">
      <form id="annulSessionForm" method="dialog">
        @Html.AntiForgeryToken()
        <input id="annulSessionId" type="hidden" />
        <h2 id="annulSessionDialogTitle">Anular sesión</h2>
        <label for="annulSessionReason">Motivo de anulación</label>
        <textarea id="annulSessionReason" minlength="3" maxlength="500" rows="3" required></textarea>
        <div class="workflow-actions">
          <button type="submit" class="btn-danger">Anular sesión</button>
          <button type="button" class="btn-secondary" data-close-dialog="annulSessionDialog">Cancelar</button>
        </div>
      </form>
    </dialog>

    <!-- ═════ TARJETAS DE ESTADÍSTICAS ═════ -->
    <section class="stats-grid" aria-label="Estadísticas de tratamientos" data-i18n-aria-label="historia.treatment">
      <div class="stat-card stat-total">
        <div class="stat-icon">📊</div>
        <div class="stat-content">
          <span class="stat-number" id="statTotal">0</span>
          <span class="stat-label" data-i18n="historia.treatment_total">Total de tratamientos</span>
        </div>
      </div>
      
      <div class="stat-card stat-en-curso">
        <div class="stat-icon">🔄</div>
        <div class="stat-content">
          <span class="stat-number" id="statEnCurso">0</span>
          <span class="stat-label">Activos</span>
        </div>
      </div>
      
      <div class="stat-card stat-completado">
        <div class="stat-icon">✅</div>
        <div class="stat-content">
          <span class="stat-number" id="statCompletado">0</span>
          <span class="stat-label">Completados</span>
        </div>
      </div>
      
      <div class="stat-card stat-pausado">
        <div class="stat-icon">⏸️</div>
        <div class="stat-content">
          <span class="stat-number" id="statPausado">0</span>
          <span class="stat-label">Pausados</span>
        </div>
      </div>
    </section>

    <!-- ═════ FILTROS Y BUSCADOR ═════ -->
    <section class="filters-section" aria-label="Filtros de búsqueda">
      <div class="search-box">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Buscar por nombre de paciente..." data-i18n-ph="table.search" aria-label="Buscar paciente" />
      </div>
      
      <div class="filters-grid">
        <div class="filter-group">
          <label for="filterPaciente" class="filter-label">Paciente</label>
          <select id="filterPaciente" class="filter-select">
            <option value="">Todos los pacientes</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label for="filterEstado" class="filter-label">Estado</label>
          <select id="filterEstado" class="filter-select">
            <option value="">Todos los estados</option>
            <option value="en-curso">En curso</option>
            <option value="propuesto">Propuesto</option>
            <option value="aprobado">Aprobado</option>
            <option value="completado">Completado</option>
            <option value="pausado">Pausado</option>
            <option value="cancelado">Cancelado</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label for="filterTipo" class="filter-label">Tipo de tratamiento</label>
          <select id="filterTipo" class="filter-select">
            <option value="">Todos los tipos</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label for="filterOdontologo" class="filter-label">Odontólogo</label>
          <select id="filterOdontologo" class="filter-select">
            <option value="">Todos los odontólogos</option>
          </select>
        </div>
        
        <div class="filter-group">
          <label for="filterPorPagina" class="filter-label">Por página</label>
          <select id="filterPorPagina" class="filter-select">
            <option value="5">5 por página</option>
            <option value="10" selected>10 por página</option>
            <option value="15">15 por página</option>
            <option value="20">20 por página</option>
          </select>
        </div>
      </div>
    </section>

    <!-- ═════ LISTA DE TRATAMIENTOS ═════ -->
    <section class="section" aria-labelledby="tratamientosTitle">
      <div class="section-header">
        <h2 class="section-title" id="tratamientosTitle">Tratamientos registrados</h2>
        <span class="results-count" id="resultsCount" aria-live="polite">Mostrando 0 de 0 tratamientos</span>
      </div>

      <div id="tratamientosList" aria-live="polite" role="list" aria-label="Lista de tratamientos">
        <!-- JS renderiza aquí -->
      </div>

      <div class="empty-state" id="emptyState" style="display:none" role="status" aria-live="polite" aria-hidden="true">
        <div class="empty-icon"></div>
        <p>No se encontraron tratamientos con los filtros seleccionados.</p>
        <button class="btn-clear-filters" id="btnClearFilters">Limpiar filtros</button>
      </div>

      <!-- ═════ PAGINACIÓN ════ -->
      <nav class="pagination" id="pagination" aria-label="Paginación de tratamientos" style="display:none">
        <button class="pagination-btn" id="btnFirst" aria-label="Primera página">««</button>
        <button class="pagination-btn" id="btnPrev" aria-label="Página anterior">«</button>
        
        <div class="pagination-numbers" id="paginationNumbers">
          <!-- Números de página generados por JS -->
        </div>
        
        <button class="pagination-btn" id="btnNext" aria-label="Página siguiente">»</button>
        <button class="pagination-btn" id="btnLast" aria-label="Última página">»»</button>
      </nav>
    </section>

  </main>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Agenda</span>
    </a>
    <a href="/historia-clinica/st-odo-06-pacientes" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Pacientes</span>
    </a>
    <a href="/historia-clinica/st-odo-03-historial" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <style>
    /* Yeray: Mantiene accesibles y estables los formularios para registrar y corregir sesiones clínicas. */
    .session-summary { display: grid; gap: 8px; padding-top: 12px; border-top: 1px solid var(--border); }
    .session-summary progress { width: 100%; height: 10px; accent-color: var(--green-dark); }
    .session-summary p, .session-row { font-size: .82rem; color: var(--text-muted); }
    .session-list { display: grid; gap: 6px; margin-top: 8px; }
    .session-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .session-row.is-annulled { opacity: .7; text-decoration: line-through; }
    .session-warning { color: #92400e !important; font-weight: 600; }
    .session-summary button, .btn-danger { border: 0; border-radius: 8px; padding: 7px 10px; font: inherit; font-weight: 600; }
    .btn-danger { background: #b91c1c; color: #fff; }
    .btn-anular-sesion { background: #fee2e2; color: #991b1b; }
    .workflow-dialog { width: min(520px, calc(100vw - 32px)); max-width: none; margin: auto; padding: 0; border: 1px solid var(--border); border-radius: 8px; color: var(--text); }
    .workflow-dialog::backdrop { background: rgba(15, 23, 42, .48); }
    .workflow-dialog form { display: grid; gap: 10px; padding: 22px; }
    .workflow-dialog h2 { font: 700 1rem var(--font-display); color: var(--primary); }
    .workflow-dialog label { font-size: .84rem; font-weight: 600; }
    .workflow-dialog input, .workflow-dialog select, .workflow-dialog textarea { width: 100%; min-width: 0; padding: 9px; border: 1px solid var(--border); border-radius: 8px; font: inherit; }
    .workflow-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }
    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
  
  <script src="@Url.Content("~/js/Historia_Clinica/st-odo-07-seguimiento-tratamiento/tratamientos.js")"></script>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;"></span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>

  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
  <script src="@Url.Content("~/js/i18n-core.js")"></script>
  <script src="@Url.Content("~/js/i18n.config.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Chatbot.cshtml"); }
</body>
</html>
