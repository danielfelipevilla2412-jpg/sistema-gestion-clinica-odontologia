@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis pacientes";
    ViewData["Description"] = "Consulta la información de los pacientes atendidos por el profesional.";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Historia_Clinica/st-odo-06-pacientes/pacientes.css" asp-append-version="true" />
}

<main class="main professional-patients" id="main-content">
  <header class="page-header">
    <div class="header-left">
      <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="odo06.breadcrumb_aria">
        <span data-i18n="odo06.breadcrumb_professional">Profesional</span>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span class="bc-active" data-i18n="odo06.title">Mis pacientes</span>
      </nav>
      <h1 class="page-title" data-i18n="odo06.title">Mis pacientes</h1>
      <p class="page-subtitle" data-i18n="odo06.subtitle">Consulta la información de los pacientes atendidos por ti.</p>
    </div>
  </header>

  <section class="stats-grid" aria-label="Resumen de pacientes" data-i18n-aria-label="odo06.stats_aria">
    <article class="stat-card" data-color="blue">
      <span class="stat-number" id="statTotal" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="odo06.stat_total">Total de pacientes</span>
    </article>
    <article class="stat-card" data-color="green">
      <span class="stat-number" id="statActivos" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="odo06.stat_active">Activos</span>
    </article>
    <article class="stat-card" data-color="orange">
      <span class="stat-number" id="statSeguimiento" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="odo06.stat_followup">En seguimiento</span>
    </article>
    <article class="stat-card" data-color="purple">
      <span class="stat-number" id="statAltas" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="odo06.stat_discharged">Altas médicas</span>
    </article>
  </section>

  <section class="filters-section" aria-label="Filtros de pacientes" data-i18n-aria-label="odo06.filters_aria">
    <div class="filters-row">
      <div class="search-wrap">
        <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
        <input type="search" id="searchInput" class="search-input"
               placeholder="Buscar por nombre, documento o servicio..."
               aria-label="Buscar por nombre, documento o servicio"
               data-i18n-ph="odo06.search_placeholder" data-i18n-aria-label="odo06.search_aria">
      </div>
      <div class="filter-wrap">
        <label for="filterEstado" class="filter-label" data-i18n="odo06.filter_status">Estado</label>
        <select id="filterEstado" class="status-select" aria-label="Filtrar por estado" data-i18n-aria-label="odo06.filter_status_aria">
          <option value="" data-i18n="odo06.all_statuses">Todos los estados</option>
          <option value="activo" data-i18n="odo06.stat_active">Activos</option>
          <option value="seguimiento" data-i18n="odo06.stat_followup">En seguimiento</option>
          <option value="alta" data-i18n="odo06.stat_discharged">Altas médicas</option>
        </select>
      </div>
      <div class="filter-wrap">
        <label for="filterAlergias" class="filter-label" data-i18n="odo06.filter_allergies">Alergias</label>
        <select id="filterAlergias" class="status-select" aria-label="Filtrar por alergias" data-i18n-aria-label="odo06.filter_allergies_aria">
          <option value="" data-i18n="odo06.all">Todas</option>
          <option value="con" data-i18n="odo06.with_allergies">Con alergias</option>
          <option value="sin" data-i18n="odo06.without_allergies">Sin alergias</option>
        </select>
      </div>
      <div class="filter-wrap">
        <label for="filterCita" class="filter-label" data-i18n="odo06.filter_appointment">Próxima cita</label>
        <select id="filterCita" class="status-select" aria-label="Filtrar por próxima cita" data-i18n-aria-label="odo06.filter_appointment_aria">
          <option value="" data-i18n="odo06.all">Todas</option>
          <option value="con" data-i18n="odo06.with_appointment">Con cita</option>
          <option value="sin" data-i18n="odo06.without_appointment">Sin cita</option>
        </select>
      </div>
      <div class="filter-wrap">
        <label for="filterServicio" class="filter-label" data-i18n="odo06.filter_service">Servicio</label>
        <select id="filterServicio" class="status-select" aria-label="Filtrar por servicio" data-i18n-aria-label="odo06.filter_service_aria">
          <option value="" data-i18n="odo06.all_services">Todos los servicios</option>
        </select>
      </div>
      <button class="btn-secondary" id="btnClearFilters" type="button" aria-label="Limpiar filtros" data-i18n-aria-label="odo06.clear_filters">
        <span class="material-symbols-outlined" aria-hidden="true">filter_alt_off</span>
        <span data-i18n="odo06.clear">Limpiar</span>
      </button>
    </div>
    <div class="filters-meta">
      <span class="filter-results" id="filterResults" aria-live="polite"></span>
      <label for="pageSizeSelect" class="visually-hidden" data-i18n="odo06.page_size_aria">Pacientes por página</label>
      <select id="pageSizeSelect" class="status-select status-select--sm" aria-label="Pacientes por página" data-i18n-aria-label="odo06.page_size_aria">
        <option value="5" data-i18n="odo06.per_page_5">5 por página</option>
        <option value="10" selected data-i18n="odo06.per_page_10">10 por página</option>
        <option value="15" data-i18n="odo06.per_page_15">15 por página</option>
        <option value="100" data-i18n="odo06.per_page_100">100 por página</option>
      </select>
    </div>
  </section>

  <section class="table-card" aria-labelledby="patientsTableTitle">
    <h2 class="visually-hidden" id="patientsTableTitle" data-i18n="odo06.patient_list">Lista de pacientes</h2>
    <div class="table-wrap">
      <table id="pacientesTable" class="table-base" aria-label="Tabla de pacientes atendidos" data-i18n-aria-label="odo06.table_aria">
        <thead>
          <tr>
            <th scope="col" data-i18n="odo06.patient">Paciente</th>
            <th scope="col" data-i18n="odo06.last_visit">Última consulta</th>
            <th scope="col" data-i18n="odo06.service">Servicio</th>
            <th scope="col" data-i18n="odo06.next_appointment">Próxima cita</th>
            <th scope="col" data-i18n="odo06.status">Estado</th>
            <th scope="col" data-i18n="odo06.actions">Acciones</th>
          </tr>
        </thead>
        <tbody id="pacientesTbody" aria-live="polite"></tbody>
      </table>
    </div>
  </section>

  <footer class="page-footer" id="paginationControls" aria-label="Navegación de páginas" data-i18n-aria-label="odo06.pagination_aria">
    <span class="pagination-info">
      <span data-i18n="odo06.pagination_showing">Mostrando</span>
      <strong id="pageShowing">0</strong>
      <span data-i18n="odo06.pagination_of">de</span>
      <strong id="pageTotal">0</strong>
      <span data-i18n="odo06.patient_count">pacientes</span>
    </span>
    <nav class="pagination" aria-label="Páginas de resultados" data-i18n-aria-label="odo06.pagination_pages_aria">
      <button class="pagination-btn" id="btnPrev" type="button" aria-label="Página anterior" data-i18n-aria-label="odo06.previous_page" disabled>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
      </button>
      <span id="pageNumBtns" class="page-num-wrap"></span>
      <button class="pagination-btn" id="btnNext" type="button" aria-label="Página siguiente" data-i18n-aria-label="odo06.next_page">
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
      </button>
    </nav>
  </footer>
</main>

@section Scripts {
  <script src="~/js/Historia_Clinica/st-odo-06-pacientes/pacientes.js" asp-append-version="true" defer></script>
}
