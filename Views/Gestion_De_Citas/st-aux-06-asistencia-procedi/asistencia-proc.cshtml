@* ============================================
   SmileTrack — Módulo: Gestión de Citas
   Vista: Asistencia en Procedimiento (st-aux-06-asistencia-procedi)
   ============================================
   Archivo: Views/Gestion_De_Citas/st-aux-06-asistencia-procedi/asistencia-proc.cshtml

   PROPÓSITO Y JUSTIFICACIÓN:
   Interfaz de apoyo en tiempo real para el auxiliar durante un procedimiento quirúrgico o tratamiento odontológico.

   REGLAS DE RENDERIZADO Y NEGOCIO:
   - Presenta temporizador circular, checklist de desinfección y alertas de salud del paciente.

   DEPENDENCIAS:
   - CSS: ~/css/Gestion_De_Citas/st-aux-06-asistencia-procedi/asistencia-proc.css
   - JS: ~/js/Gestion_De_Citas/st-aux-06-asistencia-procedi/asistencia-proc.js
   ============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Asistencia en Procedimiento";
    var asistenciaProcedDataJson = System.Text.Json.JsonSerializer.Serialize(ViewData["AsistenciaProcedData"] ?? new object());
    var citasSelector = ViewData["CitasAsistenciaSelector"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
    var asistenciaJson = System.Text.Json.JsonDocument.Parse(asistenciaProcedDataJson).RootElement;
    var citaSeleccionadaId = asistenciaJson.TryGetProperty("citaId", out var citaIdJson) && citaIdJson.ValueKind == System.Text.Json.JsonValueKind.Number
      ? citaIdJson.GetInt32()
      : 0;
    var estadoCita = asistenciaJson.TryGetProperty("estado", out var estadoJson) && estadoJson.ValueKind == System.Text.Json.JsonValueKind.String
      ? estadoJson.GetString()
      : null;
    var estadoNormalizado = asistenciaJson.TryGetProperty("estadoNormalizado", out var estadoNormalizadoJson) && estadoNormalizadoJson.ValueKind == System.Text.Json.JsonValueKind.String
      ? estadoNormalizadoJson.GetString()
      : null;
    var procedimientoEnCurso = estadoNormalizado == "en_proceso";
    var citaSeleccionadaConsultorioId = asistenciaJson.TryGetProperty("consultorioId", out var consultorioIdJson) && consultorioIdJson.ValueKind == System.Text.Json.JsonValueKind.Number
      ? consultorioIdJson.GetInt32()
      : 0;
    var estadoConsultorioUrl = citaSeleccionadaId > 0
      ? $"/gestion-de-citas/st-aux-09-estado-consultorio?citaId={citaSeleccionadaId}" +
        (citaSeleccionadaConsultorioId > 0 ? $"&consultorioId={citaSeleccionadaConsultorioId}" : string.Empty)
      : "/gestion-de-citas/st-aux-09-estado-consultorio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-aux-06-asistencia-procedi/asistencia-proc.css" asp-append-version="true" />
}

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">
    @Html.AntiForgeryToken()

    <!-- Breadcrumb y header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_auxiliar">Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="citas.procedure_assistance">Asistencia en procedimiento</span>
        </nav>
        <h1 class="page-title" data-i18n="citas.procedure_assistance">Asistencia en Procedimiento</h1>
        <p class="page-subtitle" id="apSubtitle" data-i18n="common.loading">Cargando…</p>
      </div>
      <div class="header-actions">
        <label for="citaSelect" class="visually-hidden">Seleccionar cita</label>
        <select id="citaSelect" class="status-select" aria-label="Seleccionar cita del día">
          <option value="">Seleccionar cita del día</option>
          @foreach (var cita in citasSelector)
          {
            <option value="@cita.IdCita" selected="@(cita.IdCita == citaSeleccionadaId ? "selected" : null)">
              @cita.FechaHora.ToString("HH:mm") - @(cita.Paciente?.NombresCompleto ?? "Paciente")
            </option>
          }
        </select>
        <a class="btn-secondary" id="officeStatusLink" href="@estadoConsultorioUrl">
          <span class="material-symbols-outlined" aria-hidden="true">medical_services</span>
          Ver consultorio
        </a>
      </div>
    </header>

    <!-- Alerta médica con role alert para anuncio inmediato -->
    <div class="alert-banner" id="apAlertBanner" role="alert" aria-live="assertive" style="display:none;">
      <span class="material-symbols-outlined alert-banner-icon" aria-hidden="true">warning</span>
      <p class="alert-banner-text" id="apAlertBannerText"></p>
    </div>

    <section class="procedure-empty-state" id="apEmptyState" style="@(citaSeleccionadaId > 0 ? "display:none;" : null)" aria-live="polite">
      <span class="material-symbols-outlined" aria-hidden="true">event_available</span>
      <h2>Selecciona una cita</h2>
      <p>Elige una cita de hoy para consultar los datos y las alertas del paciente. La atención se iniciará automáticamente a la hora programada.</p>
    </section>

    <!-- Layout de contenido -->
    <div class="content-layout" id="procedureContent" style="@(citaSeleccionadaId > 0 ? null : "display:none;")">

      <!-- Columna izquierda: Timer + Datos -->
      <div class="content-left">

        <!-- Tarjeta de estado con timer accesible -->
        <div class="status-card">
          <div class="timer-circle" id="procedureTimer" role="timer" aria-label="Tiempo transcurrido del procedimiento" style="@(procedimientoEnCurso ? null : "display:none;")">
            <span class="timer-value" id="timerValue">0</span>
            <span class="timer-label">min</span>
          </div>
          <div class="status-info">
            <p class="status-label" data-i18n="citas.status">Estado del procedimiento</p>
            @if (citaSeleccionadaId > 0)
            {
              <span class="status-badge" id="procedureStatus" data-status="@estadoNormalizado" role="status">
                @SmileTrack_MVC.Helpers.EstadoCitaHelper.ResolveEstadoNombre(estadoCita)
              </span>
            }
            <p class="status-time" id="apStatusTime" style="@(procedimientoEnCurso ? null : "display:none;")">Iniciado a las <time id="apStartTime" datetime=""></time></p>
          </div>
        </div>

        <!-- Datos de la cita -->
        <div class="data-card">
          <h3 class="data-card-title" data-i18n="citas.appointment_data">Datos de la cita</h3>
          <div class="data-row"><strong>Paciente:</strong> <span id="apPaciente">—</span></div>
          <div class="data-row"><strong>Profesional:</strong> <span id="apProfesional">—</span></div>
          <div class="data-row"><strong>Servicio:</strong> <span id="apServicio">—</span></div>
          <div class="data-row"><strong>Consultorio:</strong> <span id="apConsultorio">—</span></div>
        </div>

      </div>

      <!-- Columna derecha: Alertas + Estado del procedimiento -->
      <aside class="content-right">

        <!-- Alertas del paciente con role list -->
        <div class="alert-card">
          <p class="alert-card-title"><span class="material-symbols-outlined" aria-hidden="true">warning_amber</span> Alertas del paciente</p>
          <div role="list" aria-label="Alertas médicas del paciente">
            <div class="alert-item" id="apAlergiaItem" role="listitem" style="display:none;">
              <span class="material-symbols-outlined alert-icon" aria-hidden="true">error</span>
              <span><strong>Alergia:</strong> <span id="apAlergiaTexto"></span></span>
            </div>
            <div class="alert-item" id="apAntecedentesItem" role="listitem" style="display:none;">
              <span class="material-symbols-outlined alert-icon" aria-hidden="true">error</span>
              <span><strong>Antecedentes:</strong> <span id="apAntecedentesTexto"></span></span>
            </div>
            <div class="alert-item" id="apSinAlertas" role="listitem">
              <span><em>Sin alertas médicas registradas para este paciente.</em></span>
            </div>
          </div>
        </div>

        <!-- Estado del procedimiento con píldoras interactivas -->
        <div class="procedure-card" id="procedureChecklist" style="@(procedimientoEnCurso ? null : "display:none;")">
          <h3 class="procedure-card-title">Estado del Procedimiento</h3>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="material-symbols-outlined procedure-icon" aria-hidden="true">healing</span>
              Limpieza
            </span>
            <button class="procedure-pill azul" id="pillLimpieza" aria-pressed="false"
              aria-label="Marcar limpieza como completada">Limpieza</button>
          </div>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="material-symbols-outlined procedure-icon" aria-hidden="true">healing</span>
              Esterilización
            </span>
            <button class="procedure-pill verde" id="pillEsterilizacion" aria-pressed="false"
              aria-label="Marcar esterilización como completada">Esterilización</button>
          </div>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="material-symbols-outlined procedure-icon" aria-hidden="true">healing</span>
              Equipos
            </span>
            <button class="procedure-pill gris" id="pillEquipos" aria-pressed="false"
              aria-label="Marcar equipos como completada">Equipos</button>
          </div>

        </div>

      </aside>

    </div>

  </main>

  <!-- Mobile bottom nav con aria-label para navegación móvil -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">space_dashboard</span></span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-aux-02-agenda-apoyo" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-pacientes/st-aux-05-historial-parcial" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">history</span></span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-citas/st-aux-06-asistencia-procedi" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">healing</span></span>
      <span>Procedimiento</span>
    </a>
    <a href="/perfiles/st-aux-11-perfil-auxiliar" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast con aria-atomic para anuncio completo de notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
  </footer>

  <script>
    window.smiletrackAsistenciaProcedData = @Html.Raw(asistenciaProcedDataJson);
    document.getElementById('citaSelect')?.addEventListener('change', function () {
      const params = new URLSearchParams(window.location.search);
      params.set('citaId', this.value || '0');
      window.location.search = params.toString();
    });
  </script>
@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-aux-06-asistencia-procedi/asistencia-proc.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
