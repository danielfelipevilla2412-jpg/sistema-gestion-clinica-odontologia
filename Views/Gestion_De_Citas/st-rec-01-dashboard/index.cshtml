@* ============================================
SmileTrack — Dashboard Recepción (st-rec-01-dashboard)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista principal para el rol de recepcionista que muestra el control de flujo de pacientes en sala de espera, el resumen operativo del día y accesos rápidos a agendamiento.

FUNCIONALIDADES PRINCIPALES:
- Visualización de pacientes en sala de espera y tiempos acumulados
- Resumen numÉrico del estado de las citas diarias
- Control rápido para marcar asistencia y canalizar pacientes al consultorio correspondiente

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y RecepcionDashboard
- CSS: ~/css/Gestion_De_Citas/st-rec-01-dashboard/styles.css
- JS: ~/js/Gestion_De_Citas/st-rec-01-dashboard/app.js
- Partial / Otros: Sidebar unificado

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard Recepción";
    var dashboardRecDataJson = System.Text.Json.JsonSerializer.Serialize(ViewData["DashboardRecData"] ?? new object());
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-rec-01-dashboard/styles.css" asp-append-version="true" />
}

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-left">
        <div class="breadcrumb" data-i18n="rec01_breadcrumb">Recepción ? Panel</div>
        <h1 class="page-title" data-i18n="rec01_title">Panel de Recepción</h1>
        <!-- [MEJORA]: time datetime para accesibilidad de fecha/hora -->
        <p class="page-subtitle" id="pageSubtitleDate" data-i18n="common.loading">Cargando…</p>
      </div>
    </header>

    <!-- Alert Banner (próximas citas) -->
    <!-- [MEJORA]: role="region" + aria-label para sección importante -->
    <div class="alert-banner" id="alertBannerProximas" role="region" aria-label="Próximas citas en los siguientes 30 minutos" style="display:none;">
      <div class="alert-banner-icon material-symbols-outlined" aria-hidden="true">notifications</div>
      <div class="alert-banner-content">
        <h3 class="alert-banner-title" data-i18n="rec01_alert_banner_title">Próximas citas — en los siguientes 30 minutos</h3>
        <div class="alert-banner-desc" id="alertBannerDesc">
          <!-- Se llena dinámicamente desde datos reales (ver renderProximasCitas en app.js) -->
        </div>
      </div>
    </div>

    <!-- Stats Grid (usando clases unificadas) -->
    <!-- [MEJORA]: aria-label para sección de estadÍdsticas -->
    <section class="stats-grid" aria-label="Resumen de actividad del día" data-i18n-aria-label="rec01.stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statCitasHoy">—</span>
        <span class="stat-label" data-i18n="rec01.stat_today">Citas hoy</span>
        <span class="stat-sub">Hoy</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statConfirmadas">—</span>
        <span class="stat-label" data-i18n="status.confirmed">Confirmadas</span>
        <span class="stat-sub">Este turno</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statPendientes">—</span>
        <span class="stat-label" data-i18n="status.pending">Pendientes</span>
        <span class="stat-sub">Por atender</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="statFacturasPendientes">—</span>
        <span class="stat-label" data-i18n="rec01.stat_invoices_pending">Facturas pendientes</span>
        <span class="stat-sub">Sin pagar</span>
      </div>
    </section>

    <!-- Action Buttons -->
    <!-- [MEJORA]: role="group" para botones relacionados -->
    <div class="action-buttons-row" role="group" aria-label="Acciones rápidas" data-i18n-aria-label="rec01.quick_actions_aria">
      <!-- [MEJORA]: aria-label descriptivo para cada botón -->
      <button class="btn-primary" id="btnNuevoPaciente" aria-label="Registrar nuevo paciente en el sistema" data-i18n-aria-label="rec01.btn_new_patient_aria">
        <span class="material-symbols-outlined" aria-hidden="true">person_add</span> <span data-i18n="patients.new">Nuevo paciente</span>
      </button>
      <button class="btn-secondary" id="btnGenerarFactura" aria-label="Generar nueva factura para paciente" data-i18n-aria-label="rec01.btn_generate_invoice_aria">
        <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span> <span data-i18n="rec01.btn_generate_invoice">Generar factura</span>
      </button>
    </div>

    <!-- Content Layout: Table + Widgets -->
    <div class="content-layout">

      <!-- Table Section -->
      <div class="table-section">
        <div class="table-wrap">
          <!-- [MEJORA]: aria-label y role para tabla accesible -->
          <table class="table-base" aria-label="Listado de citas del día" data-i18n-aria-label="rec01.table_aria">
            <thead>
              <tr>
                <!-- [MEJORA]: scope="col" para accesibilidad de tablas -->
                <th scope="col" data-i18n="citas.time">Hora</th>
                <th scope="col" data-i18n="citas.patient">Paciente</th>
                <th scope="col" data-i18n="citas.professional">Profesional</th>
                <th scope="col" data-i18n="citas.service">Servicio</th>
                <th scope="col" data-i18n="citas.status">Estado</th>
                <th scope="col" data-i18n="table.actions">Acciones</th>
              </tr>
            </thead>
            <!-- [MEJORA]: aria-live para anunciar cambios dinámicos en la tabla -->
            <tbody id="appointmentsTable" aria-live="polite"></tbody>
          </table>
        </div>
      </div>

      <!-- Widgets Section -->
      <aside class="widgets-section" aria-label="Información complementaria">

        <!-- Alertas Pendientes -->
        <div class="sidebar-card">
          <h4 class="sidebar-card-title" id="alertasTitle"><span class="material-symbols-outlined" aria-hidden="true">notifications</span> Alertas pendientes</h4>
          <!-- [MEJORA]: role="list" + aria-labelledby para estructura semántica -->
          <div class="alerts-list" role="list" aria-labelledby="alertasTitle">
            <div class="alert-item-card" role="listitem">
              <div class="alert-item-header">
                <span class="icon red material-symbols-outlined" aria-hidden="true">warning</span>
                <span>3 pacientes sin confirmar</span>
              </div>
              <!-- [MEJORA]: aria-label descriptivo para botón de acción -->
              <button class="btn-notify btn-notify-red" data-alert="sin-confirmar"
                aria-label="Enviar notificación a pacientes sin confirmar">Notificar</button>
            </div>
            <div class="alert-item-card" role="listitem">
              <div class="alert-item-header">
                <!-- BUG FIX: 'invoice' no es un nombre de ligature válido en Material Symbols
                     y se renderizaba como texto literal "invoice". El ícono correcto para
                     facturas/cobros en la biblioteca es 'receipt_long'. -->
                <span class="icon orange material-symbols-outlined" aria-hidden="true">receipt_long</span>
                <span>2 facturas vencidas</span>
              </div>
              <button class="btn-notify btn-notify-orange" data-alert="facturas-vencidas"
                aria-label="Enviar recordatorio de pago por facturas vencidas">Notificar</button>
            </div>
          </div>
        </div>

        <!-- Sistema en línea -->
        <div class="sidebar-card">
          <h4 class="sidebar-card-title"><span class="material-symbols-outlined" aria-hidden="true">monitor_heart</span> Estado del sistema</h4>
          <p style="font-size:.85rem;color:var(--text-muted);">Todos los servicios operativos</p>
          <p style="font-size:.75rem;color:var(--text-muted);margin-top:4px;">última verificación: hace 2 min</p>
        </div>

      </aside>

    </div>

  </main>

  <!-- Toast -->
  <!-- [MEJORA]: aria-atomic="true" para que lectores anuncien mensaje completo -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
  <script>
    window.smiletrackDashboardRecData = @Html.Raw(dashboardRecDataJson);
  </script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-rec-01-dashboard/app.js")" defer></script>

  <!-- Mobile bottom nav — Recepcionista -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-rec-01-dashboard" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></span>
      <span>Inicio</span>
    </a>
    <a href="/gestion-de-citas/st-rec-03-gestion-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">event_note</span></span>
      <span>Citas</span>
    </a>
    <a href="/perfiles/st-rec-06-perfil-recepcionista" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span>Perfil</span>
    </a>
  </nav>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — <span data-i18n="footer_copyright">Todos los derechos reservados.</span></p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO — SENA</p>
  </footer>
@section Scripts {
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
