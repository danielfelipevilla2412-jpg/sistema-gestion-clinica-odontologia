@* ============================================
SmileTrack — Recordatorios (st-rec-05-recordatorios)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista que permite a los recepcionistas enviar recordatorios manuales o programar notificaciones automáticas de citas médicas por correo electrónico.

FUNCIONALIDADES PRINCIPALES:
- Listado de citas próximas para envío de recordatorios
- Envío directo e individualizado de recordatorios por correo electrónico
- Panel de configuración para mensajes automáticos y estados del envío

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y Recordatorios
- CSS: ~/css/Gestion_De_Citas/st-rec-05-recordatorios/styles.css
- JS: ~/js/Gestion_De_Citas/st-rec-05-recordatorios/app.js
- Partial / Otros: Sidebar unificado

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@model SmileTrack_MVC.Models.ViewModels.RecordatoriosViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Recordatorios";
    var pendientes = Model?.Pendientes ?? new List<SmileTrack_MVC.Models.ViewModels.RecordatorioPendienteDto>();
    var historialEnviados = Model?.HistorialEnviados ?? new List<SmileTrack_MVC.Models.ViewModels.RecordatorioEnviadoDto>();
    int enviadosHoy = Model?.EnviadosHoy ?? 0;
    int sinConfirmar = Model?.SinConfirmar ?? 0;
    int facturasVencidas = Model?.FacturasVencidas ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-rec-05-recordatorios/styles.css" asp-append-version="true" />
}

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">
    @Html.AntiForgeryToken()
    @if (TempData["ErrorValidacion"] is string errorMessage)
    {
      <div class="reminders-error" role="alert">@errorMessage</div>
    }

    <!-- Page header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="nav.sidebar_label">
          <span data-i18n="common_role_recepcionista">Recepción</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="common.notifications">Notificaciones</span>
        </nav>
        <h1 class="page-title" data-i18n="notifications.title">Recordatorios y Notificaciones</h1>
        <p class="page-subtitle" data-i18n="rec05.subtitle">Gestiona recordatorios automáticos y manuales por correo electrónico</p>
      </div>
      <a href="/gestion-de-citas/st-rec-03-gestion-citas" class="btn-primary" aria-label="Crear nueva cita" data-i18n-aria-label="citas.new">+ Nueva cita</a>
    </header>

    <!-- Stats con aria-label para sección de estadÍdsticas (patrón canónico st-adm-09) -->
    <section class="stats-grid" aria-label="Resumen de recordatorios" data-i18n-aria-label="common.notifications">
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">send</span>
        <span class="stat-number" id="statsSentCount" data-target="@enviadosHoy" aria-live="polite">@enviadosHoy</span>
        <span class="stat-label" data-i18n="status.sent">Enviados hoy</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">schedule_send</span>
        <span class="stat-number" id="statsPendingCount" data-target="@pendientes.Count()" aria-live="polite">@pendientes.Count()</span>
        <span class="stat-label" data-i18n="status.pending">Pendientes de envío</span>
      </div>
    </section>

    <!-- Grid: Lista + Alertas -->
    <div class="dashboard-grid">

      <!-- Columna izquierda: Recordatorios pendientes + Historial -->
      <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Recordatorios pendientes con role region -->
        <section class="reminders-section" aria-labelledby="pendingTitle">
          <div class="section-header">
            <h2 id="pendingTitle" data-i18n="status.pending">Pendientes de envío</h2>
            <button class="btn-success" id="btnSendSelected"
              aria-label="Enviar recordatorios a pacientes seleccionados"><span class="material-symbols-outlined" aria-hidden="true">send</span> Enviar</button>
          </div>

          <!-- Lista con role list y aria-live para anuncios dinámicos -->
          <div class="patient-list" id="patientListContainer" role="list" aria-label="Lista de pacientes pendientes"
            aria-live="polite">
            @{
                string[] paletaAvatares = { "avatar-blue", "avatar-green", "avatar-gray", "avatar-amber" };
                int colorIdx = 0;
            }
            @if (!pendientes.Any())
            {
                <p style="padding:12px;color:var(--text-secondary,#64748b);">No hay citas programadas para mañana o pasado mañana que requieran recordatorio.</p>
            }
            @foreach (var p in pendientes)
            {
                string avatarClass = paletaAvatares[colorIdx++ % paletaAvatares.Length];
                string diaTexto = p.EsManana ? "Mañana" : "Pasado mañana";
                string horaTexto = p.FechaHora.ToString("h:mm tt");
                string isoTexto = p.FechaHora.ToString("yyyy-MM-ddTHH:mm");
                string canalIcono = p.Canal == "email" ? "email" : "mail_off";
                string canalTexto = p.Canal == "email" ? "Correo electrónico" : "Correo electrónico no disponible";
                string filaClase = p.Confirmada ? "patient-row dimmed" : "patient-row selected";

                <div class="@filaClase" data-id="@p.Id" data-es-manana="@p.EsManana.ToString().ToLowerInvariant()" role="listitem">
                  <input type="checkbox" class="custom-checkbox" checked="@(!p.Confirmada)"
                    aria-label="Seleccionar recordatorio para @p.Paciente" />
                  <div class="avatar-circle @avatarClass" aria-hidden="true">@p.Iniciales</div>
                  <div class="patient-info">
                    <p class="patient-name">@p.Paciente</p>
                    <div class="patient-meta">
                      <span><time datetime="@isoTexto">@diaTexto @horaTexto</time></span>
                      <span class="meta-dot" aria-hidden="true"></span>
                      <span class="meta-channel"><span class="material-symbols-outlined" aria-hidden="true">@canalIcono</span> @canalTexto</span>
                    </div>
                  </div>
                </div>
            }
          </div>

          <!-- Botón mÓvil "Enviar a todos" -->
          <button class="mobile-action-btn" id="btnSendAllMobile"
            aria-label="Enviar recordatorios a todos los pacientes programados para mañana"><span class="material-symbols-outlined" aria-hidden="true">send</span> Enviar a todos para
            mañana</button>
        </section>

        <!-- Historial de enviados -->
        <section class="history-section" aria-labelledby="historyTitle">
          <div class="history-header">
            <h3 id="historyTitle" data-i18n="rec05.history_title">Enviados recientemente</h3>
            <span class="history-count">@historialEnviados.Count recientes</span>
          </div>
          <div class="history-scroller" id="historyScroller" role="list"
            aria-label="Historial de recordatorios enviados" data-i18n-aria-label="rec05.history_scroller_aria">
            @if (!historialEnviados.Any())
            {
              <p style="padding:12px;color:var(--text-secondary,#64748b);" data-i18n="rec05.no_history">Aún no se ha registrado el envío de recordatorios.</p>
            }
            @foreach (var envio in historialEnviados)
            {
              <article class="history-card" role="listitem">
                <span class="material-symbols-outlined avatar-circle avatar-green" aria-hidden="true">mark_email_read</span>
                <div>
                  <p class="patient-name">@envio.Paciente</p>
                  <p class="history-time">Enviado @envio.EnviadoEn.ToString("dd/MM/yyyy h:mm tt")</p>
                  <p class="history-time">Cita @envio.FechaCita.ToString("dd/MM/yyyy")</p>
                </div>
              </article>
            }
          </div>
        </section>

      </div>

      <!-- Columna derecha: Alertas -->
      <aside class="alerts-sidebar-card" aria-labelledby="alertsTitle">
        <div class="alerts-header">
          <span class="material-symbols-outlined" aria-hidden="true">warning</span>
          <h3 id="alertsTitle" data-i18n="rec05.alerts_title">Alertas pendientes</h3>
        </div>
        <div class="alerts-list" role="list" aria-label="Lista de alertas pendientes">
          <!-- Alerta roja: sin confirmar -->
          <div class="alert-item-card red-alert" role="listitem" style="@(sinConfirmar > 0 ? "" : "display:none;")">
            <div class="alert-icon-box material-symbols-outlined" aria-hidden="true">error</div>
            <div class="alert-content-box">
              <h4>@sinConfirmar paciente@(sinConfirmar == 1 ? "" : "s") sin confirmar</h4>
              <p>Las citas para mañana requieren confirmación manual.</p>
              <button class="btn-alert-action" id="btnAlertUnconfirmed"
                aria-label="Notificar a pacientes sin confirmar cita">Notificar</button>
            </div>
          </div>
          <!-- Alerta amarilla: facturas vencidas -->
          <div class="alert-item-card yellow-alert" role="listitem" style="@(facturasVencidas > 0 ? "" : "display:none;")">
            <div class="alert-icon-box material-symbols-outlined" aria-hidden="true">receipt_long</div>
            <div class="alert-content-box">
              <h4>@facturasVencidas factura@(facturasVencidas == 1 ? "" : "s") vencida@(facturasVencidas == 1 ? "" : "s")</h4>
              <p>Pacientes con pagos pendientes por más de 15 días.</p>
              <button class="btn-alert-action" id="btnAlertOverdue"
                aria-label="Notificar a pacientes con facturas vencidas">Notificar</button>
            </div>
          </div>
          @if (sinConfirmar == 0 && facturasVencidas == 0)
          {
              <p style="padding:12px;color:var(--text-secondary,#64748b);">No hay alertas pendientes.</p>
          }
        </div>
      </aside>

    </div>

  </main>

  <!-- Mobile bottom nav con aria-label para navegación móvil -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-rec-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span></span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-rec-03-gestion-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">event</span></span>
      <span>Citas</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></span>
      <span>Recordatorios</span>
    </a>
    <a href="/acceso-y-seguridad/login" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">login</span></span>
      <span>Login</span>
    </a>
  </nav>

  <!-- Toast container con atributos ARIA para notificaciones -->
  <div id="toastContainer" role="region" aria-live="polite" aria-atomic="true" aria-label="Notificaciones"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — <span data-i18n="footer_copyright">Todos los derechos reservados.</span></p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO — SENA</p>
  </footer>
@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-rec-05-recordatorios/app.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
