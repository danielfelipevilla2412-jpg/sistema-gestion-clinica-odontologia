@* ============================================
SmileTrack — Notificaciones Paciente (st-pac-03-notificaciones)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista que permite al paciente consultar y gestionar sus notificaciones del sistema (recordatorios de citas, avisos de reprogramación y alertas generales de la clínica).

FUNCIONALIDADES PRINCIPALES:
- Visualización de la lista de notificaciones pendientes y leÍdas
- Marcar notificaciones individuales como leÍdas o eliminarlas
- Filtros rápidos para clasificar las alertas (Todas, Recordatorios, Alertas)

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y NotificacionesPaciente
- CSS: ~/css/Gestion_De_Citas/st-pac-03-notificaciones/styles.css
- JS: ~/js/Gestion_De_Citas/st-pac-03-notificaciones/notificaciones.js
- Partial / Otros: Menú del paciente

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Notificaciones";
    var notificacionesDataJson = System.Text.Json.JsonSerializer.Serialize(ViewData["NotificacionesData"] ?? new object());
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-pac-03-notificaciones/styles.css" asp-append-version="true" />
}

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-left">
        <div class="breadcrumb"><span data-i18n="common_role_patient">Paciente</span> › <span data-i18n="common.notifications">Notificaciones</span></div>
        <h1 class="page-title" data-i18n="notifications.page_title">Notificaciones</h1>
        <p class="page-subtitle" data-i18n="notifications.subtitle">Recordatorios, confirmaciones y mensajes de la clínica</p>
      </div>
      <!-- [MEJORA]: aria-label para botón de acción principal -->
      <button class="btn-primary" id="btnMarkAllRead" aria-label="Marcar todas las notificaciones como leídas" data-i18n-aria-label="notifications.mark_all_aria" data-i18n="notifications.mark_all">Marcar todas como leídas</button>
    </header>

    <!-- Toolbar de filtros -->
    <div class="toolbar" role="toolbar" aria-label="Filtros de notificaciones" data-i18n-aria-label="notifications.filter_aria">
      <div class="search-wrap">
        <span class="search-icon material-symbols-outlined" aria-hidden="true">search</span>
        <!-- [MEJORA]: aria-label para input de búsqueda (consistente con st-pac-01) -->
        <input type="search" id="searchInput" class="search-input" placeholder="Buscar notificaciones…" data-i18n-ph="notifications.search_ph"
          autocomplete="off" aria-label="Buscar notificaciones" data-i18n-aria-label="notifications.search_aria" />
      </div>
      <div class="filter-chips" role="group" aria-label="Filtrar notificaciones por tipo" data-i18n-aria-label="notifications.filter_aria">
        <button class="chip chip--active" data-filter="all" aria-pressed="true" data-i18n="notifications.filter_all">Todas</button>
        <button class="chip" data-filter="reminder" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">notifications</span> <span data-i18n="notifications.filter_reminders">Recordatorios</span></button>
        <button class="chip" data-filter="confirmed" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> <span data-i18n="notifications.filter_confirmed">Confirmaciones</span></button>
        <button class="chip" data-filter="cancelled" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">cancel</span> <span data-i18n="notifications.filter_cancelled">Cancelaciones</span></button>
        <button class="chip" data-filter="message" aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">message</span> <span data-i18n="notifications.filter_messages">Mensajes</span></button>
      </div>
      <span class="count-label" id="countLabel" aria-live="polite"></span>
    </div>

    <!-- Lista de notificaciones -->
    <!-- [MEJORA]: role="list" explícito para lectores de pantalla -->
    <ul class="notifications-list" id="notificationsList" role="list" aria-live="polite"
      aria-label="Lista de notificaciones" data-i18n-aria-label="notifications.list_aria">
      <!-- Items inyectados por JS -->
    </ul>

    <!-- Empty state -->
    <!-- [MEJORA]: aria-hidden gestionado por JS, texto más accesible -->
    <div class="empty-state" id="emptyState" aria-live="polite" aria-hidden="true" style="display:none;">
      <span class="empty-icon material-symbols-outlined" aria-hidden="true">notifications_off</span>
      <p class="empty-state-text" data-i18n="common.no_notifications">No hay notificaciones en esta categoría.</p>
    </div>

  </main>

  <!-- Toast -->
  <!-- [MEJORA]: aria-atomic="true" para que lectores anuncien mensaje completo -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
  <script>
    window.smiletrackNotificacionesData = @Html.Raw(notificacionesDataJson);
  </script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-pac-03-notificaciones/notificaciones.js")" defer></script>

  <!-- Mobile bottom nav — Paciente -->
  <nav class="mobile-nav" aria-label="Navegación móvil" data-i18n-aria-label="common_mobile_nav">
    <a href="/gestion-de-citas/st-pac-01-mis-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">event_note</span></span>
      <span data-i18n="citas.title">Mis citas</span>
    </a>
    <a href="/gestion-de-citas/st-pac-03-notificaciones" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">notifications</span></span>
      <span data-i18n="notifications.tab_notices">Avisos</span>
    </a>
    <a href="/perfiles/st-pac-04-perfil-paciente" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span data-i18n="profile.title">Perfil</span>
    </a>
  </nav>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — <span data-i18n="footer_copyright">Todos los derechos reservados.</span></p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO — SENA</p>
  </footer>
@section Scripts {
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
