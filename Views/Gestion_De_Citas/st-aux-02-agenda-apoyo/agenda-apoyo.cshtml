@* ============================================
SmileTrack — Agenda de Apoyo Clínico (st-aux-02-agenda-apoyo)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista que muestra el listado de citas del día ordenadas cronológicamente, enfocÁndose en la labor del auxiliar para realizar labores de asistencia y preparación.

FUNCIONALIDADES PRINCIPALES:
- Visualización de la lista de citas del día con detalles clínicos clave (alergias y tipo de cita)
- Filtro por profesional médico (Méndez, Ramírez, Gómez) con menú desplegable accesible
- Filtros por tipo de cita (Consulta, Procedimiento, Urgencia) estructurados como radiogroup accesible
- Tabla responsive y optimizada para accesibilidad visual y lectores de pantalla

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y Stadm08Agenda (o equivalente del rol Auxiliar)
- CSS: ~/css/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.css
- JS: ~/js/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.js
- Partial / Otros: _SidebarAuxiliar.cshtml

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
- Se implementan controles ARIA con roles de radiogroup, toolbar y menuitem para una navegación accesible.
============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Agenda de Apoyo Clínico";
    var agendaApoyoDataJson = System.Text.Json.JsonSerializer.Serialize(ViewData["AgendaApoyoData"] ?? new object());
    var fechaAgenda = Context.Request.Query["fecha"].FirstOrDefault() ?? DateTime.Today.ToString("yyyy-MM-dd");
    var inicioSemana = Context.Request.Query["weekStart"].FirstOrDefault() ?? fechaAgenda;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.css" asp-append-version="true" />
}

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">

    <!-- Page header con metadatos accesibles -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_auxiliar">Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="nav.agenda">Agenda</span>
        </nav>
        <h1 class="page-title" data-i18n="nav.agenda">Agenda de Apoyo Clínico</h1>
        <p class="page-subtitle" id="phMeta" aria-live="polite" data-i18n="aux.agenda_apoyo_subtitle">Citas del d&#237;a que requieren asistencia</p>
      </div>
      <div class="header-actions" aria-label="Navegación de fecha">
        @await Component.InvokeAsync("ToggleVistas", new { vistaActiva = Context.Request.Query.ContainsKey("weekStart") ? "semana" : "dia" })
        <a class="btn-secondary" href="?fecha=@DateTime.Parse(fechaAgenda).AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Día anterior">‹ Día</a>
        <a class="btn-secondary" href="?fecha=@DateTime.Parse(fechaAgenda).AddDays(1).ToString("yyyy-MM-dd")" aria-label="Día siguiente">Día ›</a>
        <a class="btn-secondary" href="?weekStart=@DateTime.Parse(inicioSemana).AddDays(-7).ToString("yyyy-MM-dd")" aria-label="Semana anterior">‹ Semana</a>
        <a class="btn-secondary" href="?weekStart=@DateTime.Parse(inicioSemana).AddDays(7).ToString("yyyy-MM-dd")" aria-label="Semana siguiente">Semana ›</a>
      </div>
    </header>

    <!-- Contenido principal -->
    <div class="content">

      <!-- Barra de filtros con role toolbar y accesibilidad -->
      <div class="filtros-bar" role="toolbar" aria-label="Filtros de agenda" data-i18n-aria-label="table.filter">

        <!-- Dropdown profesional accesible -->
        <div class="dropdown-wrap">
          <button class="filter-btn filter-dropdown" id="btnProfesional" aria-haspopup="true" aria-expanded="false"
            aria-controls="dropdownMenu">
            <span data-i18n="citas.filter_professional">Todos los profesionales</span> <span class="dd-arrow" aria-hidden="true">▼</span>
          </button>
          <div class="dropdown-menu" id="dropdownMenu" role="menu" aria-label="Seleccionar profesional">
            <div class="dd-item active" role="menuitem" tabindex="0" data-value="todos">Todos los profesionales</div>
            @{
                var agendaData = ViewData["AgendaApoyoData"];
                var agendaJson = System.Text.Json.JsonSerializer.Serialize(agendaData ?? new { citas = Array.Empty<object>() });
                using var agendaObj = System.Text.Json.JsonDocument.Parse(agendaJson);
                var profesionalesUnicos = new HashSet<string>();
                if (agendaObj.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && agendaObj.RootElement.TryGetProperty("citas", out var citasEl) && citasEl.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var cita in citasEl.EnumerateArray())
                    {
                        if (cita.TryGetProperty("profesional", out var profEl))
                        {
                            var nombre = profEl.GetString() ?? "";
                            if (!string.IsNullOrWhiteSpace(nombre))
                                profesionalesUnicos.Add(nombre);
                        }
                    }
                }
            }
            @foreach (var prof in profesionalesUnicos.OrderBy(p => p))
            {
                <div class="dd-item" role="menuitem" tabindex="0" data-value="@prof">@prof</div>
            }
          </div>
        </div>

        <!-- Filtros de tipo con role radiogroup -->
        <div role="radiogroup" aria-label="Filtrar por tipo de cita" class="filter-group">
          <button class="filter-btn active" id="f-todos" role="radio" aria-checked="true" data-value="todos" data-i18n="table.filter">Todos los tipos</button>
          <button class="filter-btn tipo-consulta" id="f-consulta" role="radio" aria-checked="false"
            data-value="consulta">Consulta</button>
          <button class="filter-btn tipo-procedimiento" id="f-procedimiento" role="radio" aria-checked="false"
            data-value="procedimiento">Procedimiento</button>
          <button class="filter-btn tipo-urgencia" id="f-urgencia" role="radio" aria-checked="false"
            data-value="urgencia">Urgencia</button>
        </div>

      </div>

      <!-- Tabla de citas con estructura accesible -->
      <div class="table-card">
        <div class="table-scroll">
          <table class="table-base agenda-table" aria-label="Agenda de citas que requieren asistencia" data-i18n-aria-label="citas.title">
            <thead>
              <tr>
                <th scope="col" data-i18n="citas.time">HORA</th>
                <th scope="col" data-i18n="citas.patient">PACIENTE</th>
                <th scope="col" data-i18n="citas.professional">PROFESIONAL</th>
                <th scope="col" data-i18n="pqr.type">TIPO</th>
                <th scope="col" data-i18n="historia.observations">ALERGIAS</th>
                <th scope="col" data-i18n="citas.status">ESTADO</th>
              </tr>
            </thead>
            <tbody id="agendaBody" aria-live="polite">
              <tr class="skeleton-row" aria-hidden="true">
                <td><div class="skeleton-cell" style="width:50px"></div></td>
                <td><div class="skeleton-cell" style="width:140px"></div></td>
                <td><div class="skeleton-cell" style="width:120px"></div></td>
                <td><div class="skeleton-cell" style="width:90px"></div></td>
                <td><div class="skeleton-cell" style="width:80px"></div></td>
                <td><div class="skeleton-cell" style="width:70px"></div></td>
              </tr>
              <tr class="skeleton-row" aria-hidden="true">
                <td><div class="skeleton-cell" style="width:50px"></div></td>
                <td><div class="skeleton-cell" style="width:160px"></div></td>
                <td><div class="skeleton-cell" style="width:100px"></div></td>
                <td><div class="skeleton-cell" style="width:90px"></div></td>
                <td><div class="skeleton-cell" style="width:80px"></div></td>
                <td><div class="skeleton-cell" style="width:70px"></div></td>
              </tr>
              <!-- Las filas se generan dinámicamente por JavaScript -->
            </tbody>
          </table>
        </div>
        <div class="table-empty" id="tableEmpty" style="display:none" role="status" aria-live="polite">
          No hay citas que coincidan con el filtro seleccionado.
        </div>
      </div>

    </div>

  </main>

  <!-- Mobile bottom nav con aria-label para navegación mÓvil -->
  <nav class="mobile-nav" aria-label="Navegación mÓvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">space_dashboard</span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-aux-02-agenda-apoyo" class="mobile-nav-item active" aria-current="page">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">calendar_month</span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-aux-05-historial-parcial" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">history</span>
      <span>Historial</span>
    </a>
  </nav>

  <!-- Toast con aria-atomic para anuncio completo de notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
  </footer>
  <script>
    window.smiletrackAgendaApoyoData = @Html.Raw(agendaApoyoDataJson);
  </script>
@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
