@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Globalization
@using SmileTrack_MVC.Helpers
@using SmileTrack_MVC.Models.ViewModels.GestionDeCitas
@{
    ViewData["Title"] = "Agenda de Apoyo";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var agenda = ViewData["AgendaApoyoData"] as AgendaApoyoViewModel;
    var citas = agenda?.Citas ?? new List<AgendaApoyoCitaItemViewModel>();
    var fecha = ViewData["AgendaApoyoFecha"] is DateTime inicio ? inicio : ColombiaClock.Today;
    var semana = ViewData["AgendaApoyoSemana"] is true;
    var paso = semana ? 7 : 1;
    var parametro = semana ? "weekStart" : "fecha";
    var ahora = ColombiaClock.Now;
    var cultura = CultureInfo.GetCultureInfo("es-CO");
    var periodo = semana ? $"{fecha.ToString("d MMM", cultura)} – {fecha.AddDays(6).ToString("d MMM yyyy", cultura)}" : fecha.ToString("dddd d 'de' MMMM 'de' yyyy", cultura);
    string FechaIso(DateTime dia) => dia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    string Preparacion(int id) => $"/gestion-de-pacientes/st-aux-03-preparacion-consulta?citaId={id}";
    bool PuedePreparar(AgendaApoyoCitaItemViewModel cita) =>
        User.IsInRole("Auxiliar") && cita.FechaHora.Date == ahora.Date && cita.Activa;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.css" asp-append-version="true" />
}
<main class="main agenda-apoyo" id="main-content">
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación">Auxiliar › Agenda de Apoyo</nav>
            <h1 class="page-title">Agenda de Apoyo</h1>
            <p class="page-subtitle">@periodo</p>
        </div>
    </header>

    <section class="table-card apoyo-panel">
        <nav class="apoyo-controls" aria-label="Navegación de agenda">
            <div class="apoyo-controls">
                <a class="@(semana ? "btn-secondary" : "btn-primary")" aria-current="@(!semana ? "page" : null)" href="?fecha=@FechaIso(fecha)">Día</a>
                <a class="@(semana ? "btn-primary" : "btn-secondary")" aria-current="@(semana ? "page" : null)" href="?weekStart=@FechaIso(fecha)">Semana</a>
            </div>
            <div class="apoyo-controls">
                <a class="btn-secondary" href="?@(parametro)=@FechaIso(fecha.AddDays(-paso))" aria-label="@(semana ? "Semana anterior" : "Día anterior")">‹</a>
                <strong>@periodo</strong>
                <a class="btn-secondary" href="?@(parametro)=@FechaIso(fecha.AddDays(paso))" aria-label="@(semana ? "Semana siguiente" : "Día siguiente")">›</a>
                <a class="btn-secondary" href="?fecha=@FechaIso(ahora.Date)">Hoy</a>
            </div>
        </nav>

        @if (agenda is null)
        {
            <p class="apoyo-message" role="alert">No se pudo cargar la agenda. Vuelve a intentarlo.</p>
        }
        else if (citas.Count == 0)
        {
            <p class="apoyo-message">@(semana ? "No hay citas para esta semana." : "No hay citas para este día.")</p>
        }
        else
        {
            <div class="apoyo-controls apoyo-filters" id="apoyoFiltros" hidden>
                <label>Profesional
                    <select id="apoyoProfesional">
                        <option value="">Todos los profesionales</option>
                        @foreach (var profesional in citas.Select(c => c.Profesional).Distinct().OrderBy(p => p))
                        {
                            <option value="@profesional">@profesional</option>
                        }
                    </select>
                </label>
                <label>Tipo de cita
                    <select id="apoyoTipo">
                        <option value="">Todos los tipos</option>
                        <option value="consulta">Consulta</option>
                        <option value="procedimiento">Procedimiento</option>
                        <option value="urgencia">Urgencia</option>
                    </select>
                </label>
                <button class="btn-secondary" type="button" id="apoyoLimpiar" hidden>Limpiar filtros</button>
                <span id="apoyoCantidad" role="status"></span>
            </div>
            <div class="apoyo-message apoyo-next" id="apoyoSiguiente" hidden aria-live="polite">
                <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                <div><strong>Siguiente cita</strong><p id="apoyoSiguienteTexto"></p></div>
                <a class="btn-secondary" id="apoyoSiguienteAccion" hidden>Ir a preparación</a>
            </div>
            <p class="apoyo-message" id="apoyoSinResultados" hidden>Ninguna cita coincide con los filtros.</p>
            <div class="apoyo-table-scroll" id="apoyoTabla">
                <table class="table-base" aria-label="Citas del período">
                    <thead>
                        <tr>
                            @if (semana) { <th scope="col">Día</th> }
                            <th scope="col">Hora</th><th scope="col">Paciente</th><th scope="col">Profesional</th>
                            <th scope="col">Tipo</th><th scope="col">Estado</th><th scope="col">Alertas</th>
                            @if (User.IsInRole("Auxiliar")) { <th scope="col">Preparación</th> }
                        </tr>
                    </thead>
                    <tbody id="agendaBody">
                        @foreach (var cita in citas)
                        {
                            var urgente = cita.Tipo == "urgencia";
                            <tr data-profesional="@cita.Profesional" data-tipo="@cita.Tipo"
                                data-proxima="@(cita.Activa && cita.FechaHora >= ahora ? $"{cita.Fecha} · {cita.Hora} · {cita.Profesional} · {cita.Estado}" : null)">
                                @if (semana) { <td>@cita.Fecha</td> }
                                <td><strong>@cita.Hora</strong></td><td>@cita.Paciente</td><td>@cita.Profesional</td>
                                <td><span class="apoyo-badge @(urgente ? "apoyo-alert" : "")">@cultura.TextInfo.ToTitleCase(cita.Tipo)</span></td>
                                <td><span class="apoyo-badge">@cita.Estado</span></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(cita.Alergia))
                                    {
                                        <details><summary class="apoyo-alert">Alergia registrada</summary><p>@cita.Alergia</p></details>
                                    }
                                    else { <span>—</span> }
                                </td>
                                @if (User.IsInRole("Auxiliar"))
                                {
                                    <td>
                                        @if (PuedePreparar(cita)) { <a class="btn-secondary" data-preparacion href="@Preparacion(cita.Id)">Preparar consulta</a> }
                                        else { <span>—</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.js" asp-append-version="true" defer></script>
}
