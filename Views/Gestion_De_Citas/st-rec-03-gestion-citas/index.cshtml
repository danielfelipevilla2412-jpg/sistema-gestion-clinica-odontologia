@* ============================================
   SmileTrack — Módulo: Gestión de Citas
   Vista: Gestión de Citas Recepción (st-rec-03-gestion-citas)
   ============================================
   Archivo: Views/Gestion_De_Citas/st-rec-03-gestion-citas/index.cshtml

   PROPÓSITO Y JUSTIFICACIÓN:
   Interfaz operativa para la recepción de la clínica. Agendamiento, reprogramación y confirmación telefónica de turnos.

   REGLAS DE RENDERIZADO Y NEGOCIO:
   - Tabla paginada con filtros por profesional, fecha y estado.

   DEPENDENCIAS:
   - CSS: ~/css/Gestion_De_Citas/st-rec-03-gestion-citas/styles.css
   - JS: ~/js/Gestion_De_Citas/st-rec-03-gestion-citas/app.js
   ============================================ *@
@{ Layout = "_Layout"; ViewData["Title"] = "Gestión de Citas"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-rec-03-gestion-citas/styles.css" asp-append-version="true" />
}

@{var profesionalesFilterOptions = ViewData["ProfesionalesFilterOptions"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var pacientes = ViewData["Pacientes"] as List<SmileTrack_MVC.Models.Entities.Paciente> ?? new();
  var profesionales = ViewData["Profesionales"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var servicios = ViewData["Servicios"] as List<SmileTrack_MVC.Models.Entities.Servicio> ?? new();
  var consultorios = ViewData["Consultorios"] as List<SmileTrack_MVC.Models.Entities.Consultorio> ?? new();
  var estadosCita = ViewData["EstadosCita"] as List<SmileTrack_MVC.Models.Entities.EstadoCita> ?? new();
  var citas = ViewData["Citas"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
  var pageResult = ViewData["CitasPage"] as SmileTrack_MVC.Models.Shared.PagedResult<SmileTrack_MVC.Models.Entities.Cita>;
  var editingCita = ViewData["EditingCita"] as SmileTrack_MVC.Models.Entities.Cita;
  var isEditing = editingCita != null;

  var statRecHoy = (int)(ViewData["StatRecHoy"] ?? 0);
  var statRecConfirmadas = (int)(ViewData["StatRecConfirmadas"] ?? 0);
  var statRecPendientes = (int)(ViewData["StatRecPendientes"] ?? 0);
  var statRecCanceladasHoy = (int)(ViewData["StatRecCanceladasHoy"] ?? 0);
}

﻿



  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="nav.sidebar_label">
          <span data-i18n="nav.group_citas">Recepción</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="citas.title">Gestión de citas</span>
        </nav>
        <h1 class="page-title" data-i18n="citas.title">Gestión de Citas</h1>
        <p class="page-subtitle" data-i18n="citas.rec_subtitle">Programa, modifica y cancela citas de manera eficiente.</p>
      </div>
      <div class="header-actions">
        <button type="button" class="btn-secondary no-print print-button" onclick="window.print()" aria-label="Imprimir listado de citas" data-i18n-aria-label="form.print">
          <span class="material-symbols-outlined" aria-hidden="true">print</span>
          <span data-i18n="form.print">Imprimir</span>
        </button>
        <button class="btn-primary" id="btnNuevaCita" aria-label="Crear nueva cita" data-i18n-aria-label="citas.new"><span data-i18n="citas.new">➕ Nueva cita</span></button>
      </div>
    </header>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Resumen de citas del día" data-i18n-aria-label="citas.dashboard_title">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="metricToday" data-target="@statRecHoy" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="citas.total_today">Citas hoy</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="metricConfirmed" data-target="@statRecConfirmadas" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.confirmed">Confirmadas</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="metricPending" data-target="@statRecPendientes" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.pending">Pendientes</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="metricCancelled" data-target="@statRecCanceladasHoy" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.cancelled">Canceladas hoy</span>
      </div>
    </section>

    <section class="queue-panel" aria-labelledby="pendingRequestsTitle" style="margin: 1.25rem 0; background: #fff; border-radius: 16px; padding: 1.25rem; box-shadow: 0 10px 30px rgba(15,23,42,0.06); border: 1px solid #e2e8f0;">
      <div class="queue-header" style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1rem;">
        <div>
          <p style="margin:0; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.08em; color:#64748b;">Cola de atención</p>
          <h2 id="pendingRequestsTitle" style="margin:0.35rem 0 0; font-size:1.2rem;">Solicitudes pendientes</h2>
        </div>
        <span id="solicitudesPendientesBadge" class="status-badge status-agendada" style="padding:0.5rem 0.75rem; border-radius:999px;">0</span>
      </div>
      <div id="solicitudesPendientesList" class="pending-requests-list" aria-live="polite">
        <div class="empty-state" role="status" style="padding:1.25rem; color:#64748b;">No hay solicitudes pendientes por confirmar.</div>
      </div>
    </section>

    <!-- Tabs de filtrado rápido por estado (patrón canónico st-adm-09) -->
    <div class="table-tabs" role="tablist" aria-label="Filtrar citas por estado">
      <button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="all" id="tab-all">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">event_note</span>
        Todas las citas
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="cancelled" id="tab-cancelled">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">cancel</span>
        Cancelaciones
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="no-show" id="tab-no-show">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">event_busy</span>
        No asistió
      </button>
    </div>

    <section class="filters-section" aria-label="Filtros de citas" data-i18n-aria-label="citas.filter_status">
      <form method="get" class="filters-row">
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <input type="search" class="search-input" id="searchPatient" name="search" placeholder="Buscar paciente…"
            aria-label="Buscar por nombre de paciente" data-i18n-ph="table.search" data-i18n-aria-label="citas.patient" autocomplete="off" value="@ViewData["SearchFilter"]" />
        </div>
        <div class="filter-wrap">
          <label for="filterProfessional" class="visually-hidden">Filtrar por profesional</label>
          <select class="status-select" id="filterProfessional" name="profesional" aria-label="Filtrar por profesional" data-i18n-aria-label="citas.filter_professional">
            <option value="" data-i18n="citas.filter_professional">Todos los profesionales</option>
            @foreach (var profesional in profesionalesFilterOptions)
            {
              var isSelected = ViewData["ProfesionalFilter"]?.ToString() == profesional.IdProfesional.ToString();
              <option value="@profesional.IdProfesional" @(isSelected ? "selected" : "")>@profesional.NombreProfesional</option>
            }
          </select>
        </div>
        <div class="filter-wrap">
          <label for="filterDate" class="visually-hidden">Filtrar por fecha</label>
          <input type="date" class="status-select" id="filterDate" name="fecha" aria-label="Filtrar por fecha" data-i18n-aria-label="citas.filter_date" value="@ViewData["FechaFilter"]" />
        </div>
        <div class="filter-wrap">
          <label for="filterStatus" class="visually-hidden">Filtrar por estado</label>
          <select class="status-select" id="filterStatus" name="estado" aria-label="Filtrar por estado" data-i18n-aria-label="citas.filter_status">
            <option value="" data-i18n="citas.filter_all_status">Todos los estados</option>
            @{
              var estadoActual = ViewData["EstadoFilter"]?.ToString();
              var estadosFiltrar = new[] { "programada", "confirmada", "atendida", "cancelada" };
              foreach (var e in estadosFiltrar)
              {
                var isSelected = estadoActual == e;
                <option value="@e" @(isSelected ? "selected" : "")>@char.ToUpperInvariant(e[0])@e.Substring(1)</option>
              }
            }
          </select>
        </div>
        <input type="hidden" name="page" value="1" />
        <button class="btn-primary" type="submit" data-i18n="form.search">Aplicar</button>
        <a class="btn-secondary" href="@Url.Action("Strec03GestionCitas", "GestionCitas")" data-i18n="form.clear">Limpiar</a>
      </form>
    </section>

    <!-- Availability alert (oculto por defecto) -->
    <div class="availability-alert" role="status" aria-live="polite" id="availabilityAlert" style="display:none;">
      <span class="material-symbols-outlined availability-alert-icon" aria-hidden="true">check_circle</span>
      <p class="availability-alert-text">Disponibilidad validada</p>
    </div>

    <!-- Panel de tabla (visible por defecto) -->
    <div id="panel-table">
      <div class="table-wrap">
        <table class="table-base" aria-label="Listado de citas">
          <thead>
            <tr>
              <th scope="col" data-i18n="citas.date">Fecha</th>
              <th scope="col" data-i18n="citas.time">Hora</th>
              <th scope="col" data-i18n="citas.patient">Paciente</th>
              <th scope="col" data-i18n="citas.professional">Profesional</th>
              <th scope="col" data-i18n="citas.service">Servicio</th>
              <th scope="col" data-i18n="citas.office">Consultorio</th>
              <th scope="col" data-i18n="citas.status">Estado</th>
              <th scope="col" data-i18n="table.actions">Acciones</th>
            </tr>
          </thead>
          <tbody id="appointmentsTable" aria-live="polite">
            @if (!citas.Any())
            {
              <tr>
                <td colspan="8">
                  <div class="empty-state" role="status" aria-label="Sin citas registradas" style="padding:48px 24px;text-align:center;">
                    <span class="material-symbols-outlined" aria-hidden="true" style="font-size:3rem;color:var(--text-muted,#94a3b8);display:inline-block;margin-bottom:12px;">calendar_month</span>
                    <p style="font-size:1.05rem;font-weight:600;color:var(--text-primary,#1e293b);margin:0 0 6px;">Sin citas para mostrar</p>
                    <p style="font-size:.9rem;color:var(--text-muted,#64748b);margin:0 0 20px;">No hay citas que coincidan con los filtros seleccionados.</p>
                    <button type="button" class="btn-primary" id="btnNuevaCitaEmpty" onclick="document.getElementById('btnNuevaCita')?.click()" aria-label="Crear nueva cita">
                      <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">add</span>Agendar primera cita
                    </button>
                  </div>
                </td>
              </tr>
            }
            else
            {
            @foreach (var cita in citas)
            {
              var citaFecha = cita.Fecha.ToString("dd/MM/yyyy");
              var citaHora = cita.HoraInicio?.ToString("hh\\:mm") ?? "—";
              var citaPaciente = cita.Paciente?.NombresCompleto ?? "—";
              var citaProfesional = cita.Profesional?.NombreProfesional ?? "—";
              var citaServicio = cita.MotivoConsulta ?? "—";
              var citaConsultorio = cita.Consultorio?.Nombre ?? "—";
              var citaEstado = cita.EstadoCita?.NombreEstado ?? cita.Estado ?? "Sin estado";
              var citaNotas = cita.Notas ?? "";

              @* Avatar: iniciales del paciente (máx. 2 letras) para el bloque paciente *@
              var pacNombre = citaPaciente.Trim();
              var pacIniciales = string.Concat(
                pacNombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                         .Take(2)
                         .Select(s => s[0])
              ).ToUpperInvariant();
              if (string.IsNullOrWhiteSpace(pacIniciales)) pacIniciales = "?";

              @* Color del avatar determinístico: hash del nombre → índice 0-4 *@
              var avatarColors = new[] { "blue", "green", "purple", "orange", "red" };
              var colorIdx = Math.Abs(pacNombre.GetHashCode()) % avatarColors.Length;
              var avatarColor = avatarColors[colorIdx];

              @* Badge de estado: normalizar a clase CSS *@
              var estadoLower = (citaEstado ?? "").ToLowerInvariant();
              var estadoCls = estadoLower switch {
                "atendida" or "finalizada" => "status-atendida",
                "en consulta" or "en_proceso" or "en proceso" => "status-consulta",
                "agendada" or "programada" or "confirmada" => "status-agendada",
                "cancelada" or "cancelado" => "status-cancelada",
                "no asistida" or "no_asistida" or "no-show" or "no asistió" => "status-no-asistio",
                _ => "status-no-asistio"
              };

              <tr>
                <td class="col-fecha">@citaFecha</td>
                <td class="col-hora">
                  <span class="pill-hora" aria-label="Hora: @citaHora">@citaHora</span>
                </td>
                <td class="col-paciente">
                  <div class="td-paciente">
                    <div class="pac-avatar pac-avatar--@avatarColor" aria-hidden="true">@pacIniciales</div>
                    <span class="pac-name">@citaPaciente</span>
                  </div>
                </td>
                <td class="col-profesional">@citaProfesional</td>
                <td class="col-servicio">@citaServicio</td>
                <td class="col-consultorio">@citaConsultorio</td>
                <td>
                  <span class="status-badge @estadoCls" role="status" aria-label="Estado: @citaEstado">@citaEstado</span>
                </td>
                <td>
                  <div class="actions-cell" role="group" aria-label="Acciones para @Html.Encode(citaPaciente)">
                    <button type="button"
                            class="action-btn btn-secondary btn-view"
                            data-action="view"
                            data-id="@cita.IdCita"
                            aria-label="Ver detalles de la cita de @Html.Encode(citaPaciente)"
                            title="Ver detalles de la cita de @Html.Encode(citaPaciente)"
                            data-fecha="@Html.Encode(citaFecha)"
                            data-hora="@Html.Encode(citaHora)"
                            data-paciente="@Html.Encode(citaPaciente)"
                            data-profesional="@Html.Encode(citaProfesional)"
                            data-servicio="@Html.Encode(citaServicio)"
                            data-consultorio="@Html.Encode(citaConsultorio)"
                            data-estado="@Html.Encode(citaEstado)"
                            data-notas="@Html.Encode(citaNotas)">
                      <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                      <span class="btn-text">Ver</span>
                    </button>
                    <button type="button"
                            class="action-btn btn-secondary edit"
                            data-action="edit"
                            data-id="@cita.IdCita"
                            aria-label="Editar la cita de @Html.Encode(citaPaciente)"
                            title="Editar la cita de @Html.Encode(citaPaciente)"
                            role="button">
                      <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                      <span class="btn-text">Editar</span>
                    </button>
                    @if (estadoLower != "cancelada" && estadoLower != "cancelado")
                    {
                      <button type="button"
                              class="action-btn btn-danger btn-delete"
                              data-action="cancel"
                              data-id="@cita.IdCita"
                              data-paciente="@Html.Encode(citaPaciente)"
                              aria-label="Cancelar cita de @Html.Encode(citaPaciente)"
                              title="Cancelar cita de @Html.Encode(citaPaciente)">
                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        <span class="btn-text">Cancelar</span>
                      </button>
                    }
                  </div>
                </td>
              </tr>
            }
            }
          </tbody>
        </table>
      </div>

      <div class="pagination" role="navigation" aria-label="Paginación de citas">
        @{ }
        <span class="pagination-info" id="paginationInfo" aria-live="polite">Mostrando @Math.Min(pageResult?.PageSize ?? 10, pageResult?.Items.Count ?? 0) de @pageResult?.TotalCount citas</span>
        <div class="pagination-buttons">
          @if (pageResult != null && pageResult.HasPreviousPage)
          {
            <a class="pagination-btn" id="prevPage" aria-label="Página anterior" href="@Url.Action("Strec03GestionCitas", "GestionCitas", new { page = pageResult.Page - 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">← Anterior</a>
          }
          else
          {
            <button class="pagination-btn" disabled aria-label="Página anterior">← Anterior</button>
          }
          <div class="pagination-numbers" role="list" aria-label="Números de página">
            @for (var i = 1; i <= (pageResult?.TotalPages ?? 1); i++)
            {
              var isActive = i == (pageResult?.Page ?? 1);
              <a class="pagination-number @(isActive ? "active" : string.Empty)" role="listitem" aria-current="@(isActive ? "page" : null)" href="@Url.Action("Strec03GestionCitas", "GestionCitas", new { page = i, pageSize = pageResult?.PageSize ?? 10, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">@i</a>
            }
          </div>
          @if (pageResult != null && pageResult.HasNextPage)
          {
            <a class="pagination-btn" id="nextPage" aria-label="Página siguiente" href="@Url.Action("Strec03GestionCitas", "GestionCitas", new { page = pageResult.Page + 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">Siguiente →</a>
          }
          else
          {
            <button class="pagination-btn" disabled aria-label="Página siguiente">Siguiente →</button>
          }
        </div>
      </div>
    </div>

  </main>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-rec-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">home</span></span>
      <span>Inicio</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">event_note</span></span>
      <span>Citas</span>
    </a>
    <a href="/perfiles/st-rec-06-perfil-recepcionista" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span>Perfil</span>
    </a>
    <button class="mobile-nav-item" id="mobileMoreBtn" aria-label="Más opciones">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">more_horiz</span></span>
      <span>Más</span>
    </button>
  </nav>

  <!-- FAB móvil -->
  <button class="fab" id="fabNuevaCita" aria-label="Crear nueva cita">➕</button>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- ═════ MODAL: NUEVA CITA ═════ -->
  <div class="modal-overlay" id="modalNewAppointment" role="dialog" aria-modal="true" aria-labelledby="modalNewTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalNewClose" aria-label="Cerrar modal">×</button>
      <h2 class="modal-title" id="modalNewTitle">Nueva Cita</h2>
      <form id="formNewAppointment" class="modal-form" method="post" action="/gestion-de-citas/guardar-cita" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
        <input type="hidden" name="IdCita" value="0" />
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="newPatient">Paciente <span class="required"
                aria-hidden="true">*</span></label>
            <select id="newPatient" name="IdPaciente" class="form-select form-input" required aria-required="true" aria-describedby="error-newPatient">
              <option value="">Seleccione paciente</option>
              @foreach (var p in pacientes)
              {
                <option value="@p.IdPaciente">@p.NombresCompleto</option>
              }
            </select>
            <span class="error-message" id="error-newPatient" role="alert">Por favor selecciona un paciente</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="newDate">Fecha <span class="required" aria-hidden="true">*</span></label>
            <input type="date" id="newDate" name="Fecha" class="form-input" required aria-required="true" aria-describedby="error-newDate"
              min="@DateTime.Today.ToString("yyyy-MM-dd")"
              value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span class="error-message" id="error-newDate" role="alert">Por favor selecciona una fecha válida</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="newTime">Hora <span class="required" aria-hidden="true">*</span></label>
            <input type="time" id="newTime" name="HoraInicio" class="form-input" required aria-required="true" aria-describedby="error-newTime" value="09:00" />
            <span class="error-message" id="error-newTime" role="alert">Por favor selecciona una hora válida</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="newDoctor">Profesional <span class="required"
                aria-hidden="true">*</span></label>
            <select id="newDoctor" name="IdProfesional" class="form-select form-input" required aria-required="true" aria-describedby="error-newDoctor">
              <option value="">Seleccionar profesional</option>
              @foreach (var p in profesionales)
              {
                <option value="@p.IdProfesional">@p.NombreProfesional</option>
              }
            </select>
            <span class="error-message" id="error-newDoctor" role="alert">Por favor selecciona un profesional</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="newService">Servicio <span class="required"
                aria-hidden="true">*</span></label>
            <select id="newService" name="IdServicio" class="form-select form-input" required aria-required="true" aria-describedby="error-newService">
              <option value="">Seleccionar servicio</option>
              @foreach (var s in servicios)
              {
                <option value="@s.IdServicio">@s.Nombre</option>
              }
            </select>
            <span class="error-message" id="error-newService" role="alert">Por favor selecciona un servicio</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="newOffice">Consultorio <span class="required"
                aria-hidden="true">*</span></label>
            <select id="newOffice" name="IdConsultorio" class="form-select form-input" required aria-required="true" aria-describedby="error-newOffice">
              <option value="">Seleccionar consultorio</option>
              @foreach (var c in consultorios)
              {
                <option value="@c.IdConsultorio">@c.Nombre</option>
              }
            </select>
            <span class="error-message" id="error-newOffice" role="alert">Por favor selecciona un consultorio</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="newNotes">Notas adicionales</label>
          <textarea id="newNotes" name="MotivoConsulta" class="form-textarea" rows="3"
            placeholder="Información adicional sobre la cita"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalNewCancel">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar cita</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═════ MODAL: VER DETALLES ═════ -->
  <div class="modal-overlay" id="modalViewAppointment" role="dialog" aria-modal="true" aria-labelledby="modalViewTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalViewClose" aria-label="Cerrar modal">×</button>
      <h2 class="modal-title" id="modalViewTitle">Detalles de la Cita</h2>
      <div id="modalViewContent" class="modal-content"></div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modalViewCancel" aria-label="Cerrar detalles de la cita">Cerrar</button>
        <button type="button" class="btn-primary" id="modalViewEdit" aria-label="Editar la cita mostrada actualmente">Editar cita</button>
      </div>
    </div>
  </div>

  <!-- ═════ MODAL: EDITAR CITA ═════ -->
  <div class="modal-overlay" id="modalEditAppointment" role="dialog" aria-modal="true" aria-labelledby="modalEditTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalEditClose" aria-label="Cerrar modal">×</button>
      <h2 class="modal-title" id="modalEditTitle">Editar Cita</h2>
      <form id="formEditAppointment" class="modal-form" method="post" action="/gestion-de-citas/guardar-cita" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
        <input type="hidden" id="editAppointmentId" name="IdCita" value="@(editingCita?.IdCita ?? 0)" />
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="editPatient">Paciente <span class="required"
                aria-hidden="true">*</span></label>
            <select id="editPatient" name="IdPaciente" class="form-select form-input" required aria-required="true" aria-describedby="error-editPatient">
              <option value="">Seleccione paciente</option>
              @foreach (var p in pacientes)
              {
                var isSelected = editingCita?.IdPaciente == p.IdPaciente;
                <option value="@p.IdPaciente" @(isSelected ? "selected" : "")>@p.NombresCompleto</option>
              }
            </select>
            <span class="error-message" id="error-editPatient" role="alert">Por favor selecciona un paciente</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editDate">Fecha <span class="required" aria-hidden="true">*</span></label>
            <input type="date" id="editDate" name="Fecha" class="form-input" required aria-required="true" aria-describedby="error-editDate"
              min="@DateTime.Today.ToString("yyyy-MM-dd")"
              value="@(editingCita?.Fecha.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
            <span class="error-message" id="error-editDate" role="alert">Por favor selecciona una fecha válida</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editTime">Hora <span class="required" aria-hidden="true">*</span></label>
            <input type="time" id="editTime" name="HoraInicio" class="form-input" required aria-required="true" aria-describedby="error-editTime"
              value="@(editingCita?.HoraInicio?.ToString("hh\\:mm") ?? "09:00")" />
            <span class="error-message" id="error-editTime" role="alert">Por favor selecciona una hora válida</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editDoctor">Profesional <span class="required"
                aria-hidden="true">*</span></label>
            <select id="editDoctor" name="IdProfesional" class="form-select form-input" required aria-required="true" aria-describedby="error-editDoctor">
              <option value="">Seleccionar profesional</option>
              @foreach (var p in profesionales)
              {
                var isSelected = editingCita?.IdProfesional == p.IdProfesional;
                <option value="@p.IdProfesional" @(isSelected ? "selected" : "")>@p.NombreProfesional</option>
              }
            </select>
            <span class="error-message" id="error-editDoctor" role="alert">Por favor selecciona un profesional</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editService">Servicio <span class="required"
                aria-hidden="true">*</span></label>
            <select id="editService" name="IdServicio" class="form-select form-input" required aria-required="true" aria-describedby="error-editService">
              <option value="">Seleccionar servicio</option>
              @foreach (var s in servicios)
              {
                var isSelected = editingCita?.IdServicio == s.IdServicio;
                <option value="@s.IdServicio" @(isSelected ? "selected" : "")>@s.Nombre</option>
              }
            </select>
            <span class="error-message" id="error-editService" role="alert">Por favor selecciona un servicio</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editOffice">Consultorio <span class="required"
                aria-hidden="true">*</span></label>
            <select id="editOffice" name="IdConsultorio" class="form-select form-input" required aria-required="true" aria-describedby="error-editOffice">
              <option value="">Seleccionar consultorio</option>
              @foreach (var c in consultorios)
              {
                var isSelected = editingCita?.IdConsultorio == c.IdConsultorio;
                <option value="@c.IdConsultorio" @(isSelected ? "selected" : "")>@c.Nombre</option>
              }
            </select>
            <span class="error-message" id="error-editOffice" role="alert">Por favor selecciona un consultorio</span>
          </div>
          <div class="form-group">
            <label class="form-label" for="editStatus">Estado</label>
            <select id="editStatus" name="IdEstado" class="form-select form-input" aria-describedby="error-editStatus">
              <option value="">Sin cambio</option>
              @foreach (var ec in estadosCita)
              {
                var isSelected = editingCita?.IdEstado == ec.IdEstado || editingCita?.EstadoCita?.NombreEstado == ec.NombreEstado;
                <option value="@ec.IdEstado" @(isSelected ? "selected" : "")>@ec.NombreEstado</option>
              }
            </select>
            <span class="error-message" id="error-editStatus" role="alert">Por favor selecciona un estado válido.</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="editNotes">Notas adicionales</label>
          <textarea id="editNotes" name="MotivoConsulta" class="form-textarea" rows="3">@editingCita?.Notas</textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalEditCancel">Cancelar</button>
          <button type="submit" class="btn-primary">Actualizar cita</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       MODAL SSR: Confirmar Cancelación de Cita (patrón st-adm-09)
       Idéntica estructura a #modalConfirmDeleteCita pero orientado a
       recepción: solicita motivo antes de POST cancelar cita.
       ═══════════════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modalConfirmCancelCita" role="dialog" aria-modal="true"
       aria-labelledby="modalConfirmCancelCitaTitle" aria-hidden="true" inert>
    <div class="modal modal--sm" style="max-width:480px;">
      <button class="modal-close" id="modalConfirmCancelCitaClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalConfirmCancelCitaTitle">Confirmar cancelación</h2>
      <p id="modalConfirmCancelCitaMessage"
         style="margin:16px 0 16px; line-height:1.5; color:var(--text-muted,#64748b);">
        ¿Estás seguro de <strong>cancelar</strong> esta cita? El paciente recibirá una notificación y el cupo quedará libre.
      </p>
      <form id="formCancelCita" method="post" action="/gestion-de-citas/cancelar-cita">
        @Html.AntiForgeryToken()
        <input type="hidden" id="cancelCitaId" name="IdCita" value="" />
        <input type="hidden" id="cancelCitaReturnUrl" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="form-group" style="margin-bottom:20px;">
          <label class="form-label" for="cancelCitaMotivo">Motivo de la cancelación</label>
          <select id="cancelCitaMotivo" name="MotivoCancelacion" class="form-input" required aria-required="true">
            <option value="">Seleccione un motivo</option>
            <option value="Paciente cancela">Paciente cancela</option>
            <option value="Profesional no disponible">Profesional no disponible</option>
            <option value="Cambio de agenda">Cambio de agenda</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalConfirmCancelCitaCancel">Cancelar</button>
          <button type="submit" class="btn-primary"
                  style="background:var(--red,#ef4444); border-color:var(--red,#ef4444);">
            <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">cancel</span>
            Sí, cancelar cita
          </button>
        </div>
      </form>
    </div>
  </div>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track. <span data-i18n="footer_copyright">Todos los derechos reservados.</span></p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO – SENA</p>
  </footer>
<script src="@Url.Content("~/js/Gestion_De_Citas/st-rec-03-gestion-citas/app.js")" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Accordion y hamburger manejados por ~/js/shared/sidebar.js

    // ═══ MODAL VER DETALLES: poblar desde data attributes del botón 👁️ ═══
    const modalView = document.getElementById('modalViewAppointment');
    const modalViewContent = document.getElementById('modalViewContent');
    document.querySelectorAll('.btn-view').forEach(btn => {
      btn.addEventListener('click', () => {
        const html = `
          <div style="display:grid; gap:12px; font-size:0.95rem;">
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Fecha:</strong>
              <span>${btn.dataset.fecha ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Hora:</strong>
              <span>${btn.dataset.hora ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Paciente:</strong>
              <span>${btn.dataset.paciente ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Profesional:</strong>
              <span>${btn.dataset.profesional ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Servicio:</strong>
              <span>${btn.dataset.servicio ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Consultorio:</strong>
              <span>${btn.dataset.consultorio ?? '—'}</span>
            </div>
            <div style="display:flex; justify-content:space-between; gap:12px;">
              <strong style="color:var(--text-muted); min-width:110px;">Estado:</strong>
              <span>${btn.dataset.estado ?? '—'}</span>
            </div>
            ${(btn.dataset.notas && btn.dataset.notas.length > 0) ? `
            <div style="margin-top:8px; padding:12px; background:var(--bg-soft); border-radius:8px;">
              <strong style="color:var(--text-muted); display:block; margin-bottom:4px;">Notas:</strong>
              <span>${btn.dataset.notas}</span>
            </div>` : ''}
          </div>`;
        if (modalViewContent) modalViewContent.innerHTML = html;
        if (modalView) {
          modalView.classList.add('open');
          modalView.setAttribute('aria-hidden', 'false');
          modalView.removeAttribute('inert');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Cerrar modal ver detalles al hacer click fuera
    if (modalView) {
      modalView.addEventListener('click', function handler(e) {
        if (e.target === modalView) {
          modalView.classList.remove('open');
          modalView.setAttribute('aria-hidden', 'true');
          modalView.setAttribute('inert', '');
          document.body.style.overflow = '';
        }
      });
    }

    // Botón "Editar cita" dentro de Ver Detalles
    const modalViewEditBtn = document.getElementById('modalViewEdit');
    if (modalViewEditBtn) {
      modalViewEditBtn.addEventListener('click', () => {
        if (modalView) {
          modalView.classList.remove('open');
          modalView.setAttribute('aria-hidden', 'true');
          modalView.setAttribute('inert', '');
        }
        const modalEdit = document.getElementById('modalEditAppointment');
        if (modalEdit) {
          modalEdit.classList.add('open');
          modalEdit.setAttribute('aria-hidden', 'false');
          modalEdit.removeAttribute('inert');
          document.body.style.overflow = 'hidden';
        }
      });
    }

    // ═══ AUTO-ABRIR MODAL DE EDICIÓN SI editingCita != null ═══
    const isEditingCita = '@(isEditing ? "true" : "false")' === 'true';
    if (isEditingCita) {
      const modalEdit = document.getElementById('modalEditAppointment');
      if (modalEdit) {
        modalEdit.classList.add('open');
        modalEdit.setAttribute('aria-hidden', 'false');
        modalEdit.removeAttribute('inert');
        document.body.style.overflow = 'hidden';
        window.setTimeout(() => document.getElementById('editPatient')?.focus(), 200);
      }
    }

    // Cerrar modales de Nueva/Editar al hacer click fuera del overlay
    const modalesClicFuera = [
      document.getElementById('modalNewAppointment'),
      document.getElementById('modalEditAppointment')
    ];
    modalesClicFuera.forEach(m => {
      if (!m) return;
      m.addEventListener('click', function handler(e) {
        if (e.target === m) {
          m.classList.remove('open');
          m.setAttribute('aria-hidden', 'true');
          m.setAttribute('inert', '');
          if (!document.querySelector('.modal-overlay.open')) {
            document.body.style.overflow = '';
          }
        }
      });
    });

    // ═══ MODAL CONFIRMAR CANCELACIÓN DE CITA (patrón st-adm-09 SSR) ═══
    const modalCancelCita = document.getElementById('modalConfirmCancelCita');
    const cancelCitaIdInput = document.getElementById('cancelCitaId');
    const cancelCitaMotivoSelect = document.getElementById('cancelCitaMotivo');
    const cancelCitaMessageEl = document.getElementById('modalConfirmCancelCitaMessage');
    const formCancelCita = document.getElementById('formCancelCita');

    window.openConfirmCancelCita = (idCita, paciente, triggerEl) => {
      if (!modalCancelCita) return;
      if (cancelCitaIdInput) cancelCitaIdInput.value = String(idCita);
      if (cancelCitaMessageEl && paciente) {
        cancelCitaMessageEl.innerHTML =
          `¿Estás seguro de <strong>cancelar</strong> la cita de <strong>${paciente}</strong>? El paciente recibirá una notificación y el cupo quedará libre.`;
      }
      if (cancelCitaMotivoSelect) { cancelCitaMotivoSelect.value = ''; cancelCitaMotivoSelect.selectedIndex = 0; }
      modalCancelCita.classList.add('open');
      modalCancelCita.setAttribute('aria-hidden', 'false');
      modalCancelCita.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
      setTimeout(() => cancelCitaMotivoSelect?.focus(), 120);
    };

    window.closeConfirmCancelCita = () => {
      if (!modalCancelCita) return;
      modalCancelCita.classList.remove('open');
      modalCancelCita.setAttribute('aria-hidden', 'true');
      modalCancelCita.setAttribute('inert', '');
      if (cancelCitaIdInput) cancelCitaIdInput.value = '';
      if (cancelCitaMotivoSelect) cancelCitaMotivoSelect.value = '';
      if (!document.querySelector('.modal-overlay.open')) {
        document.body.style.overflow = '';
      }
    };

    // Enlazar botones Cancelar cita de la tabla
    document.querySelectorAll('.btn-delete[data-action="cancel"]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const paciente = btn.getAttribute('data-paciente') || '';
        window.openConfirmCancelCita(id, paciente, btn);
      });
    });

    // Botones cerrar/cancelar del modal
    document.getElementById('modalConfirmCancelCitaClose')?.addEventListener('click', window.closeConfirmCancelCita);
    document.getElementById('modalConfirmCancelCitaCancel')?.addEventListener('click', window.closeConfirmCancelCita);

    // Click backdrop
    if (modalCancelCita) {
      modalCancelCita.addEventListener('click', (e) => {
        if (e.target === modalCancelCita) window.closeConfirmCancelCita();
      });
    }

    // Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalCancelCita?.classList.contains('open')) {
        e.preventDefault();
        window.closeConfirmCancelCita();
      }
    });
  });
</script>

@section Scripts {
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
