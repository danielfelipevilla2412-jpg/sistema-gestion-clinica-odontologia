@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* ============================================
   SmileTrack — Módulo: Gestión de Citas
   Vista: Mis Citas Paciente (st-pac-01-mis-citas)
   ============================================
   Archivo: Views/Gestion_De_Citas/st-pac-01-mis-citas/index.cshtml

   PROPÓSITO Y JUSTIFICACIÓN:
   Portal de autoservicio para el paciente. Muestra su agenda personal de citas pasadas y futuras.

   REGLAS DE RENDERIZADO Y NEGOCIO:
   - Filtro por paciente autenticado mediante claims de sesión.

   DEPENDENCIAS:
   - CSS: ~/css/Gestion_De_Citas/st-pac-01-mis-citas/styles.css
   - JS: ~/js/Gestion_De_Citas/st-pac-01-mis-citas/mis-citas.js
   ============================================ *@
@{
  Layout = "_Layout";
  ViewData["Title"] = "Mis citas";
  var perfilPacienteCompleto = ViewData["PerfilPacienteCompleto"] as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-pac-01-mis-citas/styles.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/shared/perfil-paciente-ui.css" asp-append-version="true" />
}

  <!-- MAIN: área de contenido principal de la página -->
  <main class="main patient-appointments" id="main-content">
    @Html.AntiForgeryToken()
    <!-- Cabecera de página con breadcrumb, título, subtítulo y botón para solicitar nueva cita -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="common.breadcrumb_nav">
          <span data-i18n="common_role_patient">Paciente</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="pac_miscitas.title">Mis citas</span>
        </nav>
        <h1 class="page-title" data-i18n="pac_miscitas.title">Mis citas</h1>
        <p class="page-subtitle" data-i18n="citas.pac_subtitle">Gestiona y consulta tus citas odontológicas personales</p>
      </div>
      @if (perfilPacienteCompleto)
      {
        <button class="btn-primary" id="btnNuevaCita" aria-label="Agendar nueva cita" data-i18n="citas.new">+ Nueva cita</button>
      }
    </header>
    @if (!perfilPacienteCompleto)
    {
      <div class="patient-profile-notice" role="status">
        Para solicitar citas, primero confirma tu identidad. <a href="/perfiles/st-pac-perfil-paciente">Actualizar datos personales</a>.
      </div>
    }
    <div data-perfil-paciente-header></div>

    <!-- Stats Grid: estadísticas animadas del paciente -->
    <section class="stats-grid" aria-label="Resumen de mis citas" data-i18n-aria-label="citas.stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">event_note</span>
        <span class="stat-number" id="cnt-total" data-target="0">0</span>
        <span class="stat-label" data-i18n="citas.stat_total">Total citas</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">check_circle</span>
        <span class="stat-number" id="cnt-completadas" data-target="0">0</span>
        <span class="stat-label" data-i18n="status.completed">Completadas</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">schedule</span>
        <span class="stat-number" id="cnt-pendientes" data-target="0">0</span>
        <span class="stat-label" data-i18n="status.pending">Pendientes</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">event_busy</span>
        <span class="stat-number" id="cnt-canceladas" data-target="0">0</span>
        <span class="stat-label" data-i18n="status.cancelled">Canceladas</span>
      </div>
    </section>

    <!-- Tabs de filtrado rápido por estado (patrón canónico st-adm-09) -->
    <div class="table-tabs" role="group" aria-label="Filtrar mis citas por estado">
      <button type="button" class="tab-btn active" aria-pressed="true" data-tab="all" id="tab-all">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">event_note</span>
        <span data-i18n="citas.tab_all">Todas las citas</span>
      </button>
      <button type="button" class="tab-btn" aria-pressed="false" data-tab="pending" id="tab-pending">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">schedule</span>
        <span data-i18n="citas.tab_pending">Pendientes</span>
      </button>
      <button type="button" class="tab-btn" aria-pressed="false" data-tab="completed" id="tab-completed">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">check_circle</span>
        <span data-i18n="citas.tab_completed">Completadas</span>
      </button>
      <button type="button" class="tab-btn" aria-pressed="false" data-tab="cancelled" id="tab-cancelled">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">cancel</span>
        <span data-i18n="citas.tab_cancelled">Canceladas</span>
      </button>
    </div>

    <section class="agenda-section" aria-label="Listado de citas">
      <!-- Barra de filtros estandarizada (patrón canónico filters-section / filters-row) -->
      <section class="filters-section" aria-label="Filtros de citas" data-i18n-aria-label="table.filter">
        <div class="filters-row">
          <div class="search-wrap">
            <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
            <input type="search" id="searchInput" class="search-input"
                   placeholder="Buscar por doctor, servicio o fecha..."
                   data-i18n-ph="table.search"
                   aria-label="Buscar citas por doctor, servicio o fecha"
                   autocomplete="off" />
          </div>
          <div class="filter-wrap">
            <label for="filterEstado" class="visually-hidden" data-i18n="table.filter">Filtrar por estado</label>
            <select id="filterEstado" class="status-select" aria-label="Filtrar citas por estado" data-i18n-aria-label="table.filter">
              <option value="" data-i18n="table.filter_all_states">Todos los estados</option>
              <option value="Agendada" data-i18n="status.scheduled">Agendada</option>
              <option value="Solicitada" data-i18n="status.requested">Solicitada</option>
              <option value="Confirmada" data-i18n="status.confirmed">Confirmada</option>
              <option value="En curso" data-i18n="status.in_progress">En curso</option>
              <option value="Completada" data-i18n="status.completed">Completada</option>
              <option value="Cancelada" data-i18n="status.cancelled">Cancelada</option>
              <option value="Rechazada" data-i18n="status.rejected">Rechazada</option>
              <option value="No asistió" data-i18n="status.no_show">No asistió</option>
            </select>
          </div>
          <span class="count-label" id="countLabel" aria-live="polite"></span>
        </div>
      </section>

      <!-- Tabla de citas con columnas: fecha, hora, doctor, servicio, estado y acciones -->
      <div class="table-wrap">
        <table id="citasTable" class="table-base" aria-label="Tabla de mis citas odontológicas" data-i18n-aria-label="citas.table_aria">
          <thead>
            <tr>
              <th scope="col" data-i18n="citas.date">FECHA</th>
              <th scope="col" data-i18n="citas.time">HORA</th>
              <th scope="col" data-i18n="citas.professional">PROFESIONAL</th>
              <th scope="col" data-i18n="citas.service">SERVICIO</th>
              <th scope="col" data-i18n="citas.status">ESTADO</th>
              <th scope="col" data-i18n="table.actions">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="citasTbody"></tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- MODAL: ventana emergente con el detalle completo de una cita seleccionada -->
  <!-- BUG FIX accesibilidad: aria-hidden="true" e inert iniciales para que el foco
       de teclado y lectores de pantalla no entren al modal mientras está cerrado.
       Sin inert, Tab podría alcanzar los elementos del modal invisible (WCAG 2.1). -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true"
       aria-labelledby="modalTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar" data-i18n-aria-label="common.close"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
      <h2 class="modal-title" id="modalTitle" data-i18n="citas.modal_detail_title">Detalle de Cita</h2>
      <div id="modalContent"></div>
    </div>
  </div>

  <!-- MODAL: ventana de confirmación antes de cancelar una cita activa -->
  <!-- BUG FIX accesibilidad: mismo patrón inert que el modal de detalle -->
  <div class="modal-overlay" id="modalCancelar" role="dialog" aria-modal="true"
       aria-labelledby="cancelarTitle" aria-hidden="true" inert>
    <div class="modal modal--sm">
      <h2 class="modal-title" id="cancelarTitle" data-i18n="citas.modal_cancel_title">¿Cancelar esta cita?</h2>
      <p class="modal-desc" id="cancelarDesc"></p>
      <p class="modal-note modal-warning hidden" id="cancelarAdvertencia" aria-live="polite"></p>
      <p class="modal-note modal-error hidden" id="cancelarError" aria-live="assertive"></p>
      <label class="form-label" for="cancelarMotivo">Motivo de cancelación *</label>
      <textarea class="form-input" id="cancelarMotivo" rows="3" minlength="5" maxlength="500"
                required aria-describedby="cancelarMotivoAyuda"></textarea>
      <small id="cancelarMotivoAyuda">Describe brevemente el motivo (mínimo 5 caracteres).</small>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarNo" data-i18n="common.back">Volver</button>
        <button class="btn-danger" id="cancelarSi" data-i18n="citas.btn_confirm_cancel">Sí, cancelar</button>
      </div>
    </div>
  </div>

  <!-- MODAL: formulario para agendar una nueva cita (fecha, servicio, profesional y horario) -->
  <!-- BUG FIX accesibilidad: mismo patrón inert -->
  <div class="modal-overlay" id="modalNuevaCita" role="dialog" aria-modal="true"
       aria-labelledby="nuevaCitaTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="closeNuevaCita" aria-label="Cerrar" data-i18n-aria-label="common.close"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
      <h2 class="modal-title" id="nuevaCitaTitle" data-i18n="citas.modal_new_title">Agendar nueva cita</h2>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="citaFecha" data-i18n="citas.form_date">Fecha</label>
          <input type="date" class="form-input" id="citaFecha"
                 min="@SmileTrack_MVC.Helpers.ColombiaClock.Today.ToString("yyyy-MM-dd")"
                 data-min-date="@SmileTrack_MVC.Helpers.ColombiaClock.Today.ToString("yyyy-MM-dd")"
                 data-open-days="1,2,3,4,5,6" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="citaServicio" data-i18n="citas.form_service">Servicio</label>
          <select class="form-input" id="citaServicio" required>
            <option value="" data-i18n="citas.loading_services">Cargando servicios...</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="citaProfesional">Profesional preferido (opcional)</label>
          <select class="form-input" id="citaProfesional" disabled>
            <option value="" data-i18n="citas.select_date_service_first">Selecciona fecha y servicio primero</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="citaHora" data-i18n="citas.form_schedule">Horario disponible recomendado</label>
          <select class="form-input" id="citaHora" required disabled>
            <option value="" data-i18n="citas.select_professional_first">Selecciona un profesional primero</option>
          </select>
          <small id="citaDisponibilidadAyuda" aria-live="polite" data-i18n="citas.schedule_help">
            Elige una fecha, servicio y profesional para consultar horarios disponibles.
          </small>
        </div>
        <div class="form-group">
          <label class="form-label" for="citaNota" data-i18n="citas.form_notes">Notas adicionales</label>
          <textarea class="form-input" id="citaNota" rows="3" placeholder="Describe tu motivo..." data-i18n-ph="citas.form_notes_ph"></textarea>
        </div>
        <hr />
        <h3>Lista de espera</h3>
        <p>Si no tienes una fecha exacta, indica el rango en el que podrías asistir.</p>
        <div class="form-group">
          <label class="form-label" for="listaEsperaFechaInicio">Desde</label>
          <input type="date" class="form-input" id="listaEsperaFechaInicio" />
        </div>
        <div class="form-group">
          <label class="form-label" for="listaEsperaFechaFin">Hasta</label>
          <input type="date" class="form-input" id="listaEsperaFechaFin" />
        </div>
        <button class="btn-secondary" id="btnListaEspera" type="button">Unirme a lista de espera</button>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarNuevaCita" data-i18n="common.cancel">Cancelar</button>
        <button class="btn-secondary" id="btnAbrirListaEspera" type="button">Unirme a lista de espera</button>
        <button class="btn-primary" id="confirmarNuevaCita" type="button">Solicitar cita</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="modalListaEspera" role="dialog" aria-modal="true"
       aria-labelledby="listaEsperaTitle" aria-hidden="true" inert>
    <div class="modal modal--sm">
      <button class="modal-close" id="closeListaEspera" type="button" aria-label="Cerrar"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
      <h2 class="modal-title" id="listaEsperaTitle">Unirme a la lista de espera</h2>
      <p class="modal-desc">Si se libera un espacio compatible dentro de estas fechas, el sistema te asignará automáticamente una cita y te notificará.</p>
      <div class="form-group">
        <label class="form-label" for="listaEsperaDesde">Desde</label>
        <input type="date" class="form-input" id="listaEsperaDesde" required />
      </div>
      <div class="form-group">
        <label class="form-label" for="listaEsperaHasta">Hasta</label>
        <input type="date" class="form-input" id="listaEsperaHasta" required />
      </div>
      <div class="form-group">
        <label class="form-label" for="listaEsperaServicio">Servicio</label>
        <select class="form-input" id="listaEsperaServicio" required></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="listaEsperaProfesional">Profesional preferido (opcional)</label>
        <select class="form-input" id="listaEsperaProfesional"></select>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarListaEspera" type="button">Cancelar</button>
        <button class="btn-primary" id="confirmarListaEspera" type="button">Inscribirme</button>
      </div>
    </div>
  </div>

  <!-- El toast y el footer son provistos por el shell compartido (_Layout + footer.js). -->

@section Scripts {
  <script src="~/js/Gestion_De_Citas/st-pac-01-mis-citas/mis-citas.js" asp-append-version="true" defer></script>
  <script src="~/js/shared/perfil-paciente-service.js" asp-append-version="true" defer></script>
  <script src="~/js/shared/perfil-paciente-ui.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
