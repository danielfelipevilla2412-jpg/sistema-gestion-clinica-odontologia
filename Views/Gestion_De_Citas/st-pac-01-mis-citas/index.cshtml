﻿﻿﻿@* ============================================
SmileTrack — Mis Citas Paciente (st-pac-01-mis-citas)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista orientada al paciente que permite consultar el historial de citas clínicas, ver el estado de las citas programadas y solicitar agendamiento o cancelaciones de manera interactiva.

FUNCIONALIDADES PRINCIPALES:
- Visualización del listado de citas programadas e historial clínico del paciente
- Cancelación o reprogramación de citas pendientes sujetas a validación horaria
- Resumen interactivo (atendidas, programadas, canceladas) del paciente

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y CitasPaciente
- CSS: ~/css/Gestion_De_Citas/st-pac-01-mis-citas/styles.css
- JS: ~/js/Gestion_De_Citas/st-pac-01-mis-citas/mis-citas.js
- Partial / Otros: Menú del paciente

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
  <!-- Metadatos obligatorios: codificación UTF-8 y viewport responsivo -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Mis Citas</title>

  <!-- Fuentes externas desde Google Fonts: DM Sans para texto y Syne para títulos -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <!-- Hoja de estilos principal de la página -->
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-pac-01-mis-citas/styles.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>
  <!-- Enlace de salto: permite a usuarios de teclado ir directo al contenido principal -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- SIDEBAR: barra de navegación lateral fija con logo, menú y datos del usuario -->
  @{ await Html.RenderPartialAsync("_SidebarPaciente"); }

  <!-- HAMBURGER: botón que abre/cierra el menú lateral en dispositivos mÓviles -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <!-- Overlay semitransparente que aparece detrás del menú mÓvil abierto -->
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- MAIN: área de contenido principal de la página -->
  <main class="main" id="main-content">
    <!-- Cabecera de página con breadcrumb, título, subtítulo y botón para solicitar nueva cita -->
    <header class="page-header">
      <div class="header-left">
        <div class="breadcrumb">Paciente ? Mis citas</div>
        <h1 class="page-title">Mis Citas</h1>
        <p class="page-subtitle">Gestiona y consulta tus citas odontológicas personales</p>
      </div>
      <button class="btn-primary" id="btnNuevaCita">+ Solicitar cita</button>
    </header>

    <!-- Stats Grid (usando clases unificadas + IDs para animación) -->
    <section class="stats-grid" aria-label="Resumen de actividad del día">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="cnt-total">0</span>
        <span class="stat-label">Total citas</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="cnt-completadas">0</span>
        <span class="stat-label">Completadas</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="cnt-pendientes">0</span>
        <span class="stat-label">Pendientes</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="cnt-canceladas">0</span>
        <span class="stat-label">Canceladas</span>
      </div>
    </section>

    <!-- TABLA: sección con barra de progreso, filtros y tabla completa de citas -->
    <section class="agenda-section" aria-label="Listado de citas">
      <!-- Barra de progreso que muestra el porcentaje de citas completadas -->
      <div class="progress-row">
        <div class="progress-bar-bg" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar" id="progressBar" style="width:0%"></div>
        </div>
        <span class="progress-label" id="progressLabel">Cargando—</span>
      </div>

      <!-- Barra de herramientas con campo de búsqueda por texto y filtro por estado -->
      <div class="toolbar" role="toolbar" aria-label="Filtros de citas">
        <div class="search-wrap">
          <span class="search-icon material-symbols-outlined" aria-hidden="true">search</span>
          <!-- Campo de búsqueda para filtrar citas por doctor, servicio o fecha -->
          <input type="search" id="searchInput" class="search-input" placeholder="Buscar por doctor, servicio o fecha\…"
            autocomplete="off" />
        </div>
        <!-- Selector para filtrar citas por estado (Agendada, Confirmada, Completada, Cancelada) -->
        <select id="filterEstado" class="status-select">
          <option value="">Todos los estados</option>
          <option value="Agendada">Agendada</option>
          <option value="Confirmada">Confirmada</option>
          <option value="Completada">Completada</option>
          <option value="Cancelada">Cancelada</option>
        </select>
        <span class="count-label" id="countLabel"></span>
      </div>

      <!-- Tabla de citas con columnas: fecha, hora, doctor, servicio, estado y acciones -->
      <div class="table-wrap">
        <table id="citasTable">
          <thead>
            <tr>
              <th scope="col">Fecha</th>
              <th scope="col">Hora</th>
              <th scope="col">Doctor</th>
              <th scope="col">Servicio</th>
              <th scope="col">Estado</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody id="citasTbody"></tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- MODAL: ventana emergente con el detalle completo de una cita seleccionada -->
  <!-- BUG FIX accesibilidad: aria-hidden="true" e inert iniciales para que el foco
       de teclado y lectores de pantalla no entren al modal mientras está cerrado.
       Sin inert, Tab podría alcanzar los elementos del modal invisible (WCAG 2.1). -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true"
       aria-labelledby="modalTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar">—</button>
      <h2 class="modal-title" id="modalTitle">Detalle de Cita</h2>
      <div id="modalContent"></div>
    </div>
  </div>

  <!-- MODAL: ventana de confirmación antes de cancelar una cita activa -->
  <!-- BUG FIX accesibilidad: mismo patrón inert que el modal de detalle -->
  <div class="modal-overlay" id="modalCancelar" role="dialog" aria-modal="true"
       aria-labelledby="cancelarTitle" aria-hidden="true" inert>
    <div class="modal modal--sm">
      <h2 class="modal-title" id="cancelarTitle">¿Cancelar esta cita?</h2>
      <p class="modal-desc" id="cancelarDesc"></p>
      <p class="modal-note modal-warning hidden" id="cancelarAdvertencia" aria-live="polite"></p>
      <p class="modal-note modal-error hidden" id="cancelarError" aria-live="assertive"></p>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarNo">Volver</button>
        <button class="btn-danger" id="cancelarSi">Sí, cancelar</button>
      </div>
    </div>
  </div>

  <!-- MODAL: formulario para solicitar una nueva cita (fecha, servicio y notas) -->
  <!-- BUG FIX accesibilidad: mismo patrón inert -->
  <div class="modal-overlay" id="modalNuevaCita" role="dialog" aria-modal="true"
       aria-labelledby="nuevaCitaTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="closeNuevaCita" aria-label="Cerrar">—</button>
      <h2 class="modal-title" id="nuevaCitaTitle">Solicitar nueva cita</h2>
      <!-- Campos del formulario: fecha preferida, tipo de servicio y notas adicionales -->
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="citaFecha">Fecha preferida</label>
          <input type="date" class="form-input" id="citaFecha" />
        </div>
        <div class="form-group">
          <label class="form-label" for="citaServicio">Tipo de servicio</label>
          <select class="form-input" id="citaServicio">
            <option>Consulta general</option>
            <option>Limpieza dental</option>
            <option>Control de tratamiento</option>
            <option>Ortodoncia</option>
            <option>Urgencia</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="citaNota">Notas adicionales</label>
          <textarea class="form-input" id="citaNota" rows="3" placeholder="Describe tu motivo\…"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="cancelarNuevaCita">Cancelar</button>
        <button class="btn-primary" id="confirmarNuevaCita">Solicitar</button>
      </div>
    </div>
  </div>

  <!-- TOAST: notificación flotante temporal para confirmar acciones al usuario -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Script principal con toda la lógica de la página de citas -->
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-pac-01-mis-citas/mis-citas.js")"></script>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" style="font-size:1rem;" aria-hidden="true">copyright</span>
      <p>— 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>

  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
    <script src="@Url.Content("~/js/shared/validation-utils.js")"></script>
    <script src="@Url.Content("~/js/shared/appointment-utils.js")"></script>
</body>

</html>

