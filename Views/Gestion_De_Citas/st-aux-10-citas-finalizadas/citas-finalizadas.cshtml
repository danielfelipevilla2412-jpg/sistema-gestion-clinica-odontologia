@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@* ============================================
   SmileTrack — Módulo: Gestión de Citas
   Vista: Citas Finalizadas (st-aux-10-citas-finalizadas)
   ============================================
   Archivo: Views/Gestion_De_Citas/st-aux-10-citas-finalizadas/citas-finalizadas.cshtml

   PROPÓSITO Y JUSTIFICACIÓN:
   Muestra el histórico y métricas de citas concluidas de la jornada actual.

   REGLAS DE RENDERIZADO Y NEGOCIO:
   - Resumen estadístico por estado (Atendidas, Canceladas, Inasistencias).

   DEPENDENCIAS:
   - CSS: ~/css/Gestion_De_Citas/st-aux-10-citas-finalizadas/citas-finalizadas.css
   - JS: ~/js/Gestion_De_Citas/st-aux-10-citas-finalizadas/citas-finalizadas.js
   ============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Citas Finalizadas";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var citasFinalizadasDataJson = System.Text.Json.JsonSerializer.Serialize(ViewData["CitasFinalizadasData"] ?? new object());
    var hoy = ViewData["HoyFinalizadas"] is DateOnly fechaHoy ? fechaHoy : DateOnly.FromDateTime(SmileTrack_MVC.Helpers.ColombiaClock.Today);
    var fechaResumen = ViewData["FechaFinalizadas"] is DateOnly jornada ? jornada : hoy;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-aux-10-citas-finalizadas/citas-finalizadas.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main finalized-page" id="main-content">

    @if (TempData["ErrorValidacion"] is string error)
    {
      <p role="alert">@error</p>
    }
    <!-- Header con metadatos accesibles -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span>Gestión de Citas</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active">Citas finalizadas</span>
        </nav>
        <h1 class="page-title">Citas finalizadas</h1>
        <p class="page-subtitle">Resumen de la jornada · <time datetime="@fechaResumen.ToString("yyyy-MM-dd")">@fechaResumen.ToString("d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</time></p>
      </div>
    </header>

    <div class="finalized-toolbar">
      <form method="get">
        <div class="finalized-date-field">
          <label for="finalizedDate">Fecha de la jornada</label>
        <input id="finalizedDate" name="fecha" type="date" required value="@fechaResumen.ToString("yyyy-MM-dd")" max="@hoy.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn-primary">Consultar</button>
        @if (fechaResumen > DateOnly.MinValue)
        {
          <a class="btn-secondary" href="?fecha=@fechaResumen.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Jornada anterior">‹</a>
        }
        @if (fechaResumen < hoy)
        {
          <a class="btn-secondary" href="?fecha=@fechaResumen.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Jornada siguiente">›</a>
        }
        <a class="btn-secondary" href="?fecha=@hoy.ToString("yyyy-MM-dd")" aria-current="@(fechaResumen == hoy ? "date" : null)">Hoy</a>
        <a class="btn-secondary" href="?fecha=@hoy.AddDays(-1).ToString("yyyy-MM-dd")" aria-current="@(fechaResumen == hoy.AddDays(-1) ? "date" : null)">Ayer</a>
      </form>
      <div class="finalized-export">
      <button class="btn-export" id="btnExport" type="button" disabled aria-describedby="finalizedExportScope" aria-label="Descargar resumen de citas finalizadas" data-i18n-aria-label="table.export">
        <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <span class="btn-text">Descargar resumen CSV</span>
      </button>
        <small id="finalizedExportScope" aria-live="polite"></small>
      </div>
    </div>

    <!-- Stats Grid: patrón canónico (stats-grid + stat-card[data-color]) unificado con
         st-adm-07, st-rec-01, st-adm-01 y el resto del módulo de Citas/Profesionales.
         Antes usaba summary-cards/summary-card.green que era un diseño ad-hoc distinto. -->
    <section class="stats-grid" aria-label="Resumen de citas por estado">
      <button type="button" class="stat-card finalized-filter" data-color="green" data-tab="attended" aria-pressed="false">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">task_alt</span>
        <span class="stat-number" id="countAtendidas">0</span>
        <span class="stat-label" data-i18n="status.attended">Atendidas</span>
      </button>
      <button type="button" class="stat-card finalized-filter" data-color="red" data-tab="cancelled" aria-pressed="false">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">event_busy</span>
        <span class="stat-number" id="countCanceladas">0</span>
        <span class="stat-label" >Canceladas</span>
      </button>
      <button type="button" class="stat-card finalized-filter" data-color="orange" data-tab="no-show" aria-pressed="false">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">person_off</span>
        <span class="stat-number" id="countNoAsistio">0</span>
        <span class="stat-label" >Inasistencias</span>
      </button>
    </section>

    <!-- Tabs de filtrado rápido por estado (patrón canónico st-adm-09) -->
    <div class="table-tabs" role="group" aria-label="Filtrar citas finalizadas por estado">
      <button type="button" class="tab-btn active" aria-pressed="true" data-tab="all" id="tab-all">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">task_alt</span>
        <span class="finalized-all-label">Todas las finalizadas</span>
      </button>
    </div>

    <!-- Tabla de citas con estructura accesible -->
    <div class="finalized-empty" id="finalizedEmpty" hidden>
      <p id="finalizedEmptyMessage" role="status"></p>
      <a class="btn-secondary" id="finalizedLastDay" hidden>Consultar última jornada con registros</a>
      <button type="button" class="btn-secondary" id="finalizedClearStatus" hidden>Ver todas las finalizadas</button>
    </div>
    <div class="table-wrap" id="finalizedTable" hidden>
      <table class="table-base" aria-label="Listado de citas finalizadas del día">
        <thead>
          <tr>
            <th scope="col" data-i18n="citas.time">HORA</th>
            <th scope="col" data-i18n="citas.patient">PACIENTE</th>
            <th scope="col" data-i18n="citas.professional">PROFESIONAL</th>
            <th scope="col" data-i18n="citas.service">SERVICIO</th>
            <th scope="col" data-i18n="citas.status">ESTADO</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody id="appointmentsBody">
          <!-- Las filas se generan dinámicamente por JavaScript -->
        </tbody>
      </table>
    </div>

    <nav id="finalizedPagination" hidden class="pagination" aria-label="Paginación de citas finalizadas">
      <span class="pagination-info" id="finalizedPaginationInfo" aria-live="polite">Mostrando 0 de 0 citas</span>
      <div class="pagination-buttons">
        <button type="button" class="pagination-btn" id="finalizedPreviousPage" aria-label="Página anterior" disabled>← Anterior</button>
        <div class="pagination-numbers" id="finalizedPageNumbers" role="list" aria-label="Números de página"></div>
        <button type="button" class="pagination-btn" id="finalizedNextPage" aria-label="Página siguiente" disabled>Siguiente →</button>
      </div>
    </nav>

    <dialog id="finalizedDetail" aria-labelledby="finalizedDetailTitle">
      <h2 id="finalizedDetailTitle">Detalle de la cita</h2>
      <dl id="finalizedDetailFields"></dl>
      <form method="dialog"><button class="btn-secondary">Cerrar</button></form>
    </dialog>
  </main>

  <!-- Mobile bottom nav con aria-label para navegación móvil -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">space_dashboard</span></span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-aux-02-agenda-apoyo" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-aux-10-citas-finalizadas" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">check_circle</span></span>
      <span>Finalizadas</span>
    </a>
    <a href="/perfiles/st-aux-11-perfil-auxiliar" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast con aria-atomic para anuncio completo de notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>



  <script>
    window.smiletrackCitasFinalizadasData = @Html.Raw(citasFinalizadasDataJson);
  </script>
@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-aux-10-citas-finalizadas/citas-finalizadas.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
}
