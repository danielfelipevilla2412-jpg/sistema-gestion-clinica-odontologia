@* ============================================
   SmileTrack — Agenda General (st-adm-08-agenda)
   ============================================
   Autor: Johan Santamaria
   Fecha: 29/07/2026
   DEPENDENCIAS: agendageneral.css / agendageneral.js
============================================ *@
@model SmileTrack_MVC.Models.ViewModels.AgendaViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Agenda General"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-adm-08-agenda/agendageneral.css" asp-append-version="true" />
}

<!-- Contenido principal -->
<main class="main" id="main-content">
    <!-- Encabezado de página -->
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="adm08_bc_aria">
                <span data-i18n="adm08_bc_admin">Administración</span>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" data-i18n="adm08_bc_active">Agenda General</span>
            </nav>
            <h1 class="page-title" data-i18n="adm08_title">Agenda General</h1>
            <p class="page-subtitle" data-i18n="adm08_subtitle">Gestión de citas y horarios</p>
        </div>
        <div class="header-actions">
            <a class="btn-secondary" href="/gestion-de-citas/st-adm-09-citas" aria-label="Abrir tabla integral de citas">
                <span class="material-symbols-outlined" aria-hidden="true">table_view</span>
                <span>Tabla integral</span>
            </a>
        </div>
    </header>

    <!-- Controles de navegación y filtros -->
    <section class="agenda-controls" aria-label="Controles de navegación y filtros" data-i18n-aria-label="adm08_controls_aria">
        <div class="controls-left">
            <div class="week-nav" role="navigation" aria-label="Navegación semanal" data-i18n-aria-label="adm08_weeknav_aria">
                <button class="btn-week" id="btnPrev" aria-label="Semana anterior" data-i18n-aria-label="adm08_prev_week_aria">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                </button>
                <span class="week-label" id="weekLabel" aria-live="polite" data-week-start="@Model.WeekStart.ToString("yyyy-MM-dd")" data-duration-minutes="@Model.DuracionCitaMinutos">@Model.SemanaLabel</span>
                <button class="btn-week" id="btnNext" aria-label="Próxima semana" data-i18n-aria-label="adm08_next_week_aria">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
            </div>
            <button class="btn-primary" id="btnToday" aria-label="Ir a la semana actual" data-i18n-aria-label="adm08_today_aria">
                <span class="material-symbols-outlined" aria-hidden="true">today</span> <span data-i18n="adm08_today">Hoy</span>
            </button>
        </div>

        <div class="controls-right">
            <div class="filter-group">
                <label for="filterProfessional" class="filter-label" data-i18n="adm08_filter_prof_label">Profesional</label>
                <select id="filterProfessional" class="status-select" aria-label="Filtrar por profesional" data-i18n-aria-label="adm08_filter_prof_aria">
                    <option value="" data-i18n="adm08_filter_prof_all">Todos los profesionales</option>
                    @foreach (var profesional in Model.Profesionales)
                    {
                        <option value="@profesional.Id" selected="@(Model.ProfessionalId == profesional.Id ? "selected" : null)">@profesional.Text</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label for="filterOffice" class="filter-label" data-i18n="adm08_filter_office_label">Consultorio</label>
                <select id="filterOffice" class="status-select" aria-label="Filtrar por consultorio" data-i18n-aria-label="adm08_filter_office_aria">
                    <option value="" data-i18n="adm08_filter_office_all">Todos los consultorios</option>
                    @foreach (var consultorio in Model.Consultorios)
                    {
                        <option value="@consultorio.Id" selected="@(Model.OfficeId == consultorio.Id ? "selected" : null)">@consultorio.Text</option>
                    }
                </select>
            </div>
        </div>
    </section>

    <section class="clinic-hours-banner" aria-label="Horario de atención de la clínica" data-i18n-aria-label="adm08_hours_aria">
        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
        <div>
            <strong data-i18n="adm08_hours_title">Horario de la clínica</strong>
            <span>@Model.HorarioApertura - @Model.HorarioCierre · @Model.DiasAtencionTexto · @Model.DuracionCitaMinutos <span data-i18n="adm08_hours_min">min por cita</span></span>
        </div>
    </section>

    <div class="agenda-print-actions no-print">
        <button type="button" class="btn-secondary" onclick="window.print()" aria-label="Imprimir agenda semanal" data-i18n-aria-label="adm08_print_aria">
            <span class="material-symbols-outlined" aria-hidden="true">print</span>
            <span data-i18n="adm08_print_btn">Imprimir Agenda</span>
        </button>
    </div>

    <!-- Calendario semanal -->
    <section class="calendar-section" aria-labelledby="calendarTitle">
        <h2 class="visually-hidden" id="calendarTitle" data-i18n="adm08_calendar_title">Calendario semanal de citas</h2>
        <div class="calendar-scroll-wrapper">
            <div class="calendar-header" role="row">
                @foreach (var dia in Model.Dias)
                {
                    var headerClasses = "calendar-day-header";
                    if (dia.EsHoy) headerClasses += " current";
                    if (dia.Cerrado) headerClasses += " closed";
                    <div class="@headerClasses" role="columnheader" aria-current="@(dia.EsHoy ? "date" : null)">
                        <span class="day-name">@dia.NombreDia</span>
                        <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")" class="day-number">@dia.NumeroDia</time>
                        @if (dia.EsHoy) { <span class="day-indicator" aria-hidden="true"></span> }
                    </div>
                }
            </div>
            <div class="calendar-body" role="grid" aria-label="Citas por día">
                @foreach (var dia in Model.Dias)
                {
                    var diaClasses = "calendar-day";
                    if (dia.EsHoy) diaClasses += " current";
                    if (dia.Cerrado) diaClasses += " closed";
                    var diaId = $"day-{dia.Fecha.ToString("yyyyMMdd")}";
                    <div class="@diaClasses" role="row" aria-labelledby="@diaId">
                        <span id="@diaId" class="visually-hidden">@dia.NombreDia @dia.Fecha.Day de @dia.Fecha.ToString("MMMM")</span>
                        @if (dia.Cerrado)
                        {
                            <div class="day-closed">
                                <span class="material-symbols-outlined" aria-hidden="true">block</span>
                                <span data-i18n="adm08_day_closed">CERRADO</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var cita in dia.Citas)
                            {
                                var ariaLabel = $"Cita {cita.Estado}: {cita.Paciente}, {cita.Hora}, {cita.Servicio}, {cita.Consultorio}";
                                var dateTimeValue = $"{dia.Fecha.ToString("yyyy-MM-dd")}T{cita.Hora}:00";
                                <div class="appointment @cita.ClaseEstado" tabindex="0" role="button"
                                    aria-label="@ariaLabel"
                                    data-id="@cita.Id" data-date="@dia.Fecha.ToString("yyyy-MM-dd")"
                                    data-start-time="@Html.Encode(cita.HoraInicio)" data-end-time="@Html.Encode(cita.HoraFin)"
                                    data-patient-id="@cita.IdPaciente" data-professional-id="@cita.IdProfesional"
                                    data-office-id="@cita.IdConsultorio" data-service-id="@cita.IdServicio"
                                    data-status="@Html.Encode(cita.Estado)" data-notes="@Html.Encode(cita.Notas)"
                                    data-patient-name="@Html.Encode(cita.Paciente)" data-service-name="@Html.Encode(cita.Servicio)"
                                    data-office-name="@Html.Encode(cita.Consultorio)" data-professional-name="@Html.Encode(cita.NombreProfesional)">
                                    <time datetime="@dateTimeValue" class="appt-time">@cita.Hora</time>
                                    <span class="appt-patient">@cita.Paciente</span>
                                    <span class="appt-detail">@cita.Servicio — @cita.Consultorio</span>
                                </div>
                            }
                            @if (!dia.Citas.Any())
                            {
                                <div class="appointment available" tabindex="0" role="button"
                                    data-date="@dia.Fecha.ToString("yyyy-MM-dd")"
                                    aria-label="Sin citas registradas para @dia.Fecha.ToString("dd/MM")">
                                    <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")" class="appt-time"></time>
                                    <span class="appt-patient" data-i18n="adm08_no_appointments">Sin citas</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Leyenda -->
    <section class="legend-section" aria-labelledby="legendTitle">
        <h2 class="section-title" id="legendTitle" data-i18n="adm08_legend_title">Estados de cita</h2>
        <div class="legend-grid">
            <div class="legend-item"><span class="legend-dot reserved" aria-hidden="true"></span><span data-i18n="adm08_legend_scheduled">Programada</span></div>
            <div class="legend-item"><span class="legend-dot confirmed" aria-hidden="true"></span><span data-i18n="adm08_legend_confirmed">Confirmada</span></div>
            <div class="legend-item"><span class="legend-dot attended" aria-hidden="true"></span><span data-i18n="adm08_legend_attended">Asistida</span></div>
            <div class="legend-item"><span class="legend-dot cancelled" aria-hidden="true"></span><span data-i18n="adm08_legend_cancelled">Cancelada</span></div>
            <div class="legend-item"><span class="legend-dot available" aria-hidden="true"></span><span data-i18n="adm08_legend_available">Disponible</span></div>
        </div>
    </section>
</main>

<!-- Modal: Detalle de cita existente -->
<div class="modal-overlay" id="modalAppointment" role="dialog" aria-modal="true"
     aria-labelledby="modalApptTitle" aria-hidden="true" inert>
    <div class="modal">
        <button class="modal-close" id="modalApptClose" aria-label="Cerrar ventana" data-i18n-aria-label="adm08_modal_close_aria">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <h2 class="modal-title" id="modalApptTitle" data-i18n="adm08_modal_appt_title">Detalle de Cita</h2>
        <div class="modal-content" id="modalApptContent" aria-live="polite"></div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" id="modalApptCancel" data-i18n="form.close">Cerrar</button>
            <button type="button" class="btn-secondary btn-danger" id="modalApptCancelar" data-i18n="citas.cancel">Cancelar Cita</button>
            <button type="button" class="btn-primary" id="modalApptEdit" data-i18n="form.edit">Editar</button>
        </div>
    </div>
</div>

<!-- Modal: Crear nueva cita -->
<div class="modal-overlay" id="modalNewAppointment" role="dialog" aria-modal="true"
     aria-labelledby="modalNewApptTitle" aria-hidden="true" inert>
    <div class="modal modal-lg">
        <button class="modal-close" id="modalNewApptClose" aria-label="Cerrar ventana" data-i18n-aria-label="adm08_modal_close_aria">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <h2 class="modal-title" id="modalNewApptTitle" data-i18n="adm08_modal_newappt_title">Agendar Nueva Cita</h2>
        <div class="modal-content">
            <form id="formNewAppointment">
                @Html.AntiForgeryToken()
                <input type="hidden" id="appointmentId" name="IdCita" value="" />
                <div class="form-grid">
                    <div class="form-group">
                        <label for="newApptDate" data-i18n="citas.date">Fecha</label>
                        <input type="date" id="newApptDate" name="Fecha" required aria-required="true" />
                    </div>
                    <div class="form-group">
                        <label for="newApptStatus" data-i18n="citas.status">Estado</label>
                        <select id="newApptStatus" name="Estado" required aria-required="true">
                            <option value="Agendada" selected data-i18n="status.scheduled">Agendada</option>
                            <option value="Confirmada" data-i18n="status.confirmed">Confirmada</option>
                            <option value="Cancelada" data-i18n="status.cancelled">Cancelada</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newApptStartTime" data-i18n="adm08_form_hora_inicio">Hora Inicio</label>
                        <input type="time" id="newApptStartTime" name="HoraInicio" required aria-required="true" />
                    </div>
                    <div class="form-group">
                        <label for="newApptEndTime" data-i18n="adm08_form_hora_fin">Hora Fin</label>
                        <input type="time" id="newApptEndTime" name="HoraFin" readonly aria-describedby="appointmentDurationHint" />
                        <span id="appointmentDurationHint" class="form-hint" data-i18n="adm08_form_duracion_hint">Calculada según la duración configurada.</span>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptPatient" data-i18n="citas.patient">Paciente</label>
                        <select id="newApptPatient" name="IdPaciente" required aria-required="true">
                            <option value="" data-i18n="adm08_form_select_paciente">Seleccione paciente...</option>
                            @foreach (var paciente in Model.Pacientes)
                            {
                                <option value="@paciente.Id">@paciente.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newApptProfessional" data-i18n="citas.professional">Profesional</label>
                        <select id="newApptProfessional" name="IdProfesional" required aria-required="true">
                            <option value="" data-i18n="adm08_form_select_profesional">Seleccione profesional</option>
                            @foreach (var profesional in Model.Profesionales)
                            {
                                <option value="@profesional.Id">@profesional.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newApptOffice" data-i18n="citas.office">Consultorio</label>
                        <select id="newApptOffice" name="IdConsultorio" required aria-required="true">
                            <option value="" data-i18n="adm08_form_select_consultorio">Seleccione consultorio</option>
                            @foreach (var consultorio in Model.Consultorios)
                            {
                                <option value="@consultorio.Id">@consultorio.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptService" data-i18n="adm08_form_servicio_label">Servicio (Motivo de Consulta)</label>
                        <select id="newApptService" name="IdServicio" required aria-required="true">
                            <option value="" data-i18n="adm08_form_select_servicio">Seleccione servicio</option>
                            @foreach (var servicio in Model.Servicios)
                            {
                                <option value="@servicio.Id">@servicio.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptNotes" data-i18n="adm08_form_observaciones">Observaciones</label>
                        <textarea id="newApptNotes" name="Notas" rows="2" placeholder="Detalles adicionales..." data-i18n-ph="adm08_form_notas_ph"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" id="modalNewApptCancel" data-i18n="form.cancel">Cancelar</button>
                    <button type="submit" class="btn-primary" id="modalNewApptSave" data-i18n="adm08_form_guardar_cita">Guardar Cita</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FAB nueva cita -->
<button class="fab" id="btnNewAppointment" aria-label="Crear nueva cita" data-i18n-aria-label="citas.new_aria">
    <span class="material-symbols-outlined" aria-hidden="true">add</span>
</button>

<!-- Navegación móvil -->
<nav class="mobile-nav" aria-label="Navegación móvil" data-i18n-aria-label="adm08_mobile_nav_aria">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">space_dashboard</span>
        <span data-i18n="adm08_mobile_dashboard">Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item active" aria-current="page">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">calendar_month</span>
        <span data-i18n="adm08_mobile_agenda">Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-adm-09-citas" class="mobile-nav-item">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">event</span>
        <span data-i18n="adm08_mobile_citas">Citas</span>
    </a>
</nav>

<!-- Footer -->
<footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div class="agenda-footer-content">
        <span class="material-symbols-outlined" aria-hidden="true">copyright</span>
        <p data-i18n="footer.copyright">© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO — SENA</p>
</footer>

@section Scripts {
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/Gestion_De_Citas/st-adm-08-agenda/agendageneral.js" asp-append-version="true" defer></script>
}
