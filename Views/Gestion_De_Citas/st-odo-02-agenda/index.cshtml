@* ============================================
   SmileTrack — Mi Agenda Odontólogo (st-odo-02-agenda)
   ============================================
   Autor: Johan Santamaria / Antigravity
   Fecha: 29/07/2026 (Actualizado 2026-09-12)
   DEPENDENCIAS: agenda.css / agenda.js / appointment-utils.js
============================================ *@
@model SmileTrack_MVC.Models.ViewModels.AgendaViewModel
@{ 
    Layout = "_Layout"; 
    ViewData["Title"] = "Mi Agenda";

    var diaHoy = Model.Dias.FirstOrDefault(d => d.EsHoy);
    int citasHoyCount = diaHoy?.Citas.Count ?? 0;
    int atendidasHoyCount = diaHoy?.Citas.Count(c => c.Estado.Equals("Atendida", StringComparison.OrdinalIgnoreCase) || c.Estado.Equals("Completada", StringComparison.OrdinalIgnoreCase) || c.Estado.Equals("Asistida", StringComparison.OrdinalIgnoreCase)) ?? 0;
    int pendientesHoyCount = diaHoy?.Citas.Count(c => !c.Estado.Equals("Atendida", StringComparison.OrdinalIgnoreCase) && !c.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase)) ?? 0;
    int totalPendientesSemana = Model.Dias.Sum(d => d.Citas.Count(c => !c.Estado.Equals("Cancelada", StringComparison.OrdinalIgnoreCase)));
    int progresoPct = citasHoyCount > 0 ? (int)Math.Round((double)atendidasHoyCount * 100 / citasHoyCount) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-odo-02-agenda/agenda.css" asp-append-version="true" />
}

<!-- Contenido principal -->
<main class="main" id="main-content">
    <!-- Encabezado de página -->
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
                <span data-i18n="common_role_profesional">Odontólogo</span>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" data-i18n="nav.agenda">Mi Agenda</span>
            </nav>
            <h1 class="page-title" data-i18n="nav.agenda">Mi Agenda</h1>
            <p class="page-subtitle">
                <time datetime="@Model.WeekStart.ToString("yyyy-MM-dd")" id="headerDate" aria-live="polite">Semana del @Model.SemanaLabel</time> — Gestiona y atiende a tus pacientes
            </p>
        </div>
        <div class="header-right agenda-print-actions no-print">
            <button type="button" class="btn-secondary" onclick="window.print()" aria-label="Imprimir mi agenda semanal" data-i18n-aria-label="form.print">
                <span class="material-symbols-outlined" aria-hidden="true">print</span>
                Imprimir Agenda
            </button>
        </div>
    </header>

    <!-- Resumen de KPIs y Progreso Diario -->
    <section class="stats-grid" aria-label="Resumen de citas del día" data-i18n-aria-label="citas.title">
        <div class="stat-card" data-color="blue">
            <span class="stat-number" id="statHoy" aria-live="polite">@citasHoyCount</span>
            <span class="stat-label" data-i18n="citas.total_today">Citas hoy</span>
        </div>
        <div class="stat-card" data-color="green">
            <span class="stat-number" id="statAtendidas" aria-live="polite">@atendidasHoyCount</span>
            <span class="stat-label" data-i18n="status.attended">Atendidas</span>
        </div>
        <div class="stat-card" data-color="orange">
            <span class="stat-number" id="statPendientes" aria-live="polite">@pendientesHoyCount</span>
            <span class="stat-label" data-i18n="status.pending">Pendientes hoy</span>
        </div>
        <div class="stat-card" data-color="purple">
            <span class="stat-number" id="statMes" aria-live="polite">@totalPendientesSemana</span>
            <span class="stat-label">Pendientes en la semana</span>
        </div>
    </section>

    <!-- Barra de progreso diario accesible -->
    <div class="progress-row" aria-label="Progreso de atención del día">
        <div class="progress-bar-wrap" role="progressbar" aria-valuenow="@progresoPct" aria-valuemin="0" aria-valuemax="100"
             aria-label="Progreso del día: @progresoPct% completado">
            <div class="progress-bar" id="progressBar" style="width:@progresoPct%"></div>
        </div>
        <span class="progress-label" id="progressLabel" aria-live="polite">@atendidasHoyCount de @citasHoyCount citas atendidas hoy (@progresoPct%)</span>
    </div>

    <!-- Controles de navegación de semana -->
    <section class="agenda-controls" aria-label="Controles de navegación semanal">
        <div class="controls-left">
            <!-- Toggle de Vista -->
            <div class="view-toggle" role="radiogroup" aria-label="Tipo de vista">
                <button class="view-btn active" data-view="week" aria-pressed="true" title="Vista semanal">
                    <span class="material-symbols-outlined">view_week</span>
                    <span class="view-btn-text">Semana</span>
                </button>
                <button class="view-btn" data-view="day" aria-pressed="false" title="Vista de día">
                    <span class="material-symbols-outlined">view_day</span>
                    <span class="view-btn-text">Día</span>
                </button>
                <button class="view-btn" data-view="list" aria-pressed="false" title="Vista de lista">
                    <span class="material-symbols-outlined">list</span>
                    <span class="view-btn-text">Lista</span>
                </button>
            </div>

            <div class="week-nav" role="navigation" aria-label="Navegación semanal">
                <button class="btn-week" id="btnPrev" aria-label="Semana anterior">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                </button>
                <span class="week-label" id="weekLabel" aria-live="polite" data-week-start="@Model.WeekStart.ToString("yyyy-MM-dd")" data-duration-minutes="@Model.DuracionCitaMinutos">@Model.SemanaLabel</span>
                <button class="btn-week" id="btnNext" aria-label="Próxima semana">
                    <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
            </div>
            <button class="btn-primary" id="btnToday" aria-label="Ir a la semana actual">
                <span class="material-symbols-outlined" aria-hidden="true">today</span> Hoy
            </button>
        </div>

        <div class="controls-right">
            <!-- Búsqueda de Pacientes -->
            <div class="search-patient-wrap">
                <span class="material-symbols-outlined">search</span>
                <input type="search" 
                       id="searchPatient" 
                       placeholder="Buscar paciente..."
                       aria-label="Buscar paciente en la agenda">
            </div>

            <!-- Filtro por Estado -->
            <div class="filter-group">
                <label for="filterStatus" class="filter-label">Estado</label>
                <select id="filterStatus" class="status-select" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    <option value="programada">Programadas (@(ViewData["CitasProgramadas"] ?? 0))</option>
                    <option value="confirmada">Confirmadas (@(ViewData["CitasConfirmadas"] ?? 0))</option>
                    <option value="atendida">Atendidas (@(ViewData["CitasAtendidas"] ?? 0))</option>
                    <option value="cancelada">Canceladas (@(ViewData["CitasCanceladas"] ?? 0))</option>
                </select>
            </div>

            <!-- Filtro por Consultorio -->
            <div class="filter-group">
                <label for="filterOffice" class="filter-label">Consultorio</label>
                <select id="filterOffice" class="status-select" aria-label="Filtrar por consultorio">
                    <option value="">Todos los consultorios</option>
                    @foreach (var consultorio in Model.Consultorios)
                    {
                        <option value="@consultorio.Id" selected="@(Model.OfficeId == consultorio.Id ? "selected" : null)">@consultorio.Text</option>
                    }
                </select>
            </div>
        </div>
    </section>

    <!-- Banner de Horarios -->
    <section class="clinic-hours-banner" aria-label="Horario de atención de la clínica">
        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
        <div>
            <strong>Horario de atención médica</strong>
            <span>@Model.HorarioApertura - @Model.HorarioCierre · @Model.DiasAtencionTexto · @Model.DuracionCitaMinutos min por consulta</span>
        </div>
    </section>

    <!-- Panel de Estadísticas Rápidas -->
    @{
        var totalSemana = (int)(ViewData["TotalCitasSemana"] ?? 0);
        var programadas = (int)(ViewData["CitasProgramadas"] ?? 0);
        var confirmadas = (int)(ViewData["CitasConfirmadas"] ?? 0);
        var atendidas = (int)(ViewData["CitasAtendidas"] ?? 0);
    }
    <section class="quick-stats-panel" aria-label="Estadísticas de la semana">
        <div class="quick-stat-item" data-status="total">
            <span class="material-symbols-outlined">event</span>
            <div>
                <strong>@totalSemana</strong>
                <span>Total semana</span>
            </div>
        </div>
        <div class="quick-stat-item" data-status="programada">
            <span class="material-symbols-outlined">schedule</span>
            <div>
                <strong>@programadas</strong>
                <span>Programadas</span>
            </div>
        </div>
        <div class="quick-stat-item" data-status="confirmada">
            <span class="material-symbols-outlined">check_circle</span>
            <div>
                <strong>@confirmadas</strong>
                <span>Confirmadas</span>
            </div>
        </div>
        <div class="quick-stat-item" data-status="atendida">
            <span class="material-symbols-outlined">task_alt</span>
            <div>
                <strong>@atendidas</strong>
                <span>Atendidas</span>
            </div>
        </div>
    </section>

    <!-- Grid Semanal de Calendario -->
    <section class="calendar-section" aria-labelledby="calendarTitle">
        <h2 class="visually-hidden" id="calendarTitle">Calendario semanal de citas</h2>
        <div class="calendar-scroll-wrapper" data-view="week">
            <div class="calendar-header" role="row">
                @foreach (var dia in Model.Dias)
                {
                    var headerClasses = "calendar-day-header";
                    if (dia.EsHoy) headerClasses += " current";
                    if (dia.Cerrado) headerClasses += " closed";
                    <div class="@headerClasses" role="columnheader" aria-current="@(dia.EsHoy ? "date" : null)" data-date="@dia.Fecha.ToString("yyyy-MM-dd")">
                        <span class="day-name">@dia.NombreDia</span>
                        <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")" class="day-number">@dia.NumeroDia</time>
                        @if (dia.EsHoy) { <span class="day-indicator" aria-hidden="true"></span> }
                    </div>
                }
            </div>
            <div class="calendar-body" role="grid" aria-label="Citas por día">
                @foreach (var dia in Model.Dias)
                {
                    var diaClasses = "calendar-day";
                    if (dia.EsHoy) diaClasses += " current";
                    if (dia.Cerrado) diaClasses += " closed";
                    var diaId = $"day-{dia.Fecha.ToString("yyyyMMdd")}";
                    <div class="@diaClasses" role="row" aria-labelledby="@diaId" data-date="@dia.Fecha.ToString("yyyy-MM-dd")">
                        <span id="@diaId" class="visually-hidden">@dia.NombreDia @dia.Fecha.Day de @dia.Fecha.ToString("MMMM")</span>
                        @if (dia.Cerrado)
                        {
                            <div class="day-closed">
                                <span class="material-symbols-outlined" aria-hidden="true">block</span>
                                <span>CERRADO</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var cita in dia.Citas)
                            {
                                var ariaLabel = $"Cita {cita.Estado}: {cita.Paciente}, {cita.Hora}, {cita.Servicio}, {cita.Consultorio}";
                                var dateTimeValue = $"{dia.Fecha.ToString("yyyy-MM-dd")}T{cita.Hora}:00";
                                <div class="appointment @cita.ClaseEstado" tabindex="0" role="button"
                                     aria-label="@ariaLabel"
                                     data-id="@cita.Id" data-date="@dia.Fecha.ToString("yyyy-MM-dd")"
                                     data-start-time="@Html.Encode(cita.HoraInicio)" data-end-time="@Html.Encode(cita.HoraFin)"
                                     data-patient-id="@cita.IdPaciente" data-professional-id="@cita.IdProfesional"
                                     data-office-id="@cita.IdConsultorio" data-service-id="@cita.IdServicio"
                                     data-status="@Html.Encode(cita.Estado)" data-notes="@Html.Encode(cita.Notas)"
                                     data-patient-name="@Html.Encode(cita.Paciente)" data-service-name="@Html.Encode(cita.Servicio)"
                                     data-office-name="@Html.Encode(cita.Consultorio)" data-professional-name="@Html.Encode(cita.NombreProfesional)"
                                     draggable="true">
                                    <time datetime="@dateTimeValue" class="appt-time">@cita.Hora</time>
                                    <span class="appt-patient">@cita.Paciente</span>
                                    <span class="appt-detail">@cita.Servicio — @cita.Consultorio</span>
                                    <span class="appt-status-indicator" data-status-time="" aria-live="polite"></span>
                                </div>
                            }
                            @if (!dia.Citas.Any())
                            {
                                <div class="appointment available" tabindex="0" role="button"
                                     data-date="@dia.Fecha.ToString("yyyy-MM-dd")"
                                     aria-label="Sin citas registradas para @dia.Fecha.ToString("dd/MM")">
                                    <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")" class="appt-time"></time>
                                    <span class="appt-patient">Sin citas</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Leyenda de Estados -->
    <section class="legend-section" aria-labelledby="legendTitle">
        <h2 class="section-title" id="legendTitle">Estados de cita</h2>
        <div class="legend-grid">
            <div class="legend-item"><span class="legend-dot reserved" aria-hidden="true"></span><span>Programada</span></div>
            <div class="legend-item"><span class="legend-dot confirmed" aria-hidden="true"></span><span>Confirmada</span></div>
            <div class="legend-item"><span class="legend-dot attended" aria-hidden="true"></span><span>Atendida</span></div>
            <div class="legend-item"><span class="legend-dot cancelled" aria-hidden="true"></span><span>Cancelada</span></div>
            <div class="legend-item"><span class="legend-dot available" aria-hidden="true"></span><span>Disponible</span></div>
        </div>
    </section>
</main>

<!-- Modal: Detalle de Cita y Acciones Clínicas -->
<div class="modal-overlay" id="modalAppointment" role="dialog" aria-modal="true"
     aria-labelledby="modalApptTitle" aria-hidden="true" inert>
    <div class="modal">
        <button class="modal-close" id="modalApptClose" aria-label="Cerrar ventana">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <h2 class="modal-title" id="modalApptTitle">Detalle de Cita</h2>
        <div class="modal-content" id="modalApptContent" aria-live="polite"></div>
        <div class="modal-footer modal-actions-grid">
            <a href="/historia-clinica/st-odo-04-odontograma" class="btn-primary" id="btnIniciarAtencion">
                <span class="material-symbols-outlined" aria-hidden="true">medical_services</span>
                Iniciar Atención
            </a>
            <button type="button" class="btn-secondary" id="btnMarcarAtendida">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                Marcar Atendida
            </button>
            <button type="button" class="btn-secondary btn-danger" id="modalApptCancelar">
                <span class="material-symbols-outlined" aria-hidden="true">cancel</span>
                No asistió / Cancelar
            </button>
        </div>
    </div>
</div>

<!-- Modal: Crear nueva cita / sobrecupo -->
<div class="modal-overlay" id="modalNewAppointment" role="dialog" aria-modal="true"
     aria-labelledby="modalNewApptTitle" aria-hidden="true" inert>
    <div class="modal modal-lg">
        <button class="modal-close" id="modalNewApptClose" aria-label="Cerrar ventana">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <h2 class="modal-title" id="modalNewApptTitle">Agendar Nueva Cita</h2>
        <div class="modal-content">
            <form id="formNewAppointment">
                @Html.AntiForgeryToken()
                <input type="hidden" id="appointmentId" name="IdCita" value="" />
                <div class="form-grid">
                    <div class="form-group">
                        <label for="newApptDate">Fecha</label>
                        <input type="date" id="newApptDate" name="Fecha" required aria-required="true" />
                    </div>
                    <div class="form-group">
                        <label for="newApptStatus">Estado</label>
                        <select id="newApptStatus" name="Estado" required aria-required="true">
                            <option value="Agendada" selected>Agendada</option>
                            <option value="Confirmada">Confirmada</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newApptStartTime">Hora Inicio</label>
                        <input type="time" id="newApptStartTime" name="HoraInicio" required aria-required="true" />
                    </div>
                    <div class="form-group">
                        <label for="newApptEndTime">Hora Fin</label>
                        <input type="time" id="newApptEndTime" name="HoraFin" readonly aria-describedby="appointmentDurationHint" />
                        <span id="appointmentDurationHint" class="form-hint">Calculada según la duración configurada.</span>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptPatient">Paciente</label>
                        <select id="newApptPatient" name="IdPaciente" required aria-required="true">
                            <option value="">Seleccione paciente...</option>
                            @foreach (var paciente in Model.Pacientes)
                            {
                                <option value="@paciente.Id">@paciente.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="newApptOffice">Consultorio</label>
                        <select id="newApptOffice" name="IdConsultorio" required aria-required="true">
                            <option value="">Seleccione consultorio</option>
                            @foreach (var consultorio in Model.Consultorios)
                            {
                                <option value="@consultorio.Id">@consultorio.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptService">Servicio (Motivo de Consulta)</label>
                        <select id="newApptService" name="IdServicio" required aria-required="true">
                            <option value="">Seleccione servicio</option>
                            @foreach (var servicio in Model.Servicios)
                            {
                                <option value="@servicio.Id">@servicio.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label for="newApptNotes">Observaciones</label>
                        <textarea id="newApptNotes" name="Notas" rows="2" placeholder="Detalles adicionales..." data-i18n-ph="citas.notes_ph"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" id="modalNewApptCancel">Cancelar</button>
                    <button type="submit" class="btn-primary" id="modalNewApptSave">Guardar Cita</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FAB nueva cita -->
<button class="fab" id="btnNewAppointment" aria-label="Crear nueva cita">
    <span class="material-symbols-outlined" aria-hidden="true">add</span>
</button>

<!-- Navegación móvil -->
<nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">dashboard</span>
        <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item active" aria-current="page">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">calendar_month</span>
        <span>Agenda</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="mobile-nav-item">
        <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">person</span>
        <span>Perfil</span>
    </a>
</nav>

<!-- Toast para notificaciones accesibles -->
<div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

<!-- Footer -->
<footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
        <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
</footer>

@section Scripts {
     <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
     <script src="~/js/shared/appointment-utils.js" asp-append-version="true" defer></script>
     <script src="~/js/Gestion_De_Citas/st-odo-02-agenda/agenda.js" asp-append-version="true" defer></script>
}
