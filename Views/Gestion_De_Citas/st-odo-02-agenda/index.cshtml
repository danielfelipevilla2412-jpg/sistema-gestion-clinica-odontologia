﻿﻿﻿@* ============================================
SmileTrack — Mi Agenda Odontólogo (st-odo-02-agenda)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista que permite al odontólogo ver sus citas programadas del día, filtrar por fecha e interactuar con el estado de cada cita (Iniciar atención, registrar inasistencia, etc.).

FUNCIONALIDADES PRINCIPALES:
- Visualización de agenda diaria y semanal estructurada por horas
- Acciones rápidas sobre citas en tiempo real (iniciar atención, ver historial parcial)
- Filtro interactivo de calendario para navegación rápida por días

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController y CitasOdontologo
- CSS: ~/css/Gestion_De_Citas/st-odo-02-agenda/agenda.css
- JS: ~/js/Gestion_De_Citas/st-odo-02-agenda/agenda.js
- Partial / Otros: Sidebar unificado

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Mi Agenda</title>
  <meta name="description" content="Gestiona y actualiza el estado de tus citas asignadas en SmileTrack." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-odo-02-agenda/agenda.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal, accesibilidad keyboard-first -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }


  <!-- Botón hamburguesa para menú mÓvil, con atributos ARIA -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ----- MAIN ----- -->
  <main class="main" id="main-content">

    <!-- Header con fecha dinámica accesible -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Odontólogo</span>
          <span class="bc-sep material-symbols-outlined" aria-hidden="true">chevron_right</span>
          <span class="bc-active">Mi Agenda</span>
        </nav>
        <h1 class="page-title">Mi Agenda</h1>
        <p class="page-subtitle">
          <time datetime="" id="headerDate" aria-live="polite">Cargando fecha\…</time> — Gestiona y actualiza el estado
          de tus citas asignadas
        </p>
      </div>
    </header>

    <!-- Stats Grid con aria-live para contadores -->
    <section class="stats-grid" aria-label="Resumen de citas">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statHoy" data-target="6" aria-live="polite">0</span>
        <span class="stat-label">Citas hoy</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statAtendidas" data-target="2" aria-live="polite">0</span>
        <span class="stat-label">Atendidas</span>
        <span class="stat-sub">4</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statPendientes" data-target="3" aria-live="polite">0</span>
        <span class="stat-label">Pendientes</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="statMes" data-target="30" aria-live="polite">0</span>
        <span class="stat-label">Pendientes en el mes</span>
      </div>
    </section>

    <!-- Sección de agenda -->
    <section class="agenda-section" aria-labelledby="agendaTitle">
      <h2 class="visually-hidden" id="agendaTitle">Lista de citas</h2>

      <!-- Barra de progreso accesible con ARIA -->
      <div class="progress-row">
        <div class="progress-bar-wrap" role="progressbar" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"
          aria-label="Progreso del día: 33% completado">
          <div class="progress-bar" id="progressBar" style="width:33%"></div>
        </div>
        <span class="progress-label" id="progressLabel" aria-live="polite">2 de 6 citas completadas hoy</span>
      </div>

      <!-- Navegación de semana con accesibilidad -->
      <div class="week-nav">
        <button class="btn-week" id="btnPrev" aria-label="Ir a semana anterior"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span> Anterior</button>
        <span class="week-title" id="weekTitle" aria-live="polite">Semana 20-25 de marzo 2026</span>
        <button class="btn-week" id="btnNext" aria-label="Ir a siguiente semana">Siguiente <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button>
        <div class="status-dropdown-wrap">
          <label for="globalStatus" class="visually-hidden">Cambiar estado de todas las citas visibles</label>
          <select id="globalStatus" class="status-select" aria-label="Cambiar estado masivo de citas">
            <option value="">Cambiar estado</option>
            <option value="Atendida">Atendida</option>
            <option value="En consulta">En consulta</option>
            <option value="Agendada">Agendada</option>
            <option value="No asistiÓ">No asistiÓ</option>
            <option value="Cancelada">Cancelada</option>
          </select>
        </div>
      </div>

      <!-- Tabla de citas con estructura accesible -->
      <div class="table-wrap">
        <table id="agendaTable" class="table-base" aria-label="Tabla de citas de la semana">
          <thead>
            <tr>
              <th scope="col">FECHA</th>
              <th scope="col">HORA</th>
              <th scope="col">PACIENTE</th>
              <th scope="col">SERVICIO</th>
              <th scope="col">DURACIÓN</th>
              <th scope="col">ESTADO</th>
              <th scope="col">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="agendaTbody" aria-live="polite">
            <!-- Filas inyectadas por agenda.js -->
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <!-- Modal de detalle de cita accesible -->
  <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar ventana de detalle">—</button>
      <h2 class="modal-title" id="modalTitle">Detalle de Cita</h2>
      <div id="modalContent" role="document"></div>
    </div>
  </div>

  <!-- Mobile bottom nav con aria-label -->
  <nav class="mobile-nav" aria-label="Navegación mÓvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon material-symbols-outlined" aria-hidden="true">dashboard</span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon material-symbols-outlined" aria-hidden="true">calendar_month</span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="mobile-nav-item">
      <span class="mobile-nav-icon material-symbols-outlined" aria-hidden="true">person</span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast para notificaciones accesibles -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" style="font-size:1rem;" aria-hidden="true">copyright</span>
      <p>— 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-odo-02-agenda/agenda.js")"></script>

  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
    <script src="@Url.Content("~/js/shared/validation-utils.js")"></script>
    <script src="@Url.Content("~/js/shared/appointment-utils.js")"></script>
</body>

</html>

