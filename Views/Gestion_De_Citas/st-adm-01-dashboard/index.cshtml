@* ============================================
   SmileTrack — Dashboard de Citas (st-adm-01-dashboard)
   ============================================
   Autor: Johan Santamaria
   DESCRIPCIÓN: Vista principal del dashboard administrativo refinada.
============================================ *@
@model SmileTrack_MVC.Models.ViewModels.CitasDashboardViewModel
@using System.Globalization
@{ Layout = "_Layout"; ViewData["Title"] = "Dashboard de Citas"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Citas/st-adm-01-dashboard/styles.css" asp-append-version="true" />
}

<main class="main" id="main-content">
    <!-- ── Encabezado ─────────────────────────────────────────── -->
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="adm01_bc_aria">
                <span data-i18n="adm01_bc_admin">Administración</span>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" data-i18n="adm01_bc_active">Dashboard de citas</span>
            </nav>
            <h1 class="page-title" data-i18n="adm01_title">Dashboard de citas</h1>
            <p class="page-subtitle" data-i18n="adm01_subtitle">Resumen operativo del centro odontológico</p>
        </div>

        <button class="btn-primary" id="btnExport" type="button" aria-label="Exportar dashboard en PDF" data-i18n-aria-label="adm01_export_pdf_aria">
            <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
            <span class="btn-export-text" data-i18n="adm01_export_pdf_btn">Exportar PDF</span>
        </button>
    </header>

    @* ── Mensaje de error (si el servicio falló) ─────── *@
    @if (TempData["ErrorValidacion"] is string errorMsg)
    {
        <div role="alert" class="dashboard-error-banner">
            <span class="material-symbols-outlined" aria-hidden="true">warning</span>
            @Html.Encode(errorMsg)
        </div>
    }

    <!-- ── KPIs principales ────────────────────────────────────── -->
    <section class="stats-grid" aria-label="Indicadores principales del mes">
        <article class="stat-card" data-color="blue">
            <span class="stat-number" id="statPacientes" data-target="@Model.Kpis.PacientesActivos" aria-live="polite">
                @Model.Kpis.PacientesActivos
            </span>
            <span class="stat-label" data-i18n="adm01_stat_pacientes">Pacientes activos</span>
            <span class="stat-sub" data-i18n="adm01_stat_pacientes_sub">Total registrados</span>
        </article>

        <article class="stat-card" data-color="green">
            <span class="stat-number" id="statCitasHoy" data-target="@Model.Kpis.CitasHoy" aria-live="polite">
                @Model.Kpis.CitasHoy
            </span>
            <span class="stat-label" data-i18n="adm01_stat_citas_hoy">Citas hoy</span>
            <span class="stat-sub" data-i18n="adm01_stat_citas_hoy_sub">No canceladas</span>
        </article>

        <article class="stat-card" data-color="orange">
            <span class="stat-number" id="statProfesionales" data-target="@Model.Kpis.ProfesionalesActivos" aria-live="polite">
                @Model.Kpis.ProfesionalesActivos
            </span>
            <span class="stat-label" data-i18n="adm01_stat_profesionales">Profesionales activos</span>
            <span class="stat-sub" data-i18n="adm01_stat_profesionales_sub">En servicio</span>
        </article>

        <article class="stat-card" data-color="purple">
            <span class="stat-number currency" id="statIncome"
                  data-target="@Model.Kpis.ValorEstimadoAtendidoMes.ToString("F0", CultureInfo.InvariantCulture)" aria-live="polite">
                @Model.Kpis.ValorEstimadoAtendidoMes.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))
            </span>
            <span class="stat-label" data-i18n="adm01_stat_valor_atendido">Valor atendido</span>
            <span class="stat-sub" data-i18n="adm01_stat_valor_atendido_sub">Estimado según servicios</span>
        </article>
    </section>

    <!-- ── Barra de ocupación ──────────────────────────────────── -->
    <section class="progress-row" role="region" aria-label="Ocupación de agenda mensual" data-i18n-aria-label="adm01_occupancy_aria">
        <div>
            <h2 class="page-title" style="font-size: 1rem; margin-bottom: 4px;" data-i18n="adm01_occupancy_title">Ocupación de agenda</h2>
            <p class="page-subtitle" style="margin:0;" data-i18n="adm01_occupancy_sub">Capacidad disponible este mes</p>
        </div>
        <div class="progress-bar-wrap"
             role="progressbar"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-valuenow="@Model.OcupacionPorcentaje"
             aria-label="@($"Ocupación: {Model.OcupacionPorcentaje}%")">
            <div class="progress-bar" id="dashboardOccupancyBar" data-width="@Model.OcupacionPorcentaje"></div>
        </div>
        <span class="progress-label">@Model.OcupacionPorcentaje%</span>
    </section>

    <!-- ── Distribución por estado ─────────────────────────────── -->
    <h2 class="dashboard-section-title" data-i18n="adm01_distribution_title">Distribución por estado — mes actual</h2>

    <section class="stats-grid" aria-label="Estados de las citas del mes" data-i18n-aria-label="adm01_distribution_aria">
        <article class="stat-card" data-color="green">
            <span class="stat-number" data-target="@Model.Estados.Atendidas" aria-live="polite">@Model.Estados.Atendidas</span>
            <span class="stat-label" data-i18n="adm01_dist_attended">Atendidas</span>
            <span class="stat-sub" data-i18n-html="adm01_dist_attended_sub">
                @{ var variacion = Model.Kpis.VariacionCitasSemana; }
                <span aria-hidden="true">@(variacion >= 0 ? "↑" : "↓")</span>
                <span class="visually-hidden">@(variacion >= 0 ? "Aumentó" : "Disminuyó")</span>
                @Math.Abs(variacion) vs semana anterior
            </span>
        </article>

        <article class="stat-card" data-color="blue">
            <span class="stat-number" data-target="@Model.Estados.Confirmadas" aria-live="polite">@Model.Estados.Confirmadas</span>
            <span class="stat-label" data-i18n="adm01_dist_confirmed">Confirmadas</span>
            <span class="stat-sub">@Model.Estados.PorcentajeConfirmadas% <span data-i18n="adm01_dist_of_total">del total</span></span>
        </article>

        <article class="stat-card" data-color="orange">
            <span class="stat-number" data-target="@Model.Estados.Programadas" aria-live="polite">@Model.Estados.Programadas</span>
            <span class="stat-label" data-i18n="adm01_dist_scheduled">Programadas</span>
            <span class="stat-sub">@Model.Estados.PorcentajeProgramadas% <span data-i18n="adm01_dist_of_total">del total</span></span>
        </article>

        <article class="stat-card" data-color="red">
            <span class="stat-number" data-target="@Model.Estados.Canceladas" aria-live="polite">@Model.Estados.Canceladas</span>
            <span class="stat-label" data-i18n="adm01_dist_cancelled">Canceladas</span>
            <span class="stat-sub">@Model.Estados.PorcentajeCanceladas% <span data-i18n="adm01_dist_of_total">del total</span></span>
        </article>
    </section>

    <!-- ── Contenido principal ─────────────────────────────────── -->
    <section class="content-grid" aria-label="Contenido principal del dashboard">
        <div class="content-left">
            <section class="card" aria-labelledby="topProfessionalsTitle">
                <h2 class="card-title" id="topProfessionalsTitle" data-i18n="adm01_top_prof_title">Top 3 profesionales del mes</h2>
                <div class="table-wrap">
                    <table class="table-base" aria-label="Ranking de profesionales por citas" data-i18n-aria-label="adm01_top_prof_table_aria">
                        <caption class="visually-hidden" data-i18n="adm01_top_prof_caption">Los tres profesionales con más citas atendidas este mes</caption>
                        <thead>
                            <tr>
                                <th scope="col" data-i18n="adm01_th_professional">Profesional</th>
                                <th scope="col" data-i18n="adm01_th_specialty">Especialidad</th>
                                <th scope="col" data-i18n="adm01_th_total_appointments">Total citas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopProfesionales.Count > 0)
                            {
                                foreach (var prof in Model.TopProfesionales)
                                {
                                    <tr>
                                        <td>@prof.Nombre</td>
                                        <td><span class="badge-spec">@prof.Especialidad</span></td>
                                        <td class="td-strong">@prof.TotalCitas</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="empty-state" data-i18n="adm01_top_prof_empty">No hay datos suficientes para generar el ranking.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="content-right" aria-label="Acciones rápidas" data-i18n-aria-label="adm01_quick_aria">
            <section class="card" aria-labelledby="quickActionsTitle">
                <h2 class="card-title" id="quickActionsTitle" data-i18n="adm01_quick_title">Acciones rápidas</h2>
                <div class="quick-actions">
                    <a href="/gestion-de-citas/st-adm-08-agenda" class="btn-primary" aria-label="Ir a la agenda general" data-i18n-aria-label="adm01_quick_open_agenda_aria">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                        <span data-i18n="adm01_quick_open_agenda">Abrir agenda</span>
                    </a>
                    <a href="/gestion-de-citas/st-adm-09-citas" class="btn-secondary" aria-label="Ir a gestión de citas" data-i18n-aria-label="adm01_quick_manage_aria">
                        <span class="material-symbols-outlined" aria-hidden="true">event_note</span>
                        <span data-i18n="adm01_quick_manage">Gestión de citas</span>
                    </a>
                </div>
            </section>

            <section class="card" aria-labelledby="systemNotesTitle">
                <h2 class="card-title" id="systemNotesTitle" data-i18n="adm01_notes_title">Notas del sistema</h2>
                <p class="system-note" data-i18n="adm01_notes_text">
                    Las métricas corresponden al período mensual actual. Para crear, modificar o verificar disponibilidad, utilice la agenda general.
                </p>
            </section>
        </aside>
    </section>
</main>

<!-- ── Navegación móvil ────────────────────────────────────── -->
<nav class="mobile-nav" aria-label="Navegación móvil" data-i18n-aria-label="adm01_mobile_nav_aria">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item active" aria-current="page">
        <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></span>
        <span data-i18n="adm01_mobile_dashboard">Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
        <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></span>
        <span data-i18n="adm01_mobile_agenda">Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-adm-09-citas" class="mobile-nav-item">
        <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">event_note</span></span>
        <span data-i18n="adm01_mobile_citas">Citas</span>
    </a>
</nav>

<!-- ── Footer ──────────────────────────────────────────────── -->
<footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div class="footer-content">
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size: 16px;">copyright</span>
        <p data-i18n="footer_copyright">© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub" data-i18n="footer_project">Proyecto Formativo ADSO — SENA</p>
</footer>

@section Scripts {
    <script src="~/js/Gestion_De_Citas/st-adm-01-dashboard/app.js" asp-append-version="true" defer></script>
}
