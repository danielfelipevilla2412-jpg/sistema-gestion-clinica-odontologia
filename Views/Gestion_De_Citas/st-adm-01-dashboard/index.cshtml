@* ============================================
SmileTrack — Dashboard General Administrativo (st-adm-01-dashboard)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista principal del dashboard administrativo para el módulo de citas.
Incluye KPIs, gráficos de ocupación, top profesionales y acceso al panel de gestión.

DEPENDENCIAS TÉCNICAS:
- Controller: GestionCitasController → Stadm01Dashboard
- CSS: ~/css/Gestion_De_Citas/st-adm-01-dashboard/styles.css
- JS: ~/js/Gestion_De_Citas/st-adm-01-dashboard/app.js
- Partial / Otros: _SidebarAdmin.cshtml
============================================ *@
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Dashboard administrativo de SmileTrack para gestión de citas, métricas y seguimiento." />
    <title>SmileTrack — Dashboard General</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-adm-01-dashboard/styles.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>
<body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    @{ await Html.RenderPartialAsync("_SidebarAdmin"); }

    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </button>
    <div class="overlay" id="overlay" aria-hidden="true"></div>

    <main class="main" id="main-content">
        <header class="page-header">
            <div class="header-left">
                <nav class="breadcrumb" aria-label="Ruta de navegación">
                    <span>Administración</span>
                    <span class="bc-sep" aria-hidden="true">›</span>
                    <span class="bc-active">Dashboard General</span>
                </nav>
                <h1 class="page-title">Dashboard General</h1>
                <p class="page-subtitle">Resumen operativo y métricas clave del centro odontológico</p>
            </div>
            <button class="btn-primary" id="btnExport" aria-label="Exportar reporte en PDF">📄 Exportar PDF</button>
        </header>

        <section class="stats-grid" aria-label="Métricas principales">
            <div class="stat-card" data-color="blue">
                <span class="stat-number" id="statTotal" data-target="@(ViewData["TotalPacientes"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label">Pacientes activos</span>
                <span class="stat-sub">Total registrados</span>
            </div>
            <div class="stat-card" data-color="green">
                <span class="stat-number" id="statScheduled" data-target="@(ViewData["CitasHoy"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label">Citas hoy</span>
                <span class="stat-sub">Programadas</span>
            </div>
            <div class="stat-card" data-color="orange">
                <span class="stat-number" id="statAttended" data-target="@(ViewData["ProfesionalesActivos"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label">Profesionales activos</span>
                <span class="stat-sub">En servicio</span>
            </div>
            <div class="stat-card" data-color="purple">
                <span class="stat-number" id="statIncome" data-target="@(ViewData["IngresosDelMes"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label">Ingresos del mes</span>
                <span class="stat-sub">Solo citas atendidas</span>
            </div>
        </section>

        <section class="progress-row" role="region" aria-label="Ocupación de agenda mensual">
            <div>
                <h2 class="section-title">Ocupación de agenda</h2>
                <p class="page-subtitle">Porcentaje estimado de citas utilizadas este mes</p>
            </div>
            <div class="progress-bar-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(ViewData["PctOcupacion"] ?? 0)" aria-label="Ocupación de agenda mensual">
                <div class="progress-bar" id="dashboardOccupancyBar" data-width="@(ViewData["PctOcupacion"] ?? 0)"></div>
            </div>
            <span class="progress-label">@(ViewData["PctOcupacion"] ?? 0)% de uso estimado</span>
        </section>

        <section class="stats-grid" aria-label="Distribución de estados de cita">
            <div class="stat-card" data-color="green">
                <span class="stat-number">@(ViewData["CitasAtendidas"] ?? 0)</span>
                <span class="stat-label">Atendidas</span>
                <span class="stat-sub">@((ViewData["PctAtendidas"] ?? 0) + "% de la categoría más frecuente")</span>
            </div>
            <div class="stat-card" data-color="blue">
                <span class="stat-number">@(ViewData["CitasConfirmadas"] ?? 0)</span>
                <span class="stat-label">Confirmadas</span>
                <span class="stat-sub">@((ViewData["PctConfirmadas"] ?? 0) + "% de la categoría más frecuente")</span>
            </div>
            <div class="stat-card" data-color="orange">
                <span class="stat-number">@(ViewData["CitasProgramadas"] ?? 0)</span>
                <span class="stat-label">Programadas</span>
                <span class="stat-sub">@((ViewData["PctProgramadas"] ?? 0) + "% de la categoría más frecuente")</span>
            </div>
            <div class="stat-card" data-color="red">
                <span class="stat-number">@(ViewData["CitasCanceladas"] ?? 0)</span>
                <span class="stat-label">Canceladas</span>
                <span class="stat-sub">@((ViewData["PctCanceladas"] ?? 0) + "% de la categoría más frecuente")</span>
            </div>
        </section>

        <section class="content-grid" aria-label="Contenido principal del dashboard">
            <div class="content-left">
                <section class="card" aria-labelledby="topProfessionalsTitle">
                    <h2 class="card-title" id="topProfessionalsTitle">Top 3 profesionales del mes</h2>
                    <div class="table-wrap">
                        <table class="table-base" aria-label="Top 3 profesionales por citas">
                            <thead>
                                <tr>
                                    <th scope="col">Profesional</th>
                                    <th scope="col">Especialidad</th>
                                    <th scope="col">Total citas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var topProfesionales = ViewData["TopProfesionales"] as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>(); }
                                @if (topProfesionales.Any())
                                {
                                    foreach (var prof in topProfesionales)
                                    {
                                        <tr>
                                            <td>@prof.Nombre</td>
                                            <td>@prof.Especialidad</td>
                                            <td>@prof.TotalCitas</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" style="text-align:center; color:var(--text-muted); padding:18px;">No hay datos suficientes para mostrar los top profesionales.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <aside class="content-right" aria-label="Información complementaria">
                <section class="card" aria-labelledby="quickActionsTitle">
                    <h2 class="card-title" id="quickActionsTitle">Acciones rápidas</h2>
                    <div class="quick-actions">
                        <a href="/gestion-de-citas/st-adm-09-citas" class="btn-primary" aria-label="Ir a la gestión integral de citas">Ver gestión de citas</a>
                        <a href="/gestion-de-citas/st-adm-08-agenda" class="btn-primary" aria-label="Ir a la agenda general">Abrir agenda</a>
                    </div>
                </section>
                <section class="card" aria-labelledby="notesTitle">
                    <h2 class="card-title" id="notesTitle">Notas del sistema</h2>
                    <p style="font-size:.95rem;color:var(--text-muted);line-height:1.5;">Este panel presenta métricas resumidas. Para modificar una cita o verificar disponibilidad, utiliza la agenda general o la gestión de citas.</p>
                </section>
            </aside>
        </section>
    </main>

    <script src="@Url.Content("~/js/Gestion_De_Citas/st-adm-01-dashboard/app.js")"></script>
    <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
    @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
</body>
</html>
