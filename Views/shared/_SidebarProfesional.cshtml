@{
    var rawPath = Context.Request.Path.Value ?? "/";
    var currentPath = rawPath.TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";

    Func<string, string> linkClass = href =>
    {
        var cleanHref = (href ?? "/").TrimEnd('/');
        if (string.IsNullOrEmpty(cleanHref)) cleanHref = "/";
        return currentPath.Equals(cleanHref, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    };
}
