    <a href="/acceso-y-seguridad/login" class="nav-item nav-item--logout" data-icon="🚪" aria-label="Cerrar sesión y volver al login">Cerrar sesión</a>
  </nav>

  <div class="sidebar-user">
    @{
      var _pName     = User.Identity?.Name ?? "Profesional";
      var _pEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "profesional@smiletrack.co";
      var _pInitials = string.Concat(_pName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
    }
    <div class="user-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(_pInitials) ? "PR" : _pInitials)</div>
    <div class="user-info">
      <span class="user-role">@_pName</span>
      <span class="user-email">@_pEmail</span>
    </div>
  </div>
