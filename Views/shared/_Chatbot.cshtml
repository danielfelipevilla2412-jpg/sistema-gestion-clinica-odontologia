@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var chatbotToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var chatbotName = User.Identity?.Name ?? "Usuario";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <link rel="stylesheet" href="~/css/shared/chatbot.css" asp-append-version="true" />
    <section class="chatbot" id="smiletrack-chatbot" data-chatbot-token="@chatbotToken" data-chatbot-path="@Context.Request.Path" aria-label="Asistente virtual de SmileTrack" data-i18n-aria-label="chatbot.aria_label">
        <button class="chatbot__launcher" type="button" aria-expanded="false" aria-controls="chatbot-panel" title="Abrir Centro de Ayuda" data-i18n-title="chatbot.open_title">
            <span class="material-symbols-outlined" aria-hidden="true">support_agent</span>
            <span class="chatbot__launcher-label" data-i18n="chatbot.launcher">Centro de Ayuda</span>
        </button>
        <div class="chatbot__panel" id="chatbot-panel" role="dialog" aria-modal="false" aria-labelledby="chatbot-title" aria-describedby="chatbot-notice" hidden>
            <header class="chatbot__header">
                <div class="chatbot__brand">
                    <div class="chatbot__avatar" aria-hidden="true">
                        <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="" />
                    </div>
                    <div>
                        <h2 id="chatbot-title" data-chatbot-title>Centro de Ayuda</h2>
                        <p class="chatbot__status"><span aria-hidden="true"></span> Ayuda disponible</p>
                        <p class="chatbot__role" data-chatbot-role>Ayuda para @chatbotName</p>
                    </div>
                </div>
                <div class="chatbot__header-actions">
                    <button class="chatbot__reset" type="button" aria-label="Iniciar una nueva conversación">Nueva conversación</button>
                    <button class="chatbot__close" type="button" aria-label="Cerrar asistente" data-i18n-aria-label="chatbot.close">&times;</button>
                </div>
            </header>
            <div class="chatbot__messages" data-chatbot-messages aria-label="Conversación de ayuda" aria-live="polite" aria-relevant="additions text"></div>
            <div class="chatbot__suggestions" data-chatbot-suggestions></div>
            <form class="chatbot__form" data-chatbot-form>
                <label class="sr-only" for="chatbot-message">Escribe tu consulta al Centro de Ayuda</label>
                    <input id="chatbot-message" name="message" type="text" maxlength="500" autocomplete="off" placeholder="Busca una guía o describe tu problema" data-i18n-placeholder="chatbot.placeholder" />
                <button type="submit" aria-label="Enviar consulta" data-i18n-aria-label="chatbot.send"><span class="material-symbols-outlined" aria-hidden="true">send</span></button>
            </form>
            <p class="chatbot__notice" id="chatbot-notice" data-i18n="chatbot.notice">No compartas contraseñas ni datos clínicos innecesarios. Puedes crear un ticket desde aquí.</p>
        </div>
    </section>
    <script src="~/js/shared/chatbot.js" asp-append-version="true"></script>
}