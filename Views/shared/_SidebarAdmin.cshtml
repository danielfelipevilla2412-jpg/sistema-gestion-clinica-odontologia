        class="lang-btn" aria-label="Español" data-i18n-aria-label="sidebar_lang_es">ES</button>
      <button type="button" data-i18n-switcher data-i18n-lang="en"
        class="lang-btn" aria-label="English" data-i18n-aria-label="sidebar_lang_en">EN</button>
