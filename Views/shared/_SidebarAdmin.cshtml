@*
  SmileTrack — Sidebar Admin (_SidebarAdmin.cshtml)
  Partial reutilizable para el rol Administrador.
  Incluye: <aside> completo, logo, nav con grupos colapsables y bloque de usuario.
*@
@{
    var rawPath = Context.Request.Path.Value ?? "/";
    var currentPath = rawPath.TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";

    Func<string, string> linkClass = href =>
    {
        var cleanHref = (href ?? "/").TrimEnd('/');
        if (string.IsNullOrEmpty(cleanHref)) cleanHref = "/";
        return currentPath.Equals(cleanHref, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    };

    var _aName     = User.Identity?.Name ?? "Administrador";
    var _aEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "admin@smiletrack.co";
    var _aInitials = string.Concat(
        _aName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
              .Take(2)
              .Select(s => s[0])
    ).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(_aInitials)) _aInitials = "AD";
}

<aside class="sidebar" id="sidebar" aria-label="Navegación principal" data-i18n-aria-label="sidebar_main_nav">

  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>

  <nav class="sidebar-nav">
    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_inicio">
        Inicio <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/" class="@linkClass("/")" data-icon="🏠" data-i18n="nav.item_homepage">Homepage</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_reportes_analitica">
        Reportes y Analítica <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/reportes" class="@linkClass("/reportes")" data-icon="📊" data-i18n="nav.item_panel_analitica">Panel de Analítica</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_acceso_seguridad">
        Acceso y Seguridad <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/acceso-y-seguridad/st-adm-02-gestion-usuarios"
           class="@linkClass("/acceso-y-seguridad/st-adm-02-gestion-usuarios")"
           data-icon="👥" data-i18n="nav.item_gestion_usuarios">Gestión de Usuarios</a>
        <a href="/acceso-y-seguridad/st-adm-03-gestion-roles"
           class="@linkClass("/acceso-y-seguridad/st-adm-03-gestion-roles")"
           data-icon="🛡️" data-i18n="nav.item_gestion_roles">Gestión de Roles</a>
        <a href="/acceso-y-seguridad/st-adm-15-bitacora"
           class="@linkClass("/acceso-y-seguridad/st-adm-15-bitacora")"
           data-icon="📜" data-i18n="nav.item_bitacora_sistema">Bitácora del Sistema</a>
        <a href="/acceso-y-seguridad/cambiar-contrasena"
           class="@linkClass("/acceso-y-seguridad/cambiar-contrasena")"
           data-icon="🔐" data-i18n="nav.item_cambiar_contrasena">Cambiar Contraseña</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_gestion_pacientes">
        Gestión de Pacientes <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
