@*
  SmileTrack — Sidebar Auxiliar (_SidebarAuxiliar.cshtml)
  Partial reutilizable para el rol Auxiliar/Asistente Dental.
  Incluye: <aside> completo, logo, nav con grupos colapsables y bloque de usuario.
*@
@{
    var rawPath = Context.Request.Path.Value ?? "/";
    var currentPath = rawPath.TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";

    Func<string, string> linkClass = href =>
    {
        var cleanHref = (href ?? "/").TrimEnd('/');
        if (string.IsNullOrEmpty(cleanHref)) cleanHref = "/";

        bool isMatch = currentPath.Equals(cleanHref, StringComparison.OrdinalIgnoreCase)
            || (cleanHref.Contains("st-aux-01-panel-operativo") && currentPath.Contains("st-aux-01-panel-operativo"));

        return isMatch ? "nav-item active" : "nav-item";
    };

    var _auxName     = User.Identity?.Name ?? "Auxiliar";
    var _auxEmail    = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "auxiliar@smiletrack.co";
    var _auxInitials = string.Concat(
        _auxName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(s => s[0])
    ).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(_auxInitials)) _auxInitials = "AU";
}

<aside class="sidebar" id="sidebar" aria-label="Navegación principal" data-i18n-aria-label="sidebar_main_nav">

  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>

  <nav class="sidebar-nav">
    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_inicio">
        Inicio <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/" class="@linkClass("/")" data-icon="🏠" data-i18n="nav.item_homepage">Homepage</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_gestion_citas">
        Gestión de Citas <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo"
           class="@linkClass("/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo")"
           data-icon="📊" data-i18n="nav.item_panel_auxiliar">Panel Auxiliar</a>
        <a href="/gestion-de-citas/st-aux-02-agenda-apoyo"
           class="@linkClass("/gestion-de-citas/st-aux-02-agenda-apoyo")"
           data-icon="📅" data-i18n="nav.item_agenda_apoyo">Agenda de Apoyo</a>
        <a href="/gestion-de-citas/st-aux-10-citas-finalizadas"
           class="@linkClass("/gestion-de-citas/st-aux-10-citas-finalizadas")"
           data-icon="✅" data-i18n="nav.item_citas_finalizadas">Citas Finalizadas</a>
        <div class="nav-subsection-label" aria-hidden="true" data-i18n="sidebar_durante_atencion">Durante la atención</div>
        <a href="/gestion-de-citas/st-aux-06-asistencia-procedi"
           class="@linkClass("/gestion-de-citas/st-aux-06-asistencia-procedi")"
           data-icon="🦷" data-i18n="nav.item_asistencia_procedimiento">Asistencia en Procedimiento</a>
        <a href="/gestion-de-citas/st-aux-09-estado-consultorio"
           class="@linkClass("/gestion-de-citas/st-aux-09-estado-consultorio")"
           data-icon="🏥" data-i18n="nav.item_estado_consultorio">Estado del Consultorio</a>
        <a href="/gestion-de-citas/st-aux-05-historial-parcial"
           class="@linkClass("/gestion-de-citas/st-aux-05-historial-parcial")"
           data-icon="📋" data-i18n="nav.item_historial_paciente">Historial del Paciente</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_gestion_pacientes">
        Gestión de Pacientes <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/gestion-de-pacientes/st-aux-03-preparacion-consulta"
           class="@linkClass("/gestion-de-pacientes/st-aux-03-preparacion-consulta")"
           data-icon="🧪" data-i18n="nav.item_preparacion_consulta">Preparación de Consulta</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_gestion_pqr">
        Gestión de PQR <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/gestion-de-pqr/st-pac-04-nueva-pqr"
           class="@linkClass("/gestion-de-pqr/st-pac-04-nueva-pqr")"
           data-icon="📝" data-i18n="nav.item_nueva_solicitud">Nueva Solicitud</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_gestion_ayuda">
        Gestión de Ayuda <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/centro-de-ayuda/guias-tutoriales"
           class="@linkClass("/centro-de-ayuda/guias-tutoriales")"
           data-icon="❓" data-i18n="nav.item_centro_ayuda">Centro de Ayuda</a>
        <a href="/gestion-de-pqr/st-pac-04-nueva-pqr"
           class="@linkClass("/gestion-de-pqr/st-pac-04-nueva-pqr")"
           data-icon="📝" data-i18n="nav.item_nueva_solicitud">Nueva Solicitud</a>
      </div>
    </div>

    <div class="nav-group">
      <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="nav.group_perfil">
        Perfil <span class="nav-arrow" aria-hidden="true">▼</span>
      </div>
      <div class="nav-group-items">
        <a href="/perfiles/st-aux-11-perfil-auxiliar"
           class="@linkClass("/perfiles/st-aux-11-perfil-auxiliar")"
           data-icon="👤" data-i18n="nav.item_mi_perfil">Mi Perfil</a>
        <a href="/acceso-y-seguridad/cambiar-contrasena"
           class="@linkClass("/acceso-y-seguridad/cambiar-contrasena")"
           data-icon="🔐" data-i18n="nav.item_cambiar_contrasena">Cambiar Contraseña</a>
      </div>
    </div>

    <div class="nav-separator" aria-hidden="true"></div>

    <a href="/acceso-y-seguridad/login"
       class="nav-item nav-item--logout"
       data-icon="🚪"
       aria-label="Cerrar sesión y volver al login"
       data-i18n-aria-label="sidebar_logout_aria"
       data-i18n="sidebar_logout_text">Cerrar sesión</a>
  </nav>

  <div class="sidebar-user">
    <div class="user-avatar" aria-hidden="true">@_auxInitials</div>
    <div class="user-info">
      <span class="user-role">@_auxName</span>
      <span class="user-email">@_auxEmail</span>
    </div>
    <div class="sidebar-lang" aria-label="Cambiar idioma" data-i18n-aria-label="sidebar_change_language">
      <button type="button" data-i18n-switcher data-i18n-lang="es" class="lang-btn" aria-label="Español" data-i18n-aria-label="sidebar_lang_es">ES</button>
      <button type="button" data-i18n-switcher data-i18n-lang="en" class="lang-btn" aria-label="English" data-i18n-aria-label="sidebar_lang_en">EN</button>
    </div>
  </div>

</aside>

<style>
  .nav-subsection-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted, #94a3b8);
    padding: 10px 16px 2px;
    margin-top: 4px;
    border-top: 1px solid var(--border, #e2e8f0);
    pointer-events: none;
    user-select: none;
  }
</style>
