@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Módulos</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f7fb; color: #10243f; }
    .wrap { max-width: 980px; margin: 0 auto; padding: 48px 20px; }
    .card { background: white; border-radius: 16px; padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
    .item { padding: 18px; border: 1px solid #e5eaf2; border-radius: 12px; text-decoration: none; color: inherit; }
    .item:hover { border-color: #3b82f6; transform: translateY(-2px); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Panel de módulos</h1>
      <p>Accede a las pantallas principales del sistema.</p>
      <div class="grid">
        <a class="item" href="/acceso-y-seguridad/login">Acceso y seguridad</a>
        <a class="item" href="/gestion-de-citas/st-adm-01-dashboard">Gestión de citas</a>
        <a class="item" href="/gestion-de-pacientes/st-adm-05-gestion-pacientes">Gestión de pacientes</a>
        <a class="item" href="/gestion-de-profesionales/st-odo-01-dashboard">Gestión de profesionales</a>
        <a class="item" href="/facturacion-y-pagos/st-adm-12-facturacion">Facturación y pagos</a>
        <a class="item" href="/servicios-y-recursos/st-adm-10-servicios">Servicios y recursos</a>
        <a class="item" href="/reportes">Reportes y analítica</a>
      </div>
    </div>
  </div>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>
</html>