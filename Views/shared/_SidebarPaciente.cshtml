@{
    var _pNombre  = User.Identity?.Name ?? "Paciente";
    var _pEmail   = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "paciente@smiletrack.co";

    var _partes   = _pNombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var _iniciales = _partes.Length >= 2
    ? $"{_partes[0][0]}{_partes[^1][0]}".ToUpper()
    : (_pNombre.Length >= 2 ? _pNombre[..2].ToUpper() : _pNombre.ToUpper());
    var rawPath = Context.Request.Path.Value ?? "/";
    var currentPath = rawPath.TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath)) currentPath = "/";

    string linkState(string href)
    {
        var cleanHref = (href ?? "/").TrimEnd('/');
        if (string.IsNullOrEmpty(cleanHref)) cleanHref = "/";
        return currentPath.Equals(cleanHref, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";
    }

    string groupKey(string title) => title switch
    {
        "Inicio" => "nav.group_inicio",
        "Mis citas" => "nav.group_gestion_citas",
        "Mi historial" => "nav.group_historia_clinica",
        "PQR" => "nav.group_gestion_pqr",
        "Gestión de Ayuda" => "nav.group_centro_ayuda",
        "Mi perfil" => "profile.title",
        _ => "common.info"
    };

    string itemKey(string label) => label switch
    {
        "Inicio" => "nav.item_homepage",
        "Mis citas" => "citas.title",
        "Notificaciones" => "common.notifications",
        "Mi historial" => "historia.title",
        "Nueva Solicitud" => "pqr.new",
        "Centro de Ayuda" => "help.title",
        "Mi perfil" => "profile.title",
        "Cambiar Contraseña" => "common.password",
        _ => "common.info"
    };

    var groups = new[]
    {
        new
        {
            Title = "Inicio",
            Items = new[]
            {
                new { Label = "Inicio", Href = "/", Icon = "🏠" }
            }
        },
        new
        {
            Title = "Mis citas",
            Items = new[]
            {
                new { Label = "Mis citas", Href = "/gestion-de-citas/st-pac-01-mis-citas", Icon = "📅" },
                new { Label = "Notificaciones", Href = "/gestion-de-citas/st-pac-03-notificaciones", Icon = "🔔" }
            }
        },
        new
        {
            Title = "Mi historial",
            Items = new[]
            {
                new { Label = "Mi historial", Href = "/historia-clinica/st-pac-02-historial", Icon = "📋" }
            }
        },
        new
        {
            Title = "PQR",
            Items = new[]
            {
                new { Label = "Nueva Solicitud", Href = "/gestion-de-pqr/st-pac-04-nueva-pqr", Icon = "📮" }
            }
        },
        new
        {
            Title = "Gestión de Ayuda",
            Items = new[]
            {
                new { Label = "Centro de Ayuda", Href = "/centro-de-ayuda/guias-tutoriales", Icon = "❓" },
                new { Label = "Nueva Solicitud", Href = "/gestion-de-pqr/st-pac-04-nueva-pqr", Icon = "📝" }
            }
        },
        new
        {
            Title = "Mi perfil",
            Items = new[]
            {
                new { Label = "Mi perfil", Href = "/perfiles/st-pac-perfil-paciente", Icon = "👤" },
                new { Label = "Cambiar Contraseña", Href = "/acceso-y-seguridad/cambiar-contrasena", Icon = "🔐" }
            }
        }
    };
}

<aside class="sidebar" id="sidebar" aria-label="Navegación principal" data-i18n-aria-label="sidebar_main_nav">
    <div class="sidebar-logo">
        <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
    </div>

    <nav class="sidebar-nav">
        @foreach (var group in groups)
        {
            <div class="nav-group">
                <div class="nav-group-header" role="button" tabindex="0" aria-expanded="false" data-i18n="@groupKey(group.Title)">
                    @group.Title
                    <span class="nav-arrow" aria-hidden="true">▼</span>
                </div>

                <div class="nav-group-items">
                    @foreach (var item in group.Items)
                    {
                        <a href="@item.Href"
                           class="@linkState(item.Href)"
                           data-icon="@item.Icon" data-i18n="@itemKey(item.Label)">
                            @item.Label
                        </a>
                    }
                </div>
            </div>
        }

        <div class="nav-separator" aria-hidden="true"></div>

        <a href="/acceso-y-seguridad/login"
           class="nav-item nav-item--logout"
           data-icon="🚪"
           aria-label="Cerrar sesión y volver al login" data-i18n-aria-label="sidebar_logout_aria" data-i18n="sidebar_logout_text">
            Cerrar sesión
        </a>
    </nav>

    <div class="sidebar-user">
        <div class="user-avatar">@_iniciales</div>
        <span class="user-role">@_pNombre</span>
        <span class="user-email">@_pEmail</span>
        <div class="sidebar-lang" aria-label="Cambiar idioma">
            <button type="button" data-i18n-switcher data-i18n-lang="es" class="lang-btn" aria-label="Español">ES</button>
            <button type="button" data-i18n-switcher data-i18n-lang="en" class="lang-btn" aria-label="English">EN</button>
        </div>
    </div>
</aside>
