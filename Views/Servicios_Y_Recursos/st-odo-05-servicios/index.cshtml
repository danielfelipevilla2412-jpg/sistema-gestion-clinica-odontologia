@model IEnumerable<SmileTrack_MVC.Models.Entities.ProfesionalServicio>
@using System.Globalization
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis servicios";
    ViewData["Description"] = "Consulta los procedimientos asignados a tu perfil profesional.";
    ViewData["UseGestionModulesDesignSystem"] = true;

    var items = Model?.Where(x => x.Servicio != null).ToList() ?? new();
    var disponibles = items.Count(x => x.Activo && x.Servicio!.Estado == "activo");
    var nombreProfesional = ViewData["NombreProfesional"] as string;
    var cop = CultureInfo.GetCultureInfo("es-CO");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Servicios_Y_Recursos/st-odo-05-servicios/servicios.css" asp-append-version="true" />
}

<main id="main-content" class="main catalog-main professional-services">
  <header class="catalog-header page-header">
    <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="odo05.breadcrumb_aria">
      <span data-i18n="common_role_profesional">Odontólogo</span>
      <span class="bc-sep" aria-hidden="true">›</span>
      <span data-i18n="odo05.section_title">Servicios y Recursos</span>
      <span class="bc-sep" aria-hidden="true">›</span>
      <strong class="bc-active" data-i18n="odo05.title">Mis servicios</strong>
    </nav>
    <div class="header-line">
      <div>
        <h1 class="page-title" data-i18n="odo05.title">Mis servicios</h1>
        <p class="page-subtitle" data-i18n="odo05.subtitle">Consulta los procedimientos asignados a tu perfil profesional.</p>
      </div>
      @if (!string.IsNullOrWhiteSpace(nombreProfesional))
      {
        <div class="professional-name">@nombreProfesional</div>
      }
      else
      {
        <div class="professional-name" data-i18n="odo05.professional_profile">Perfil profesional</div>
      }
    </div>
  </header>

  <section class="stats-grid" aria-label="Resumen de servicios" data-i18n-aria-label="odo05.stats_aria">
    <div class="stat-card" data-color="blue">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">inventory_2</span>
      <strong class="stat-number" data-target="@items.Count">@items.Count</strong>
      <span class="stat-label" data-i18n="odo05.assigned_services">Servicios asignados</span>
    </div>
    <div class="stat-card" data-color="green">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">task_alt</span>
      <strong class="stat-number" data-target="@disponibles">@disponibles</strong>
      <span class="stat-label" data-i18n="odo05.available">Disponibles</span>
    </div>
    <div class="stat-card" data-color="orange">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">event_busy</span>
      <strong class="stat-number" data-target="@(items.Count - disponibles)">@(items.Count - disponibles)</strong>
      <span class="stat-label" data-i18n="odo05.unavailable">No disponibles</span>
    </div>
  </section>

  <section class="catalog-panel" aria-label="Catálogo de servicios" data-i18n-aria-label="odo05.panel_aria">
    <div class="section-title">
      <div>
        <h2 data-i18n="odo05.catalog_title">Catálogo profesional</h2>
        <p data-i18n="odo05.catalog_desc">Explora los detalles de los servicios que tienes asignados.</p>
      </div>
    </div>
    <div class="filters-row">
      <label class="search-wrap">
        <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
        <input id="buscarServicio" class="search-input" type="search" placeholder="Buscar servicio o descripción..." aria-label="Buscar servicios" data-i18n-ph="odo05.search_placeholder" data-i18n-aria-label="odo05.search_aria" />
      </label>
      <label class="filter-group">
        <span class="filter-label" data-i18n="odo05.specialty_label">Especialidad</span>
        <select id="filtroEspecialidad" class="filter-select" aria-label="Filtrar por especialidad" data-i18n-aria-label="odo05.specialty_aria">
          <option value="" data-i18n="odo05.all_specialties">Todas</option>
          @foreach (var esp in items.Select(x => x.Servicio?.Especialidad?.Nombre).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x))
          {
            <option value="@esp">@esp</option>
          }
          @if (items.Any(x => string.IsNullOrWhiteSpace(x.Servicio?.Especialidad?.Nombre)))
          {
            <option value="__none__" data-i18n="odo05.no_specialty">Sin especialidad</option>
          }
        </select>
      </label>
      <label class="filter-group">
        <span class="filter-label" data-i18n="odo05.status_label">Estado</span>
        <select id="filtroEstado" class="filter-select" aria-label="Filtrar por estado" data-i18n-aria-label="odo05.status_aria">
          <option value="" data-i18n="odo05.all_statuses">Todos</option>
          <option value="activo" data-i18n="odo05.status_available">Disponible</option>
          <option value="inactivo" data-i18n="odo05.status_unavailable">No disponible</option>
        </select>
      </label>
    </div>

    <div class="service-grid" id="listaServicios">
      @foreach (var ps in items)
      {
        var s = ps.Servicio!;
        var activo = ps.Activo && s.Estado == "activo";
        var esp = s.Especialidad?.Nombre;
        var precio = ps.PrecioPersonalizado ?? s.Precio;
        <article class="service-card" data-name="@s.Nombre" data-description="@s.Descripcion" data-specialty="@(string.IsNullOrWhiteSpace(esp) ? "__none__" : esp)" data-status="@(activo ? "activo" : "inactivo")">
          <div class="card-top">
            <span class="service-symbol" aria-hidden="true">
              <span class="material-symbols-outlined">dentistry</span>
            </span>
            <span class="status-badge badge-estado @(activo ? "activo" : "inactivo")">
              <span data-i18n="@(activo ? "odo05.status_available" : "odo05.status_unavailable")">@(activo ? "Disponible" : "No disponible")</span>
            </span>
          </div>
          <h3>@s.Nombre</h3>
          @if (string.IsNullOrWhiteSpace(s.Descripcion))
          {
            <p class="service-description" data-i18n="odo05.description_not_registered">Sin descripción registrada para este procedimiento.</p>
          }
          else
          {
            <p class="service-description">@s.Descripcion</p>
          }
          <div class="tags">
            <span>
              @if (string.IsNullOrWhiteSpace(esp))
              {
                <span data-i18n="odo05.no_specialty">Sin especialidad</span>
              }
              else
              {
                @esp
              }
            </span>
            <span>@s.DuracionMinutos min</span>
          </div>
          <div class="card-bottom">
            <div>
              <small data-i18n="odo05.service_price">Precio del servicio</small>
              <strong>@precio.ToString("C0", cop) <span>COP</span></strong>
            </div>
            <button type="button" class="btn-secondary details-button" data-id="@s.IdServicio" aria-haspopup="dialog" aria-controls="detallePanel">
              <span data-i18n="odo05.view_details">Ver detalles</span>
              <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </button>
          </div>
          <div class="service-data" hidden data-name="@s.Nombre" data-description="@(string.IsNullOrWhiteSpace(s.Descripcion) ? "" : s.Descripcion)" data-specialty="@esp" data-category="@s.Categoria" data-duration="@s.DuracionMinutos" data-base="@s.Precio.ToString("C0",cop)" data-price="@precio.ToString("C0",cop)" data-custom="@(ps.PrecioPersonalizado.HasValue ? "true" : "false")" data-status="@(activo ? "activo" : "inactivo")"></div>
        </article>
      }
    </div>

    <div id="sinResultados" class="empty-state" hidden>
      <span class="material-symbols-outlined empty-icon" aria-hidden="true">search_off</span>
      <h3 class="empty-state-title" data-i18n="odo05.no_results">No hay servicios que coincidan con los filtros.</h3>
      <p class="empty-state-text" data-i18n="odo05.no_results_help">Ajusta los filtros de búsqueda e inténtalo de nuevo.</p>
    </div>
    @if (!items.Any())
    {
      <div class="empty-state">
        <span class="material-symbols-outlined empty-icon" aria-hidden="true">inventory_2</span>
        <h3 class="empty-state-title" data-i18n="odo05.no_services_title">Aún no tienes servicios asignados.</h3>
        <p class="empty-state-text" data-i18n="odo05.no_services">Contacta al administrador para gestionar tus asignaciones.</p>
      </div>
    }
  </section>

  <div id="detalleOverlay" class="detail-overlay" aria-hidden="true" hidden></div>
  <aside id="detallePanel" class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="detalleTitulo" aria-describedby="detalleDescripcion" aria-hidden="true" hidden tabindex="-1">
  <div class="detail-head">
    <span data-i18n="odo05.modal_title">Información del procedimiento</span>
    <button id="cerrarDetalle" class="btn-secondary detail-close" type="button" aria-label="Cerrar detalles" data-i18n-aria-label="odo05.close_details">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
  </div>
  <div class="detail-body">
    <div class="detail-icon" aria-hidden="true">
      <span class="material-symbols-outlined">dentistry</span>
    </div>
    <h2 id="detalleTitulo"></h2>
    <span id="detalleEstado" class="status"></span>
    <h3 data-i18n="odo05.desc_heading">Descripción</h3>
    <p id="detalleDescripcion"></p>
    <h3 data-i18n="odo05.specs_heading">Características</h3>
    <dl>
      <div><dt data-i18n="odo05.specialty_label">Especialidad</dt><dd id="detalleEspecialidad"></dd></div>
      <div><dt data-i18n="odo05.category_label">Categoría</dt><dd id="detalleCategoria"></dd></div>
      <div><dt data-i18n="odo05.duration_label">Duración estimada</dt><dd id="detalleDuracion"></dd></div>
      <div><dt data-i18n="odo05.base_price_label">Precio base</dt><dd id="detalleBase"></dd></div>
      <div><dt data-i18n="odo05.applicable_price_label">Precio aplicable</dt><dd id="detallePrecio"></dd></div>
      <div><dt data-i18n="odo05.custom_price_label">Precio personalizado</dt><dd id="detallePersonalizado"></dd></div>
    </dl>
    <p class="detail-note" data-i18n="odo05.modal_note">Los precios y asignaciones se administran desde el módulo correspondiente. Esta vista es solo de consulta.</p>
  </div>
  </aside>
</main>

@section Scripts {
  <script src="~/js/Servicios_Y_Recursos/st-odo-05-servicios/servicios.js" asp-append-version="true" defer></script>
}
