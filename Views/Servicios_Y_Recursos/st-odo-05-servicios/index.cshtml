@model IEnumerable<SmileTrack_MVC.Models.Entities.ProfesionalServicio>
@using System.Globalization
@{ Layout = null; var items = Model?.Where(x => x.Servicio != null).ToList() ?? new(); var disponibles = items.Count(x => x.Activo && x.Servicio!.Estado == "activo"); var cop = CultureInfo.GetCultureInfo("es-CO"); }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>SmileTrack — Mis servicios</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto+Flex:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/Servicios_Y_Recursos/st-odo-05-servicios/servicios.css")?v=3" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
</head>
<body>
@{ await Html.RenderPartialAsync("~/Views/shared/_LangSwitcher.cshtml"); }
<a class="skip" href="#contenido">Saltar al contenido</a>
@{ await Html.RenderPartialAsync("_SidebarProfesional"); }
<div id="sidebar-backdrop" class="sidebar-backdrop" hidden></div>
<button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">☰</button>
<main id="contenido" class="catalog-main">
<header class="catalog-header">
 <nav class="breadcrumb" aria-label="Ruta de navegación">Odontólogo <span>→</span> Servicios y Recursos <span>→</span> <strong>Mis servicios</strong></nav>
 <div class="header-line"><div><h1>Mis servicios</h1><p>Consulta los procedimientos asignados a tu perfil profesional.</p></div><div class="professional-name">@(ViewData["NombreProfesional"] ?? "Perfil profesional")</div></div>
</header>
<section class="stats" aria-label="Resumen de servicios">
 <div class="stat" data-color="blue"><span class="material-symbols-outlined stat-icon" aria-hidden="true">inventory_2</span><strong>@items.Count</strong><span class="stat-label">Servicios asignados</span></div>
 <div class="stat" data-color="green"><span class="material-symbols-outlined stat-icon" aria-hidden="true">task_alt</span><strong>@disponibles</strong><span class="stat-label">Disponibles</span></div>
 <div class="stat" data-color="orange"><span class="material-symbols-outlined stat-icon" aria-hidden="true">event_busy</span><strong>@(items.Count - disponibles)</strong><span class="stat-label">No disponibles</span></div>
</section>
<section class="catalog-panel" aria-label="Catálogo de servicios">
 <div class="section-title"><div><h2>Catálogo profesional</h2><p>Explora los detalles de los servicios que tienes asignados.</p></div></div>
 <div class="filters"><label class="search"><span aria-hidden="true">⌕</span><input id="buscarServicio" type="search" placeholder="Buscar servicio o descripción..." aria-label="Buscar servicios" /></label><label class="select-wrap">Especialidad <select id="filtroEspecialidad"><option value="">Todas</option>@foreach (var esp in items.Select(x => x.Servicio?.Especialidad?.Nombre ?? "Sin especialidad").Distinct().OrderBy(x => x)){<option value="@esp">@esp</option>}</select></label><label class="select-wrap">Estado <select id="filtroEstado"><option value="">Todos</option><option value="activo">Disponible</option><option value="inactivo">No disponible</option></select></label></div>
 <div class="service-grid" id="listaServicios">
 @foreach (var ps in items) { var s = ps.Servicio!; var activo = ps.Activo && s.Estado == "activo"; var esp = s.Especialidad?.Nombre ?? "Sin especialidad"; var precio = ps.PrecioPersonalizado ?? s.Precio;
 <article class="service-card" data-name="@s.Nombre" data-description="@s.Descripcion" data-specialty="@esp" data-status="@(activo ? "activo" : "inactivo")">
  <div class="card-top"><span class="service-symbol" aria-hidden="true">✦</span><span class="status @(activo ? "is-active" : "is-inactive")">@(activo ? "Disponible" : "No disponible")</span></div>
  <h3>@s.Nombre</h3><p class="service-description">@(string.IsNullOrWhiteSpace(s.Descripcion) ? "Sin descripción registrada para este procedimiento." : s.Descripcion)</p>
  <div class="tags"><span>@esp</span><span>@s.DuracionMinutos min</span></div>
  <div class="card-bottom"><div><small>Precio del servicio</small><strong>@precio.ToString("C0", cop) <span>COP</span></strong></div><button type="button" class="details-button" data-id="@s.IdServicio">Ver detalles <span aria-hidden="true">→</span></button></div>
  <div class="service-data" hidden data-name="@s.Nombre" data-description="@(string.IsNullOrWhiteSpace(s.Descripcion) ? "Sin descripción registrada." : s.Descripcion)" data-specialty="@esp" data-category="@s.Categoria" data-duration="@s.DuracionMinutos" data-base="@s.Precio.ToString("C0",cop)" data-price="@precio.ToString("C0",cop)" data-custom="@(ps.PrecioPersonalizado.HasValue ? "Sí" : "No")" data-status="@(activo ? "Disponible" : "No disponible")"></div>
 </article>
 }
 </div>
 <div id="sinResultados" class="empty" hidden>No hay servicios que coincidan con los filtros.</div>
 @if (!items.Any()) { <div class="empty">No tienes servicios asignados. Contacta al administrador para gestionar tus asignaciones.</div> }
</section>
</main>
<div id="detalleOverlay" class="detail-overlay" hidden></div>
<aside id="detallePanel" class="detail-panel" role="dialog" aria-modal="true" aria-labelledby="detalleTitulo" aria-hidden="true" hidden>
 <div class="detail-head"><span>Información del procedimiento</span><button id="cerrarDetalle" type="button" aria-label="Cerrar detalles">✕</button></div>
 <div class="detail-body"><div class="detail-icon" aria-hidden="true">✦</div><h2 id="detalleTitulo"></h2><span id="detalleEstado" class="status"></span><h3>Descripción</h3><p id="detalleDescripcion"></p><h3>Características</h3><dl><div><dt>Especialidad</dt><dd id="detalleEspecialidad"></dd></div><div><dt>Categoría</dt><dd id="detalleCategoria"></dd></div><div><dt>Duración estimada</dt><dd id="detalleDuracion"></dd></div><div><dt>Precio base</dt><dd id="detalleBase"></dd></div><div><dt>Precio aplicable</dt><dd id="detallePrecio"></dd></div><div><dt>Precio personalizado</dt><dd id="detallePersonalizado"></dd></div></dl><p class="detail-note">Los precios y asignaciones se administran desde el módulo correspondiente. Esta vista es solo de consulta.</p></div>
</aside>
<script src="@Url.Content("~/js/Servicios_Y_Recursos/st-odo-05-servicios/servicios.js")" defer></script>
</body></html>
