@{ Layout = null; }

﻿<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Consulta y gestiona los servicios prestados en la historia clínica del paciente." />
  <title>SmileTrack — Servicios Prestados</title>
  
  <!-- Tailwind CSS CDN con plugins -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto+Flex:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Configuración personalizada de Tailwind para consistencia -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#1a73e8',
            primaryDark: '#1a2744',
            primaryActive: '#1e5a9c',
            surface: '#f4f7f9',
            border: '#e5e7eb',
            muted: '#9ca3af',
            success: '#16a34a',
            warning: '#d97706',
            danger: '#ef4444'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Roboto Flex', 'sans-serif']
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="@Url.Content("~/css/Servicios_Y_Recursos/st-odo-05-servicios/servicios.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>
<body class="bg-surface text-gray-800 font-body">

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }

  <!-- Overlay móvil -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" aria-hidden="true"></div>

  <!-- Botón hamburguer móvil -->
  <button id="menu-toggle" class="lg:hidden fixed top-4 left-4 z-50 p-2 rounded-lg bg-primaryDark text-white hover:bg-primaryActive transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span class="text-xl" aria-hidden="true">☰</span>
  </button>

  <!-- ═════ MAIN ═════ -->
  <main class="ml-0 lg:ml-64 min-h-screen p-4 sm:p-6 lg:p-8 transition-all" id="main-content">
    
    <!-- Header con breadcrumb -->
    <header class="mb-8">
      <nav class="text-xs text-gray-500 mb-2" aria-label="Breadcrumb">
        <span>Odontólogo</span>
        <span class="mx-1">→</span>
        <span>Historia clínica</span>
        <span class="mx-1">→</span>
        <span class="text-primary font-semibold">Servicios prestados</span>
      </nav>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-display font-bold text-primary">Servicios Prestados</h1>
          <p class="text-sm text-gray-600 mt-1">Cita del 20 Mar 2026 · Pedro García · Dr. Carlos Méndez</p>
        </div>
        <button id="btnAddService" class="bg-primary hover:bg-blue-600 text-white px-5 sm:px-6 py-2.5 rounded-lg font-display font-semibold flex items-center justify-center gap-2 transition-all shadow-md w-full md:w-auto" aria-label="Agregar nuevo servicio">
          <span class="text-xl leading-none" aria-hidden="true">+</span> Agregar servicio
        </button>
      </div>
    </header>

    <!-- Tabla de servicios (responsive) -->
    <section class="max-w-6xl mx-auto" aria-label="Lista de servicios prestados">
      
      <!-- Encabezados de tabla (desktop) -->
      <div class="hidden md:grid grid-cols-6 px-8 py-3 bg-white/60 rounded-t-xl text-[10px] font-bold text-gray-400 uppercase tracking-widest shadow-sm border-b border-border" role="row">
        <div class="col-span-2 lg:col-span-1" role="columnheader">Servicio</div>
        <div class="text-center hidden lg:block" role="columnheader">Categoría</div>
        <div class="text-center" role="columnheader">Precio Histórico</div>
        <div class="text-center" role="columnheader">Precio Actual</div>
        <div class="text-center" role="columnheader">Diferencia</div>
        <div class="text-center" role="columnheader">Estado</div>
      </div>

      <!-- Fila 1: Control de tratamiento -->
      <div class="grid grid-cols-1 md:grid-cols-6 items-center px-4 sm:px-8 py-5 bg-white shadow-sm mb-4 border border-border rounded-lg md:rounded-none md:first:rounded-t-none md:last:rounded-b-none gap-4 md:gap-0" role="row" tabindex="0" aria-label="Servicio: Control de tratamiento">
        <div class="col-span-1 md:col-span-2 lg:col-span-1" role="cell">
          <p class="font-bold text-gray-800 text-sm">Control de tratamiento</p>
          <p class="text-[10px] sm:text-xs text-gray-400">Pieza 23 – Seguimiento endodoncia</p>
        </div>
        <div class="flex justify-start md:justify-center hidden lg:flex" role="cell">
          <span class="bg-blue-50 text-blue-600 px-3 py-1 rounded text-[11px] font-bold" role="status" aria-label="Categoría: Preventiva">Preventiva</span>
        </div>

        <!-- Vista móvil: labels + valores -->
        <div class="grid grid-cols-2 gap-y-2 text-sm md:hidden mt-2" aria-hidden="true">
          <div class="text-gray-500 font-medium">Precio Histórico:</div>
          <div class="font-semibold text-success">$30.000</div>
          <div class="text-gray-500 font-medium">Precio Actual:</div>
          <div class="font-medium text-gray-600">$30.000</div>
          <div class="text-gray-500 font-medium">Diferencia:</div>
          <div class="text-gray-400">—</div>
        </div>

        <!-- Vista desktop: columnas -->
        <div class="hidden md:block text-center" role="cell">
          <span class="bg-green-50 text-success px-3 py-1 rounded text-sm font-semibold">$30.000</span>
        </div>
        <div class="hidden md:block text-center text-sm font-medium text-gray-600" role="cell">$30.000</div>
        <div class="hidden md:block text-center text-sm text-gray-400" role="cell">—</div>

        <div class="flex md:justify-center mt-2 md:mt-0 pt-3 md:pt-0 border-t border-border md:border-0" role="cell">
          <span class="bg-green-100 text-success px-3 py-1 rounded-full text-[11px] font-bold flex items-center gap-1 w-max" role="status" aria-label="Estado: Realizado">
            <span class="w-2 h-2 bg-success rounded-full" aria-hidden="true"></span> Realizado
          </span>
        </div>
      </div>

      <!-- Fila 2: Control general -->
      <div class="grid grid-cols-1 md:grid-cols-6 items-center px-4 sm:px-8 py-5 bg-white shadow-sm mb-4 border border-border rounded-lg md:rounded-none gap-4 md:gap-0" role="row" tabindex="0" aria-label="Servicio: Control general">
        <div class="col-span-1 md:col-span-2 lg:col-span-1" role="cell">
          <p class="font-bold text-gray-800 text-sm">Control general</p>
          <p class="text-[10px] sm:text-xs text-gray-400">Valoración y diagnóstico</p>
        </div>
        <div class="flex justify-start md:justify-center hidden lg:flex" role="cell">
          <span class="bg-blue-50 text-blue-600 px-3 py-1 rounded text-[11px] font-bold" role="status" aria-label="Categoría: Preventiva">Preventiva</span>
        </div>

        <!-- Vista móvil -->
        <div class="grid grid-cols-2 gap-y-2 text-sm md:hidden mt-2" aria-hidden="true">
          <div class="text-gray-500 font-medium">Precio Histórico:</div>
          <div class="font-semibold text-success">$45.000</div>
          <div class="text-gray-500 font-medium">Precio Actual:</div>
          <div class="font-medium text-gray-600">$50.000</div>
          <div class="text-gray-500 font-medium">Diferencia:</div>
          <div class="font-bold text-success">↑ $5.000</div>
        </div>

        <!-- Vista desktop -->
        <div class="hidden md:block text-center" role="cell">
          <span class="bg-green-50 text-success px-3 py-1 rounded text-sm font-semibold">$45.000</span>
        </div>
        <div class="hidden md:block text-center text-sm font-medium text-gray-600" role="cell">$50.000</div>
        <div class="hidden md:block text-center text-sm font-bold text-success" role="cell">↑ $5.000</div>

        <div class="flex md:justify-center mt-2 md:mt-0 pt-3 md:pt-0 border-t border-border md:border-0" role="cell">
          <span class="bg-green-100 text-success px-3 py-1 rounded-full text-[11px] font-bold flex items-center gap-1 w-max" role="status" aria-label="Estado: Realizado">
            <span class="w-2 h-2 bg-success rounded-full" aria-hidden="true"></span> Realizado
          </span>
        </div>
      </div>

      <!-- Resumen de facturación -->
      <div class="bg-blue-50/50 border border-blue-100 rounded-xl p-5 sm:p-8 mt-8 lg:mt-12 flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center justify-between gap-4 sm:gap-8" aria-label="Resumen de facturación">
        <div class="w-full sm:w-auto flex justify-between sm:justify-start items-baseline gap-2">
          <span class="text-gray-400 text-sm font-medium">Subtotal:</span>
          <span class="text-gray-800 text-lg font-bold" id="subtotal">$80.000</span>
        </div>
        <div class="w-full sm:w-auto flex justify-between sm:justify-start items-baseline gap-2">
          <span class="text-success text-sm font-medium">Descuento:</span>
          <span class="text-success text-lg font-bold" id="discount">- $5.000</span>
        </div>
        <div class="w-full sm:w-auto flex justify-between sm:justify-start items-baseline gap-2">
          <span class="text-gray-400 text-sm font-medium">IVA:</span>
          <span class="text-gray-800 text-lg font-bold" id="tax">$0</span>
        </div>
        <div class="w-full sm:w-auto flex justify-between sm:justify-start items-baseline gap-3 pt-4 sm:pt-0 border-t border-blue-100 sm:border-0">
          <span class="text-primary text-xl sm:text-2xl font-medium">Total:</span>
          <span class="text-primary text-2xl sm:text-3xl font-black" id="total">$75.000</span>
        </div>
      </div>

    </section>

    <!-- Banner de estado (accesible) -->
    <div id="statusBanner" class="max-w-6xl mx-auto mt-6 hidden" role="status" aria-live="polite">
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center">
        <span class="w-3 h-3 rounded-full bg-success mr-3 animate-pulse" aria-hidden="true"></span>
        <span id="statusText" class="text-green-800 text-sm font-medium">Servicio agregado correctamente</span>
      </div>
    </div>

  </main>

  <!-- Toast para notificaciones -->
  <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-gray-800 text-white px-5 py-3 rounded-lg shadow-lg text-sm font-body opacity-0 pointer-events-none transition-all z-50" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    .skip-link:focus:not(.sr-only) { position:static; width:auto; height:auto; overflow:visible; clip:auto; white-space:normal; }
  </style>

<footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>

  <script src="@Url.Content("~/js/Servicios_Y_Recursos/st-odo-05-servicios/servicios.js")"></script>
  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>
</html>

