@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
  Layout = "_Layout";
  ViewData["Title"] = "Catálogo de Servicios";
  ViewData["Description"] = "Configura y gestiona el catálogo de servicios odontológicos en SmileTrack.";
  ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Servicios_Y_Recursos/st-adm-10-servicios/catalogoservicios.css" asp-append-version="true" />
}

<main class="main services-page" id="main-content">
  <header class="page-header">
    <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="layout_breadcrumb_aria">
      <a href="/gestion-de-citas/st-adm-01-dashboard" data-i18n="common_bc_administracion">Administración</a>
      <span class="bc-sep" aria-hidden="true">›</span>
      <span aria-current="page" data-i18n="servicios.catalog_title">Catálogo de servicios</span>
    </nav>
    <div class="page-header-content">
      <div class="page-header-title">
        <h1 class="page-title" data-i18n="servicios.catalog_title">Catálogo de servicios</h1>
        <p class="page-subtitle" data-i18n="servicios.catalog_subtitle">Administra precios, categorías y disponibilidad.</p>
      </div>
    </div>
  </header>

  <section class="stats-grid services-stats" aria-label="Resumen de servicios" data-i18n-aria-label="servicios.summary">
    <article class="stat-card" data-color="blue">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">medical_services</span>
      <span class="stat-number" id="statTotal" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="servicios.total">Total de servicios</span>
      <span class="stat-sub" data-i18n="servicios.total_sub">Servicios registrados</span>
    </article>
    <article class="stat-card" data-color="green">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">check_circle</span>
      <span class="stat-number" id="statActive" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="servicios.active_plural">Servicios activos</span>
      <span class="stat-sub" data-i18n="servicios.active_sub">Disponibles para asignar</span>
    </article>
    <article class="stat-card" data-color="red">
      <span class="material-symbols-outlined stat-icon" aria-hidden="true">pause_circle</span>
      <span class="stat-number" id="statInactive" data-target="0" aria-live="polite">0</span>
      <span class="stat-label" data-i18n="servicios.inactive_plural">Servicios inactivos</span>
      <span class="stat-sub" data-i18n="servicios.inactive_sub">No disponibles para asignar</span>
    </article>
  </section>

  <section class="controls-section filters-section" aria-label="Filtros de servicios" data-i18n-aria-label="servicios.filters">
    <div class="services-filters">
      <label class="search-wrap" for="searchServices">
        <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
        <input type="search" id="searchServices" class="search-input"
               placeholder="Buscar por nombre o descripción"
               aria-label="Buscar servicios" data-i18n-ph="servicios.search_placeholder"
               data-i18n-aria-label="servicios.search_aria">
      </label>
      <label class="filter-field">
        <span class="visually-hidden" data-i18n="servicios.filter_category">Filtrar por categoría</span>
        <select id="filterCategory" class="filter-select" aria-label="Filtrar por categoría" data-i18n-aria-label="servicios.filter_category">
          <option value="" data-i18n="servicios.all_categories">Todas las categorías</option>
          <option value="prevencion" data-i18n="servicios.category_prevencion">Prevención</option>
          <option value="estetica" data-i18n="servicios.category_estetica">Estética</option>
          <option value="cirugia" data-i18n="servicios.category_cirugia">Cirugía</option>
          <option value="ortodoncia" data-i18n="servicios.category_ortodoncia">Ortodoncia</option>
          <option value="endodoncia" data-i18n="servicios.category_endodoncia">Endodoncia</option>
          <option value="periodoncia" data-i18n="servicios.category_periodoncia">Periodoncia</option>
          <option value="general" data-i18n="servicios.category_general">General</option>
        </select>
      </label>
      <label class="filter-field">
        <span class="visually-hidden" data-i18n="servicios.filter_status">Filtrar por estado</span>
        <select id="filterStatus" class="filter-select" aria-label="Filtrar por estado" data-i18n-aria-label="servicios.filter_status">
          <option value="" data-i18n="servicios.all_statuses">Todos los estados</option>
          <option value="true" data-i18n="servicios.active">Activo</option>
          <option value="false" data-i18n="status.inactive">Inactivo</option>
        </select>
      </label>
      <button type="button" class="btn-primary" id="btnNewService" aria-label="Crear nuevo servicio"
              data-i18n-aria-label="servicios.new">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        <span data-i18n="servicios.new">Nuevo servicio</span>
      </button>
    </div>
  </section>

  <div class="table-wrap services-table-wrap">
    <section class="table-section services-table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle" data-i18n="servicios.table_title">Lista de servicios</h2>
      <div class="services-table" role="table" aria-labelledby="tableTitle">
        <div class="table-header" role="row">
          <div class="table-col col-nombre" role="columnheader" data-i18n="servicios.column_name">Servicio</div>
          <div class="table-col col-categoria" role="columnheader" data-i18n="servicios.category">Categoría</div>
          <div class="table-col col-duracion" role="columnheader" data-i18n="servicios.duration">Duración</div>
          <div class="table-col col-costo" role="columnheader" data-i18n="servicios.price">Precio base</div>
          <div class="table-col col-estado text-center" role="columnheader" data-i18n="facturacion.status">Estado</div>
          <div class="table-col col-acciones text-right" role="columnheader" data-i18n="table.actions">Acciones</div>
        </div>
        <div id="servicesBody" class="table-body" role="rowgroup" aria-live="polite" aria-busy="false"></div>
      </div>
      <footer class="table-footer" aria-label="Paginación de servicios" data-i18n-aria-label="servicios.pagination">
        <span>
          <span data-i18n="servicios.pagination_showing">Mostrando</span>
          <strong id="pageShowing">0</strong>
          <span data-i18n="servicios.pagination_of">de</span>
          <strong id="pageTotal">0</strong>
          <span data-i18n="servicios.pagination_records">servicios</span>
        </span>
        <nav class="pagination" id="servicePagination" aria-label="Páginas de resultados" data-i18n-aria-label="servicios.pagination"></nav>
      </footer>
    </section>
  </div>
</main>

<div class="drawer-overlay" id="drawerOverlay" role="dialog" aria-modal="true" aria-labelledby="drawerTitle"
     aria-hidden="true" inert>
  <section class="drawer-panel" id="drawerPanel">
    <header class="drawer-header">
      <h2 class="drawer-title" id="drawerTitle" data-i18n="servicios.edit">Editar servicio</h2>
      <button class="drawer-close" id="drawerClose" type="button" aria-label="Cerrar panel" data-i18n-aria-label="servicios.close_drawer">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>
    <form id="serviceForm" class="drawer-form">
      @Html.AntiForgeryToken()
      <div class="form-group">
        <label for="serviceName" class="form-label" data-i18n="servicios.name">Nombre del servicio</label>
        <input type="text" id="serviceName" class="form-input" required minlength="3" maxlength="150">
      </div>
      <div class="form-group">
        <label for="serviceDescription" class="form-label" data-i18n="servicios.description">Descripción</label>
        <textarea id="serviceDescription" class="form-textarea" rows="4" maxlength="500"></textarea>
      </div>
      <div class="form-group">
        <label for="serviceCategory" class="form-label" data-i18n="servicios.category">Categoría</label>
        <select id="serviceCategory" class="form-select" aria-describedby="serviceCategoryHint" required>
          <option value="" selected disabled data-i18n="servicios.select_category">Selecciona una categoría</option>
          <option value="prevencion" data-i18n="servicios.category_prevencion">Prevención</option>
          <option value="estetica" data-i18n="servicios.category_estetica">Estética</option>
          <option value="cirugia" data-i18n="servicios.category_cirugia">Cirugía</option>
          <option value="ortodoncia" data-i18n="servicios.category_ortodoncia">Ortodoncia</option>
          <option value="endodoncia" data-i18n="servicios.category_endodoncia">Endodoncia</option>
          <option value="periodoncia" data-i18n="servicios.category_periodoncia">Periodoncia</option>
          <option value="general" data-i18n="servicios.category_general">General</option>
        </select>
        <small class="form-hint" id="serviceCategoryHint" data-i18n="servicios.category_help">
          Si el servicio tiene una categoría antigua, selecciona una categoría válida para guardar.
        </small>
      </div>
      <div class="form-group">
        <label for="serviceSpecialty" class="form-label" data-i18n="servicios.specialty">Especialidad clínica</label>
        <select id="serviceSpecialty" class="form-select" required>
          <option value="" selected disabled data-i18n="servicios.select_specialty">Selecciona una especialidad</option>
        </select>
        <small class="form-hint" id="serviceSpecialtyHint" data-i18n="servicios.specialty_required_hint">
          La especialidad es obligatoria para guardar el servicio.
        </small>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="serviceCost" class="form-label" data-i18n="servicios.price_cop">Precio base (COP)</label>
          <input type="number" id="serviceCost" class="form-input" step="1" min="1" max="999999999" required>
        </div>
        <div class="form-group">
          <label for="serviceDuration" class="form-label" data-i18n="servicios.duration_minutes">Duración (minutos)</label>
          <input type="number" id="serviceDuration" class="form-input" min="5" max="480" step="1" value="60" required>
        </div>
      </div>
      <div class="form-group form-toggle">
        <span class="toggle-label">
          <strong data-i18n="servicios.current_status">Estado actual</strong>
          <small data-i18n="servicios.status_change_hint">Cambia la disponibilidad desde las acciones de la tabla.</small>
        </span>
        <span id="serviceDrawerStatus" class="status-badge activo" role="status"></span>
      </div>
      <footer class="drawer-footer">
        <button type="button" class="btn-secondary" id="drawerCancel" data-i18n="common.cancel">Cancelar</button>
        <button type="submit" class="btn-primary" id="serviceSaveButton" data-i18n="servicios.save_changes">Guardar cambios</button>
      </footer>
    </form>
  </section>
</div>

@section Scripts {
  <script>
    window.RAZOR_SERVICIOS = @Html.Raw(ViewData["ServiciosJson"] ?? "[]");
    window.RAZOR_ESPECIALIDADES = @Html.Raw(ViewData["EspecialidadesJson"] ?? "[]");
  </script>
  <script src="~/js/lib/apiRequest.js" asp-append-version="true"></script>
  <script src="~/js/Servicios_Y_Recursos/st-adm-10-servicios/catalogoservicios.js" asp-append-version="true"></script>
}
