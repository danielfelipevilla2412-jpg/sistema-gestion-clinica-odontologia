@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Configuración General";
    ViewData["Description"] = "Configura parámetros del centro, citas y notificaciones en SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Servicios_Y_Recursos/st-adm-16-configuracion-general/styles.css" asp-append-version="true" />
}

<main class="main config-page" id="main-content">
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="layout_breadcrumb_aria">
                <a href="/gestion-de-citas/st-adm-01-dashboard" data-i18n="common_bc_administracion">Administración</a>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" aria-current="page" data-i18n="config.title">Configuración General</span>
            </nav>
            <h1 class="page-title" data-i18n="config.title">Configuración General</h1>
            <p class="page-subtitle" data-i18n="config.subtitle">Administra los datos del centro, las citas y las notificaciones.</p>
        </div>
    </header>

    <form id="configForm" class="config-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="config-grid">
            <section class="config-card" aria-labelledby="appointmentsTitle">
                <h2 class="card-title" id="appointmentsTitle" data-i18n="config.appointments">Configuración de citas</h2>
                <div class="config-list">
                    <div class="form-group">
                        <label for="defaultDuration" class="form-label" data-i18n="config.duration">Duración predeterminada (minutos)</label>
                        <input type="number" id="defaultDuration" class="form-input" min="5" max="180" step="5" required>
                    </div>
                    <div class="form-group">
                        <label for="openTime" class="form-label" data-i18n="config.opening_time">Horario de apertura</label>
                        <input type="time" id="openTime" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label for="closeTime" class="form-label" data-i18n="config.closing_time">Horario de cierre</label>
                        <input type="time" id="closeTime" class="form-input" required>
                    </div>
                </div>
            </section>

            <section class="config-card" aria-labelledby="centerTitle">
                <h2 class="card-title" id="centerTitle" data-i18n="config.center_data">Datos del centro</h2>
                <p class="card-subtitle" data-i18n="config.center_hint">Información que aparece en documentos y comunicaciones.</p>
                <div class="config-list">
                    <div class="form-group">
                        <label for="centerName" class="form-label" data-i18n="config.clinic_name">Nombre de la clínica</label>
                        <input type="text" id="centerName" class="form-input" maxlength="150" minlength="3" required>
                    </div>
                    <div class="form-group">
                        <label for="centerNIT" class="form-label" data-i18n="config.nit">Número de NIT / Identificación</label>
                        <input type="text" id="centerNIT" class="form-input" pattern="\d{3}\.\d{3}\.\d{3}-\d" aria-describedby="nitHelp" required>
                        <small class="form-help" id="nitHelp" data-i18n="config.nit_hint">Formato: 000.000.000-0</small>
                    </div>
                    <div class="form-group">
                        <label for="centerAddress" class="form-label" data-i18n="config.address">Dirección</label>
                        <input type="text" id="centerAddress" class="form-input" maxlength="250" minlength="5" required>
                    </div>
                </div>
            </section>

            <section class="config-card" aria-labelledby="notificationsTitle">
                <h2 class="card-title" id="notificationsTitle" data-i18n="common.notifications">Notificaciones</h2>
                <div class="toggle-list">
                    <div class="toggle-item">
                        <span class="toggle-info">
                            <strong data-i18n="config.email_reminders">Recordatorios por correo</strong>
                            <small data-i18n="config.email_reminders_hint">Enviar avisos por correo antes de la cita.</small>
                        </span>
                        <button type="button" class="toggle-switch" id="toggleEmail" role="switch" aria-checked="true" aria-label="Recordatorios por correo" data-i18n-aria-label="config.email_reminders">
                            <span class="toggle-dot" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="toggle-item">
                        <span class="toggle-info">
                            <strong data-i18n="config.sms_reminders">Recordatorios por SMS</strong>
                            <small data-i18n="config.sms_reminders_hint">Enviar avisos de texto al teléfono registrado.</small>
                        </span>
                        <button type="button" class="toggle-switch" id="toggleSMS" role="switch" aria-checked="false" aria-label="Recordatorios por SMS" data-i18n-aria-label="config.sms_reminders">
                            <span class="toggle-dot" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="toggle-item">
                        <span class="toggle-info">
                            <strong data-i18n="config.system_notifications">Notificaciones del sistema</strong>
                            <small data-i18n="config.system_notifications_hint">Mostrar alertas internas de actividad.</small>
                        </span>
                        <button type="button" class="toggle-switch" id="toggleSystem" role="switch" aria-checked="true" aria-label="Notificaciones del sistema" data-i18n-aria-label="config.system_notifications">
                            <span class="toggle-dot" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </section>

            <section class="config-card config-note" aria-labelledby="settingsNoteTitle">
                <h2 class="card-title" id="settingsNoteTitle" data-i18n="config.save_title">Guardar configuración</h2>
                <p class="card-subtitle" data-i18n="config.save_hint">Los cambios se aplicarán al sistema cuando guardes el formulario.</p>
                <button type="submit" class="btn-primary btn-submit" id="btnSaveChanges">
                    <span class="material-symbols-outlined" aria-hidden="true">save</span>
                    <span data-i18n="config.save">Guardar cambios</span>
                </button>
            </section>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        window.CONFIG_GENERAL = @Html.Raw(ViewData["ConfigsJson"] ?? "{}");
    </script>
    <script src="~/js/lib/apiRequest.js" asp-append-version="true"></script>
    <script src="~/js/Servicios_Y_Recursos/st-adm-16-configuracion-general/script.js" asp-append-version="true"></script>
}
