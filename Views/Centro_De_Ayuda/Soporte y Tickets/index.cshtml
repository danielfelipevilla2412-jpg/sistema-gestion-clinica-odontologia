@model SmileTrack_MVC.Models.ViewModels.CentroDeAyudaViewModel
@{
    ViewData["Title"] = "SmileTrack - Centro de Ayuda";
    Layout = "_Layout";
    var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.Trim().ToLowerInvariant();
    var roleLabel = role switch
    {
        "profesional" or "odontologo" or "odontólogo" or "doctor" => "Panel Profesional",
        "paciente" => "Panel Paciente",
        "recepcionista" => "Panel Recepcionista",
        "auxiliar" => "Panel Auxiliar",
        _ => "Panel Administrador"
    };

    var categories = Model.Articles
        .GroupBy(a => a.Categoria)
        .Select(g => new
        {
            Title = g.Key,
            Description = g.FirstOrDefault()?.Descripcion ?? "Artículos de ayuda",
            IconClass = g.Key switch
            {
                "Citas" => "fa-calendar-check",
                "Pacientes" => "fa-user-injured",
                "Facturación" => "fa-file-invoice-dollar",
                "Profesionales" => "fa-user-md",
                "Soporte" => "fa-headset",
                _ => "fa-circle-question"
            },
            ColorKey = g.Key switch
            {
                "Citas" => "blue",
                "Pacientes" => "green",
                "Facturación" => "amber",
                "Profesionales" => "purple",
                "Soporte" => "red",
                _ => "slate"
            }
        })
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Centro_De_Ayuda/Guias_Tutoriales_Y_Soporte/styles.css" asp-append-version="true" />
}

<main class="main" id="main-content">
        <header class="page-header">
            <div class="header-left">
                <nav class="breadcrumb" aria-label="Ruta de navegación">
                    <span>@roleLabel</span>
                    <span class="bc-sep" aria-hidden="true">→</span>
                    <span class="bc-active">Centro de Ayuda</span>
                </nav>
                <h1 class="page-title">Centro de Ayuda</h1>
                <p class="page-subtitle">Busca guías, tutoriales y soporte para tu clínica</p>
            </div>
            <button class="btn-support" type="button" aria-expanded="false">
                <i class="fas fa-headset"></i>
                <span>+ Soporte Directo</span>
            </button>
        </header>

        <section class="support-banner">
            <div class="support-card">
                <div class="support-card__header">
                    <div class="support-card__icon"><i class="fas fa-circle-info"></i></div>
                    <h2>Canales de soporte</h2>
                </div>
                <ul class="support-list">
                    <li><i class="fas fa-comment-dots"></i> @Model.Support.ChatHours</li>
                    <li><i class="fas fa-envelope"></i> @Model.Support.Email</li>
                    <li><i class="fas fa-phone"></i> @Model.Support.Phone</li>
                </ul>
            </div>
        </section>

        <section class="category-grid" aria-label="Categorías del centro de ayuda">
            @foreach (var category in categories)
            {
                <article class="category-card border-@category.ColorKey" data-category="@category.Title">
                    <div class="category-icon">
                        <i class="fas @category.IconClass text-@category.ColorKey"></i>
                    </div>
                    <h3 class="text-@category.ColorKey">@category.Title</h3>
                    <span>@category.Description</span>
                </article>
            }
        </section>

        <section class="search-section">
            <div class="search-container">
                <div class="search-input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" class="search-input" placeholder="¿Cómo programar una cita?..." />
                </div>
            </div>

            <div class="articles-section">
                <div class="articles-header">
                    <h3>Artículos recomendados</h3>
                    <a href="/centro-de-ayuda/guias-tutoriales" class="view-all">Ver todo</a>
                </div>

                <div class="article-list">
                    @foreach (var article in Model.Articles)
                    {
                        <article class="article-item" data-category="@article.Categoria">
                            <div class="article-icon icon-@article.Categoria">
                                <i class="fas @article.Icono"></i>
                            </div>
                            <div class="article-content">
                                <h4>@article.Titulo</h4>
                                <p>@article.Descripcion</p>
                            </div>
                            <div class="article-meta">
                                <span class="article-badge badge-@article.Categoria">@article.Categoria</span>
                                <i class="fas fa-chevron-right article-arrow"></i>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    </main>

@section Scripts {
    <script src="~/js/Centro_De_Ayuda/Guias_Tutoriales_Y_Soporte/app.js" asp-append-version="true"></script>
}

