<script>
(function(){'use strict';const $=id=>document.getElementById(id);const $$=(sel,p=document)=>Array.from(p.querySelectorAll(sel));
// Referencias
const chatModal=$('chatbotModal'),pqrsModal=$('pqrsModal'),chatClose=$('chatbotClose'),pqrsClose=$('pqrsClose');
