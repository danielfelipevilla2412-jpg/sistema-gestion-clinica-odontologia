@model SmileTrack_MVC.Models.ViewModels.PublicHomeViewModel
@using System.Globalization
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.LinkTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.ScriptTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "SmileTrack | Plataforma odontológica";
    ViewData["Description"] = "Consulta los servicios odontológicos activos y gestiona tus citas desde SmileTrack.";
    ViewData["HideHeaderSpacer"] = true;
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/Publico/homepage.css")" asp-append-version="true" />
}

<main class="public-home" id="main-content">
    <section class="home-hero" aria-labelledby="home-hero-title">
        <div class="home-hero-inner">
            <div class="home-hero-copy">
                <p class="home-hero-badge">
                    <span class="material-symbols-outlined" aria-hidden="true">health_and_safety</span>
                    <span data-i18n="home.hero_badge">Plataforma odontológica SmileTrack</span>
                </p>
                <h1 id="home-hero-title" data-i18n-html="home.hero_title_html">
                    Tu atención odontológica, <span>más fácil de gestionar</span>
                </h1>
                <p class="home-hero-subtitle" data-i18n="home.hero_subtitle">
                    Consulta los servicios activos y gestiona tus citas desde un solo lugar.
                </p>
                <div class="home-hero-actions">
                    <a href="/acceso-y-seguridad/login" class="home-button home-button-primary">
                        <span data-i18n="home.hero_login">Acceder a mi cuenta</span>
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                    </a>
                    <a href="/acceso-y-seguridad/register" class="home-button home-button-secondary" data-i18n="home.hero_register">
                        Crear cuenta
                    </a>
                </div>
                <div class="home-hero-tags">
                    <span data-i18n="home.tag_easy_booking">Servicios del catálogo</span>
                    <span data-i18n="home.tag_reliable">Acceso a tu cuenta</span>
                    <span data-i18n="home.tag_followup">Gestión de citas</span>
                </div>
            </div>

            <aside class="home-hero-visual" aria-label="Servicios odontológicos activos">
                <div class="home-hero-orbit home-hero-orbit-outer"></div>
                <div class="home-hero-orbit home-hero-orbit-inner"></div>
                <div class="home-tooth-art" aria-hidden="true">
                    <svg viewBox="0 0 100 100" role="presentation">
                        <path d="M50 8c-10 0-15 6-22 6-10 0-17 8-16 20 1 11 8 19 12 30 4 11 5 28 13 28 7 0 7-23 13-23s6 23 13 23c8 0 9-17 13-28 4-11 11-19 12-30 1-12-6-20-16-20-7 0-12-6-22-6Z" />
                        <path class="home-tooth-shine" d="M31 25c-5 5-6 13-3 19" />
                    </svg>
                </div>
                <div class="home-hero-service-card">
                    <div class="home-hero-service-heading">
                        <span class="material-symbols-outlined" aria-hidden="true">medical_services</span>
                        <div>
                            <span data-i18n="home.glass_services_title">Servicios activos</span>
                            <small>@Model.Services.Count <span data-i18n="home.active_services_label">en el catálogo</span></small>
                        </div>
                    </div>
                    @if (Model.Services.Count == 0)
                    {
                        <p class="home-empty-preview" data-i18n="home.services_empty">
                            Los servicios aparecerán aquí cuando se registren y activen en el catálogo.
                        </p>
                    }
                    else
                    {
                        @foreach (var service in Model.Services.Take(3))
                        {
                            <div class="home-hero-service-row">
                                <span class="home-service-dot" aria-hidden="true"></span>
                                <div>
                                    <strong>@service.Name</strong>
                                    <small>@service.DurationMinutes min · @service.Category</small>
                                </div>
                                <span class="home-service-price">@service.Price.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</span>
                            </div>
                        }
                    }
                    <a class="home-card-link" href="#servicios" data-i18n="home.view_services">Ver catálogo</a>
                </div>
                <div class="home-hero-note">
                    <span class="material-symbols-outlined" aria-hidden="true">database</span>
                    <span data-i18n="home.live_catalog">Catálogo actualizado</span>
                </div>
            </aside>
        </div>
    </section>

    <section class="home-trust-strip" id="beneficios" aria-label="Funciones de la plataforma">
        <div class="home-trust-inner">
            <article class="home-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">list_alt</span>
                <div>
                    <strong>@Model.Services.Count</strong>
                    <span data-i18n="home.active_services_label">servicios activos en el catálogo</span>
                </div>
            </article>
            <article class="home-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                <div>
                    <strong data-i18n="home.feature_appointments">Gestión de citas</strong>
                    <span data-i18n="home.feature_appointments_desc">Consulta y administra tus solicitudes desde tu cuenta.</span>
                </div>
            </article>
            <article class="home-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                <div>
                    <strong data-i18n="home.feature_account">Portal personal</strong>
                    <span data-i18n="home.feature_account_desc">Accede con tu cuenta SmileTrack.</span>
                </div>
            </article>
        </div>
    </section>

    <section class="home-journey" aria-labelledby="home-journey-title">
        <div class="home-section-inner">
            <header class="home-section-heading">
                <p class="home-eyebrow" data-i18n="home.journey_eyebrow">Empieza en pocos pasos</p>
                <h2 id="home-journey-title" data-i18n="home.journey_title">Tu atención, más fácil de organizar</h2>
                <p data-i18n="home.journey_desc">Encuentra un servicio y usa tu cuenta para dar seguimiento a tus citas.</p>
            </header>
            <div class="home-journey-grid">
                <article class="home-journey-card">
                    <span class="home-journey-number" aria-hidden="true">01</span>
                    <span class="material-symbols-outlined home-journey-icon" aria-hidden="true">search</span>
                    <h3 data-i18n="home.journey_services_title">Explora los servicios</h3>
                    <p data-i18n="home.journey_services_desc">Consulta el catálogo activo, sus descripciones, duración y precios publicados.</p>
                    <a href="#servicios" data-i18n="home.view_services">Ver catálogo</a>
                </article>
                <article class="home-journey-card">
                    <span class="home-journey-number" aria-hidden="true">02</span>
                    <span class="material-symbols-outlined home-journey-icon" aria-hidden="true">person_add</span>
                    <h3 data-i18n="home.journey_account_title">Crea tu cuenta</h3>
                    <p data-i18n="home.journey_account_desc">Regístrate para acceder a las funciones disponibles para tu perfil.</p>
                    <a href="/acceso-y-seguridad/register" data-i18n="home.hero_register">Crear cuenta</a>
                </article>
                <article class="home-journey-card">
                    <span class="home-journey-number" aria-hidden="true">03</span>
                    <span class="material-symbols-outlined home-journey-icon" aria-hidden="true">calendar_month</span>
                    <h3 data-i18n="home.journey_appointments_title">Gestiona tus citas</h3>
                    <p data-i18n="home.journey_appointments_desc">Accede a tu cuenta para consultar y gestionar tus solicitudes de cita.</p>
                    <a href="/acceso-y-seguridad/login" data-i18n="home.hero_login">Acceder a mi cuenta</a>
                </article>
            </div>
        </div>
    </section>

    <section class="home-services" id="servicios">
        <div class="home-section-inner">
            <header class="home-section-heading">
                <p class="home-eyebrow" data-i18n="home.services_eyebrow">Catálogo</p>
                <h2 data-i18n="home.services_title">Servicios odontológicos</h2>
                <p data-i18n="home.services_subtitle">Información obtenida del catálogo activo de SmileTrack.</p>
            </header>

            @if (Model.Services.Count == 0)
            {
                <div class="home-empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">medical_services</span>
                    <h3 data-i18n="home.services_empty_title">Aún no hay servicios publicados</h3>
                    <p data-i18n="home.services_empty">Los servicios aparecerán aquí cuando se registren y activen en el catálogo.</p>
                </div>
            }
            else
            {
                <div class="home-service-grid">
                    @foreach (var service in Model.Services)
                    {
                        <article class="home-service-card">
                            <div class="home-service-card-icon">
                                <span class="material-symbols-outlined" aria-hidden="true">dentistry</span>
                            </div>
                            <p class="home-service-category">@service.Category</p>
                            <h3>@service.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <p class="home-service-description">@service.Description</p>
                            }
                            <div class="home-service-meta">
                                <span>
                                    <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                                    @service.DurationMinutes min
                                </span>
                                <strong>@service.Price.ToString("C0", CultureInfo.GetCultureInfo("es-CO"))</strong>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="home-steps" id="contacto">
        <div class="home-section-inner home-steps-inner">
            <div>
                <p class="home-eyebrow" data-i18n="home.get_started_eyebrow">Empieza aquí</p>
                <h2 data-i18n="home.get_started_title">Gestiona tu atención desde SmileTrack</h2>
                <p data-i18n="home.get_started_desc">Crea una cuenta o inicia sesión para acceder a las funciones disponibles para tu perfil.</p>
            </div>
            <div class="home-steps-actions">
                <a href="/acceso-y-seguridad/login" class="home-button home-button-light">
                    <span data-i18n="home.hero_login">Acceder a mi cuenta</span>
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
                <a href="/acceso-y-seguridad/register" class="home-steps-login" data-i18n="home.hero_register">Crear cuenta</a>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="@Url.Content("~/js/Publico/homepage.js")" asp-append-version="true" defer></script>
}
