const pqrsForm=$('pqrsForm'),pqrsSuccess=$('pqrsSuccess'),pqrsTicket=$('pqrsTicket'),pqrsResp=$('pqrsResponseEmail');
const toast=$('stToast'),toastMsg=$('stToastMsg');
// Chatbot knowledge
const KB={citas:{kw:['cita','agendar','reservar','hora'],r:'📅 Para agendar: 1) Haz clic en "Agendar cita", 2) Completa el formulario, 3) Te confirmamos por WhatsApp.'},
pagos:{kw:['pago','factura','tarjeta','efectivo','nequi'],r:'💳 Aceptamos: Efectivo, tarjetas, Nequi, Daviplata. Consulta tus pagos en tu cuenta.'},
servicios:{kw:['servicio','limpieza','blanqueamiento','ortodoncia'],r:'🦷 Ofrecemos: Limpieza ($80k), Blanqueamiento ($350k), Ortodoncia y más. ¿Te interesa agendar?'},
horarios:{kw:['horario','abre','cierra','lunes','sábado'],r:'🕒 Lunes-Viernes: 8AM-6PM | Sábados: 9AM-2PM | Urgencias: 300 123 4567'},
urgencias:{kw:['urgencia','dolor','emergencia','ayuda'],r:'🚨 Para urgencias: Llama YA al 300 123 4567 o acude a nuestra sede.'},
ubicacion:{kw:['ubicación','dirección','dónde','carrera'],r:'📍 Estamos en: Cra. 15 #93-47, Oficina 302, Bogotá. También ofrecemos consultas virtuales.'},
fallback:{r:'😅 No entendí. Pregúntame sobre: citas, pagos, servicios, horarios, urgencias o ubicación.'}};
// Utils
const showToast=(m,t='success')=>{if(!toast||!toastMsg)return;const i={success:'✅',error:'❌',warning:'⚠️'};toast.className=`st-toast ${t} show`;$('#stToastIcon').textContent=i[t]||'✅';toastMsg.textContent=m;toast.hidden=false;clearTimeout(toast._t);toast._t=setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>{toast.hidden=true},200)},4000)};
const findReply=t=>{const s=t.toLowerCase().trim();for(const[k,d]of Object.entries(KB)){if(k==='fallback')continue;if(d.kw.some(w=>s.includes(w)))return d.r}return KB.fallback.r};
const addMsg=(txt,user)=>{if(!chatMessages)return;const tm=new Date().toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}),el=document.createElement('div');el.className=`st-message ${user?'user':'bot'}`;el.innerHTML=`<div class="st-msg-avatar">${user?'👤':'🤖'}</div><div class="st-msg-content"><p>${txt.replace(/\n/g,'<br>')}</p><time class="st-msg-time">${tm}</time></div>`;chatMessages.appendChild(el);chatMessages.scrollTop=chatMessages.scrollHeight};
// Modal controls
const openM=m=>{if(m){m.hidden=false;document.body.style.overflow='hidden'}};const closeM=m=>{if(m){m.hidden=true;document.body.style.overflow=''}};
// Openers: usar botón flotante existente para chat (title="Chat")
$$('button[title="Chat"]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();openM(chatModal);if(chatMessages.children.length===0)addMsg('¡Hola! 👋 Soy tu asistente de SmileTrack. ¿En qué puedo ayudarte?',false);setTimeout(()=>chatInput?.focus(),100)}));
// PQRS: agregar botón en footer (sección Compañía)
const footerPqrs=$$('footer a').find(a=>a.textContent.trim()==='Preguntas frecuentes')?.parentElement;
if(footerPqrs){const li=document.createElement('li');li.innerHTML='<a href="#" id="openPqrsLink" class="hover:text-[#a4f0e9] transition-colors">PQRS</a>';footerPqrs.after(li);$('#openPqrsLink')?.addEventListener('click',e=>{e.preventDefault();openM(pqrsModal);if(pqrsForm)pqrsForm.reset();if(pqrsSuccess)pqrsSuccess.hidden=true;pqrsForm.hidden=false})}
// Cerrar modales
chatClose?.addEventListener('click',()=>closeM(chatModal));pqrsClose?.addEventListener('click',()=>closeM(pqrsModal));
$$('.st-modal-overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o){closeM(chatModal);closeM(pqrsModal)}}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeM(chatModal);closeM(pqrsModal)}});
// Chatbot logic
chatForm?.addEventListener('submit',e=>{e.preventDefault();const t=chatInput?.value.trim();if(!t)return;addMsg(t,true);if(chatInput)chatInput.value='';if(typing)typing.hidden=false;setTimeout(()=>{if(typing)typing.hidden=true;addMsg(findReply(t),false);if(t.toLowerCase().includes('urgencia')||t.toLowerCase().includes('dolor'))showToast('🚨 Para emergencias, llama al 300 123 4567','warning')},700)});
$$('.st-quick-btn').forEach(b=>b.addEventListener('click',()=>{const q=b.dataset.q;if(q&&chatInput){chatInput.value=q;chatForm.requestSubmit()}}));
// PQRS form
pqrsForm?.addEventListener('submit',async e=>{e.preventDefault();const btn=pqrsForm.querySelector('button[type="submit"]'),bt=btn?.querySelector('.st-btn-text'),bl=btn?.querySelector('.st-btn-load');try{if(bt&&bl){bt.hidden=true;bl.hidden=false;btn.disabled=true}await new Promise(r=>setTimeout(r,1200));if(pqrsForm)pqrsForm.hidden=true;if(pqrsSuccess){pqrsSuccess.hidden=false;pqrsTicket.textContent=`ST-${new Date().getFullYear()}-${Math.random().toString(36).slice(2,6).toUpperCase()}`;pqrsResp.textContent=$('pqrsEmail')?.value||'tu@email.com'}showToast('✅ PQRS registrada exitosamente','success')}catch(err){console.error('PQRS error',err);showToast('❌ Error al enviar. Intenta de nuevo.','error')}finally{if(bt&&bl){bt.hidden=false;bl.hidden=true;btn.disabled=false}}});
$('#pqrsNew')?.addEventListener('click',()=>{if(pqrsSuccess)pqrsSuccess.hidden=true;if(pqrsForm){pqrsForm.hidden=false;pqrsForm.reset()}});$('#pqrsCancel')?.addEventListener('click',()=>{if(confirm('¿Cancelar esta solicitud?'))closeM(pqrsModal)});$('#stToastClose')?.addEventListener('click',()=>{if(toast){toast.classList.remove('show');setTimeout(()=>{toast.hidden=true},200)}});console.log('✅ SmileTrack: Chatbot+PQRS listos');})();
</script>

  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>

</html>
