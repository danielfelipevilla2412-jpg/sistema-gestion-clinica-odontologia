@{ Layout = null; }

﻿<!DOCTYPE html>
<html class="scroll-smooth" lang="es">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="robots" content="index, follow">
    <meta name="description" content="SmileTrack es la plataforma de gestión odontológica para agendar citas, consultar tratamientos y contactar especialistas con confianza.">
    <meta name="keywords" content="odontología, citas dentales, clínica dental, historial clínico, reserva cita">
    <link rel="canonical" href="https://smiletrack.com/">
    <meta property="og:title" content="SmileTrack | Agenda tu cita dental en línea">
    <meta property="og:description" content="Reserva tu cita, consulta especialistas y gestiona tu salud bucal con seguridad y soporte profesional.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://smiletrack.com/">
    <meta property="og:image" content="https://smiletrack.com/images/logo.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="SmileTrack | Agenda tu cita dental en línea">
    <meta name="twitter:description" content="Reserva tu cita, consulta especialistas y gestiona tu salud bucal con seguridad y soporte profesional.">
    <title>SmileTrack | Agenda cita dental, gestiona tu salud bucal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto+Flex:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/Publico/homepage.css")">
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Dentist",
      "name": "SmileTrack",
      "image": "https://smiletrack.com/images/logo.jpg",
      "description": "Clínica dental en Bogotá que ofrece citas en línea, atención especializada y gestión de historias clínicas.",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Cra. 15 #93-47, Oficina 302",
        "addressLocality": "Bogotá D.C.",
        "addressRegion": "Bogotá",
        "addressCountry": "CO"
      },
      "telephone": "+573001234567",
      "priceRange": "$$",
      "openingHours": [
        "Mo-Fr 08:00-18:00",
        "Sa 09:00-14:00"
      ]
    }
    </script>
</head>

<body class="bg-[#f9f9ff] text-[#021c3a] font-[Roboto_Flex,sans-serif] overflow-x-hidden">

    <!-- ══════════════ HEADER ══════════════ -->
    <header id="site-header" class="fixed top-0 w-full z-50 transition-all duration-300 h-[72px]">
        <div class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-[#c0c7d4]/30 shadow-sm transition-opacity duration-300"
            id="header-bg"></div>
        <nav class="relative flex justify-between items-center px-10 h-full max-w-[1280px] mx-auto gap-6">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3 group">
                <div class="h-10 w-10 rounded-xl overflow-hidden flex items-center justify-center bg-[#005ea4]/10">
                    <img alt="Smile Track Logo" class="h-10 w-auto object-contain" loading="lazy" decoding="async"
                        src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")"
                        onerror="this.onerror=null;this.src='@Url.Content("~/images/logo.jpg")'">
                </div>
                <span class="font-[Montserrat,sans-serif] text-xl font-extrabold text-[#005ea4] tracking-tight">Smile
                    Track</span>
            </a>

            <!-- Nav links -->
            <div class="hidden md:flex items-center gap-8">
                <a class="nav-link text-sm font-semibold text-[#404752] hover:text-[#005ea4] transition-colors"
                    href="#servicios">Servicios</a>
                <a class="nav-link text-sm font-semibold text-[#404752] hover:text-[#005ea4] transition-colors"
                    href="#profesionales">Profesionales</a>
                <a class="nav-link text-sm font-semibold text-[#404752] hover:text-[#005ea4] transition-colors"
                    href="#testimonios">Testimonios</a>
                <a class="nav-link text-sm font-semibold text-[#404752] hover:text-[#005ea4] transition-colors"
                    href="#nosotros">Nosotros</a>
                <a class="nav-link text-sm font-semibold text-[#404752] hover:text-[#005ea4] transition-colors"
                    href="#contacto">Contacto</a>
            </div>

            <!-- CTA buttons -->
            <div class="flex items-center gap-3">
                <a href="/acceso-y-seguridad/login"
                    class="hidden sm:inline-flex items-center gap-1.5 border border-[#005ea4] text-[#005ea4] px-5 py-2 rounded-xl text-sm font-bold hover:bg-[#005ea4]/8 transition-all active:scale-95">
                    <span class="material-symbols-outlined text-base">login</span>
                    Iniciar sesión
                </a>
                <a href="#contacto"
                    class="inline-flex items-center gap-1.5 bg-[#005ea4] text-white px-5 py-2 rounded-xl text-sm font-bold hover:bg-[#004881] transition-all active:scale-95 shadow-md hover:shadow-lg">
                    <span class="material-symbols-outlined text-base">calendar_month</span>
                    Agendar cita
                </a>
            </div>
        </nav>
    </header>

    <!-- Floating side buttons -->
    <div class="fixed right-0 top-1/2 -translate-y-1/2 z-40 flex flex-col gap-3 mr-5">
        <button
            class="bg-white text-[#021c3a] p-3 rounded-xl shadow-lg hover:shadow-xl hover:-translate-x-1 transition-all active:scale-95"
            title="Chat">
            <span class="material-symbols-outlined text-xl">chat_bubble</span>
        </button>
        <button
            class="bg-white text-[#005ea4] p-3 rounded-xl shadow-lg hover:shadow-xl hover:-translate-x-1 transition-all active:scale-95"
            title="Llamar">
            <span class="material-symbols-outlined text-xl">phone</span>
        </button>
    </div>

    <main class="pt-[72px]">

        <!-- ══════════════ HERO ══════════════ -->
        <section class="hero-gradient min-h-[90vh] flex items-center">
            <div class="max-w-[1280px] mx-auto px-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center py-24">
                <div class="text-white z-10">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 rounded-full border border-white/20 mb-8 animate-fade-in-up">
                        <span class="material-symbols-outlined text-sm text-[#a4f0e9]">verified</span>
                        <span class="text-xs font-semibold text-[#a4f0e9] tracking-wide">Clínica certificada · Bogotá,
                            Colombia</span>
                    </div>
                    <h1
                        class="font-[Montserrat,sans-serif] text-5xl lg:text-[52px] font-extrabold leading-[1.1] mb-6 animate-fade-in-up delay-100">
                        Tu salud bucal en manos de <span class="text-[#a4f0e9]">especialistas</span> de confianza
                    </h1>
                    <p class="text-lg text-[#d5e3ff]/80 mb-10 max-w-xl animate-fade-in-up delay-200">
                        Más de 15 años devolviendo sonrisas con diagnóstico digital y tecnología de vanguardia.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up delay-300">
                        <a href="/acceso-y-seguridad/login"
                            class="bg-[#0077ce] text-white px-8 py-4 rounded-xl font-bold hover:bg-[#005ea4] hover:shadow-xl transition-all active:scale-95 flex items-center justify-center gap-2">
                            Iniciar sesión
                            <span class="material-symbols-outlined">login</span>
                        </a>
                        <a href="/acceso-y-seguridad/register"
                            class="bg-white/10 backdrop-blur-sm border border-white/25 text-white px-8 py-4 rounded-xl font-bold hover:bg-white/20 transition-all active:scale-95 text-center">
                            Crear cuenta
                        </a>
                    </div>
                    <div class="mt-6 flex flex-wrap gap-3 text-sm text-[#d5e3ff]/80">
                        <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1">Reserva fácil</span>
                        <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1">Atención confiable</span>
                        <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1">Seguimiento clínico</span>
                    </div>
                    <div class="mt-8 grid gap-3 sm:grid-cols-3">
                        <a href="/acceso-y-seguridad/register" class="rounded-2xl border border-white/15 bg-white/10 px-4 py-4 text-left text-sm text-white hover:bg-white/15 transition focus:outline-none focus:ring-2 focus:ring-[#a4f0e9]/60">
                            <p class="font-semibold">Soy paciente</p>
                            <p class="text-[#d5e3ff]/80 mt-1 text-xs">Crea tu cuenta y agenda tu primera cita.</p>
                        </a>
                        <a href="/acceso-y-seguridad/login" class="rounded-2xl border border-white/15 bg-white/10 px-4 py-4 text-left text-sm text-white hover:bg-white/15 transition focus:outline-none focus:ring-2 focus:ring-[#a4f0e9]/60">
                            <p class="font-semibold">Soy profesional</p>
                            <p class="text-[#d5e3ff]/80 mt-1 text-xs">Accede a tu agenda y controla tus citas.</p>
                        </a>
                        <a href="#contacto" class="rounded-2xl border border-white/15 bg-white/10 px-4 py-4 text-left text-sm text-white hover:bg-white/15 transition focus:outline-none focus:ring-2 focus:ring-[#a4f0e9]/60">
                            <p class="font-semibold">Contacto rápido</p>
                            <p class="text-[#d5e3ff]/80 mt-1 text-xs">Habla con nuestro equipo para resolver tus dudas.</p>
                        </a>
                    </div>
                </div>

                <!-- Glass Card -->
                <div class="relative flex justify-center lg:justify-end animate-fade-in-up delay-500">
                    <div class="glass-card p-8 rounded-3xl w-full max-w-md">
                        <h3
                            class="font-[Montserrat,sans-serif] font-bold text-lg text-white mb-6 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#a2c9ff]">dentistry</span>
                            Servicios destacados
                        </h3>
                        <div class="space-y-3">
                            <div
                                class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors cursor-pointer group">
                                <div class="flex items-center gap-4">
                                    <span class="text-2xl">🪥</span>
                                    <div>
                                        <p class="font-semibold text-white text-sm">Limpieza dental</p>
                                        <p class="text-xs text-[#d5e3ff]/70">Prevención · 45 min</p>
                                    </div>
                                </div>
                                <span class="font-bold text-[#a2c9ff] text-sm">Desde $80k</span>
                            </div>
                            <div
                                class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors cursor-pointer">
                                <div class="flex items-center gap-4">
                                    <span class="text-2xl">✨</span>
                                    <div>
                                        <p class="font-semibold text-white text-sm">Blanqueamiento</p>
                                        <p class="text-xs text-[#d5e3ff]/70">Estética · 90 min</p>
                                    </div>
                                </div>
                                <span class="font-bold text-[#a2c9ff] text-sm">Desde $350k</span>
                            </div>
                            <div
                                class="flex items-center justify-between p-4 bg-white/5 rounded-2xl border border-white/10 hover:bg-white/10 transition-colors cursor-pointer">
                                <div class="flex items-center gap-4">
                                    <span class="text-2xl">🦷</span>
                                    <div>
                                        <p class="font-semibold text-white text-sm">Ortodoncia</p>
                                        <p class="text-xs text-[#d5e3ff]/70">Corrección · Plan mes</p>
                                    </div>
                                </div>
                                <span class="font-bold text-[#a2c9ff] text-sm">Desde $200k/mes</span>
                            </div>
                        </div>
                        <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between">
                            <div class="flex -space-x-3">
                                <div class="w-9 h-9 rounded-full border-2 border-[#021c3a] overflow-hidden">
                                    <img class="w-full h-full object-cover"
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJ0fnRd4JV9g461RdOVbYVclqZkk5CnSMxrgvTc86s37F285MIj1Zjfjarl_dpFmd4I5oLxrEfUMoC8-yoS-BCpQkt2oL4uHibCMUTHgqUUYWwRWM0P16xsdVlsgV00cr2vL1kcyrkcNefk3y7K3BVfQMfUddWsWVHjbAv0oYo_wOto7KGBDWl8lURw7RbKAv6bfY89aNp8p3rCktZscEzdqYbk8pRiPaYEjF4HNJedbzt2jKRShEIwkomuDj6NAwcLX39PcgUPQ"
                                        alt="Especialista">
                                </div>
                                <div class="w-9 h-9 rounded-full border-2 border-[#021c3a] overflow-hidden">
                                    <img class="w-full h-full object-cover"
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuDSErmwZfefFsds9d1aCAyLOFWl51yIhVzYBly5Y39iNSG6P4aZk9mXLhIs6T0T9_AIHXlgVAK-moPstWdCDZD2WIkiWTnGGYR3Pnf4RP69gR3irvmyCnfhhjIMz2-aqDapCHqF4quMQqCzwprjfBIZ0M9N1KBt-bLouFcFY-tnwpQaJU2KqcwiRJNv3WKPdVzAvrEWrMHt3zavsZFhhPshmnyfcn6o8YIhMPRMhY9_OEUOCMOl6sY2OlXOARYXQB0Yqk7utqhQ0w"
                                        alt="Especialista">
                                </div>
                            </div>
                            <p class="text-xs text-[#d5e3ff]/70 font-medium">Consultar con especialistas →</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════ TRUST STRIP ══════════════ -->
        <div class="bg-[#1a3150] py-10 px-10">
            <div class="max-w-[1280px] mx-auto flex flex-wrap justify-between gap-10 text-white">
                <div class="flex items-center gap-4 flex-1 min-w-[180px]">
                    <span class="material-symbols-outlined text-[#a4f0e9] text-4xl">group</span>
                    <div>
                        <p class="font-[Montserrat,sans-serif] text-2xl font-bold">+2.400</p>
                        <p class="text-sm text-[#d5e3ff]/60">Pacientes atendidos</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 flex-1 min-w-[180px]">
                    <span class="material-symbols-outlined text-[#a4f0e9] text-4xl">star</span>
                    <div>
                        <p class="font-[Montserrat,sans-serif] text-2xl font-bold">4.9/5.0</p>
                        <p class="text-sm text-[#d5e3ff]/60">Calificación Google</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 flex-1 min-w-[180px]">
                    <span class="material-symbols-outlined text-[#a4f0e9] text-4xl">medical_services</span>
                    <div>
                        <p class="font-[Montserrat,sans-serif] text-2xl font-bold">15 años</p>
                        <p class="text-sm text-[#d5e3ff]/60">De experiencia clínica</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 flex-1 min-w-[180px]">
                    <span class="material-symbols-outlined text-[#a4f0e9] text-4xl">verified_user</span>
                    <div>
                        <p class="font-[Montserrat,sans-serif] text-2xl font-bold">INVIMA</p>
                        <p class="text-sm text-[#d5e3ff]/60">Habilitados y certificados</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════ SERVICES ══════════════ -->
        <section class="py-24 bg-[#F5F7FA]" id="servicios">
            <div class="max-w-[1280px] mx-auto px-10">
                <div class="mb-16">
                    <p class="text-[#005ea4] text-xs font-bold mb-3 uppercase tracking-widest">Lo que hacemos</p>
                    <h2 class="font-[Montserrat,sans-serif] text-3xl font-bold text-[#021c3a] mb-4">Tratamientos que
                        cambian sonrisas</h2>
                    <p class="max-w-2xl text-[#404752]">Ofrecemos soluciones odontológicas de alta precisión, desde
                        prevención básica hasta estética avanzada.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Card -->
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">cleaning_services</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Limpieza dental</h3>
                            <span class="text-[#005ea4] font-bold text-sm">$80.000</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Elimina el sarro y placa bacteriana que el cepillo no
                            alcanza.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Para
                            toda la familia</span>
                    </div>
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">auto_fix_high</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Blanqueamiento</h3>
                            <span class="text-[#005ea4] font-bold text-sm">$350.000</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Recupera el brillo natural de tus dientes de forma segura
                            y efectiva.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Estética
                            avanzada</span>
                    </div>
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">straighten</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Ortodoncia</h3>
                            <span class="text-[#005ea4] font-bold text-sm">$200k/mes</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Corrección de la posición dental con técnicas fijas e
                            invisibles.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Niños
                            y adultos</span>
                    </div>
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">healing</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Endodoncia</h3>
                            <span class="text-[#005ea4] font-bold text-sm">$450.000</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Tratamiento de conductos para salvar piezas dentales
                            comprometidas.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Alta
                            precisión</span>
                    </div>
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">sentiment_very_satisfied</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Implantes</h3>
                            <span class="text-[#005ea4] font-bold text-sm">$2.800.000</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Reemplaza piezas perdidas con implantes de titanio de
                            larga duración.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Solución
                            permanente</span>
                    </div>
                    <div
                        class="bg-white p-8 rounded-2xl card-shadow border border-[#c0c7d4]/30 hover:border-[#005ea4] hover:-translate-y-1 transition-all group">
                        <div
                            class="w-12 h-12 bg-[#005ea4]/10 rounded-xl flex items-center justify-center mb-6 text-[#005ea4] group-hover:bg-[#005ea4] group-hover:text-white transition-colors">
                            <span class="material-symbols-outlined">child_care</span>
                        </div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="font-[Montserrat,sans-serif] text-lg font-bold">Odontopediatría</h3>
                            <span class="text-[#005ea4] font-bold text-sm">Desde $60k</span>
                        </div>
                        <p class="text-[#404752] text-sm mb-5">Cuidado dental especializado para los más pequeños del
                            hogar.</p>
                        <span
                            class="px-3 py-1 bg-[#d5e3ff]/50 text-[#005ea4] text-xs font-bold rounded-full uppercase">Niños
                            0–12 años</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════ PROFESSIONALS ══════════════ -->
        <section class="py-24 bg-white" id="profesionales">
            <div class="max-w-[1280px] mx-auto px-10">
                <div class="text-center mb-16">
