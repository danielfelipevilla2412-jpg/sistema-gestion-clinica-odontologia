@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.Entities.Usuario
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Perfil";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Perfiles/st-aux-11-perfil-auxiliar/mi-perfil.css" asp-append-version="true" />
}

<main class="main aux-profile" id="main-content">

    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_auxiliar">Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" aria-current="page" data-i18n="profile.title">Mi perfil</span>
        </nav>
        <h1 class="page-title" data-i18n="profile.title">Mi Perfil</h1>
        <p class="page-subtitle" data-i18n="profile.subtitle">Gestiona tu informaci&#243;n personal y acceso al sistema.</p>
      </div>
    </header>

    <div>

      <section class="profile-card" aria-labelledby="personalDataTitle">
        <div class="profile-header">
          <div class="avatar-large" aria-hidden="true">@(Model.Nombre.FirstOrDefault())@(Model.Apellidos.FirstOrDefault())</div>
          <h2 class="profile-title" id="personalDataTitle" data-i18n="common.personal_data">Datos personales</h2>
          <a class="btn-edit" href="?editar=true#editarPerfil"><span class="material-symbols-outlined edit-icon" aria-hidden="true">edit</span> Editar</a>
        </div>

        <div class="profile-content">
          @if (TempData["PerfilAuxiliarMensaje"] is string mensaje)
          {
            <p role="status">@mensaje</p>
          }
          @if (Context.Request.Query["editar"] == "true" || ViewData["EditarPerfil"] is true)
          {
          <form method="post" id="editarPerfil" action="@Url.Action("GuardarPerfilAuxiliar", "Perfiles")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="info-grid">
              <div class="form-group"><label class="info-label" for="nombre">Nombres</label><input class="form-input" id="nombre" name="nombre" value="@Model.Nombre" maxlength="100" required /></div>
              <div class="form-group"><label class="info-label" for="apellidos">Apellidos</label><input class="form-input" id="apellidos" name="apellidos" value="@Model.Apellidos" maxlength="100" required /></div>
            </div>
            <p class="aux-profile-actions"><button class="btn-edit" type="submit">Guardar</button> <a class="btn-edit" href="@Url.Action("Staux11PerfilAuxiliar", "Perfiles")">Cancelar</a></p>
          </form>
          }
          else
          {
            <dl class="info-grid">
              <div class="info-group"><dt class="info-label">Nombres</dt><dd class="info-value">@Model.Nombre</dd></div>
              <div class="info-group"><dt class="info-label">Apellidos</dt><dd class="info-value">@Model.Apellidos</dd></div>
              <div class="info-group"><dt class="info-label">Correo electrónico</dt><dd class="info-value">@Model.Correo</dd></div>
              <div class="info-group"><dt class="info-label">Fecha de ingreso</dt><dd class="info-value">@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd></div>
              <div class="info-group"><dt class="info-label">Estado</dt><dd class="info-value"><span class="status-badge @(string.Equals(Model.Estado, "activo", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><span class="status-dot" aria-hidden="true"></span>@(string.Equals(Model.Estado, "activo", StringComparison.OrdinalIgnoreCase) ? "Activo" : Model.Estado)</span></dd></div>
            </dl>
          }
        </div>
      </section>

    </div>

  </main>

  <!-- Mobile bottom nav con aria-label para navegación móvil -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">space_dashboard</span>
      <span>Panel</span>
    </a>
    <a href="/gestion-de-citas/st-aux-02-agenda-apoyo" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">calendar_month</span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-aux-10-citas-finalizadas" class="mobile-nav-item">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">check_circle</span>
      <span>Finalizadas</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">person</span>
      <span>Perfil</span>
    </a>
  </nav>

