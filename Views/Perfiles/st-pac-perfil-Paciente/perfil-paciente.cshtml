@model SmileTrack_MVC.Models.Entities.Paciente
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Mi Perfil - SmileTrack Paciente: Consulta y edita tu información personal" />
  <title>Mi Perfil — SmileTrack Paciente</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Perfiles/st-pac-perfil-Paciente/perfil-paciente.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>
<body>
  @{ await Html.RenderPartialAsync("~/Views/shared/_LangSwitcher.cshtml"); }
  <a href="#main-content" class="skip-link" data-i18n="common_skip_link">Saltar al contenido principal</a>

  <!-- ═════ SIDEBAR DEL PACIENTE (Activo: Mi Perfil) ═════ -->
  @{ await Html.RenderPartialAsync("_SidebarPaciente"); }

  <!-- Overlay móvil -->
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- Hamburger -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span></span><span></span><span></span>
  </button>

  <!-- ═══ MAIN ═══ -->
  <main class="main" id="main-content">
    <!-- Breadcrumb -->
    <div class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
      <span data-i18n="nav.group_inicio">Inicio</span>
      <span class="sep" aria-hidden="true">→</span>
      <span class="current" data-i18n="profile.title">Mi Perfil</span>
    </div>

    <!-- Profile Header -->
    @{
    var iniciales = $"{(string.IsNullOrEmpty(Model.Nombres) ? "" : Model.Nombres[0].ToString())}{(string.IsNullOrEmpty(Model.Apellidos) ? "" : Model.Apellidos[0].ToString())}".ToUpperInvariant();
    var estadoTexto = Model.Estado == "activo" ? "Paciente activo" : "Paciente inactivo";
    var odontologoTexto = Model.ProfesionalAsignado != null
        ? $"Dr(a). {Model.ProfesionalAsignado.Nombres} {Model.ProfesionalAsignado.Apellidos}"
        : "Sin asignar";
      }
      <div class="header-avatar" id="headerAvatar">@iniciales</div>
      <div>
        <h1 class="header-name" id="headerNombre">@Model.Nombres @Model.Apellidos</h1>
        <p class="header-sub">
          @estadoTexto · Odontólogo: <span>@odontologoTexto</span>
        </p>
      </div>
      </div>
      <div class="header-actions">
        <button class="btn-editar" id="btnEditar" aria-label="Activar modo edición" data-i18n-aria-label="profile.edit"><span data-i18n="profile.edit">✏️ Editar perfil</span></button>
        <button class="btn-guardar" id="btnGuardar" aria-label="Guardar cambios" data-i18n-aria-label="common.save"><span data-i18n="common.save">💾 Guardar</span></button>
        <button class="btn-cancelar" id="btnCancelar" aria-label="Cancelar edición" data-i18n-aria-label="common.cancel"><span data-i18n="common.cancel">✕ Cancelar</span></button>
      </div>
    </header>

    <!-- Main Grid -->
    <div class="main-grid">

      <!-- Columna izquierda -->
      <div class="left-col">

        <!-- Card: Datos personales -->
        <div class="card" id="cardPersonal">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">👤</span> <span data-i18n="common.personal_data">Datos personales</span></h2>

          <!-- Avatar Upload (oculto fuera de edición) -->
          <div class="avatar-upload" id="avatarUpload" style="display:none;">
            <div class="avatar-preview" id="avatarPreview">PG</div>
            <div class="avatar-upload-actions">
              <label class="btn-upload" tabindex="0" role="button" aria-label="Subir foto de perfil">
                📷 Cambiar foto
                <input type="file" id="avatarInput" accept="image/*" style="display:none;" />
              </label>
              <span class="upload-hint">JPG, PNG. Máx 2MB</span>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="nombre">Nombre completo</label>
              <input class="form-input" id="nombre" type="text" value="@Model.Nombres @Model.Apellidos" disabled disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="cedula">Número de cédula</label>
              <input class="form-input locked" id="cedula" type="text" value="@Model.Documento" disabled disabled />
              <span class="field-note">🔒 No editable</span>
            </div>
            <div class="form-group">
              <label class="form-label" for="fechaNac">Fecha de nacimiento</label>
              <input class="form-input locked" id="fechaNac" type="text" value="@Model.FechaNacimiento.ToString("dd/MM/yyyy")" disabled disabled />
              <span class="field-note">🔒 No editable</span>
            </div>
            <div class="form-group">
              <label class="form-label" for="genero">Género</label>
              <select class="form-input" id="genero" disabled>
              <option value="M" selected="@(Model.Genero == "M")">Masculino</option>
              <option value="F" selected="@(Model.Genero == "F")">Femenino</option>
              <option value="O" selected="@(Model.Genero == "O")">Otro</option>
            </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="tipoSangre">Tipo de sangre</label>
              @{ var tiposSangre = new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" }; }
              <select class="form-input locked" id="tipoSangre" disabled>
                @foreach (var tipo in tiposSangre)
                {
                    <option value="@tipo" selected="@(Model.GrupoSanguineo == tipo)">@tipo</option>
                }
              </select>
              <span class="field-note">🔒 No editable</span>
            </div>
            <div class="form-group">
              <label class="form-label" for="estadoCivil">Estado civil</label>
              @{
                var estadosCiviles = new (string valor, string texto)[] {
                    ("soltero", "Soltero/a"), ("casado", "Casado/a"), ("union-libre", "Unión libre"),
                    ("divorciado", "Divorciado/a"), ("viudo", "Viudo/a")
                };
            }
            <select class="form-input" id="estadoCivil" disabled>
              @foreach (var (valor, texto) in estadosCiviles)
              {
                  <option value="@valor" selected="@(Model.EstadoCivil == valor)">@texto</option>
              }
            </select>
            </div>
          </div>
        </div>

        <!-- Card: Información de contacto -->
        <div class="card" id="cardContacto">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">📞</span> Información de contacto</h2>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="email">Correo electrónico</label>
              <input class="form-input" id="email" type="email" @Model.Correo disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="telefono">Teléfono</label>
              <input class="form-input" id="telefono" type="tel" 	@Model.Telefono disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="direccion">Dirección</label>
              <input class="form-input" id="direccion" type="text" @Model.Direccion disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="ciudad">Ciudad</label>
              <input class="form-input" id="ciudad" type="text" @Model.Ciudad disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="departamento">Departamento</label>
              <input class="form-input" id="departamento" type="text" @Model.Departamento disabled />
            </div>
          </div>
        </div>

        <!-- Card: Contacto de emergencia -->
        <div class="card" id="cardEmergencia">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">🚨</span> Contacto de emergencia</h2>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="emergNombre">Nombre</label>
              <input class="form-input" id="emergNombre" type="text" 	@Model.ContactoEmergencia disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="emergParentesco">Parentesco</label>
              <input class="form-input" id="emergParentesco" type="text" @Model.ParentescoEmergencia disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="emergTelefono">Teléfono</label>
              <input class="form-input" id="emergTelefono" type="tel" @Model.TelefonoEmergencia disabled />
            </div>
          </div>
        </div>

      </div>

      <!-- Columna derecha -->
      <div class="right-col">

        <!-- Card: Información médica (solo lectura) -->
        <div class="card" id="cardMedica">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">🏥</span> Información médica</h2>
          <div class="info-readonly-note">
            🔒 Esta información solo puede ser modificada por tu odontólogo
          </div>

          @{
            var alergias = (Model.Alergias ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var condiciones = (Model.AntecedentesMedicos ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var medicamentos = (Model.MedicamentosActuales ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var antecedentesFam = (Model.AntecedentesFamiliares ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }

        <div class="med-section">
          <div class="med-label">Alergias</div>
          <div class="tags-wrap">
            @if (alergias.Length == 0) { <span class="tag neutral">Sin alergias registradas</span> }
            @foreach (var a in alergias) { <span class="tag alerta">⚠️ @a</span> }
          </div>
        </div>

        <div class="med-section">
          <div class="med-label">Enfermedades o condiciones</div>
          <div class="tags-wrap">
            @if (condiciones.Length == 0) { <span class="tag neutral">Ninguna registrada</span> }
            @foreach (var c in condiciones) { <span class="tag info">@c</span> }
          </div>
        </div>

        <div class="med-section">
          <div class="med-label">Medicamentos actuales</div>
          <div class="tags-wrap">
            @if (medicamentos.Length == 0) { <span class="tag neutral">Ninguno registrado</span> }
            @foreach (var m in medicamentos) { <span class="tag neutral">@m</span> }
          </div>
        </div>

        <div class="med-section">
          <div class="med-label">Antecedentes familiares</div>
          <div class="tags-wrap">
            @if (antecedentesFam.Length == 0) { <span class="tag neutral">Ninguno registrado</span> }
            @foreach (var af in antecedentesFam) { <span class="tag neutral">@af</span> }
          </div>
        </div>
        <!-- Card: Seguro / EPS -->
        <div class="card" id="cardSeguro">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">🏦</span> Seguro / EPS</h2>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="eps">EPS / Aseguradora</label>
              <input class="form-input" id="eps" type="text" value="@Model.EpsAseguradora" disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="poliza">Número de póliza</label>
              <input class="form-input" id="poliza" type="text" value="@Model.NumeroPoliza" disabled />
            </div>
            <div class="form-group">
              <label class="form-label" for="afiliacion">Tipo de afiliación</label>
              @{
                var afiliaciones = new (string valor, string texto)[] {
                    ("contributivo", "Régimen contributivo"), ("subsidiado", "Régimen subsidiado"), ("particular", "Particular")
                };
            }
            <select class="form-input" id="afiliacion" disabled>
              @foreach (var (valor, texto) in afiliaciones)
              {
                  <option value="@valor" selected="@(Model.TipoAfiliacion == valor)">@texto</option>
              }
            </select>
            </div>
          </div>
        </div>

        <!-- Card: Seguridad -->
        <div class="card" id="cardSeguridad">
          <h2 class="card-title"><span class="card-icon" aria-hidden="true">🔑</span> Seguridad</h2>
          <div class="form-grid" style="grid-template-columns: 1fr;">
            <div class="form-group">
              <label class="form-label" for="passActual">Contraseña actual</label>
              <div class="pass-wrap">
                <input class="form-input" id="passActual" type="password" placeholder="••••••••" disabled />
                <button type="button" class="btn-eye" onclick="togglePass('passActual', this)" aria-label="Mostrar contraseña">👁️</button>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="passNueva">Nueva contraseña</label>
              <div class="pass-wrap">
                <input class="form-input" id="passNueva" type="password" placeholder="Mínimo 8 caracteres" disabled />
                <button type="button" class="btn-eye" onclick="togglePass('passNueva', this)" aria-label="Mostrar contraseña">👁️</button>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="passConfirm">Confirmar contraseña</label>
              <div class="pass-wrap">
                <input class="form-input" id="passConfirm" type="password" placeholder="Repite la contraseña" disabled />
                <button type="button" class="btn-eye" onclick="togglePass('passConfirm', this)" aria-label="Mostrar contraseña">👁️</button>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Mobile Nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">🏠</span>
      <span>Inicio</span>
    </a>
    <a href="/perfiles/st-pac-perfil-paciente" class="mobile-nav-item active">
      <span class="mobile-nav-icon" aria-hidden="true">👤</span>
      <span>Perfil</span>
    </a>
    <a href="/gestion-de-citas/st-pac-01-mis-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Citas</span>
    </a>
    <a href="/historia-clinica/st-pac-02-historial" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-citas/st-pac-03-notificaciones" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">🔔</span>
      <span>Avisos</span>
    </a>
  </nav>
  <script src="@Url.Content("~/js/Perfiles/st-pac-perfil-Paciente/perfil-paciente.js")"></script>
  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
  <script src="@Url.Content("~/js/i18n-core.js")"></script>
  <script src="@Url.Content("~/js/i18n.config.js")"></script>
</body>
</html>

