@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.Entities.Usuario
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Perfil";
    ViewData["Description"] = "Consulta y edita tu información de recepcionista en SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Perfiles/st-rec-06-perfil-recepcionista/perfil-recepcionista.css" asp-append-version="true" />
}

<main class="main" id="main-content">

  <!-- Page header -->
  <header class="page-header">
    <div class="header-left">
      <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="common.breadcrumb_nav">
        <span data-i18n="common_role_recepcionista">Recepción</span>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span class="bc-active" aria-current="page" data-i18n="profile.title">Mi perfil</span>
      </nav>
      <h1 class="page-title" data-i18n="profile.title">Mi Perfil</h1>
      <p class="page-subtitle" data-i18n="rec_profile.subtitle">Gestiona tu información personal y preferencias de cuenta</p>
    </div>
  </header>

  <!-- Layout de perfil -->
  <div class="profile-layout">

    <!-- Columna izquierda: Tarjeta de perfil -->
    <aside class="profile-card" aria-labelledby="profileHeading">
      <h2 id="profileHeading" class="visually-hidden" data-i18n="rec_profile.info_heading">Información del perfil</h2>
      <div class="profile-avatar-large" id="profileAvatar" aria-label="Foto de perfil" data-i18n-aria-label="pac_profile.photo_alt">RE</div>
      <p class="profile-name" id="profileName">Recepcionista</p>
      <p class="profile-role" data-i18n="rec_profile.role_value">Recepción — SmileTrack</p>
      <p class="profile-email" id="profileEmail">recepcion@smiletrack.co</p>
      <button class="btn-upload" id="btnUploadPhoto" type="button" aria-label="Cambiar foto de perfil" data-i18n-aria-label="pac_profile.change_photo">
        <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span>
        <span data-i18n="pac_profile.change_photo">Cambiar foto</span>
      </button>
      <input type="file" id="fileInput" accept="image/*" class="visually-hidden"
        aria-label="Seleccionar imagen de perfil" data-i18n-aria-label="rec_profile.select_image_aria" />
    </aside>

    <!-- Columna derecha: Formularios -->
    <div class="profile-main">

      <!-- Formulario: Datos personales -->
      <section class="profile-form" aria-labelledby="personalDataTitle">
        <h3 class="profile-form-title" id="personalDataTitle" data-i18n="common.personal_data">Datos personales</h3>
        <form id="profileForm" class="modal-form" novalidate>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="nombre" data-i18n="rec_profile.full_name">Nombre completo</label>
              <input type="text" id="nombre" name="nombre" class="form-input" value="Recepcionista"
                autocomplete="name" />
            </div>
            <div class="form-group">
              <label class="form-label" for="cargo" data-i18n="rec_profile.position">Cargo</label>
              <input type="text" id="cargo" name="cargo" class="form-input" value="Recepción"
                autocomplete="organization-title" />
            </div>
            <div class="form-group">
              <label class="form-label" for="email" data-i18n="common.email">Correo electrónico</label>
              <input type="email" id="email" name="email" class="form-input"
                value="recepcion@smiletrack.co" autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label" for="telefono" data-i18n="common.phone">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" class="form-input"
                value="+57 300 123 4567" autocomplete="tel" />
            </div>
            <div class="form-group full-width">
              <label class="form-label" for="bio" data-i18n="rec_profile.bio">Biografía</label>
              <textarea id="bio" name="bio" class="form-textarea"
                placeholder="Cuéntanos sobre ti..." data-i18n-ph="rec_profile.bio_ph">Encargada de recepción en SmileTrack. Apasionada por la atención al paciente.</textarea>
            </div>
          </div>
          <div class="form-actions">
            <button type="button" class="btn-secondary" id="btnCancel" data-i18n="common.cancel">Cancelar</button>
            <button type="submit" class="btn-primary" id="btnSaveProfile">
              <span class="material-symbols-outlined" aria-hidden="true">save</span>
              <span data-i18n="common.save">Guardar cambios</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Sección: Preferencias -->
      <section class="profile-form preferences-section" aria-labelledby="preferencesTitle">
        <h3 class="profile-form-title" id="preferencesTitle">
          <span class="material-symbols-outlined" aria-hidden="true">settings</span>
          <span data-i18n="rec_profile.preferences">Preferencias</span>
        </h3>

        <div class="preference-item">
          <div>
            <p class="preference-label" data-i18n="rec_profile.notif_email">Notificaciones por correo</p>
            <p class="preference-desc" data-i18n="rec_profile.notif_email_desc">Recibir recordatorios y alertas por email</p>
          </div>
          <button class="toggle-switch active" id="toggleEmail" type="button" role="switch" aria-checked="true"
            aria-label="Activar notificaciones por correo" data-i18n-aria-label="rec_profile.notif_email_aria">
            <span class="visually-hidden" data-i18n="rec_profile.notif_email_state">Notificaciones por correo: activado</span>
          </button>
        </div>

        <div class="preference-item">
          <div>
            <p class="preference-label" data-i18n="rec_profile.notif_sms">Notificaciones SMS</p>
            <p class="preference-desc" data-i18n="rec_profile.notif_sms_desc">Recibir alertas urgentes por mensaje de texto</p>
          </div>
          <button class="toggle-switch" id="toggleSMS" type="button" role="switch" aria-checked="false"
            aria-label="Activar notificaciones SMS" data-i18n-aria-label="rec_profile.notif_sms_aria">
            <span class="visually-hidden" data-i18n="rec_profile.notif_sms_state">Notificaciones SMS: desactivado</span>
          </button>
        </div>

        <div class="preference-item">
          <div>
            <p class="preference-label" data-i18n="rec_profile.dark_mode">Modo oscuro</p>
            <p class="preference-desc" data-i18n="rec_profile.dark_mode_desc">Activar tema oscuro en la interfaz</p>
          </div>
          <button class="toggle-switch" type="button" role="switch" data-theme-toggle aria-checked="false" aria-label="Modo oscuro" hidden></button>
        </div>
      </section>

      <!-- Sección: Historial de actividad -->
      <section class="activity-section" aria-labelledby="activityTitle">
        <h3 class="activity-section-title" id="activityTitle">
          <span class="material-symbols-outlined" aria-hidden="true">history</span>
          <span data-i18n="rec_profile.activity_title">Actividad reciente</span>
        </h3>
        <div class="activity-list" role="list" aria-label="Lista de actividades recientes" data-i18n-aria-label="rec_profile.activity_list_aria">
          <div class="activity-item" role="listitem">
            <span class="activity-icon material-symbols-outlined" aria-hidden="true">login</span>
            <div class="activity-info">
              <p class="activity-title" data-i18n="rec_profile.activity_login">Inicio de sesión</p>
              <p class="activity-time"><time datetime="2026-03-20T09:47" data-i18n="rec_profile.activity_login_time">Hoy, 09:47 AM</time> —
                Bogotá, CO</p>
            </div>
          </div>
          <div class="activity-item" role="listitem">
            <span class="activity-icon material-symbols-outlined" aria-hidden="true">edit</span>
            <div class="activity-info">
              <p class="activity-title" data-i18n="rec_profile.activity_profile_updated">Perfil actualizado</p>
              <p class="activity-time"><time datetime="2026-03-19T15:22" data-i18n="rec_profile.activity_updated_time">Ayer, 03:22 PM</time></p>
            </div>
          </div>
          <div class="activity-item" role="listitem">
            <span class="activity-icon material-symbols-outlined" aria-hidden="true">settings</span>
            <div class="activity-info">
              <p class="activity-title" data-i18n="rec_profile.activity_prefs_updated">Preferencias modificadas</p>
              <p class="activity-time"><time datetime="2026-03-15T11:05" data-i18n="rec_profile.activity_prefs_time">15 Mar, 11:05 AM</time></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Sección: Zona de peligro -->
      <section class="danger-section" aria-labelledby="dangerTitle">
        <h3 class="danger-section-title" id="dangerTitle">
          <span class="material-symbols-outlined" aria-hidden="true">warning</span>
          <span data-i18n="rec_profile.danger_title">Zona de peligro</span>
        </h3>
        <p class="danger-section-desc" data-i18n="rec_profile.danger_desc">Estas acciones son irreversibles. Por favor, procede con precaución.</p>
        <div class="danger-actions">
          <button class="btn-danger" id="btnLogoutAll" type="button"
            aria-label="Cerrar sesión en todos los dispositivos" data-i18n-aria-label="rec_profile.logout_all_aria">
            <span class="material-symbols-outlined" aria-hidden="true">logout</span>
            <span data-i18n="rec_profile.logout_all">Cerrar sesión en todos</span>
          </button>
          <button class="btn-danger" id="btnDeleteAccount" type="button"
            aria-label="Eliminar cuenta permanentemente" data-i18n-aria-label="rec_profile.delete_account_aria">
            <span class="material-symbols-outlined" aria-hidden="true">delete_forever</span>
            <span data-i18n="rec_profile.delete_account">Eliminar cuenta</span>
          </button>
        </div>
      </section>

    </div>
  </div>

</main>

@section Scripts {
  <script src="~/js/Perfiles/st-rec-06-perfil-recepcionista/perfil-recepcionista.js" asp-append-version="true"></script>
}
