@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq
@model IEnumerable<SmileTrack_MVC.Models.ViewModels.PacienteViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Pacientes";
    ViewData["Description"] = "Gestiona y consulta el historial de pacientes atendidos en SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var esRecepcionista = User.IsInRole("Recepcionista");
    var pacientes = (Model ?? Enumerable.Empty<SmileTrack_MVC.Models.ViewModels.PacienteViewModel>()).ToList();
    var pacientesJson = System.Text.Json.JsonSerializer.Serialize(pacientes);

    @* Yeray (2025) - Los stats ahora vienen del ViewBag (COUNT en BD)
       en lugar de calcularse sobre el array completo de pacientes.
       Esto es necesario porque el listado solo carga la primera página. *@
    int statTotal     = ViewBag.StatTotal     ?? pacientes.Count();
    int statHistory   = ViewBag.StatHistory   ?? pacientes.Count(p => p.History != null && p.History.Count > 0);
    int statNext      = ViewBag.StatNext      ?? pacientes.Count(p => p.NextVisit.HasValue && p.NextVisit.Value >= DateTime.Today);
    int statNoAllergy = ViewBag.StatNoAllergy ?? pacientes.Count(p => p.Allergies == null || p.Allergies.Count == 0);
}

@section Styles {
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Pacientes/st-adm-05-gestion-pacientes/styles.css")" asp-append-version="true" />
}

<main class="main patients-page" id="main-content">
  @Html.AntiForgeryToken()

  <header class="page-header">
    <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="gestion_pacientes_breadcrumb_aria">
      @if (esRecepcionista)
      {
        <a href="/gestion-de-citas/st-rec-01-dashboard" data-i18n="common_role_recepcionista">Recepción</a>
      }
      else
      {
        <a href="/gestion-de-citas/st-adm-01-dashboard" data-i18n="gestion_pacientes_breadcrumb_administracion">Administración</a>
      }
      <span class="bc-sep" aria-hidden="true">/</span>
      <span class="bc-active" aria-current="page" data-i18n="gestion_pacientes_breadcrumb_gestion_pacientes">Gestión de Pacientes</span>
    </nav>
    <div class="page-header-content">
      <div class="page-header-title">
        <h1 class="page-title" data-i18n="gestion_pacientes_page_title">Gestión de Pacientes</h1>
        <p class="page-subtitle" data-i18n="gestion_pacientes_page_subtitle">Historial de pacientes — Solo lectura</p>
      </div>
      <div class="page-header-actions">
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <input type="search" id="searchPatients" class="search-input" data-i18n-ph="gestion_pacientes_buscar_placeholder" placeholder="Buscar paciente, cédula o diagnóstico..." data-i18n-aria-label="gestion_pacientes_buscar_paciente" aria-label="Buscar paciente" />
        </div>
      </div>
    </div>
  </header>

    <section class="stats-grid" aria-label="Resumen de pacientes" data-i18n-aria-label="gestion_pacientes_stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">groups</span>
        <span class="stat-number" id="statTotal" data-target="@statTotal">0</span>
        <span class="stat-label" data-i18n="gestion_pacientes_stat_total">Total de pacientes</span>
        <span class="stat-sub" data-i18n="gestion_pacientes_stat_total_sub">Registrados en el sistema</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">medical_services</span>
        <span class="stat-number" id="statHistory" data-target="@statHistory">0</span>
        <span class="stat-label" data-i18n="gestion_pacientes_stat_history">Con historial clínico</span>
        <span class="stat-sub" data-i18n="gestion_pacientes_stat_history_sub">Tienen registros médicos</span>
      </div>
      <div class="stat-card" data-color="blue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">event_available</span>
        <span class="stat-number" id="statNext" data-target="@statNext">0</span>
        <span class="stat-label" data-i18n="gestion_pacientes_stat_next">Próximas citas</span>
        <span class="stat-sub" data-i18n="gestion_pacientes_stat_next_sub">Citas programadas</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">verified</span>
        <span class="stat-number" id="statNoAllergy" data-target="@statNoAllergy">0</span>
        <span class="stat-label" data-i18n="gestion_pacientes_stat_no_allergies">Sin alergias</span>
        <span class="stat-sub" data-i18n="gestion_pacientes_stat_no_allergies_sub">Sin restricciones registradas</span>
      </div>
    </section>

    <section class="filters-bar filters-section no-print" aria-label="Filtros de búsqueda" data-i18n-aria-label="gestion_pacientes_filters_aria">
      <div class="filters-row">
        <div class="filter-group">
          <label class="filter-label" for="filterEstado" data-i18n="gestion_pacientes_filter_status">Estado</label>
          <select id="filterEstado" class="filter-select" aria-label="Filtrar por estado del paciente" data-i18n-aria-label="gestion_pacientes_filter_status_aria">
            <option value="activo" data-i18n="gestion_pacientes_active_plural">Activos</option>
            <option value="inactivo" data-i18n="gestion_pacientes_inactive_plural">Inactivos</option>
            <option value="retirado" data-i18n="gestion_pacientes_status_retired">Retirados</option>
            <option value="todos" data-i18n="gestion_pacientes_all_male">Todos</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filterAlergias" data-i18n="gestion_pacientes_filter_allergies">Alergias</label>
          <select id="filterAlergias" class="filter-select" aria-label="Filtrar por alergias" data-i18n-aria-label="gestion_pacientes_filter_allergies_aria">
            <option value="" data-i18n="gestion_pacientes_all_feminine">Todas</option>
            <option value="con" data-i18n="gestion_pacientes_with_allergies">Con alergias</option>
            <option value="sin" data-i18n="gestion_pacientes_without_allergies">Sin alergias</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filterCita" data-i18n="gestion_pacientes_filter_appointment">Próxima cita</label>
          <select id="filterCita" class="filter-select" aria-label="Filtrar por próxima cita" data-i18n-aria-label="gestion_pacientes_filter_appointment_aria">
            <option value="" data-i18n="gestion_pacientes_all_feminine">Todas</option>
            <option value="con" data-i18n="gestion_pacientes_with_appointment">Con cita programada</option>
            <option value="sin" data-i18n="gestion_pacientes_without_appointment">Sin cita programada</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filterHistorial" data-i18n="gestion_pacientes_filter_history">Historial clínico</label>
          <select id="filterHistorial" class="filter-select" aria-label="Filtrar por historial clínico" data-i18n-aria-label="gestion_pacientes_filter_history_aria">
            <option value="" data-i18n="gestion_pacientes_all_male">Todos</option>
            <option value="con" data-i18n="gestion_pacientes_with_history">Con historial</option>
            <option value="sin" data-i18n="gestion_pacientes_without_history">Sin historial</option>
          </select>
        </div>
        <button type="button" class="btn-secondary" id="btnClearFilters" aria-label="Limpiar todos los filtros" data-i18n-aria-label="gestion_pacientes_clear_filters_aria">
          <span class="material-symbols-outlined" aria-hidden="true">filter_alt_off</span>
          <span data-i18n="gestion_pacientes_clear_filters">Limpiar filtros</span>
        </button>
      </div>
      <span class="filter-results" id="filterResults" role="status" aria-live="polite"></span>
    </section>

    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle" data-i18n="gestion_pacientes_table_title">Lista de pacientes</h2>

      <div class="table-wrap" id="patientsTableWrap" role="region" aria-label="Tabla de pacientes" data-i18n-aria-label="gestion_pacientes_table_aria" tabindex="0">
        <div class="patients-grid" role="grid" aria-labelledby="tableTitle">
          <div class="table-header" role="row">
            <div class="table-col col-paciente" role="columnheader" data-i18n="gestion_pacientes_column_patient">Paciente</div>
            <div class="table-col col-fecha" role="columnheader" data-i18n="gestion_pacientes_column_last_visit">Última consulta</div>
            <div class="table-col col-diagnostico" role="columnheader" data-i18n="gestion_pacientes_column_diagnosis">Diagnóstico</div>
            <div class="table-col col-cita" role="columnheader" data-i18n="gestion_pacientes_column_next_visit">Próxima cita</div>
            <div class="table-col col-alergias" role="columnheader" data-i18n="gestion_pacientes_column_allergies">Alergias</div>
            <div class="table-col col-acciones" role="columnheader" data-i18n="table.actions">Acciones</div>
          </div>

          <div id="patientsBody" class="table-body" role="rowgroup" aria-live="polite" aria-busy="false"></div>

        </div>
        <div class="empty-state" id="emptyState" role="status" aria-live="polite" hidden>
          <span class="material-symbols-outlined empty-state-icon" aria-hidden="true">person_search</span>
          <h3 class="empty-state-title" data-i18n="gestion_pacientes_empty_title">No se encontraron pacientes</h3>
          <p class="empty-state-desc" data-i18n="gestion_pacientes_empty_description">Ajusta los filtros o la búsqueda e inténtalo de nuevo.</p>
        </div>
      </div>
    </section>

    <footer class="page-footer no-print" aria-label="Navegación de páginas" data-i18n-aria-label="gestion_pacientes_pagination_aria">
      <span><span data-i18n="gestion_pacientes_showing">Mostrando</span> <strong id="pageShowing">0</strong> <span data-i18n="gestion_pacientes_of">de</span> <strong id="pageTotal">0</strong> <span data-i18n="gestion_pacientes_patient_count">pacientes</span></span>
      <nav class="pagination" aria-label="Páginas de resultados" data-i18n-aria-label="gestion_pacientes_page_navigation_aria">
        <button type="button" class="pagination-btn" id="btnPrev" aria-label="Página anterior" data-i18n-aria-label="audit.previous_page" disabled>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <button type="button" class="pagination-btn" id="btnNext" aria-label="Página siguiente" data-i18n-aria-label="audit.next_page">
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </nav>
    </footer>
  </main>

  <div class="modal-overlay" id="modalPatient" role="dialog" aria-modal="true" aria-labelledby="modalPatientTitle" aria-hidden="true" inert>
    <div class="modal-content modal-lg">
      <div class="modal-header">
        <h2 class="modal-title" id="modalPatientTitle" data-i18n="gestion_pacientes_modal_title">Detalle del paciente</h2>
        <button type="button" class="modal-close-btn" id="modalPatientClose" aria-label="Cerrar ventana" data-i18n-aria-label="common.close">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>
      <div id="modalPatientContent" class="patient-modal-body modal-body" role="document"></div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modalPatientCancel" data-i18n="common.close">Cerrar</button>
      </div>
    </div>
  </div>

@section Scripts {
  <script>
    window.RAZOR_PATIENTS = @Html.Raw(pacientesJson);
    window.canEditPatientIdentity = @User.IsInRole("Administrador").ToString().ToLowerInvariant() || @User.IsInRole("Recepcionista").ToString().ToLowerInvariant();
  </script>
  <script src="~/js/Gestion_De_Pacientes/st-adm-05-gestion-pacientes/script.js" asp-append-version="true" defer></script>
}
