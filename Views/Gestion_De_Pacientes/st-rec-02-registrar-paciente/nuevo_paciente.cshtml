@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.ViewModels.RegistrarPacienteViewModel
@using SmileTrack_MVC.Models.ViewModels
@{
    Layout = "_Layout";
    ViewData["Title"] = "Registrar Paciente";
    ViewData["Description"] = "Registra un nuevo paciente en SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Gestion_De_Pacientes/st-rec-02-registrar-paciente/nuevo_paciente.css" asp-append-version="true" />
}

<main class="main" id="main-content">

  <!-- Page header -->
  <header class="page-header">
    <div class="header-left">
      <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="common.breadcrumb_nav">
        <span data-i18n="common_role_recepcionista">Recepción</span>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span data-i18n="nav.item_gestion_pacientes">Pacientes</span>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span class="bc-active" aria-current="page" data-i18n="pacientes.breadcrumb_register">Registrar</span>
      </nav>
      <h1 class="page-title" data-i18n="pacientes.new">Registrar Nuevo Paciente</h1>
      <p class="page-subtitle" data-i18n="pacientes.new_subtitle">El sistema creará automáticamente su historia clínica</p>
    </div>
  </header>

  <!-- Formulario principal -->
  <!-- [MEJORA]: aria-describedby para instrucciones de validación -->
  <form id="patientForm" novalidate aria-describedby="formInstructions">
    @Html.AntiForgeryToken()
    <span id="formInstructions" class="visually-hidden" data-i18n="pacientes.form_instructions">Los campos marcados con asterisco son obligatorios</span>

    <div>

      <!-- Card: Datos personales -->
      <section class="form-card" aria-labelledby="cardTitle1">
        <h2 class="form-card-title" id="cardTitle1">
          <span data-i18n="common.personal_data">Datos personales</span>
          <span class="required" aria-hidden="true" data-i18n="pacientes.required_note">* Campos obligatorios</span>
        </h2>

        <div class="form-grid">
          <!-- Nombres -->
          <div class="form-group">
            <label class="form-label" for="nombres"><span data-i18n="register.firstname_label">Nombres</span> <span class="required" aria-hidden="true">*</span></label>
            <input type="text" id="nombres" name="nombres" class="form-input" placeholder="Ej. Juan Sebastián"
                   data-i18n-ph="pacientes.form_nombres_ph"
                   required autocomplete="given-name" />
            <span class="error-message" id="error-nombres" role="alert" aria-live="polite">Por favor ingresa los
              nombres.</span>
          </div>

          <!-- Apellidos -->
          <div class="form-group">
            <label class="form-label" for="apellidos"><span data-i18n="register.lastname_label">Apellidos</span> <span class="required" aria-hidden="true">*</span></label>
            <input type="text" id="apellidos" name="apellidos" class="form-input" placeholder="Ej. Morales Rincón"
                   data-i18n-ph="pacientes.form_apellidos_ph"
                   required autocomplete="family-name" />
            <span class="error-message" id="error-apellidos" role="alert" aria-live="polite">Por favor ingresa los
              apellidos.</span>
          </div>

          <!-- Tipo de documento — opciones desde RegistrarPacienteViewModel.TiposDocumento -->
          <div class="form-group">
            <label class="form-label" for="tipoDoc"><span data-i18n="gestion_pacientes_document_type">Tipo de documento</span> <span class="required" aria-hidden="true">*</span></label>
            <select id="tipoDoc" name="tipoDoc" class="form-select" required autocomplete="off">
              <option value="" data-i18n="pacientes.select_placeholder">Seleccione...</option>
              @foreach (var (valor, etiqueta) in RegistrarPacienteViewModel.TiposDocumento)
              {
                  var tipoDocSelected = valor == "CC";
                  <option value="@valor" selected="@tipoDocSelected">@etiqueta</option>
              }
            </select>
            <span class="error-message" id="error-tipoDoc" role="alert" aria-live="polite">Por favor selecciona un
              tipo de documento.</span>
          </div>

          <!-- Número de documento -->
          <div class="form-group">
            <label class="form-label" for="documento"><span data-i18n="pac_profile.document_number">Número de documento</span> <span class="required" aria-hidden="true">*</span></label>
            <input type="text" id="documento" name="documento" class="form-input" placeholder="Ej. 1098765432"
                   data-i18n-ph="pacientes.form_doc_ph"
                   required autocomplete="off" maxlength="20" />
            <span class="error-message" id="error-documento" role="alert" aria-live="polite">Por favor ingresa un
              documento válido.</span>
          </div>

          <!-- Fecha de nacimiento -->
          <div class="form-group">
            <label class="form-label" for="fechaNacimiento"><span data-i18n="pacientes.birth_date">Fecha de nacimiento</span> <span class="required" aria-hidden="true">*</span></label>
            <input type="date" id="fechaNacimiento" name="fechaNacimiento" class="form-input" required />
            <span class="error-message" id="error-fechaNacimiento" role="alert" aria-live="polite">Por favor ingresa
              una fecha válida.</span>
          </div>

          <!-- Género — opciones desde RegistrarPacienteViewModel.Generos -->
          <div class="form-group">
            <label class="form-label" for="genero" data-i18n="pacientes.gender">Género</label>
            <select id="genero" name="genero" class="form-select" autocomplete="off">
              @foreach (var (valor, etiqueta) in RegistrarPacienteViewModel.Generos)
              {
                  var generoSelected = valor == "M";
                  <option value="@valor" selected="@generoSelected">@etiqueta</option>
              }
            </select>
          </div>

          <!-- Teléfono -->
          <div class="form-group">
            <label class="form-label" for="telefono" data-i18n="common.phone">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" class="form-input" placeholder="Ej. 312 456 7890"
                   data-i18n-ph="pacientes.form_tel_ph"
                   autocomplete="tel" inputmode="tel" />
            <span class="error-message" id="error-telefono" role="alert" aria-live="polite">Por favor ingresa un
              teléfono válido (mínimo 7 dígitos).</span>
          </div>

          <!-- Correo -->
          <div class="form-group">
            <label class="form-label" for="correo" data-i18n="common.email">Correo electrónico</label>
            <input type="email" id="correo" name="correo" class="form-input" placeholder="Ej. juan@correo.com"
                   data-i18n-ph="pacientes.form_correo_ph"
                   autocomplete="email" />
            <span class="error-message" id="error-correo" role="alert" aria-live="polite">Por favor ingresa un correo
              válido.</span>
          </div>

          <!-- Grupo sanguíneo — desde RegistrarPacienteViewModel.GruposSanguineos -->
          <div class="form-group">
            <label class="form-label" for="grupoSanguineo" data-i18n="gestion_pacientes_blood_type">Grupo sanguíneo</label>
            <select id="grupoSanguineo" name="grupoSanguineo" class="form-select" autocomplete="off">
              <option value="" data-i18n="pacientes.select_placeholder">Seleccione...</option>
              @foreach (var gs in RegistrarPacienteViewModel.GruposSanguineos)
              {
                  <option value="@gs">@gs</option>
              }
            </select>
          </div>

          <!-- Ciudad — desde RegistrarPacienteViewModel.Ciudades -->
          <div class="form-group">
            <label class="form-label" for="ciudad" data-i18n="gestion_pacientes_city">Ciudad</label>
            <select id="ciudad" name="ciudad" class="form-select" autocomplete="address-level2">
              <option value="" data-i18n="pacientes.select_placeholder">Seleccione...</option>
              @foreach (var c in RegistrarPacienteViewModel.Ciudades)
              {
                  <option value="@c">@c</option>
              }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="direccion" data-i18n="common.address">Dirección</label>
            <input type="text" id="direccion" name="direccion" class="form-input"
                   maxlength="255" autocomplete="street-address" />
          </div>

          <div class="form-group">
            <label class="form-label" for="contactoEmergencia" data-i18n="pacientes.guardian_label">Acudiente o contacto responsable</label>
            <input type="text" id="contactoEmergencia" name="contactoEmergencia" class="form-input"
                   maxlength="100" autocomplete="off" />
            <span class="error-message" id="error-contactoEmergencia" role="alert" aria-live="polite">
              Es obligatorio para pacientes menores de edad o con documento TI.
            </span>
          </div>

          <div class="form-group">
            <label class="form-label" for="telefonoEmergencia" data-i18n="gestion_pacientes_emergency_phone">Teléfono de emergencia</label>
            <input type="tel" id="telefonoEmergencia" name="telefonoEmergencia" class="form-input"
                   maxlength="20" autocomplete="off" />
            <span class="error-message" id="error-telefonoEmergencia" role="alert" aria-live="polite">
              Ingresa un teléfono válido para el responsable.
            </span>
          </div>

          <!-- Alergias -->
          <div class="form-group">
            <label class="form-label" for="alergias" data-i18n="gestion_pacientes_known_allergies">Alergias conocidas</label>
            <input type="text" id="alergias" name="alergias" class="form-input" placeholder="Ninguna conocida"
                   data-i18n-ph="pacientes.form_alergias_ph"
                   autocomplete="off" />
          </div>

          <!-- Medicamentos -->
          <div class="form-group">
            <label class="form-label" for="medicamentos" data-i18n="pac_profile.medications">Medicamentos actuales</label>
            <input type="text" id="medicamentos" name="medicamentos" class="form-input" placeholder="Ninguno reportado"
                   data-i18n-ph="pacientes.form_medicamentos_ph"
                   autocomplete="off" />
          </div>

          <div class="form-group form-group--full">
            <label class="form-label" for="antecedentesMedicos" data-i18n="gestion_pacientes_medical_history">Antecedentes médicos</label>
            <textarea id="antecedentesMedicos" name="antecedentesMedicos" class="form-input"
                      autocomplete="off"></textarea>
          </div>
        </div>
      </section>

      <!-- Banner de éxito: Historia clínica -->
      <!-- [MEJORA]: role="status" para anuncio de información importante -->
      <div class="success-banner" role="status" aria-live="polite">
        <span class="material-symbols-outlined success-banner-icon" aria-hidden="true">check_circle</span>
        <div class="success-banner-content">
          <p class="success-banner-title" data-i18n="pacientes.hc_banner_title">Historia clínica creada automáticamente</p>
          <p class="success-banner-desc"><span data-i18n="pacientes.hc_banner_desc">Al guardar, se creará la historia clínica</span> <strong
            id="autoHC">HC-XXXXXX</strong></p>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-secondary" id="cancelBtn1" data-i18n="common.cancel">Cancelar</button>
        <button type="submit" class="btn-success" id="saveBtn" data-i18n="pacientes.save_patient">Guardar paciente</button>
      </div>

    </div>
  </form>

</main>

@section Scripts {
  <script src="~/js/Gestion_De_Pacientes/st-rec-02-registrar-paciente/app_paciente.js" asp-append-version="true"></script>
}
