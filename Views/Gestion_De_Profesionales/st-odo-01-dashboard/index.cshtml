@* ============================================
SmileTrack — Dashboard del Odontólogo (st-odo-01-dashboard)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista de dashboard personal del odontólogo que muestra un resumen del día: próximas citas, procedimientos pendientes, estadísticas de la jornada y accesos directos a las funciones más usadas.

FUNCIONALIDADES PRINCIPALES:
- Tarjetas de métricas de la jornada (citas atendidas, pendientes, canceladas) con animación de conteo
- Lista de próximas citas del día con estado visual por color de badge
- Panel de accesos rápidos a agenda, reportes y perfil del profesional
- Notificaciones activas del sistema con capacidad de dismissal individual

DEPENDENCIAS TÉCNICAS:
- Controller: GestionProfesionalesController o DashboardOdontologoController
- CSS: ~/css/Gestion_De_Profesionales/st-odo-01-dashboard/styles.css
- JS: ~/js/Gestion_De_Profesionales/st-odo-01-dashboard/app.js
- Partial / Otros: Layout = null (standalone)

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
- Los contadores de métricas se animan al cargar la vista para atraer la atención del profesional hacia los KPIs del día.
============================================ *@
@{ Layout = "_Layout"; ViewData["Title"] = "Dashboard Odontólogo"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Profesionales/st-odo-01-dashboard/styles.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Profesional</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active">Dashboard</span>
        </nav>
        <h1 class="page-title" data-i18n="nav.dashboard_general">Dashboard General</h1>
        <p class="page-subtitle">
          Resumen en tiempo real ·
          <time datetime="" id="headerDate">Cargando fecha...</time>
        </p>
      </div>
      <a href="/reportes/vista-profesional" class="btn-secondary">
        <span class="material-symbols-outlined">analytics</span>
        Ver Reportes Completos
      </a>
    </header>

    @{
        var proximaCita = ViewData["OdoProximaCitaUrgente"] as SmileTrack_MVC.Models.Entities.Cita;
        var ultimaAtencion = ViewData["UltimaAtencionProximaCita"] as SmileTrack_MVC.Models.Entities.Cita;
    }

    <!-- Banner de Próxima Cita Urgente -->
    <section class="next-appointment-banner" aria-live="polite">
        @if (proximaCita != null)
        {
            var minutos = (proximaCita.FechaHora - DateTime.Now).TotalMinutes;
            var urgente = minutos <= 15 && minutos > 0;
            var claseUrgencia = urgente ? "urgent" : "upcoming";
            var nombrePaciente = $"{proximaCita.Paciente?.Nombres} {proximaCita.Paciente?.Apellidos}".Trim();
            
            <div class="next-appt-card @claseUrgencia">
                <div class="next-appt-icon">
                    <span class="material-symbols-outlined">@(urgente ? "notification_important" : "schedule")</span>
                </div>
                <div class="next-appt-info">
                    <span class="next-appt-label">@(urgente ? "¡CITA URGENTE!" : "Próxima cita")</span>
                    <strong class="next-appt-patient">@nombrePaciente</strong>
                    <span class="next-appt-time">
                        @proximaCita.FechaHora.ToString("HH:mm") — @(proximaCita.Servicio?.Nombre ?? "Consulta") — @(proximaCita.Consultorio?.Nombre ?? "Sin asignar")
                    </span>
                    @if (urgente)
                    {
                        <span class="next-appt-countdown">⏰ En @((int)minutos) minutos</span>
                    }
                    @if (ultimaAtencion != null)
                    {
                        <span class="next-appt-context">
                            Última atención: @ultimaAtencion.FechaHora.ToString("dd/MM/yyyy") - @(ultimaAtencion.Servicio?.Nombre ?? "Consulta")
                        </span>
                    }
                </div>
                <a href="/gestion-de-citas/st-odo-02-agenda" class="btn-primary btn-sm">
                    <span class="material-symbols-outlined">calendar_month</span>
                    Ver en Agenda
                </a>
            </div>
        }
        else
        {
            <div class="next-appt-card empty">
                <span class="material-symbols-outlined">check_circle</span>
                <span>No tienes citas programadas para hoy. ¡Buen trabajo!</span>
            </div>
        }
    </section>

    <!-- Barra de progreso del día -->
    @{
        var citasHoyCount = (int)(ViewData["OdoCitasHoy"] ?? 0);
        var atendidasHoyCount = (int)(ViewData["OdoCitasAtendidas"] ?? 0);
        var progresoDia = citasHoyCount > 0 ? (int)Math.Round((double)atendidasHoyCount / citasHoyCount * 100) : 0;
    }
    <div class="progress-row" role="progressbar" aria-valuenow="@progresoDia" aria-valuemin="0" aria-valuemax="100"
      aria-label="Progreso del día: @progresoDia%">
      <div class="progress-bar-wrap">
        <div class="progress-bar" id="topProgressBar" style="width:@progresoDia%"></div>
      </div>
      <span class="progress-label" id="dailyProgressLabel" aria-live="polite">
        @atendidasHoyCount de @citasHoyCount citas completadas hoy (@progresoDia%)
      </span>
    </div>

    <!-- Accesos Rápidos -->
    <section class="quick-actions" aria-label="Accesos rápidos">
        <h2 class="section-subtitle">Accesos Rápidos</h2>
        <div class="quick-actions-grid">
            <a href="/gestion-de-citas/st-odo-02-agenda" class="quick-action-card">
                <span class="material-symbols-outlined">calendar_month</span>
                <strong>Mi Agenda</strong>
                <span>Ver y gestionar citas</span>
            </a>
            <a href="/historia-clinica/st-odo-06-pacientes" class="quick-action-card">
                <span class="material-symbols-outlined">folder_open</span>
                <strong>Mis Pacientes</strong>
                <span>Historial clínico</span>
            </a>
            <a href="/reportes/vista-profesional" class="quick-action-card">
                <span class="material-symbols-outlined">analytics</span>
                <strong>Reportes</strong>
                <span>Estadísticas detalladas</span>
            </a>
            <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="quick-action-card">
                <span class="material-symbols-outlined">person</span>
                <strong>Mi Perfil</strong>
                <span>Datos personales</span>
            </a>
        </div>
    </section>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Métricas principales" data-i18n-aria-label="facturacion.title">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statPacientes" data-target="@(ViewData["OdoPacientesActivos"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label">Pacientes del mes</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statCitas" data-target="@(ViewData["OdoCitasHoy"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="citas.total_today">Citas hoy</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statProfesionales" data-target="@(ViewData["OdoCitasAtendidas"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.attended">Citas atendidas</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="statIngresos" data-format="currency-cop" data-target="@(Convert.ToDecimal(ViewData["OdoIngresosMes"] ?? 0))" aria-live="polite">0</span>
        <span class="stat-label">Ingresos del mes</span>
      </div>
    </section>

    <!-- Content Grid -->
    <div class="content-grid">

      <!-- Columna izquierda: Gráficos -->
      <div class="content-left">

        <!-- Gráfico de ingresos -->
        <section class="card" aria-labelledby="revenueTitle">
          <h2 class="card-title" id="revenueTitle">Ingresos de los últimos 3 meses</h2>
          <div class="chart-container" id="revenueChart" role="img" aria-label="Ingresos reales de los últimos tres meses"></div>
          <p class="chart-summary" aria-live="polite">Datos calculados exclusivamente con las citas del profesional autenticado.</p>
        </section>

        <!-- Últimos pacientes atendidos -->
        <section class="card" aria-labelledby="topProfTitle">
          <h2 class="card-title" id="topProfTitle">Últimos pacientes atendidos</h2>
          <div class="table-wrap">
            <table class="table-base" aria-label="Tabla de últimos pacientes atendidos">
              <thead>
                <tr>
                  <th scope="col">Paciente</th>
                  <th scope="col" style="text-align:center">Servicio</th>
                  <th scope="col" style="text-align:right">Fecha</th>
                </tr>
              </thead>
              <tbody>
                @{
                  var avatarColors = new[] { "#3b82f6", "#10b981", "#8b5cf6", "#f59e0b", "#ef4444" };
                  var ultimosPacientes = ViewData["OdoUltimosPacientes"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
                  if (ultimosPacientes.Any())
                  {
                    int colorIdx = 0;
                    foreach (var cita in ultimosPacientes)
                    {
                      var nombrePaciente = $"{cita.Paciente?.Nombres} {cita.Paciente?.Apellidos}".Trim();
                      var initials = string.Concat(nombrePaciente.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
                      var color = avatarColors[colorIdx % avatarColors.Length];
                      colorIdx++;
                      <tr>
                        <td style="display:flex; align-items:center; gap:10px;">
                          <div class="td-avatar" style="background:@color; color:#fff; border-radius:50%; width:32px; height:32px; display:flex; align-items:center; justify-content:center; font-size:.75rem; font-weight:700; flex-shrink:0;">@initials</div>
                          <span class="td-name">@nombrePaciente</span>
                        </td>
                        <td style="text-align:center"><span class="badge-spec">@(cita.Servicio?.Nombre ?? "Consulta")</span></td>
                        <td style="text-align:right; font-size:.85rem; color:var(--text-muted);">@cita.FechaHora.ToString("dd MMM")</td>
                      </tr>
                    }
                  }
                  else
                  {
                    <tr>
                      <td colspan="3" style="text-align:center; color:var(--text-muted); padding:16px;">No hay pacientes atendidos este mes.</td>
                    </tr>
                  }
                }
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- Columna derecha: Estado e invoices -->
      <div class="content-right">
        @{
            var totalCitas = (int)(ViewData["OdoTotalCitasMes"] ?? 0);
            var pctAtendidas = totalCitas > 0 ? (int)Math.Round((double)(int)(ViewData["OdoCitasAtendidas"] ?? 0) / totalCitas * 100) : 0;
            var pctProgramadas = totalCitas > 0 ? (int)Math.Round((double)(int)(ViewData["OdoCitasProgramadas"] ?? 0) / totalCitas * 100) : 0;
            var pctCanceladas = totalCitas > 0 ? (int)Math.Round((double)(int)(ViewData["OdoCitasCanceladas"] ?? 0) / totalCitas * 100) : 0;
            var pctNoAsistio = totalCitas > 0 ? (int)Math.Round((double)(int)(ViewData["OdoCitasNoAsistio"] ?? 0) / totalCitas * 100) : 0;
            
            var tasaAsistencia = (int)(ViewData["TasaAsistenciaHoy"] ?? 0);
            var iconoMs = tasaAsistencia >= 80 ? "local_fire_department" : tasaAsistencia >= 50 ? "thumb_up" : "warning";
            var mensajeRendimiento = tasaAsistencia >= 80 
                ? "¡Excelente día! Estás cumpliendo tus objetivos."
                : tasaAsistencia >= 50 
                    ? "Buen ritmo, continúa así."
                    : "Varias citas pendientes, organiza tu tiempo.";
            var colorMensaje = tasaAsistencia >= 80 ? "#10b981" : tasaAsistencia >= 50 ? "#f59e0b" : "#ef4444";
        }

        <!-- Rendimiento del Día -->
        <section class="card" aria-labelledby="performanceTitle">
            <h2 class="card-title" id="performanceTitle">
                <span class="material-symbols-outlined">trending_up</span>
                Rendimiento del Día
            </h2>
            <div class="performance-score">
                <div class="score-circle" data-score="@tasaAsistencia">
                    <svg width="120" height="120" viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="50" fill="none" stroke="#e5e7eb" stroke-width="10"/>
                        <circle cx="60" cy="60" r="50" fill="none" stroke="url(#gradient)" 
                                stroke-width="10" stroke-linecap="round"
                                stroke-dasharray="@(314 * tasaAsistencia / 100) 314"
                                transform="rotate(-90 60 60)"
                                style="transition: stroke-dasharray 1s ease;"/>
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="score-text">
                        <span class="score-emoji material-symbols-outlined" aria-hidden="true">@iconoMs</span>
                        <strong class="score-value">@tasaAsistencia%</strong>
                        <span class="score-label">Atendidas</span>
                    </div>
                </div>
                <p class="performance-message">
                    <strong style="color: @colorMensaje;">@mensajeRendimiento</strong>
                </p>
            </div>
        </section>

        <!-- Panel de Notificaciones -->
        <section class="card notifications-card" aria-labelledby="notifTitle">
            <h2 class="card-title" id="notifTitle">
                <span class="material-symbols-outlined">notifications</span>
                Notificaciones
            </h2>
            <div class="notifications-list">
                @{
                    var citasPendientesConfirmar = (int)(ViewData["CitasPendientesConfirmar"] ?? 0);
                    var pacientesEspera = (int)(ViewData["PacientesEnEspera"] ?? 0);
                    var historiasPendientes = (int)(ViewData["HistoriasPendientes"] ?? 0);
                }
                
                @if (citasPendientesConfirmar > 0)
                {
                    <div class="notif-item warning">
                        <span class="material-symbols-outlined">schedule</span>
                        <div>
                            <strong>@citasPendientesConfirmar citas sin confirmar</strong>
                            <span>Revisa tu agenda para confirmar</span>
                        </div>
                    </div>
                }
                
                @if (pacientesEspera > 0)
                {
                    <div class="notif-item urgent">
                        <span class="material-symbols-outlined">groups</span>
                        <div>
                            <strong>@pacientesEspera pacientes en espera</strong>
                            <span>Esperando en sala de atención</span>
                        </div>
                    </div>
                }
                
                @if (historiasPendientes > 0)
                {
                    <div class="notif-item info">
                        <span class="material-symbols-outlined">assignment</span>
                        <div>
                            <strong>@historiasPendientes historias por completar</strong>
                            <span>Cierra las historias clínicas pendientes</span>
                        </div>
                    </div>
                }
                
                @if (citasPendientesConfirmar == 0 && pacientesEspera == 0 && historiasPendientes == 0)
                {
                    <div class="notif-empty">
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>Todo al día</span>
                    </div>
                }
            </div>
        </section>

        <!-- Estado de citas -->
        <section class="card" aria-labelledby="statusTitle">
          <h2 class="card-title" id="statusTitle">Tus citas del mes</h2>
          <div class="status-chart" id="statusChart" role="img" aria-label="Gráfico de estado de citas">
            <div class="status-row">
              <span class="status-label">Atendidas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill green" data-width="@pctAtendidas" style="width:0" role="progressbar" aria-valuenow="@pctAtendidas"
                  aria-valuemin="0" aria-valuemax="100" aria-label="Atendidas: @(ViewData["OdoCitasAtendidas"] ?? 0) citas, @pctAtendidas%"></div>
              </div>
              <span class="status-val">@(ViewData["OdoCitasAtendidas"] ?? 0)</span>
            </div>
            <div class="status-row">
              <span class="status-label">Programadas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill blue" data-width="@pctProgramadas" style="width:0" role="progressbar" aria-valuenow="@pctProgramadas"
                  aria-valuemin="0" aria-valuemax="100" aria-label="Programadas: @(ViewData["OdoCitasProgramadas"] ?? 0) citas, @pctProgramadas%"></div>
              </div>
              <span class="status-val">@(ViewData["OdoCitasProgramadas"] ?? 0)</span>
            </div>
            <div class="status-row">
              <span class="status-label">Canceladas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill red" data-width="@pctCanceladas" style="width:0" role="progressbar" aria-valuenow="@pctCanceladas"
                  aria-valuemin="0" aria-valuemax="100" aria-label="Canceladas: @(ViewData["OdoCitasCanceladas"] ?? 0) citas, @pctCanceladas%"></div>
              </div>
              <span class="status-val">@(ViewData["OdoCitasCanceladas"] ?? 0)</span>
            </div>
            <div class="status-row">
              <span class="status-label">No asistió</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill orange" data-width="@pctNoAsistio" style="width:0" role="progressbar"
                  aria-valuenow="@pctNoAsistio" aria-valuemin="0" aria-valuemax="100" aria-label="No asistió: @(ViewData["OdoCitasNoAsistio"] ?? 0) citas, @pctNoAsistio%"></div>
              </div>
              <span class="status-val">@(ViewData["OdoCitasNoAsistio"] ?? 0)</span>
            </div>
          </div>
        </section>

        <!-- Próximas citas -->
        <section class="card" aria-labelledby="invoicesTitle">
          <h2 class="card-title" id="invoicesTitle">Próximas citas de hoy</h2>
          <div class="invoices-list" role="list">
            @{
                var proximasCitas = ViewData["OdoProximasCitas"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
                if (proximasCitas.Any())
                {
                    foreach (var cita in proximasCitas)
                    {
                        <div class="invoice-item" role="listitem">
                          <div>
                            <p class="invoice-code">@(cita.HoraInicio?.ToString(@"hh\:mm") ?? "00:00")</p>
                            <p class="invoice-desc">Paciente: @(cita.Paciente?.Nombres ?? "N/A") @(cita.Paciente?.Apellidos ?? "")</p>
                          </div>
                          <p class="invoice-amount" style="font-size: 0.9rem; font-weight: 500;">@(cita.Servicio?.Nombre ?? "Consulta")</p>
                        </div>
                    }
                }
                else
                {
                    <p style="padding: 16px; color: var(--text-muted); font-size: 0.9rem;">No tienes más citas programadas para hoy.</p>
                }
            }
          </div>
        </section>

      </div>

    </div>

  </main>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
  </footer>
  <script>
    window.ODO_REVENUE = @Html.Raw((string)(ViewData["OdoRevenueMonthsJson"] ?? "[]"));  </script>
@section Scripts {
    <script src="~/js/Gestion_De_Profesionales/st-odo-01-dashboard/app.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
}
