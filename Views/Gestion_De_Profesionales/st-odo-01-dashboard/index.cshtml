@* ============================================
SmileTrack — Dashboard del Odontólogo (st-odo-01-dashboard)
============================================
Dashboard personal del profesional. El layout compartido selecciona el sidebar correspondiente al rol.
============================================ *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard General";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Profesionales/st-odo-01-dashboard/styles.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main professional-dashboard" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="odo01.breadcrumb_aria">
          <span data-i18n="odo01.breadcrumb_professional">Profesional</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="odo01.breadcrumb_dashboard">Dashboard</span>
        </nav>
        <h1 class="page-title" data-i18n="nav.dashboard_general">Dashboard General</h1>
        <p class="page-subtitle">
          <span data-i18n="odo01.subtitle">Resumen de tu actividad profesional</span>
          <span aria-hidden="true">·</span>
          <time datetime="" id="headerDate"></time>
        </p>
      </div>
      <a href="/reportes/vista-prof" class="btn-secondary">
        <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
        <span data-i18n="odo01.view_reports">Ver reportes completos</span>
      </a>
    </header>

    @{
        var proximaCita = ViewData["OdoProximaCitaUrgente"] as SmileTrack_MVC.Models.Entities.Cita;
        var ultimaAtencion = ViewData["UltimaAtencionProximaCita"] as SmileTrack_MVC.Models.Entities.Cita;
    }

    <!-- Banner de Próxima Cita Urgente -->
    <section class="next-appointment-banner" aria-live="polite">
        @if (proximaCita != null)
        {
            var minutos = (proximaCita.FechaHora - SmileTrack_MVC.Helpers.ColombiaClock.Now).TotalMinutes;
            var urgente = minutos <= 15 && minutos > 0;
            var claseUrgencia = urgente ? "urgent" : "upcoming";
            var nombrePaciente = $"{proximaCita.Paciente?.Nombres} {proximaCita.Paciente?.Apellidos}".Trim();
            var fechaCita = proximaCita.FechaHora.Date == SmileTrack_MVC.Helpers.ColombiaClock.Today
                ? string.Empty
                : proximaCita.FechaHora.ToString("dd MMM yyyy");
            
            <div class="next-appt-card @claseUrgencia" data-fecha-hora="@proximaCita.FechaHora.ToString("s")">
                <div class="next-appt-icon">
                    <span class="material-symbols-outlined" aria-hidden="true">@(urgente ? "notification_important" : "schedule")</span>
                </div>
                <div class="next-appt-info">
                    <span class="next-appt-label" data-i18n="@(urgente ? "odo01.next_urgent" : "odo01.next_label")">
                        @(urgente ? "¡CITA URGENTE!" : "Próxima cita")
                    </span>
                    <strong class="next-appt-patient">@nombrePaciente</strong>
                    <span class="next-appt-time">
                        @if (!string.IsNullOrEmpty(fechaCita))
                        {
                            <time datetime="@proximaCita.FechaHora.ToString("yyyy-MM-dd")" data-date-format="long">@fechaCita</time>
                            <span aria-hidden="true">—</span>
                        }
                        <time datetime="@proximaCita.FechaHora.ToString("s")">@proximaCita.FechaHora.ToString("HH:mm")</time>
                        <span aria-hidden="true">—</span>
                        @if (proximaCita.Servicio?.Nombre is string nombreServicio)
                        {
                            @nombreServicio
                        }
                        else
                        {
                            <span data-i18n="odo01.consultation">Consulta</span>
                        }
                        <span aria-hidden="true">—</span>
                        @if (proximaCita.Consultorio?.Nombre is string nombreConsultorio)
                        {
                            @nombreConsultorio
                        }
                        else
                        {
                            <span data-i18n="odo01.office_unassigned">Sin asignar</span>
                        }
                    </span>
                    <span class="next-appt-countdown" aria-live="polite" aria-atomic="true" hidden>
                      <span class="material-symbols-outlined countdown-icon" aria-hidden="true"></span>
                      <span class="countdown-text"></span>
                    </span>
                    @if (ultimaAtencion != null)
                    {
                        <span class="next-appt-context">
                            <span data-i18n="odo01.last_visit">Última atención</span>:
                            <time datetime="@ultimaAtencion.FechaHora.ToString("yyyy-MM-dd")" data-date-format="long">
                                @ultimaAtencion.FechaHora.ToString("dd/MM/yyyy")
                            </time>
                            <span aria-hidden="true">—</span>
                            @if (ultimaAtencion.Servicio?.Nombre is string ultimoServicio)
                            {
                                @ultimoServicio
                            }
                            else
                            {
                                <span data-i18n="odo01.consultation">Consulta</span>
                            }
                        </span>
                    }
                </div>
                <a href="/gestion-de-citas/st-odo-02-agenda" class="btn-primary btn-sm">
                    <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                    <span data-i18n="odo01.view_in_agenda">Ver en agenda</span>
                </a>
            </div>
        }
        else
        {
            <div class="next-appt-card empty">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                <span data-i18n="odo01.no_upcoming">No tienes citas próximas. ¡Buen trabajo!</span>
            </div>
        }
    </section>

    <!-- Barra de progreso del día -->
    @{
        var citasHoyCount = (int)(ViewData["OdoCitasHoy"] ?? 0);
        var atendidasHoyCount = (int)(ViewData["OdoCitasAtendidasHoy"] ?? 0);
        var progresoDia = citasHoyCount > 0 ? (int)Math.Round((double)atendidasHoyCount / citasHoyCount * 100) : 0;
    }
    <div class="progress-row" role="group" aria-label="Progreso del día" data-i18n-aria-label="odo01.daily_progress_aria">
      <div class="progress-bar-wrap" role="progressbar" aria-valuenow="@progresoDia" aria-valuemin="0" aria-valuemax="100"
           aria-label="Progreso del día: @progresoDia%" data-progress-aria>
        <div class="progress-bar" id="topProgressBar" data-width="@progresoDia"></div>
      </div>
      <span class="progress-label" id="dailyProgressLabel" aria-live="polite"
            data-attended="@atendidasHoyCount" data-total="@citasHoyCount" data-percent="@progresoDia">
        @atendidasHoyCount de @citasHoyCount citas completadas hoy (@progresoDia%)
      </span>
    </div>

    <!-- Accesos Rápidos -->
    <section class="quick-actions" aria-label="Accesos rápidos" data-i18n-aria-label="odo01.quick_actions">
        <h2 class="section-subtitle" data-i18n="odo01.quick_actions">Accesos rápidos</h2>
        <div class="quick-actions-grid">
            <a href="/gestion-de-citas/st-odo-02-agenda" class="quick-action-card">
                <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
                <strong data-i18n="odo01.my_agenda">Mi agenda</strong>
                <span data-i18n="odo01.my_agenda_desc">Ver y gestionar citas</span>
            </a>
            <a href="/historia-clinica/st-odo-06-pacientes" class="quick-action-card">
                <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
                <strong data-i18n="odo01.my_patients">Mis pacientes</strong>
                <span data-i18n="odo01.my_patients_desc">Historial clínico</span>
            </a>
            <a href="/reportes/vista-prof" class="quick-action-card">
                <span class="material-symbols-outlined" aria-hidden="true">analytics</span>
                <strong data-i18n="odo01.reports">Reportes</strong>
                <span data-i18n="odo01.reports_desc">Estadísticas detalladas</span>
            </a>
            <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="quick-action-card">
                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                <strong data-i18n="odo01.my_profile">Mi perfil</strong>
                <span data-i18n="odo01.my_profile_desc">Datos personales</span>
            </a>
        </div>
    </section>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Métricas principales" data-i18n-aria-label="odo01.stats_aria">
      <div class="stat-card" data-color="blue" data-i18n-title="odo01.tooltip_patients">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">groups</span>
        <span class="stat-number" id="statPacientes" data-target="@(ViewData["OdoPacientesActivos"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="odo01.stat_patients">Pacientes con cita este mes</span>
      </div>
      <div class="stat-card" data-color="green" data-i18n-title="odo01.tooltip_today">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">event</span>
        <span class="stat-number" id="statCitas" data-target="@(ViewData["OdoCitasHoy"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="odo01.stat_today">Citas hoy</span>
      </div>
      <div class="stat-card" data-color="green" data-i18n-title="odo01.tooltip_attended">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">task_alt</span>
        <span class="stat-number" id="statProfesionales" data-target="@(ViewData["OdoCitasAtendidasHoy"] ?? 0)" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="odo01.stat_attended">Citas atendidas hoy</span>
      </div>
      <div class="stat-card" data-color="purple" data-i18n-title="odo01.tooltip_revenue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">payments</span>
        <span class="stat-number" id="statIngresos" data-format="currency-cop" data-target="@(Convert.ToDecimal(ViewData["OdoIngresosMes"] ?? 0))" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="odo01.stat_revenue">Ingresos del mes</span>
        <small data-i18n="odo01.revenue_note">Suma de servicios en citas atendidas; no equivale a comisión neta.</small>
      </div>
    </section>

    <!-- Content Grid -->
    <div class="content-grid">

      <!-- Columna izquierda: Gráficos -->
      <div class="content-left">

        <!-- Gráfico de ingresos -->
        <section class="card" aria-labelledby="revenueTitle">
          <h2 class="card-title" id="revenueTitle" data-i18n="odo01.revenue_title">Ingresos de los últimos 3 meses</h2>
          <div class="chart-container" id="revenueChart" role="group" aria-label="Ingresos de los últimos tres meses" data-i18n-aria-label="odo01.revenue_aria"></div>
          <p class="chart-summary" aria-live="polite" data-i18n="odo01.revenue_summary">Datos calculados exclusivamente con las citas del profesional autenticado.</p>
        </section>

        <!-- Últimos pacientes atendidos -->
        <section class="card" aria-labelledby="topProfTitle">
          <h2 class="card-title" id="topProfTitle" data-i18n="odo01.recent_patients">Últimos pacientes atendidos</h2>
          <div class="table-wrap">
            <table class="table-base" aria-label="Tabla de últimos pacientes atendidos" data-i18n-aria-label="odo01.patients_table_aria">
              <thead>
                <tr>
                  <th scope="col" data-i18n="odo01.patient">Paciente</th>
                  <th scope="col" class="table-cell--service" data-i18n="odo01.service">Servicio</th>
                  <th scope="col" class="table-cell--date" data-i18n="odo01.date">Fecha</th>
                </tr>
              </thead>
              <tbody>
                @{
                  var avatarColors = new[] { "blue", "green", "yellow", "purple", "slate" };
                  var ultimosPacientes = ViewData["OdoUltimosPacientes"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
                  if (ultimosPacientes.Any())
                  {
                    foreach (var cita in ultimosPacientes)
                    {
                      var nombrePaciente = $"{cita.Paciente?.Nombres} {cita.Paciente?.Apellidos}".Trim();
                      var initials = string.Concat(nombrePaciente.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
                      var color = avatarColors[Math.Abs(cita.IdPaciente % avatarColors.Length)];
                      <tr>
                        <td class="patient-cell">
                          <span class="patient-avatar" data-color="@color" aria-hidden="true">@initials</span>
                          <span class="td-name">@nombrePaciente</span>
                        </td>
                        <td class="table-cell--service">
                          <span class="badge-spec">
                            @if (cita.Servicio?.Nombre is string nombreServicioPaciente)
                            {
                                @nombreServicioPaciente
                            }
                            else
                            {
                                <span data-i18n="odo01.consultation">Consulta</span>
                            }
                          </span>
                        </td>
                        <td class="table-cell--date">
                          <time datetime="@cita.FechaHora.ToString("s")" data-date-format="short">@cita.FechaHora.ToString("dd MMM")</time>
                        </td>
                      </tr>
                    }
                  }
                  else
                  {
                    <tr>
                      <td colspan="3">
                        <div class="empty-state">
                          <span class="material-symbols-outlined empty-icon" aria-hidden="true">person_search</span>
                          <p class="empty-state-text" data-i18n="odo01.no_recent_patients">No hay pacientes atendidos este mes.</p>
                        </div>
                      </td>
                    </tr>
                  }
                }
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- Columna derecha: Estado e invoices -->
      <div class="content-right">
        @{
            var totalCitas = (int)(ViewData["OdoTotalCitasMes"] ?? 0);
            var citasAtendidasMes = (int)(ViewData["OdoCitasAtendidas"] ?? 0);
            var citasProgramadasMes = (int)(ViewData["OdoCitasProgramadas"] ?? 0);
            var citasCanceladasMes = (int)(ViewData["OdoCitasCanceladas"] ?? 0);
            var citasNoAsistioMes = (int)(ViewData["OdoCitasNoAsistio"] ?? 0);
            var pctAtendidas = totalCitas > 0 ? (int)Math.Round((double)citasAtendidasMes / totalCitas * 100) : 0;
            var pctProgramadas = totalCitas > 0 ? (int)Math.Round((double)citasProgramadasMes / totalCitas * 100) : 0;
            var pctCanceladas = totalCitas > 0 ? (int)Math.Round((double)citasCanceladasMes / totalCitas * 100) : 0;
            var pctNoAsistio = totalCitas > 0 ? (int)Math.Round((double)citasNoAsistioMes / totalCitas * 100) : 0;

            var tasaAsistencia = (int)(ViewData["TasaAsistenciaHoy"] ?? 0);
            var iconoMs = tasaAsistencia >= 80 ? "local_fire_department" : tasaAsistencia >= 50 ? "thumb_up" : "warning";
            var mensajeRendimientoKey = tasaAsistencia >= 80
                ? "odo01.performance_excellent"
                : tasaAsistencia >= 50
                    ? "odo01.performance_good"
                    : "odo01.performance_low";
            var citasPendientesConfirmar = (int)(ViewData["CitasPendientesConfirmar"] ?? 0);
            var pacientesEspera = (int)(ViewData["PacientesEnEspera"] ?? 0);
            var historiasPendientes = (int)(ViewData["HistoriasPendientes"] ?? 0);
            var hayNotificaciones = citasPendientesConfirmar > 0 || pacientesEspera > 0 || historiasPendientes > 0;
        }

        <!-- Rendimiento del Día -->
        <section class="card" aria-labelledby="performanceTitle">
            <h2 class="card-title" id="performanceTitle">
                <span class="material-symbols-outlined" aria-hidden="true">trending_up</span>
                <span data-i18n="odo01.performance">Rendimiento del día</span>
            </h2>
            <div class="performance-score">
                <div class="score-circle" data-score="@tasaAsistencia">
                    <svg width="120" height="120" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                        <circle cx="60" cy="60" r="50" fill="none" stroke="#e5e7eb" stroke-width="10"/>
                        <circle class="score-progress-circle" cx="60" cy="60" r="50" fill="none" stroke="url(#gradient)"
                                stroke-width="10" stroke-linecap="round"
                                stroke-dasharray="@(314 * tasaAsistencia / 100) 314"
                                transform="rotate(-90 60 60)"/>
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop class="score-gradient-start" offset="0%" />
                                <stop class="score-gradient-end" offset="100%" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="score-text">
                        <span class="score-emoji material-symbols-outlined" aria-hidden="true">@iconoMs</span>
                        <strong class="score-value">@tasaAsistencia%</strong>
                        <span class="score-label" data-i18n="odo01.performance_attended">Atendidas</span>
                    </div>
                </div>
                <p class="performance-message">
                    <strong class="performance-message--@((tasaAsistencia >= 80) ? "excellent" : (tasaAsistencia >= 50) ? "good" : "low")"
                            data-i18n="@mensajeRendimientoKey"></strong>
                </p>
            </div>
        </section>

        <!-- Panel de Notificaciones -->
        <section class="card notifications-card" aria-labelledby="notifTitle">
            <h2 class="card-title" id="notifTitle">
                <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
                <span data-i18n="odo01.notifications">Notificaciones</span>
            </h2>
            <div class="notifications-list">
                @if (citasPendientesConfirmar > 0)
                {
                    <button class="notif-item warning" type="button" data-i18n-aria-label="odo01.dismiss_notification">
                        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                        <div>
                            <strong data-i18n-count="odo01.notification_unconfirmed" data-count="@citasPendientesConfirmar">
                                @citasPendientesConfirmar citas sin confirmar
                            </strong>
                            <span data-i18n="odo01.review_agenda">Revisa tu agenda para confirmar</span>
                        </div>
                    </button>
                }

                @if (pacientesEspera > 0)
                {
                    <button class="notif-item urgent" type="button" data-i18n-aria-label="odo01.dismiss_notification">
                        <span class="material-symbols-outlined" aria-hidden="true">groups</span>
                        <div>
                            <strong data-i18n-count="odo01.notification_waiting" data-count="@pacientesEspera">
                                @pacientesEspera pacientes en espera
                            </strong>
                            <span data-i18n="odo01.waiting_desc">Esperando en sala de atención</span>
                        </div>
                    </button>
                }

                @if (historiasPendientes > 0)
                {
                    <button class="notif-item info" type="button" data-i18n-aria-label="odo01.dismiss_notification">
                        <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
                        <div>
                            <strong data-i18n-count="odo01.notification_records" data-count="@historiasPendientes">
                                @historiasPendientes historias por completar
                            </strong>
                            <span data-i18n="odo01.complete_records">Completa las historias clínicas pendientes</span>
                        </div>
                    </button>
                }
                <div class="notif-empty" @(hayNotificaciones ? "hidden" : "")>
                    <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                    <span data-i18n="odo01.notifications_empty">Todo al día</span>
                </div>
            </div>
        </section>

        <!-- Estado de citas -->
        <section class="card" aria-labelledby="statusTitle">
          <h2 class="card-title" id="statusTitle" data-i18n="odo01.monthly_appointments">Tus citas del mes</h2>
          <div class="status-chart" id="statusChart" role="group" aria-label="Estado de tus citas del mes" data-i18n-aria-label="odo01.status_chart_aria">
            <div class="status-row">
              <span class="status-label" data-i18n="odo01.status_attended">Atendidas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill status-attended" data-width="@pctAtendidas" role="progressbar"
                  aria-valuenow="@pctAtendidas" aria-valuemin="0" aria-valuemax="100"
                  data-status-key="odo01.status_attended_aria" data-count="@citasAtendidasMes" data-percent="@pctAtendidas"
                  aria-label="Atendidas: @citasAtendidasMes, @pctAtendidas%"></div>
              </div>
              <span class="status-val">@citasAtendidasMes</span>
            </div>
            <div class="status-row">
              <span class="status-label" data-i18n="odo01.status_scheduled">Programadas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill status-scheduled" data-width="@pctProgramadas" role="progressbar"
                  aria-valuenow="@pctProgramadas" aria-valuemin="0" aria-valuemax="100"
                  data-status-key="odo01.status_scheduled_aria" data-count="@citasProgramadasMes" data-percent="@pctProgramadas"
                  aria-label="Programadas: @citasProgramadasMes, @pctProgramadas%"></div>
              </div>
              <span class="status-val">@citasProgramadasMes</span>
            </div>
            <div class="status-row">
              <span class="status-label" data-i18n="odo01.status_cancelled">Canceladas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill status-cancelled" data-width="@pctCanceladas" role="progressbar"
                  aria-valuenow="@pctCanceladas" aria-valuemin="0" aria-valuemax="100"
                  data-status-key="odo01.status_cancelled_aria" data-count="@citasCanceladasMes" data-percent="@pctCanceladas"
                  aria-label="Canceladas: @citasCanceladasMes, @pctCanceladas%"></div>
              </div>
              <span class="status-val">@citasCanceladasMes</span>
            </div>
            <div class="status-row">
              <span class="status-label" data-i18n="odo01.status_no_show">No asistió</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill status-no-show" data-width="@pctNoAsistio" role="progressbar"
                  aria-valuenow="@pctNoAsistio" aria-valuemin="0" aria-valuemax="100"
                  data-status-key="odo01.status_no_show_aria" data-count="@citasNoAsistioMes" data-percent="@pctNoAsistio"
                  aria-label="No asistió: @citasNoAsistioMes, @pctNoAsistio%"></div>
              </div>
              <span class="status-val">@citasNoAsistioMes</span>
            </div>
          </div>
        </section>

        <!-- Próximas citas -->
        <section class="card" aria-labelledby="invoicesTitle">
          <h2 class="card-title" id="invoicesTitle" data-i18n="odo01.upcoming_today">Próximas citas de hoy</h2>
          <div class="invoices-list" role="list">
            @{
                var proximasCitas = ViewData["OdoProximasCitas"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
                if (proximasCitas.Any())
                {
                    foreach (var cita in proximasCitas)
                    {
                        <div class="invoice-item" role="listitem">
                          <div>
                            <p class="invoice-code">@(cita.HoraInicio?.ToString(@"hh\:mm") ?? "00:00")</p>
                            <p class="invoice-desc">
                              <span data-i18n="odo01.patient_label">Paciente:</span>
                              @if (cita.Paciente is not null)
                              {
                                  <span>@cita.Paciente.Nombres @cita.Paciente.Apellidos</span>
                              }
                              else
                              {
                                  <span data-i18n="odo01.not_available">No disponible</span>
                              }
                            </p>
                          </div>
                          <p class="invoice-amount">
                            @if (cita.Servicio?.Nombre is string nombreServicioCita)
                            {
                                @nombreServicioCita
                            }
                            else
                            {
                                <span data-i18n="odo01.consultation">Consulta</span>
                            }
                          </p>
                          <a class="btn-secondary"
                             href="@Url.Action("Stodo04Odontograma", "HistoriaClinica", new { pacienteId = cita.IdPaciente, citaId = cita.IdCita })">
                            <span data-i18n="odo01.open_odontogram">Abrir odontograma</span>
                          </a>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                      <span class="material-symbols-outlined empty-icon" aria-hidden="true">event_busy</span>
                      <p class="empty-state-text" data-i18n="odo01.no_more_appointments_today">No tienes más citas programadas para hoy.</p>
                    </div>
                }
            }
          </div>
        </section>

      </div>

    </div>

  </main>

  <script type="application/json" id="revenueChartData">@Html.Raw((string)(ViewData["OdoRevenueMonthsJson"] ?? "[]"))</script>
@section Scripts {
    <script src="~/js/Gestion_De_Profesionales/st-odo-01-dashboard/app.js" asp-append-version="true" defer></script>
}
