@* ============================================
SmileTrack — Gestión de Profesionales (st-adm-07-gestion-profesionales)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista de administración de profesionales que permite registrar, editar y eliminar odontólogos del sistema, asignarles especialidades y usuarios de acceso, y visualizar la lista completa con filtros y búsqueda en tiempo real.

FUNCIONALIDADES PRINCIPALES:
- CRUD completo de profesionales renderizado con Razor desde el Controller (server-side)
- Modales de creación y edición con validación de formularios en cliente y servidor
- Filtro de búsqueda y paginación en la tabla de profesionales con feedback ARIA
- Contadores de métricas (total, activos, especialidades) con animación de conteo

DEPENDENCIAS TÉCNICAS:
- Controller: GestionProfesionalesController (ViewBag: Especialidades, Usuarios, Profesionales)
- CSS: ~/css/Gestion_De_Profesionales/st-adm-07-gestion-profesionales/styles.css
- JS: ~/js/Gestion_De_Profesionales/st-adm-07-gestion-profesionales/app.js
- Partial / Otros: _Layout o Layout=null (verificar)

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
- La vista usa ViewData con fallback a colección vacía para evitar NullReferenceException si el Controller falla al poblar los datos.
============================================ *@
@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Profesionales/st-adm-07-gestion-profesionales/styles.css" asp-append-version="true" />
}

@{ Layout = "_Layout"; ViewData["Title"] = "Gestión de Profesionales";
  
  // Extraer datos del ViewBag con fallback para evitar null reference en caso de error del Controller
  var especialidades = ViewData["Especialidades"] as List<SmileTrack_MVC.Models.Entities.Especialidad> ?? new();
  var profesionales  = ViewData["Profesionales"]  as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var pageResult     = ViewData["ProfesionalesPage"] as SmileTrack_MVC.Models.Shared.PagedResult<SmileTrack_MVC.Models.Entities.Profesional>;
  // Stats globales: vienen del Controller como COUNT() sobre toda la BD (no de la página actual).
  // WHY: si hay 80 profesionales y se muestran 10 por página, los stats deben decir 80, no 10.
  var statTotal      = (int)(ViewData["StatTotal"]      ?? 0);
  var statActivos    = (int)(ViewData["StatActivos"]    ?? 0);
  var statVacaciones = (int)(ViewData["StatVacaciones"] ?? 0);
  var statInactivos  = (int)(ViewData["StatInactivos"]  ?? 0);
}



  <!-- ═════ MAIN ═════ -->
  @{ await Html.RenderPartialAsync("~/Views/shared/_LangSwitcher.cshtml"); }
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span data-i18n="gestionprofesionales_breadcrumb_admin">Administración</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="gestionprofesionales_breadcrumb_current">Gestión de Profesionales</span>
        </nav>
        <h1 class="page-title" data-i18n="gestionprofesionales_title">Gestión de Profesionales</h1>
        <p class="page-subtitle" data-i18n="gestionprofesionales_subtitle">Administra los odontólogos y especialistas de la clínica</p>
      </div>
      <button class="btn-primary" id="profesionales-btn-nuevo" aria-label="Crear nuevo profesional" data-i18n-aria-label="gestionprofesionales_btn_nuevo_aria" data-i18n="gestionprofesionales_btn_nuevo">
        + Nuevo Profesional
      </button>
    </header>

    <!--
      Stats Grid: los data-target reciben valores reales de BD (COUNT global, sin filtros).
      WHY: el JS lee data-target y anima el contador de 0 al valor real al cargar la página.
           Los valores NO dependen de la página actual ni de filtros activos — siempre son el total real.
    -->
    <section class="stats-grid" aria-label="Estadísticas de profesionales" data-i18n-aria-label="gestionprofesionales_stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="profesionales-stat-total" data-target="@statTotal" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestionprofesionales_stat_total">Total Profesionales</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="profesionales-stat-activos" data-target="@statActivos" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestionprofesionales_stat_activos">Activos</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="profesionales-stat-vacaciones" data-target="@statVacaciones" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestionprofesionales_stat_vacaciones">En vacaciones</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="profesionales-stat-inactivos" data-target="@statInactivos" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestionprofesionales_stat_inactivos">Inactivos</span>
      </div>
    </section>

    <!-- Tabs de filtrado rápido por estado (patrón canónico st-adm-09) -->
    <div class="table-tabs" role="tablist" aria-label="Filtrar profesionales por estado">
      <button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="all" id="tab-all">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">groups</span>
        Todos los profesionales
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="activo" id="tab-activo">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">person_check</span>
        Activos
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="vacaciones" id="tab-vacaciones">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">beach_access</span>
        En vacaciones
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="inactivo" id="tab-inactivo">
        <span class="material-symbols-outlined tab-icon" aria-hidden="true">person_off</span>
        Inactivos
      </button>
    </div>


    <!-- Filtros: cada submit hace GET real al Controller — los parámetros van como query string -->
    <!-- WHY: GET en lugar de POST permite compartir URLs con filtros aplicados (bookmarkeable) -->
    <section class="filters-section" aria-label="Filtros de búsqueda" data-i18n-aria-label="gestionprofesionales_filters_aria">
      <form method="get" class="filters-row">
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <input type="search" id="searchInput" name="search" class="search-input"
            placeholder="Buscar por nombre, especialidad o registro..." aria-label="Buscar profesional" data-i18n-ph="gestionprofesionales_search_ph" data-i18n-aria-label="gestionprofesionales_search_aria" value="@ViewData["SearchFilter"]">
        </div>
        <div class="filter-wrap">
          <label for="filterSpecialty" class="visually-hidden" data-i18n="gestionprofesionales_filter_specialty_label">Filtrar por especialidad</label>
          <select id="filterSpecialty" name="especialidad" class="status-select" aria-label="Filtrar profesionales por especialidad" data-i18n-aria-label="gestionprofesionales_filter_specialty_aria">
            <option value="" data-i18n="gestionprofesionales_filter_specialty_all">Todas las especialidades</option>
            @foreach (var especialidad in especialidades)
            {
              var espSelected = ViewData["EspecialidadFilter"]?.ToString() == especialidad.Nombre;
              <option value="@especialidad.Nombre" @(espSelected ? "selected" : null)>@especialidad.Nombre</option>
            }
          </select>
        </div>
        <div class="filter-wrap">
          <label for="filterStatus" class="visually-hidden" data-i18n="gestionprofesionales_filter_status_label">Filtrar por estado</label>
          <select id="filterStatus" name="estado" class="status-select" aria-label="Filtrar profesionales por estado" data-i18n-aria-label="gestionprofesionales_filter_status_aria">
            <option value="" data-i18n="gestionprofesionales_filter_status_all">Todos los estados</option>
            @{
              var estadoActual = ViewData["EstadoFilter"]?.ToString();
              var estadosProf = new[] { ("activo", "Activo"), ("vacaciones", "Vacaciones"), ("inactivo", "Inactivo") };
              foreach (var (clave, texto) in estadosProf)
              {
                if (estadoActual == clave)
                {
                  <option value="@clave" selected data-i18n="gestionprofesionales_status_@clave">@texto</option>
                }
                else
                {
                  <option value="@clave" data-i18n="gestionprofesionales_status_@clave">@texto</option>
                }
              }
            }
          </select>
        </div>
        <!-- Resetear page=1 al filtrar: evita quedarse en una página que ya no existe tras filtrar -->
        <input type="hidden" name="page" value="1" />
        <button class="btn-primary" type="submit" aria-label="Aplicar los filtros de búsqueda seleccionados" data-i18n-aria-label="gestionprofesionales_btn_buscar_aria" data-i18n="gestionprofesionales_btn_buscar">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">search</span>Buscar
        </button>
        <!-- Limpiar: enlace simple al GET sin params — más limpio que resetear el form con JS -->
        <a class="btn-secondary" href="@Url.Action("Stadm07GestionProfesionales", "GestionProfesionales")" aria-label="Limpiar todos los filtros y ver todos los profesionales" data-i18n-aria-label="gestionprofesionales_btn_limpiar_aria" data-i18n="gestionprofesionales_btn_limpiar">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">close</span>Limpiar filtros
        </a>
      </form>
    </section>

    <!-- Tabla de profesionales: renderizada server-side por Razor (SSR) -->
    <!-- WHY: SSR garantiza que el contenido esté disponible inmediatamente sin esperar JS -->
    <section class="table-card" aria-labelledby="professionalsTitle">
      <h2 class="visually-hidden" id="professionalsTitle" data-i18n="gestionprofesionales_table_title">Lista de profesionales</h2>
      <div class="table-wrap">
        <table id="professionalsTable" class="table-base" aria-label="Tabla de profesionales de la clínica" data-i18n-aria-label="gestionprofesionales_table_aria">
          <thead>
            <tr>
              <th scope="col" data-i18n="gestionprofesionales_th_profesional">PROFESIONAL</th>
              <th scope="col" data-i18n="gestionprofesionales_th_especialidad">ESPECIALIDAD</th>
              <th scope="col" data-i18n="gestionprofesionales_th_registro">REGISTRO</th>
              <th scope="col" data-i18n="gestionprofesionales_th_telefono">TELÉFONO</th>
              <th scope="col" data-i18n="gestionprofesionales_th_estado">ESTADO</th>
              <th scope="col" data-i18n="gestionprofesionales_th_acciones">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="professionalsTbody" aria-live="polite">
            @if (!profesionales.Any())
            {
              @await Html.PartialAsync("_EmptyState", new { 
                message = "No se encontraron profesionales",
                icon = "🩺",
                colspan = 6
              })
            }
            @foreach (var profesional in profesionales)
            {
              var especialidadPrincipal = profesional.Especialidades.FirstOrDefault(pe => pe.Principal)?.Especialidad?.Nombre ?? profesional.Especialidades.FirstOrDefault()?.Especialidad?.Nombre;
              <tr>
                <td class="td-profesional">
                  @{
                    var name = $"{profesional.Nombres} {profesional.Apellidos}".Trim();
                    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
                  }
                  <span class="p-avatar p-avatar--color-@(profesional.IdProfesional % 5)">@initials</span>
                  <span class="p-name">@name</span>
                </td>
                <td><span class="badge-spec @((especialidadPrincipal ?? string.Empty).ToLowerInvariant())">@especialidadPrincipal</span></td>
                <td>@profesional.RegistroMedico</td>
                <td>@profesional.Telefono</td>
                <td><span class="badge-status badge-@((profesional.Estado ?? string.Empty).ToLowerInvariant())">@profesional.Estado</span></td>
                <td>
          @{
            var profNombreCompleto = $"{profesional.Nombres} {profesional.Apellidos}".Trim();
            var profIniciales = string.Concat(profNombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
            var avatarColorIdx = profesional.IdProfesional % 5;
            var avatarColorPalette = new[] { "#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6" };
            var profAvatarColor = avatarColorPalette[avatarColorIdx];
            var profStatusClass = $"badge-{((profesional.Estado ?? string.Empty).ToLowerInvariant())}";
          }
          <div class="actions-cell">
            <!-- Ver detalles: abrir modal con data desde atributos -->
            <button class="btn-secondary btn-view view" type="button"
                    data-id="@profesional.IdProfesional"
                    data-name="@Html.Encode(profNombreCompleto)"
                    data-initials="@Html.Encode(profIniciales)"
                    data-specialty="@Html.Encode(especialidadPrincipal)"
                    data-registry="@Html.Encode(profesional.RegistroMedico)"
                    data-phone="@Html.Encode(profesional.Telefono)"
                    data-status="@Html.Encode(profesional.Estado)"
                    data-avatar-color="@profAvatarColor"
                    data-status-class="@profStatusClass"
                    aria-label="@Html.Encode($"Ver detalles del profesional {profesional.Nombres} {profesional.Apellidos}")"
                    title="Ver detalles del profesional @Html.Encode(profNombreCompleto)"
                    data-i18n-title="gestionprofesionales_btn_ver_title">
              <span class="material-symbols-outlined action-icon" aria-hidden="true">visibility</span> <span class="btn-text" data-i18n="gestionprofesionales_btn_ver">Ver</span>
            </button>
            <button class="btn-secondary edit" type="button"
                    onclick="editProfessional(@profesional.IdProfesional)"
                    aria-label="Editar el profesional @profesional.Nombres @profesional.Apellidos"
                    title="Editar profesional @Html.Encode(profNombreCompleto)"
                    data-i18n-title="gestionprofesionales_btn_editar_title">
              <span class="material-symbols-outlined action-icon" aria-hidden="true">edit</span> <span class="btn-text" data-i18n="gestionprofesionales_btn_editar">Editar</span>
            </button>
            @if (String.Equals(profesional.Estado, "activo", StringComparison.OrdinalIgnoreCase))
            {
              <!-- Activo: acción Desactivar -->
              <button class="btn-danger btn-delete toggle" type="button"
                      data-id="@profesional.IdProfesional"
                      data-name="@profesional.Nombres @profesional.Apellidos"
                      data-estado="activo"
                      aria-label="Desactivar el profesional @profesional.Nombres @profesional.Apellidos"
                      title="Desactivar profesional @Html.Encode(profNombreCompleto)"
                      data-i18n-title="gestionprofesionales_btn_desactivar_title">
                <span class="material-symbols-outlined action-icon" aria-hidden="true">block</span> <span class="btn-text" data-i18n="gestionprofesionales_btn_desactivar">Desactivar</span>
              </button>
            }
            else
            {
              <!-- Inactivo/Vacaciones: acción Reactivar -->
              <button class="btn-danger btn-delete toggle" type="button"
                      data-id="@profesional.IdProfesional"
                      data-name="@profesional.Nombres @profesional.Apellidos"
                      data-estado="@(profesional.Estado ?? "inactivo")"
                      aria-label="Reactivar el profesional @profesional.Nombres @profesional.Apellidos"
                      title="Reactivar profesional @Html.Encode(profNombreCompleto)"
                      data-i18n-title="gestionprofesionales_btn_reactivar_title">
                <span class="material-symbols-outlined action-icon" aria-hidden="true">check_circle</span> <span class="btn-text" data-i18n="gestionprofesionales_btn_reactivar">Reactivar</span>
              </button>
            }
          </div>
        </td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <!-- Paginación server-side: los links llevan page, pageSize y filtros actuales como query string -->
      <!-- WHY: cada click es un GET real al Controller — no se cargan todos los registros en memoria -->
      <div class="pagination" role="navigation" aria-label="Paginación de profesionales" data-i18n-aria-label="gestionprofesionales_pagination_aria">
        @{ }
      <span id="paginationInfo" aria-live="polite" data-i18n-html="gestionprofesionales_pagination_info" data-i18n-html-params="{\"showing\":\"@(pageResult?.Items.Count ?? 0)\",\"total\":\"@(pageResult?.TotalCount ?? 0)\"}">Mostrando <strong>@(pageResult?.Items.Count ?? 0)</strong> de <strong>@(pageResult?.TotalCount ?? 0)</strong> profesionales registrados</span>
        <div class="pagination-buttons" id="paginationButtons">
          @if (pageResult != null && pageResult.HasPreviousPage)
          {
            <a class="pagination-btn" aria-label="Página anterior" href="@Url.Action("Stadm07GestionProfesionales", "GestionProfesionales", new { page = pageResult.Page - 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], especialidad = ViewData["EspecialidadFilter"], estado = ViewData["EstadoFilter"] })" data-i18n-aria-label="gestionprofesionales_pagination_prev_aria">‹</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página anterior" disabled data-i18n-aria-label="gestionprofesionales_pagination_prev_aria">‹</button>
          }
          @for (var i = 1; i <= (pageResult?.TotalPages ?? 1); i++)
          {
            var isActive = i == (pageResult?.Page ?? 1);
            <a class="pagination-btn @(isActive ? "active" : string.Empty)" aria-current="@(isActive ? "page" : null)" aria-label="Página @i" href="@Url.Action("Stadm07GestionProfesionales", "GestionProfesionales", new { page = i, pageSize = pageResult?.PageSize ?? 10, search = ViewData["SearchFilter"], especialidad = ViewData["EspecialidadFilter"], estado = ViewData["EstadoFilter"] })" data-i18n-aria-label="gestionprofesionales_pagination_page_aria" data-i18n-aria-label-params="{\"page\":\"@i\"}">@i</a>
          }
          @if (pageResult != null && pageResult.HasNextPage)
          {
            <a class="pagination-btn" aria-label="Página siguiente" href="@Url.Action("Stadm07GestionProfesionales", "GestionProfesionales", new { page = pageResult.Page + 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], especialidad = ViewData["EspecialidadFilter"], estado = ViewData["EstadoFilter"] })" data-i18n-aria-label="gestionprofesionales_pagination_next_aria">›</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página siguiente" disabled data-i18n-aria-label="gestionprofesionales_pagination_next_aria">›</button>
          }
        </div>
      </div>
    </section>

  </main>

  <!-- Modal Crear/Editar Profesional -->
  <!--
    inert attribute: bloquea focus y teclado dentro del modal cuando está cerrado (WCAG 2.1).
    WHY: sin inert, Tab llegaría a los inputs aunque el modal sea invisible — falla de accesibilidad.
    aria-hidden="true" oculta el modal de lectores de pantalla cuando está cerrado.
  -->
  <div class="modal-overlay" id="modalForm" role="dialog" aria-modal="true" aria-labelledby="modalFormTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalFormClose" aria-label="Cerrar ventana" data-i18n-aria-label="gestionprofesionales_modal_close_aria">×</button>
      <h2 class="modal-title" id="modalFormTitle" data-i18n="gestionprofesionales_modal_form_title">Nuevo Profesional</h2>
      <!-- novalidate: desactiva validación HTML nativa para controlar el flujo desde JS -->
      <!-- WHY: la validación nativa del browser no muestra mensajes custom ni toast -->
      <form id="formProfessional" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdProfesional" id="formIdProfesional" value="0" />
        <div class="form-group">
          <label class="form-label" for="formNombres" data-i18n="gestionprofesionales_form_nombres_label">Nombres *</label>
          <input type="text" id="formNombres" name="Nombres" class="form-input" required aria-required="true" aria-describedby="error-formNombres" placeholder="Ej. Carlos" value="" data-i18n-ph="gestionprofesionales_form_nombres_ph">
          <span class="error-message" id="error-formNombres" role="alert" data-i18n="gestionprofesionales_form_nombres_error">Por favor ingresa los nombres.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="formApellidos" data-i18n="gestionprofesionales_form_apellidos_label">Apellidos *</label>
          <input type="text" id="formApellidos" name="Apellidos" class="form-input" required aria-required="true" aria-describedby="error-formApellidos" placeholder="Ej. Méndez Ruiz" value="" data-i18n-ph="gestionprofesionales_form_apellidos_ph">
          <span class="error-message" id="error-formApellidos" role="alert" data-i18n="gestionprofesionales_form_apellidos_error">Por favor ingresa los apellidos.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="formRegistroMedico" data-i18n="gestionprofesionales_form_registro_label">Registro Médico *</label>
          <input type="text" id="formRegistroMedico" name="RegistroMedico" class="form-input" required aria-required="true" aria-describedby="error-formRegistroMedico" placeholder="Ej. RM-2026-001" value="" data-i18n-ph="gestionprofesionales_form_registro_ph">
          <span class="error-message" id="error-formRegistroMedico" role="alert" data-i18n="gestionprofesionales_form_registro_error">Por favor ingresa el registro médico.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="formCategoria" data-i18n="gestionprofesionales_form_categoria_label">Categoría</label>
          <input type="text" id="formCategoria" name="Categoria" class="form-input" placeholder="Ej. Odontología General" value="" data-i18n-ph="gestionprofesionales_form_categoria_ph">
        </div>
        <div class="form-group">
          <label class="form-label" for="formTelefono" data-i18n="gestionprofesionales_form_telefono_label">Teléfono</label>
          <input type="tel" id="formTelefono" name="Telefono" class="form-input" placeholder="Ej. 300 123 4567" value="" data-i18n-ph="gestionprofesionales_form_telefono_ph">
        </div>
        <div class="form-group">
          <label class="form-label" for="formEspecialidad" data-i18n="gestionprofesionales_form_especialidad_label">Especialidad</label>
          <select id="formEspecialidad" name="IdEspecialidad" class="form-input">
            <option value="" data-i18n="gestionprofesionales_form_especialidad_none">Sin especialidad</option>
            @foreach (var especialidad in especialidades)
            {
              <option value="@especialidad.IdEspecialidad">@especialidad.Nombre</option>
            }
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="formCorreoAcceso" data-i18n="gestionprofesionales_form_correo_label">Correo de acceso *</label>
          <input type="email" id="formCorreoAcceso" name="CorreoAcceso" class="form-input" required aria-required="true" placeholder="Ej. profesional@smiletrack.co" value="" data-i18n-ph="gestionprofesionales_form_correo_ph">
          <span class="error-message" id="error-formCorreoAcceso" role="alert" data-i18n="gestionprofesionales_form_correo_error">Ingresa un correo válido.</span>
        </div>
        <div class="form-group">
          <label class="form-label" for="formContrasenaAcceso" data-i18n="gestionprofesionales_form_password_label">Contraseña</label>
          <div style="position:relative;">
            <input type="password" id="formContrasenaAcceso" name="ContrasenaAcceso" class="form-input" minlength="8" placeholder="Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo" style="padding-right:44px;" data-i18n-ph="gestionprofesionales_form_password_ph">
            <button type="button" id="toggleProfesionalPassword" aria-label="Mostrar contraseña" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:transparent;cursor:pointer;font-size:16px;" data-i18n-aria-label="gestionprofesionales_form_password_toggle_aria"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button>
          </div>
          <small id="formContrasenaHelp" style="display:block;margin-top:5px;color:var(--text-muted);" data-i18n="gestionprofesionales_form_password_help">Debe tener 8+ caracteres, mayúscula, minúscula, número y símbolo.</small>
        </div>
        <div class="form-group" id="professionalPasswordRules">
          <div style="font-size:12px;line-height:1.6;">
            <div style="font-weight:600;margin-bottom:4px;" data-i18n="gestionprofesionales_form_password_rules_title">La contraseña debe cumplir:</div>
            <div data-rule="length"><span class="rule-icon material-symbols-outlined" aria-hidden="true">close</span> <span class="rule-text" data-i18n="gestionprofesionales_form_password_rule_length">Mínimo 8 caracteres</span></div>
            <div data-rule="upper"><span class="rule-icon material-symbols-outlined" aria-hidden="true">close</span> <span class="rule-text" data-i18n="gestionprofesionales_form_password_rule_upper">Una letra mayúscula</span></div>
            <div data-rule="lower"><span class="rule-icon material-symbols-outlined" aria-hidden="true">close</span> <span class="rule-text" data-i18n="gestionprofesionales_form_password_rule_lower">Una letra minúscula</span></div>
            <div data-rule="number"><span class="rule-icon material-symbols-outlined" aria-hidden="true">close</span> <span class="rule-text" data-i18n="gestionprofesionales_form_password_rule_number">Un número</span></div>
            <div data-rule="symbol"><span class="rule-icon material-symbols-outlined" aria-hidden="true">close</span> <span class="rule-text" data-i18n="gestionprofesionales_form_password_rule_symbol">Un símbolo especial</span></div>
          </div>
        </div>
        <div class="form-group" id="statusGroup">
          <label class="form-label" for="formStatus" data-i18n="gestionprofesionales_form_estado_label">Estado</label>
          <select id="formStatus" name="Estado" class="form-input" required>
            <option value="activo" data-i18n="gestionprofesionales_status_activo">Activo</option>
            <option value="vacaciones" data-i18n="gestionprofesionales_status_vacaciones">Vacaciones</option>
            <option value="inactivo" data-i18n="gestionprofesionales_status_inactivo">Inactivo</option>
          </select>
          <input type="hidden" name="EstadoFallback" id="formEstado" value="activo" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalFormCancel" data-i18n="common.cancel">Cancelar</button>
          <button type="submit" class="btn-primary" data-i18n="gestionprofesionales_btn_guardar">Guardar Profesional</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Ver Detalle -->
  <div class="modal-overlay" id="modalDetail" role="dialog" aria-modal="true" aria-labelledby="modalDetailTitle"
    aria-hidden="true" inert>
    <div class="modal" style="max-width: 680px;">
      <button class="modal-close" id="modalDetailClose" aria-label="Cerrar ventana" data-i18n-aria-label="gestionprofesionales_modal_close_aria">×</button>
      <h2 class="modal-title" id="modalDetailTitle" data-i18n="gestionprofesionales_modal_detail_title">Ficha de Profesional</h2>

      <!-- Pestañas de navegación interna del modal -->
      <div class="modal-tabs" role="tablist" aria-label="Secciones del profesional">
        <button type="button" class="modal-tab-btn active" id="tabBtnGeneral" role="tab" aria-selected="true" aria-controls="tabPaneGeneral">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">description</span>Ficha General
        </button>
        <button type="button" class="modal-tab-btn" id="tabBtnHorarios" role="tab" aria-selected="false" aria-controls="tabPaneHorarios">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">schedule</span>Horarios de Atención
        </button>
        <button type="button" class="modal-tab-btn" id="tabBtnAusencias" role="tab" aria-selected="false" aria-controls="tabPaneAusencias">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">beach_access</span>Ausencias y Permisos
        </button>
      </div>

      <!-- Tab 1: Ficha General -->
      <div class="modal-tab-pane active" id="tabPaneGeneral" role="tabpanel" aria-labelledby="tabBtnGeneral">
        <div class="modal-detail">
          <div class="detail-avatar-wrap">
            <div class="detail-avatar" id="detailAvatar" aria-hidden="true">--</div>
          </div>
          <h3 class="detail-name" id="detailName">--</h3>
          <p class="detail-specialty" id="detailSpecialty">--</p>
          <div class="detail-grid">
            <div class="detail-item">
              <span class="detail-key" data-i18n="gestionprofesionales_detail_registro">Registro Médico</span>
              <span class="detail-value" id="detailRegistry">--</span>
            </div>
            <div class="detail-item">
              <span class="detail-key" data-i18n="gestionprofesionales_detail_telefono">Teléfono</span>
              <span class="detail-value" id="detailPhone">--</span>
            </div>
            <div class="detail-item">
              <span class="detail-key" data-i18n="gestionprofesionales_detail_estado">Estado</span>
              <span class="detail-value"><span class="badge-status" id="detailStatus">--</span></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Horarios de Atención -->
      <div class="modal-tab-pane" id="tabPaneHorarios" role="tabpanel" aria-labelledby="tabBtnHorarios">
        <section id="professionalSchedule" aria-labelledby="professionalScheduleTitle">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:8px;">
            <h3 id="professionalScheduleTitle" style="margin:0;font-size:1rem;font-weight:700;">Horario Semanal de Atención</h3>
            <button type="button" class="btn-secondary" id="btnApplyDefaultSchedule" style="font-size:0.8rem;padding:4px 10px;">
              <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;margin-right:3px;" aria-hidden="true">bolt</span>Aplicar Horario Estándar (Lun-Vie 08:00 - 17:00)
            </button>
          </div>
          <p style="font-size:0.82rem;color:var(--text-muted);margin:0 0 12px;line-height:1.4;">
            <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:3px;" aria-hidden="true">lightbulb</span> <em>Configura los días y franjas horarias en las que este profesional atiende citas. Si no tiene días configurados, el sistema usará el horario general de la clínica por defecto.</em>
          </p>
          <form id="scheduleForm">
            <div class="schedule-grid" id="scheduleDaysContainer">
              <!-- Renderizado dinámico desde app.js -->
            </div>
            <div style="margin-top:16px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
              <span id="scheduleStatusMsg" style="font-size:0.82rem;font-weight:600;"></span>
              <button type="submit" class="btn-primary" id="scheduleSaveButton">
                <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">save</span>Guardar Horarios
              </button>
            </div>
          </form>
          <p id="scheduleLoading" aria-live="polite" style="margin:10px 0 0;font-size:0.85rem;color:var(--text-muted);"></p>
        </section>
      </div>

      <!-- Tab 3: Ausencias -->
      <div class="modal-tab-pane" id="tabPaneAusencias" role="tabpanel" aria-labelledby="tabBtnAusencias">
        <section id="professionalAbsences" aria-labelledby="professionalAbsencesTitle">
          <h3 id="professionalAbsencesTitle" style="margin:0 0 12px;font-size:1rem;font-weight:700;">Registro de Ausencias</h3>
          <form id="absenceForm" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
            <input type="hidden" id="absenceId" value="">
            <label class="form-label">Tipo
              <select id="absenceTipo" class="form-input" required>
                <option value="vacaciones">Vacaciones</option>
                <option value="incapacidad">Incapacidad</option>
                <option value="permiso">Permiso</option>
                <option value="otro">Otro</option>
              </select>
            </label>
            <label class="form-label">Inicio
              <input type="date" id="absenceFechaInicio" class="form-input" required>
            </label>
            <label class="form-label">Fin
              <input type="date" id="absenceFechaFin" class="form-input" required>
            </label>
            <label class="form-label" style="grid-column:1/-1;">Observaciones
              <input type="text" id="absenceObservaciones" class="form-input" maxlength="500">
            </label>
            <div style="grid-column:1/-1;display:flex;gap:8px;">
              <button type="submit" class="btn-primary" id="absenceSaveButton">Registrar ausencia</button>
              <button type="button" class="btn-secondary" id="absenceCancelEdit" hidden>Cancelar edición</button>
            </div>
          </form>
          <p id="absenceLoading" aria-live="polite" style="margin:12px 0 0;">Cargando ausencias...</p>
          <div id="absenceList" style="display:grid;gap:8px;margin-top:10px;"></div>
        </section>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modalDetailCloseBtn" data-i18n="common.close">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Confirmar Eliminación -->
  <div class="modal-overlay" id="modalConfirmDelete" role="dialog" aria-modal="true" aria-labelledby="modalConfirmDeleteTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalConfirmDeleteClose" aria-label="Cerrar ventana" data-i18n-aria-label="gestionprofesionales_modal_close_aria">×</button>
      <h2 class="modal-title" id="modalConfirmDeleteTitle" data-i18n="gestionprofesionales_modal_delete_title">Desactivar profesional</h2>
      <p id="modalConfirmDeleteMessage" style="margin-bottom: 8px;" data-i18n="gestionprofesionales_modal_delete_question">¿Estás seguro de desactivar a este profesional?</p>
      <p id="modalConfirmDeleteWarning" style="margin-bottom: 20px; font-size: 0.875rem; color: var(--text-muted);" data-i18n="gestionprofesionales_modal_delete_warning">
        ⚠️ El profesional pasará a estado <strong>inactivo</strong> y no podrá recibir nuevas citas. Esta operación es reversible: puedes reactivarlo editando su perfil. No es posible desactivar profesionales con citas activas pendientes.
      </p>
      <input type="hidden" id="deleteProfesionalId" value="" />
      <input type="hidden" id="deleteProfesionalEstado" value="activo" />
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modalConfirmDeleteCancel"
                aria-label="Cancelar eliminación del profesional" data-i18n-aria-label="gestionprofesionales_modal_delete_cancel_aria" data-i18n="gestionprofesionales_modal_delete_cancel">
          Cancelar — no desactivar
        </button>
        <button type="button" id="modalConfirmDeleteConfirm" class="btn-primary"
                style="background-color: var(--red); border-color: var(--red);"
                aria-label="Confirmar desactivación del profesional seleccionado" data-i18n-aria-label="gestionprofesionales_modal_delete_confirm_aria" data-i18n="gestionprofesionales_modal_delete_confirm">
          Confirmar desactivación
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil" data-i18n-aria-label="gestionprofesionales_mobile_nav_aria">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">query_stats</span></span>
      <span data-i18n="gestionprofesionales_mobile_dashboard">Dashboard</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">stethoscope</span></span>
      <span data-i18n="gestionprofesionales_mobile_profesionales">Profesionales</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></span>
      <span data-i18n="gestionprofesionales_mobile_agenda">Agenda</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  @if (TempData["MensajeExito"] != null)
  {
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toast = document.getElementById('toast');
        if (toast) {
          toast.textContent = '✅ @TempData["MensajeExito"]';
          toast.className = 'toast show';
          setTimeout(() => toast.classList.remove('show'), 4000);
        }
      });
    </script>
  }

  @if (TempData["ErrorValidacion"] != null)
  {
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toast = document.getElementById('toast');
        if (toast) {
          toast.textContent = '⚠️ @TempData["ErrorValidacion"]';
          toast.className = 'toast warning show';
          setTimeout(() => toast.classList.remove('show'), 5000);
        }
      });
    </script>
  }

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
      <p data-i18n="footer.copyright" data-i18n-html-params="{\"year\":\"@DateTime.Now.Year\"}">© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub" data-i18n="gestionprofesionales_footer_sub">Proyecto Formativo ADSO — SENA</p>
  </footer>
  <!-- Scripts finales (fuera del footer para HTML válido) -->

<script>
   // La apertura del modal de edición SSR fue migrada a la Fase 2E:
   // editProfessional(id) en app.js carga los datos desde GET /api/profesionales/{id}
   // y abre el modal sin necesidad de recargar la página.
   // El bloque isEditing anterior fue eliminado porque editingProfesional ya no existe
   // en el contexto Razor (el flujo MVC de edición fue reemplazado por el flujo API).
</script>

@section Scripts {
    <script src="~/js/Gestion_De_Profesionales/st-adm-07-gestion-profesionales/app.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
}
