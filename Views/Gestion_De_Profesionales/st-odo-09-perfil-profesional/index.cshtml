@* ============================================
SmileTrack — Perfil Profesional (st-odo-09-perfil-profesional)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista que permite al profesional de la salud visualizar sus datos personales, especialidades asociadas, estado de su agenda, y actualizar información de contacto de manera segura.

FUNCIONALIDADES PRINCIPALES:
- Visualización de datos de perfil del odontólogo logueado (nombres, especialidades, registro médico)
- Formulario interactivo para actualización de información personal y de contacto
- Sección de seguridad para cambio de contraseña y credenciales de acceso

DEPENDENCIAS TÉCNICAS:
- Controller: GestionProfesionalesController (ViewData: LoggedProfesional)
- CSS: ~/css/Gestion_De_Profesionales/st-odo-09-perfil-profesional/styles.css
- JS: ~/js/Gestion_De_Profesionales/st-odo-09-perfil-profesional/perfil.js
- Partial / Otros: Sidebar unificado

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
============================================ *@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Perfil";
    var loggedProfesional = ViewData["LoggedProfesional"] as SmileTrack_MVC.Models.Entities.Profesional;
    var especialidades = loggedProfesional?.Especialidades?.Select(pe => pe.Especialidad?.Nombre).Where(n => n != null).ToList() ?? new List<string?>();
    var initials = loggedProfesional != null && !string.IsNullOrEmpty(loggedProfesional.Nombres)
        ? $"{loggedProfesional.Nombres[0]}{(string.IsNullOrEmpty(loggedProfesional.Apellidos) ? "" : loggedProfesional.Apellidos[0])}"
        : "DR";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Profesionales/st-odo-09-perfil-profesional/styles.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="sidebar_main_nav">
          <span data-i18n="common_role_profesional">Odontólogo</span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-active" data-i18n="profile.title">Perfil Profesional</span>
        </nav>
        <h1 class="page-title" data-i18n="profile.title">Mi Perfil Profesional</h1>
        <p class="page-subtitle" data-i18n="profile.professional_subtitle">Informaci&#243;n personal y configuraci&#243;n del profesional</p>
      </div>
    </header>

    <!-- Profile Header Card -->
    <section class="profile-header-card" aria-labelledby="profileName">
      <div class="profile-avatar-large" aria-hidden="true">@initials</div>
      <div class="profile-info">
        <h2 id="profileName">@(loggedProfesional != null ? $"Dr. {loggedProfesional.Nombres} {loggedProfesional.Apellidos}" : "Profesional no disponible")</h2>
        <div class="profile-tags" role="list">
          @if (loggedProfesional != null)
          {
            foreach (var esp in especialidades)
            {
              <span class="tag tag-blue" role="listitem"><span class="material-symbols-outlined" style="font-size:.85rem;vertical-align:middle;margin-right:2px;" aria-hidden="true">medical_services</span> @esp</span>
            }
            <span class="tag tag-green" role="listitem"><span class="material-symbols-outlined" style="font-size:.85rem;vertical-align:middle;margin-right:2px;" aria-hidden="true">verified</span> @loggedProfesional.RegistroMedico</span>
          }
          else
          {
            <span class="tag tag-gray" role="listitem">Información no disponible</span>
          }
        </div>
      </div>
    </section>

    <!-- Content Layout -->
    <div class="content-layout">

      <!-- Left Column: Personal Info -->
      <div class="content-left">
        <div class="card info-card">
          <h3 class="card-title"><span class="material-symbols-outlined" style="font-size:1.05rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">person_search</span><span data-i18n="common.personal_data">Información personal</span></h3>

          <div class="info-grid">
            <div class="info-item">
              <div class="info-icon" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">call</span></div>
              <div>
                <label>Teléfono</label>
                <div class="info-value">@(loggedProfesional?.Telefono ?? "No disponible")</div>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">mail</span></div>
              <div>
                <label>Correo</label>
                <div class="info-value">@(loggedProfesional?.Usuario?.Correo ?? "No disponible")</div>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></div>
              <div>
                <label>Fecha de ingreso</label>
                <div class="info-value">
                  <time datetime="@(loggedProfesional?.FechaIngreso?.ToString("yyyy-MM-dd") ?? string.Empty)">
                    @(loggedProfesional?.FechaIngreso?.ToString("dd MMM yyyy") ?? "No disponible")
                  </time>
                </div>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon" aria-hidden="true"></div>
              <div>
                <label>Estado</label>
                <div class="info-value">
                  <span class="status-badge active" role="status" aria-label="Estado: @(loggedProfesional?.Estado ?? "Activo")">
                    <span class="status-dot" aria-hidden="true"></span>
                    @(loggedProfesional?.Estado ?? "Activo")
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="form-divider"></div>

          <!-- Change Password Section -->
          <div class="password-section">
            <h3 class="card-title"><span class="material-symbols-outlined" style="font-size:1.05rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">lock</span> Cambiar contraseña</h3>

            <form id="passwordForm" novalidate>
              @Html.AntiForgeryToken()
              <div class="form-group">
                <label class="form-label" for="currentPassword">Contraseña actual</label>
                <div class="input-with-icon">
                  <input type="password" class="form-input" id="currentPassword" placeholder="••••••••" required
                    aria-required="true">
                  <button type="button" class="toggle-password" aria-label="Mostrar u ocultar contraseña actual"
                    aria-pressed="false"><span class="material-symbols-outlined" aria-hidden="true">visibility</span></button>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="newPassword">Nueva contraseña</label>
                <div class="input-with-icon">
                  <input type="password" class="form-input" id="newPassword" placeholder="••••••••" required
                    aria-required="true" aria-describedby="passwordStrength">
                  <button type="button" class="toggle-password" aria-label="Mostrar u ocultar nueva contraseña"
                    aria-pressed="false">👁</button>
                </div>
                <div class="password-strength" id="passwordStrength" role="status" aria-live="polite"></div>
              </div>
              <div class="form-group">
                <label class="form-label" for="confirmPassword">Confirmar nueva contraseña</label>
                <div class="input-with-icon">
                  <input type="password" class="form-input" id="confirmPassword" placeholder="••••••••" required
                    aria-required="true">
                  <button type="button" class="toggle-password"
                    aria-label="Mostrar u ocultar confirmación de contraseña" aria-pressed="false">👁</button>
                </div>
              </div>
              <button type="submit" class="btn-primary">Actualizar contraseña</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Right Column: Schedule -->
      <div class="content-right">
        <div class="card schedule-card">
          <div class="schedule-header">
            <h3 class="card-title schedule-card-title"><span class="material-symbols-outlined" style="font-size:1.05rem;vertical-align:middle;margin-right:4px;" aria-hidden="true">calendar_month</span> Horario Semanal</h3>
            <span class="edit-hint">Click en un día para editar</span>
          </div>

          <div class="schedule-grid" id="scheduleGrid" role="list" aria-label="Horario semanal del profesional"
               data-profesional-id="@(loggedProfesional?.IdProfesional ?? 0)">
            <!-- Generated by JS -->
          </div>

          <div class="schedule-legend" aria-hidden="true">
            <div class="legend-item">
              <span class="legend-dot active"></span>
              <span>Día laboral</span>
            </div>
            <div class="legend-item">
              <span class="legend-dot inactive"></span>
              <span>No disponible</span>
            </div>
          </div>

          <div class="schedule-summary" id="scheduleSummary" aria-live="polite">
            <div class="summary-text">Total semanal</div>
            <div class="summary-number" id="totalHours">0 horas</div>
            <div class="summary-text" id="totalDays">0 días laborales</div>
          </div>
        </div>
      </div>

    </div>

  </main>

  <!-- ═════ MODAL EDITAR HORARIO ═════ -->
  <div class="modal-backdrop" id="scheduleModal" role="dialog" aria-modal="true" aria-labelledby="modalDayName"
    aria-hidden="true" inert>
    <div class="modal-schedule" role="document">
      <div class="modal-header">
        <div class="modal-header-left">
          <div class="modal-day-icon" id="modalDayIcon" aria-hidden="true"></div>
          <div>
            <h3 class="modal-day-name" id="modalDayName"></h3>
            <div class="modal-day-subtitle">Editar horario laboral</div>
          </div>
        </div>
        <button class="modal-close" id="modalClose" aria-label="Cerrar ventana de edición">×</button>
      </div>

      <div class="modal-body">
        <!-- Toggle Activo/Inactivo -->
        <div class="modal-toggle-section">
          <label class="modal-toggle">
            <!--
              ACCESIBILIDAD: El checkbox mantiene position:absolute + opacity:0
              para que sea alcanzable por teclado y lectores de pantalla.
              role="switch" + aria-checked son actualizados por perfil.js.
            -->
            <input type="checkbox"
                   id="modalDayActive"
                   role="switch"
                   aria-checked="false"
                   aria-describedby="toggleText">
            <span class="toggle-slider" aria-hidden="true"></span>
            <span class="toggle-text" id="toggleText">Día laboral</span>
          </label>
        </div>

        <!-- Time Inputs (solo visibles si está activo) -->
        <div class="modal-time-section" id="modalTimeSection">
          <div class="time-input-group">
            <label class="time-label" for="modalStartTime"><span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:3px;" aria-hidden="true">wb_twilight</span> Hora de inicio</label>
            <input type="time" class="time-input" id="modalStartTime" value="08:00">
          </div>
          <div class="time-separator" aria-hidden="true">
            <span>a</span>
          </div>
          <div class="time-input-group">
            <label class="time-label" for="modalEndTime"><span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;margin-right:3px;" aria-hidden="true">nightlight</span> Hora de fin</label>
            <input type="time" class="time-input" id="modalEndTime" value="12:00">
          </div>
        </div>

        <!-- Preview -->
        <div class="modal-preview" id="modalPreview" aria-live="polite">
          <div class="preview-label">Horario resultante:</div>
          <div class="preview-time" id="previewTime">08:00 - 12:00</div>
          <div class="preview-hours" id="previewHours">4 horas</div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="modal-btn modal-btn-secondary" id="modalCancel">Cancelar</button>
        <button class="modal-btn modal-btn-primary" id="modalSave" disabled aria-disabled="true" title="Cargando horario..."><span class="material-symbols-outlined" aria-hidden="true">save</span> Guardar horario</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>


  <!-- Mobile bottom nav — Odontólogo -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">bar_chart</span></span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span></span>
      <span>Mi agenda</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon"><span class="material-symbols-outlined" aria-hidden="true">person</span></span>
      <span>Perfil</span>
    </a>
  </nav>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div class="profile-footer-content">
      <span class="material-symbols-outlined" aria-hidden="true">copyright</span>
      <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>

  </footer>
@section Scripts {
    <script src="~/js/shared/toasts.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
    <script src="~/js/Gestion_De_Profesionales/st-odo-09-perfil-profesional/perfil.js" asp-append-version="true" defer></script>
}
