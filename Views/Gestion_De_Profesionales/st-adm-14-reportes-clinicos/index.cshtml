@* ============================================
SmileTrack — Reportes Clínicos (st-adm-14-reportes-clinicos)
============================================
Autor: Johan Santamaria
Fecha: 29/07/2026

DESCRIPCIÓN:
Vista de administración de reportes clínicos que permite al administrador consultar, filtrar y paginar los reportes generados por los odontólogos.

FUNCIONALIDADES PRINCIPALES:
- Tabla paginada de reportes clínicos renderizada server-side con Razor desde PagedResult
- Filtros por profesional, rango de fechas y estado del reporte
- Diagnóstico y procedimiento provenientes de la nota clínica más reciente por paciente

DEPENDENCIAS TÉCNICAS:
- Controller: GestionProfesionalesController (ViewData: ProfesionalesReportes, ReportesClinicos, ReportesClinicosPage)
- CSS: ~/css/Gestion_De_Profesionales/st-adm-14-reportes-clinicos/styles.css
- JS: ~/js/Gestion_De_Profesionales/st-adm-14-reportes-clinicos/reportes.js
- Partial / Otros: Layout o Layout=null (verificar)

NOTAS DE MANTENIMIENTO:
- Los comentarios internos explican el "por qué" de las decisiones de diseño/negocio, no el "qué" hace el código básico.
- La vista usa PagedResult para no cargar todos los reportes en memoria y mantener tiempos de respuesta aceptables.
============================================ *@
@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_Profesionales/st-adm-14-reportes-clinicos/styles.css" asp-append-version="true" />
}

@{ Layout = "_Layout"; ViewData["Title"] = "Reportes Clínicos";
  
    var profesionales = ViewData["ProfesionalesReportes"] as List<string> ?? new();
    var reportes = ViewData["ReportesClinicos"] as List<SmileTrack_MVC.Models.ViewModels.ReporteClinicoViewModel> ?? new();
    var pageResult = ViewData["ReportesClinicosPage"] as SmileTrack_MVC.Models.Shared.PagedResult<SmileTrack_MVC.Models.ViewModels.ReporteClinicoViewModel>;
}



    <!-- ═══ MAIN ═══ -->
    <main class="main" id="main-content">

        <!-- Header -->
        <header class="page-header">
            <div class="header-left">
                <nav class="breadcrumb" aria-label="Ruta de navegación">
                    <span data-i18n="reportesclinicos_breadcrumb_admin">Administración</span>
                    <span class="bc-sep" aria-hidden="true">›</span>
                    <span class="bc-active" data-i18n="reportesclinicos_breadcrumb_current">Reportes Clínicos</span>
                </nav>
                <h1 class="page-title" data-i18n="reportesclinicos_title">Reportes Clínicos</h1>
                <p class="page-subtitle" data-i18n="reportesclinicos_subtitle">Análisis médico y seguimiento de pacientes</p>
            </div>
        </header>

        <!-- Stats Grid -->
        <section class="stats-grid" aria-label="Resumen clínico" data-i18n-aria-label="reportesclinicos_stats_aria">
            <div class="stat-card" data-color="blue">
                <span class="stat-number" id="metricTotal" data-target="@(ViewData["TotalPacientesReportes"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label" data-i18n="reportesclinicos_stat_pacientes">Pacientes Registrados</span>
            </div>
            <div class="stat-card" data-color="green">
                <span class="stat-number" id="metricActivos" data-target="@(ViewData["ConsultasMes"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label" data-i18n="reportesclinicos_stat_consultas">Consultas Este Mes</span>
            </div>
            <div class="stat-card" data-color="purple">
                <span class="stat-number" id="metricAttendanceRate" data-target="@(ViewData["TasaAsistencia"] ?? 0)" aria-live="polite">0</span>
                <span class="stat-label" data-i18n="reportesclinicos_stat_asistencia">Tasa de asistencia</span>
            </div>
        </section>


        <!-- Filtros -->
        <section class="filters-section" aria-label="Filtros de búsqueda" data-i18n-aria-label="reportesclinicos_filters_aria">
            <form method="get" class="filters-row">
                <div class="search-wrap">
                    <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
                    <input type="search" id="searchInput" name="search" class="search-input" placeholder="Buscar por nombre o documento..." aria-label="Buscar paciente" data-i18n-ph="reportesclinicos_search_ph" data-i18n-aria-label="reportesclinicos_search_aria" value="@ViewData["SearchFilter"]">
                </div>
                <div class="filter-wrap">
                    <label for="filterProfessional" class="visually-hidden" data-i18n="reportesclinicos_filter_profesional_label">Filtrar por profesional</label>
                    <select id="filterProfessional" name="profesional" class="status-select" aria-label="Filtrar por profesional" data-i18n-aria-label="reportesclinicos_filter_profesional_aria">
                        <option value="" data-i18n="reportesclinicos_filter_profesional_all">Todos los profesionales</option>
                        @foreach (var prof in profesionales)
                        {
                            var profSelected = ViewData["ProfesionalFilter"]?.ToString() == prof;
                            <option value="@prof" @(profSelected ? "selected" : null)>@prof</option>
                        }
                    </select>
                </div>
                <div class="filter-wrap">
                    <label for="filterMes" class="visually-hidden" data-i18n="reportesclinicos_filter_mes_label">Filtrar por mes</label>
                    <select id="filterMes" name="mes" class="status-select" aria-label="Filtrar por mes" data-i18n-aria-label="reportesclinicos_filter_mes_aria">
                        <option value="" data-i18n="reportesclinicos_filter_mes_all">Todos los meses</option>
                        @for (int i = 0; i < 12; i++)
                        {
                            var mes = DateTime.Now.AddMonths(-i).ToString("yyyy-MM");
                            var mesTexto = DateTime.Now.AddMonths(-i).ToString("MMMM yyyy");
                            var mesSelected = ViewData["MesFilter"]?.ToString() == mes;
                            <option value="@mes" @(mesSelected ? "selected" : null)>@mesTexto</option>
                        }
                    </select>
                </div>
                <!-- Resetear page=1 al filtrar -->
                <input type="hidden" name="page" value="1" />
                <button class="btn-primary" type="submit" data-i18n="reportesclinicos_btn_aplicar">Aplicar</button>
                <a class="btn-secondary" href="@Url.Action("Stadm14ReportesClinicos", "GestionProfesionales")" data-i18n="reportesclinicos_btn_limpiar">Limpiar</a>
            </form>
        </section>

        <!-- Tabla de reportes -->
        <section class="table-card" aria-labelledby="reportesTitle">
            <h2 class="visually-hidden" id="reportesTitle" data-i18n="reportesclinicos_table_title">Lista de reportes clínicos</h2>
            <div class="table-wrap">
                <table id="reportesTable" class="table-base" aria-label="Tabla de reportes clínicos" data-i18n-aria-label="reportesclinicos_table_aria">
                    <thead>
                        <tr>
                            <th scope="col" data-i18n="reportesclinicos_th_paciente">PACIENTE</th>
                            <th scope="col" data-i18n="reportesclinicos_th_ultconsulta">ÚLTIMA CONSULTA</th>
                            <th scope="col" data-i18n="reportesclinicos_th_diagnostico">DIAGNÓSTICO</th>
                            <th scope="col">PROCEDIMIENTO</th>
                            <th scope="col" data-i18n="reportesclinicos_th_profesional">PROFESIONAL</th>
                            <th scope="col" data-i18n="reportesclinicos_th_proxcita">PRÓXIMA CITA</th>
                            <th scope="col" data-i18n="reportesclinicos_th_alerta">ALERTA</th>
                        </tr>
                    </thead>
                    <tbody id="reportesTbody" aria-live="polite">
                        @if (!reportes.Any())
                        {
                            <tr>
                                <td colspan="7" style="text-align:center; padding:48px 24px; color:var(--text-muted);">
                                    <div style="font-size:2rem; margin-bottom:8px;">🩺</div>
                                    <strong data-i18n="reportesclinicos_empty_title">Sin resultados</strong>
                                    <br /><span style="font-size:0.875rem;" data-i18n-html="reportesclinicos_empty_desc">Ningún reporte coincide con los filtros aplicados. <a href="@Url.Action("Stadm14ReportesClinicos", "GestionProfesionales")">Limpiar filtros</a></span>
                                </td>
                            </tr>
                        }
                        @foreach (var reporte in reportes)
                        {
                            <tr>
                                <td class="td-profesional">
                                    @{
                                        var name = reporte.NombrePaciente;
                                        var initials = reporte.Avatar;
                                    }
                                    <div class="p-avatar p-avatar--color-@(reporte.Id % 5)">@initials</div>
                                    <div>
                                        <span class="p-name">@name</span>
                                        <span style="font-size: 0.75rem; color: var(--text-muted);">@reporte.Documento · @reporte.Edad años</span>
                                    </div>
                                </td>
                                <td>@reporte.UltimaConsulta.ToString("dd/MM/yyyy")</td>
                                <td>@reporte.Diagnostico</td>
                                <td>@reporte.Procedimiento</td>
                                <td>@reporte.ProfesionalNombre</td>
                                <td>
                                    @if (reporte.ProximaCita.HasValue)
                                    {
                                        <span class="badge-spec general">@reporte.ProximaCita.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-inactivo">Sin cita</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(reporte.Alerta))
                                    {
                                        <span class="badge-status badge-inactivo">⚠️ @reporte.Alerta</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination" role="navigation" aria-label="Paginación de reportes">
                <span id="paginationInfo" aria-live="polite">Mostrando <strong>@(pageResult?.Items.Count ?? 0)</strong> de <strong>@(pageResult?.TotalCount ?? 0)</strong> reportes clínicos</span>
                <div class="pagination-buttons" id="paginationButtons">
                    @if (pageResult != null && pageResult.HasPreviousPage)
                    {
                        <a class="pagination-btn" aria-label="Página anterior" href="@Url.Action("Stadm14ReportesClinicos", "GestionProfesionales", new { page = pageResult.Page - 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], profesional = ViewData["ProfesionalFilter"], mes = ViewData["MesFilter"] })">‹</a>
                    }
                    else
                    {
                        <button class="pagination-btn" aria-label="Página anterior" disabled>‹</button>
                    }
                    @for (var i = 1; i <= (pageResult?.TotalPages ?? 1); i++)
                    {
                        var isActive = i == (pageResult?.Page ?? 1);
                        <a class="pagination-btn @(isActive ? "active" : string.Empty)" aria-current="@(isActive ? "page" : null)" aria-label="Página @i" href="@Url.Action("Stadm14ReportesClinicos", "GestionProfesionales", new { page = i, pageSize = pageResult?.PageSize ?? 10, search = ViewData["SearchFilter"], profesional = ViewData["ProfesionalFilter"], mes = ViewData["MesFilter"] })">@i</a>
                    }
                    @if (pageResult != null && pageResult.HasNextPage)
                    {
                        <a class="pagination-btn" aria-label="Página siguiente" href="@Url.Action("Stadm14ReportesClinicos", "GestionProfesionales", new { page = pageResult.Page + 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], profesional = ViewData["ProfesionalFilter"], mes = ViewData["MesFilter"] })">›</a>
                    }
                    else
                    {
                        <button class="pagination-btn" aria-label="Página siguiente" disabled>›</button>
                    }
                </div>
            </div>
        </section>

    </main>

    <!-- Mobile bottom nav -->
    <nav class="mobile-nav" aria-label="Navegación móvil">
        <a href="/gestion-de-profesionales/st-adm-07-gestion-profesionales" class="mobile-nav-item">
            <span class="mobile-nav-icon" aria-hidden="true">📊</span>
            <span>Dashboard</span>
        </a>
        <a href="#" class="mobile-nav-item active" aria-current="page">
            <span class="mobile-nav-icon" aria-hidden="true">📋</span>
            <span>Reportes</span>
        </a>
        <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
            <span class="mobile-nav-icon" aria-hidden="true">📅</span>
            <span>Agenda</span>
        </a>
    </nav>

    <!-- Toast -->
    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

    <!-- Estilos para screen readers -->
    <style>
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--primary);
            color: #fff;
            padding: 8px 16px;
            z-index: 1000;
            transition: top var(--tr);
        }

        .skip-link:focus {
            top: 0;
            outline: 2px solid #fff;
            outline-offset: 2px;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    </style>

    <footer id="dynamic-footer" class="site-footer" role="contentinfo">
        <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
            <span class="material-symbols-outlined" aria-hidden="true" style="font-size:1rem;">copyright</span>
            <p>© @DateTime.Now.Year Smile Track — Todos los derechos reservados.</p>
        </div>
        <p class="footer-sub">Proyecto Formativo ADSO — SENA</p>
    </footer>

@section Scripts {
    <script src="~/js/Gestion_De_Profesionales/st-adm-14-reportes-clinicos/reportes.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/validation-utils.js" asp-append-version="true" defer></script>
}
