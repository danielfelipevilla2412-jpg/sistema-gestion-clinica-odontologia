@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de PQR";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_PQR/st-adm-17-gestion-pqr/styles.css" asp-append-version="true" />
}

    <main class="main pqr-page" id="main-content">
        <header class="page-header">
            <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="layout_breadcrumb_aria">
                <a href="/gestion-de-citas/st-adm-01-dashboard" data-i18n="common_bc_administracion">Administración</a>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span aria-current="page" data-i18n="pqr.title">Gestión de PQR</span>
            </nav>
            <div class="page-header-content">
              <div class="page-header-title">
                <h1 class="page-title" data-i18n="pqr.title">Gestión de PQR</h1>
                <p class="page-subtitle" data-i18n="pqr.admin_subtitle">Administra, consulta y responde las solicitudes de los pacientes.</p>
              </div>
              <div class="page-header-actions action-buttons">
                <button class="notification-btn" id="pqrNotificationBtn"
                        type="button"
                        title="Nuevas solicitudes PQR" data-i18n-title="pqr.notifications_aria"
                        aria-label="Nuevas solicitudes PQR" data-i18n-aria-label="pqr.notifications_aria">
                    <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
                    <span class="notification-badge" id="pqrNotificationBadge" aria-live="polite">0</span>
                </button>
              </div>
            </div>
        </header>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <span class="material-symbols-outlined" aria-hidden="true">inbox</span>
                </div>
                <div class="stat-info">
                    <h3 id="statTotal">0</h3>
                    <p data-i18n="pqr.total">Total PQR</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon yellow">
                    <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                </div>
                <div class="stat-info">
                    <h3 id="statSinResponder">0</h3>
                    <p data-i18n="pqr.unanswered">Sin responder</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple">
                    <span class="material-symbols-outlined" aria-hidden="true">pending_actions</span>
                </div>
                <div class="stat-info">
                    <h3 id="statEnGestion">0</h3>
                    <p data-i18n="pqr.in_management">En gestión</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red">
                    <span class="material-symbols-outlined" aria-hidden="true">warning</span>
                </div>
                <div class="stat-info">
                    <h3 id="statVencidas">0</h3>
                    <p data-i18n="pqr.overdue">Vencidas</p>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-bar">
            <div class="search-box">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input type="search" id="searchInput" placeholder="Buscar por paciente, radicado o asunto..."
                       aria-label="Buscar solicitudes PQR" data-i18n-ph="table.search" data-i18n-aria-label="pqr.search_aria">
            </div>
            <select class="filter-select" id="filterTipo" aria-label="Filtrar por tipo" data-i18n-aria-label="pqr.type">
                <option value="todos" data-i18n="pqr.all_types">Todos los tipos</option>
                <option value="peticion" data-i18n="pqr.type_petition">Petición</option>
                <option value="queja" data-i18n="pqr.type_complaint">Queja</option>
                <option value="reclamo" data-i18n="pqr.type_claim">Reclamo</option>
                <option value="sugerencia" data-i18n="pqr.type_suggestion">Sugerencia</option>
            </select>
            <select class="filter-select" id="filterEstado" aria-label="Filtrar por estado" data-i18n-aria-label="pqr.status">
                <option value="todos" data-i18n="pqr.all_statuses">Todos los estados</option>
                <option value="recibido" data-i18n="pqr.status_received">Recibido</option>
                <option value="proceso" data-i18n="pqr.status_in_progress">En proceso</option>
                <option value="resuelto" data-i18n="pqr.status_resolved">Resuelto</option>
                <option value="cerrado" data-i18n="pqr.status_closed">Cerrado</option>
                <option value="rechazado" data-i18n="pqr.rejected">Rechazado</option>
            </select>
        </div>

        <!-- Content Container -->
        <div class="content-container">
            <!-- Table -->
            <div class="table-container">
                <div class="table-wrapper table-wrap" role="region" aria-label="Tabla de solicitudes PQR" data-i18n-aria-label="pqr.table_aria" tabindex="0">
                    <table id="pqrsTable" aria-label="Solicitudes PQR" data-i18n-aria-label="pqr.table_aria">
                        <thead>
                            <tr>
                                <th scope="col" data-i18n="pqr.ticket">Radicado</th>
                                <th scope="col" data-i18n="citas.patient">Paciente</th>
                                <th scope="col" data-i18n="pqr.type">Tipo</th>
                                <th scope="col" data-i18n="pqr.subject">Asunto</th>
                                <th scope="col" data-i18n="pqr.status">Estado</th>
                                <th scope="col" data-i18n="pqr.priority">Prioridad</th>
                                <th scope="col" data-i18n="citas.date">Tiempo</th>
                                <th scope="col" data-i18n="table.actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="pqrsTableBody">
                            <!-- Filas renderizadas dinámicamente por script.js desde window.RAZOR_PQRS (datos reales de SQL Server) -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="detail-overlay" id="detailOverlay" aria-hidden="true"></div>

            <!-- Detail Panel -->
            <div class="detail-panel" id="detailPanel" role="region" aria-label="Detalle de solicitud PQR" data-i18n-aria-label="pqr.detail_aria">
                <div class="empty-state" id="emptyState">
                    <span class="material-symbols-outlined" aria-hidden="true">touch_app</span>
                    <h3 data-i18n="pqr.select_case">Selecciona un caso</h3>
                    <p data-i18n="pqr.select_case_help">Selecciona una solicitud para ver el detalle y gestionar la respuesta.</p>
                </div>

                <div id="detailContent" hidden>
                    <div class="detail-header">
                        <div>
                            <h2 id="detailTitle"></h2>
                            <div class="radicado-code" id="detailRadicado"></div>
                        </div>
                        <button class="close-panel" id="closeDetailButton" type="button" aria-label="Cerrar detalle" data-i18n-aria-label="pqr.close_detail">
                            <span class="material-symbols-outlined" aria-hidden="true">close</span>
                        </button>
                    </div>

                    <div class="detail-badges">
                        <span class="badge" id="detailTipo"></span>
                        <span class="badge" id="detailEstado"></span>
                        <span class="badge" id="detailPrioridad"></span>
                    </div>

                    <div class="detail-section">
                        <h3 data-i18n="pqr.general_information">Información general</h3>
                        <div class="info-row">
                            <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                            <div>
                                <strong data-i18n="pqr.ticket">Radicado:</strong> <span id="infoRadicado"></span>
                            </div>
                        </div>
                        <div class="info-row">
                            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                            <div>
                                <strong data-i18n="pqr.open_time">Tiempo abierto:</strong> <span id="infoTiempo"></span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 data-i18n="pqr.patient">Paciente</h3>
                        <div class="info-row">
                            <span class="material-symbols-outlined" aria-hidden="true">person</span>
                            <div>
                                <strong id="infoPaciente"></strong>
                            </div>
                        </div>
                        <div class="info-row">
                            <span class="material-symbols-outlined" aria-hidden="true">badge</span>
                            <div id="infoDocumento"></div>
                        </div>
                        <div class="info-row">
                            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
                            <div id="infoEmail"></div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3 data-i18n="pqr.description">Descripción</h3>
                        <div class="description-box" id="detailDescripcion"></div>
                    </div>

                    <div class="detail-section" id="evidenciaSection" hidden>
                        <h3 data-i18n="pqr.attached_evidence">Evidencia adjunta</h3>
                        <a id="evidenciaLink" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary pqr-evidence-link">
                            <span class="material-symbols-outlined" aria-hidden="true">attach_file</span> <span data-i18n="pqr.view_attachment">Ver archivo adjunto</span>
                        </a>
                    </div>

                    <div class="detail-section">
                        <h3 id="responsesTitle" data-i18n="pqr.response_thread">Hilo de respuestas</h3>
                        <div class="timeline" id="responsesThread"></div>
                    </div>

                    <div class="detail-section response-box">
                        <h3 data-i18n="pqr.reply">Responder</h3>
                        <textarea id="responseTextarea" placeholder="Escribe tu respuesta al paciente..." data-i18n-ph="pqr.reply_placeholder"></textarea>
                        <button class="btn btn-primary" id="btnSendResponse" type="button">
                            <span class="material-symbols-outlined" aria-hidden="true">send</span>
                            <span data-i18n="pqr.send_response">Enviar respuesta</span>
                        </button>
                    </div>

                    <div class="detail-section">
                        <h3 data-i18n="pqr.change_status">Cambiar estado</h3>
                        <div class="status-buttons">
                            <button class="status-btn recibido" type="button" data-state="recibida">
                                <span class="material-symbols-outlined" aria-hidden="true">inbox</span> <span data-i18n="pqr.received">Recibida</span>
                            </button>
                            <button class="status-btn proceso" type="button" data-state="en_proceso">
                                <span class="material-symbols-outlined" aria-hidden="true">pending_actions</span> <span data-i18n="pqr.status_in_progress">En proceso</span>
                            </button>
                            <button class="status-btn resuelto" type="button" data-state="resuelta">
                                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span> <span data-i18n="pqr.resolved">Resuelta</span>
                            </button>
                            <button class="status-btn cerrado" type="button" data-state="cerrada">
                                <span class="material-symbols-outlined" aria-hidden="true">lock</span> <span data-i18n="pqr.status_closed">Cerrada</span>
                            </button>
                            <button class="status-btn rechazado" type="button" data-state="rechazada">
                                <span class="material-symbols-outlined" aria-hidden="true">block</span> <span data-i18n="pqr.rejected">Rechazada</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    @Html.AntiForgeryToken()
@section Scripts {
    <script>
        window.RAZOR_PQRS = @Html.Raw(ViewData["PqrsJson"] ?? "[]");
        window.RAZOR_PQR_STATS = @Html.Raw(ViewData["PqrStatsJson"] ?? "null");
    </script>
    <script src="~/js/Gestion_De_PQR/st-adm-17-gestion-pqr/script.js" asp-append-version="true"></script>
}

