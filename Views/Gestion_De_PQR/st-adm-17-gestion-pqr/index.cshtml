@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmileTrack — Gestión de PQR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_PQR/st-adm-17-gestion-pqr/styles.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>
    @{ await Html.RenderPartialAsync("~/Views/shared/_LangSwitcher.cshtml"); }
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    @{ await Html.RenderPartialAsync("_SidebarAdmin"); }

    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </button>
    <div class="overlay" id="overlay" aria-hidden="true"></div>

    <!-- Main Content -->
    <main class="main-content" id="main-content">
        <!-- Top Bar -->
        <div class="top-bar">
            <div class="page-header">
                <h1 data-i18n="pqr.title">Peticiones, Quejas y Reclamos</h1>
                <p data-i18n="pqr.response_time">Módulo PQR - SmileTrack</p>
            </div>
            <div class="action-buttons">
                <button class="btn btn-primary active" onclick="showManagement()">
                    <i class="fas fa-list"></i>
                    <span data-i18n="pqr.management">Gestión de PQR</span>
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fas fa-inbox"></i>
                </div>
                <div class="stat-info">
                    <h3>6</h3>
                    <p>Total PQR</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon yellow">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-info">
                    <h3>1</h3>
                    <p>Sin responder</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="stat-info">
                    <h3>1</h3>
                    <p>En gestión</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-info">
                    <h3>2</h3>
                    <p>Vencidas</p>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Buscar por paciente, ID o asunto..." data-i18n-ph="table.search"
                    onkeyup="filterTable()">
            </div>
            <select class="filter-select" id="filterTipo" onchange="filterTable()" data-i18n-aria-label="pqr.type">
                <option value="todos" data-i18n="table.filter">Todos los tipos</option>
                <option value="peticion" data-i18n="pqr.type_petition">Petición</option>
                <option value="queja" data-i18n="pqr.type_complaint">Queja</option>
                <option value="reclamo" data-i18n="pqr.type_claim">Reclamo</option>
            </select>
            <select class="filter-select" id="filterEstado" onchange="filterTable()">
                <option value="todos">Todos los estados</option>
                <option value="recibido">Recibido</option>
                <option value="proceso">En proceso</option>
                <option value="pendiente">Pend. info</option>
                <option value="resuelto">Resuelto</option>
                <option value="cerrado">Cerrado</option>
            </select>
        </div>

        <!-- Content Container -->
        <div class="content-container">
            <!-- Table -->
            <div class="table-container">
                <div class="table-wrapper">
                    <table id="pqrsTable">
                        <thead>
                            <tr>
                                <th data-i18n="pqr.subject">Radicado</th>
                                <th data-i18n="citas.patient">Paciente</th>
                                <th data-i18n="pqr.type">Tipo</th>
                                <th data-i18n="pqr.subject">Asunto</th>
                                <th data-i18n="pqr.status">Estado</th>
                                <th data-i18n="status.pending">Prioridad</th>
                                <th data-i18n="citas.date">Tiempo</th>
                                <th data-i18n="table.actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="pqrsTableBody">
                            <!-- Filas renderizadas dinámicamente por script.js desde window.RAZOR_PQRS (datos reales de SQL Server) -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Detail Panel -->
            <div class="detail-panel" id="detailPanel">
                <div class="empty-state" id="emptyState">
                    <i class="fas fa-mouse-pointer"></i>
                    <h3>Selecciona un caso</h3>
                    <p>Haz clic en cualquier PQR de la lista para ver el detalle y gestionar la respuesta.</p>
                </div>

                <div id="detailContent" style="display: none;">
                    <div class="detail-header">
                        <div>
                            <h2 id="detailTitle"></h2>
                            <div class="radicado-code" id="detailRadicado"></div>
                        </div>
                        <button class="close-panel" onclick="closeDetail()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="detail-badges">
                        <span class="badge" id="detailTipo"></span>
                        <span class="badge" id="detailEstado"></span>
                        <span class="badge" id="detailPrioridad"></span>
                    </div>

                    <div class="detail-section">
                        <h3>Información General</h3>
                        <div class="info-row">
                            <i class="fas fa-calendar"></i>
                            <div>
                                <strong>Radicado:</strong> <span id="infoRadicado"></span>
                            </div>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-clock"></i>
                            <div>
                                <strong>Tiempo abierto:</strong> <span id="infoTiempo"></span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3>Paciente</h3>
                        <div class="info-row">
                            <i class="fas fa-user"></i>
                            <div>
                                <strong id="infoPaciente"></strong>
                            </div>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-id-card"></i>
                            <div id="infoDocumento"></div>
                        </div>
                        <div class="info-row">
                            <i class="fas fa-envelope"></i>
                            <div id="infoEmail"></div>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h3>Descripción</h3>
                        <div class="description-box" id="detailDescripcion"></div>
                    </div>

                    <div class="detail-section" id="evidenciaSection" style="display: none;">
                        <h3>Evidencia adjunta</h3>
                        <a id="evidenciaLink" href="#" target="_blank" class="btn btn-secondary" style="width: 100%; text-align: center; display: block;">
                            <i class="fas fa-paperclip"></i> Ver archivo adjunto
                        </a>
                    </div>

                    <div class="detail-section">
                        <h3 id="responsesTitle">Hilo de Respuestas (0)</h3>
                        <div class="timeline" id="responsesThread"></div>
                    </div>

                    <div class="detail-section response-box">
                        <h3>Responder</h3>
                        <textarea id="responseTextarea" placeholder="Escribe tu respuesta al paciente..."></textarea>
                        <button class="btn btn-primary" id="btnSendResponse" style="width: 100%;">
                            <i class="fas fa-paper-plane"></i>
                            Enviar respuesta
                        </button>
                    </div>

                    <div class="detail-section">
                        <h3>Cambiar Estado</h3>
                        <div class="status-buttons">
                            <button class="status-btn recibido" onclick="changeStatus(this, 'recibida')">
                                <i class="fas fa-inbox"></i> Recibida
                            </button>
                            <button class="status-btn proceso" onclick="changeStatus(this, 'en_proceso')">
                                <i class="fas fa-tasks"></i> En proceso
                            </button>
                            <button class="status-btn resuelto" onclick="changeStatus(this, 'resuelta')">
                                <i class="fas fa-check-circle"></i> Resuelta
                            </button>
                            <button class="status-btn cerrado" onclick="changeStatus(this, 'cerrada')">
                                <i class="fas fa-lock"></i> Cerrada
                            </button>
                            <button class="status-btn cerrado" onclick="changeStatus(this, 'rechazada')"
                                style="grid-column: span 2;">
                                <i class="fas fa-ban"></i> Rechazada
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

    <script>
        window.RAZOR_PQRS = @Html.Raw(ViewData["PqrsJson"] ?? "[]");
        window.RAZOR_PQR_STATS = @Html.Raw(ViewData["PqrStatsJson"] ?? "null");
    </script>
    <script src="@Url.Content("~/js/Gestion_De_PQR/st-adm-17-gestion-pqr/script.js")"></script>
  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
    <script src="@Url.Content("~/js/i18n-core.js")"></script>
    <script src="@Url.Content("~/js/i18n.config.js")"></script>
    @{ await Html.RenderPartialAsync("~/Views/shared/_Chatbot.cshtml"); }
</body>

</html>


