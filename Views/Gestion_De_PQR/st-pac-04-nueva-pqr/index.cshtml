﻿﻿﻿@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmileTrack — Nueva Solicitud PQR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_PQR/st-pac-04-nueva-pqr/styles.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/shared/sidebar.css")" />
</head>

<body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    @if (User.IsInRole("Paciente"))
    {
        await Html.RenderPartialAsync("_SidebarPaciente");
    }
    else if (User.IsInRole("Profesional"))
    {
        await Html.RenderPartialAsync("_SidebarProfesional");
    }
    else if (User.IsInRole("Administrador"))
    {
        await Html.RenderPartialAsync("_SidebarAdmin");
    }
    else if (User.IsInRole("Recepcionista"))
    {
        await Html.RenderPartialAsync("_SidebarRecepcionista");
    }
    else if (User.IsInRole("Auxiliar"))
    {
        await Html.RenderPartialAsync("_SidebarAuxiliar");
    }
    else
    {
        await Html.RenderPartialAsync("_SidebarPaciente");
    }

    <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </button>
    <div class="overlay" id="overlay" aria-hidden="true"></div>

    <!-- Main Content -->
    <main class="main-content" id="main-content">
        <!-- Top Bar -->
        <div class="top-bar">
            <div>
                <div class="breadcrumb">
                    <a href="/">Inicio</a> › Peticiones, Quejas y Reclamos
                </div>
                <div class="page-title">
                    <h1>Peticiones, Quejas y Reclamos</h1>
                    <p>MÓdulo PQR - SmileTrack</p>
                </div>
            </div>
            <div class="top-actions">
                <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </button>
                <button class="btn-primary">
                    <i class="fas fa-plus"></i>
                    Nueva Solicitud PQR
                </button>
            </div>
        </div>

        <!-- Content Grid -->
        <div class="content-grid">
            <!-- Main Form -->
            <div class="main-form">
                <div class="section-title">1 - TIPO DE SOLICITUD</div>

                <!-- Request Types -->
                <div class="request-types">
                    <div class="request-card petition selected" onclick="selectRequestType(this, 'petition')">
                        <div class="request-icon">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <div class="request-title">Petición</div>
                        <div class="request-desc">Solicita información, documentos o servicios relacionados con tu
                            atención.</div>
                    </div>
                    <div class="request-card complaint" onclick="selectRequestType(this, 'complaint')">
                        <div class="request-icon">
                            <i class="fas fa-comment-dots"></i>
                        </div>
                        <div class="request-title">Queja</div>
                        <div class="request-desc">Manifiesta inconformidad con la atención o servicio recibido.</div>
                    </div>
                    <div class="request-card claim" onclick="selectRequestType(this, 'claim')">
                        <div class="request-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="request-title">Reclamo</div>
                        <div class="request-desc">Exige la corrección de irregularidades o incumplimientos del servicio.
                        </div>
                    </div>
                </div>

                <div class="section-title" style="margin-top: 30px;">2 - DATOS DEL SOLICITANTE</div>

                <form id="pqrForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Nombre completo</label>
                            <input type="text" placeholder="Ej: María Fernanda López" required>
                        </div>
                        <div class="form-group">
                            <label>Número de documento</label>
                            <input type="text" placeholder="Cédula o T.I." required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Correo electrÓnico</label>
                            <input type="email" placeholder="correo@ejemplo.com" required>
                        </div>
                        <div class="form-group">
                            <label>TelÉfono de contacto</label>
                            <input type="tel" placeholder="+57 300 000 0000" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Fecha del servicio</label>
                            <input type="date" required>
                        </div>
                        <div class="form-group">
                            <label>Odontólogo tratante</label>
                            <input type="text" placeholder="Nombre del profesional">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Asunto *</label>
                        <input type="text" id="pqrAsunto" placeholder="Ej: Demora en la atención de la cita" required>
                    </div>

                    <div class="form-group">
                        <label>Descripción detallada *</label>
                        <textarea id="pqrDescripcion"
                            placeholder="Describe con detalle tu solicitud, queja o reclamo. Incluye fechas, nombres y circunstancias relevantes."
                            required></textarea>
                        <div style="text-align: right; font-size: 12px; color: var(--text-light); margin-top: 5px;">0 /
                            1000</div>
                    </div>

                    <div class="form-group">
                        <label>Adjuntar soporte (opcional)</label>
                        <div class="file-upload" onclick="document.getElementById('fileInput').click()">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <div>Haz clic para adjuntar un archivo (PDF, JPG, PNG — m—x. 5 MB)</div>
                            <input type="file" id="fileInput" hidden accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                    </div>

                    <div class="submit-section">
                        <button type="submit" class="btn-submit">
                            <i class="fas fa-paper-plane"></i>
                            Radicar solicitud
                        </button>
                        <p class="terms-text">Al enviar, aceptas nuestra política de tratamiento de datos personales.
                        </p>
                    </div>
                </form>
            </div>

            <!-- Sidebar Right -->
            <div class="sidebar-right">
                <!-- Response Times -->
                <div class="info-card">
                    <h3>Tiempos de respuesta</h3>
                    <div class="time-item">
                        <div class="time-label petition">
                            <i class="fas fa-file-alt"></i>
                            <span>Petición</span>
                        </div>
                        <div class="time-value">15 días hábiles</div>
                    </div>
                    <div class="time-item">
                        <div class="time-label complaint">
                            <i class="fas fa-comment-dots"></i>
                            <span>Queja</span>
                        </div>
                        <div class="time-value">10 días hábiles</div>
                    </div>
                    <div class="time-item">
                        <div class="time-label claim">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Reclamo</span>
                        </div>
                        <div class="time-value">5 días hábiles</div>
                    </div>
                </div>

                <!-- Contact Channels -->
                <div class="info-card">
                    <h3>Canales de atención</h3>
                    <div class="channel-item">
                        <div class="channel-label">Línea PQR</div>
                        <div class="channel-value">01 8000 123 456</div>
                        <div style="font-size: 12px; color: var(--text-light);">Lun - Vie: 7 am - 6 pm</div>
                    </div>
                    <div class="channel-item">
                        <div class="channel-label">Correo oficial</div>
                        <div class="channel-value">pqr@smiletrack.co</div>
                        <div style="font-size: 12px; color: var(--text-light);">Respuesta en 24 h hábiles</div>
                    </div>
                </div>

                <!-- How it Works -->
                <div class="info-card how-it-works">
                    <h3><i class="fas fa-info-circle"></i> —Cómo funciona?</h3>
                    <div class="step">
                        <div class="step-number">01</div>
                        <div>Diligencia el formulario con tu información y descripción del caso.</div>
                    </div>
                    <div class="step">
                        <div class="step-number">02</div>
                        <div>Recibes un número de radicado en tu correo electrÓnico.</div>
                    </div>
                    <div class="step">
                        <div class="step-number">03</div>
                        <div>Nuestro equipo analiza y gestiona tu solicitud.</div>
                    </div>
                    <div class="step">
                        <div class="step-number">04</div>
                        <div>Te notificamos la respuesta según los tiempos legales.</div>
                    </div>
                </div>

                <!-- Recent Requests -->
                <div class="info-card">
                    <h3 style="display: flex; justify-content: space-between; align-items: center;">
                        Radicados recientes
                        <a href="#" style="font-size: 12px; color: var(--primary-blue); text-decoration: none;">Ver
                            todos</a>
                    </h3>
                    <div id="recentPqrList">
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001847</div>
                        <div class="recent-title">Demora en entrega de historia clínica</div>
                        <div class="recent-date">Queja — 14 Jun 2024</div>
                        <span class="badge process">En proceso</span>
                    </div>
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001621</div>
                        <div class="recent-title">Solicitud de certificado de atención</div>
                        <div class="recent-date">Petición — 02 May 2024</div>
                        <span class="badge resolved">Resuelto</span>
                    </div>
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001380</div>
                        <div class="recent-title">Cobro incorrecto en servicio de ortodoncia</div>
                        <div class="recent-date">Reclamo — 18 Abr 2024</div>
                        <span class="badge closed">Cerrado</span>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
        window.RAZOR_MIS_PQRS = @Html.Raw(ViewData["MisPqrsJson"] ?? "[]");
    </script>
    <script src="@Url.Content("~/js/Gestion_De_PQR/st-pac-04-nueva-pqr/script.js")"></script>
  <script src="@Url.Content("~/js/shared/sidebar.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>

</html>



