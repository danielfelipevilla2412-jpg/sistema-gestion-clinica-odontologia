@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.Entities.Paciente
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nueva PQR";
    ViewData["Description"] = "Radica una petición, queja o reclamo ante SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;

}

@section Styles {
    <link rel="stylesheet" href="~/css/Gestion_De_PQR/st-pac-04-nueva-pqr/styles.css" asp-append-version="true" />
}

<main class="main pqr-nueva-page" id="main-content">

    <header class="page-header">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="layout_breadcrumb_aria">
            <a href="/" data-i18n="nav.homepage">Inicio</a>
            <span class="bc-sep" aria-hidden="true">/</span>
            <span class="bc-active" aria-current="page" data-i18n="pqr.title">Peticiones, Quejas y Reclamos</span>
        </nav>
        <div class="page-header-content">
            <div class="page-header-title">
                <h1 class="page-title" data-i18n="pac_pqr.page_title">Nueva PQR</h1>
                <p class="page-subtitle" data-i18n="pac_pqr.page_subtitle">Módulo PQR - SmileTrack</p>
            </div>
        </div>
    </header>

    <!-- Content Grid -->
    <div class="content-grid">
        <!-- Main Form -->
        <div class="main-form">
            <div class="section-title" data-i18n="pqr.type">1 - TIPO DE SOLICITUD</div>

            <!-- Request Types -->
            <div class="request-types">
                <div class="request-card petition selected" data-request-type="petition">
                    <div class="request-icon">
                        <span class="material-symbols-outlined" aria-hidden="true">description</span>
                    </div>
                    <div class="request-title" data-i18n="pqr.type_petition">Petición</div>
                    <div class="request-desc" data-i18n="pqr.petition_description">Solicita información, documentos o servicios relacionados con tu atención.</div>
                </div>
                <div class="request-card complaint" data-request-type="complaint">
                    <div class="request-icon">
                        <span class="material-symbols-outlined" aria-hidden="true">forum</span>
                    </div>
                    <div class="request-title" data-i18n="pqr.type_complaint">Queja</div>
                    <div class="request-desc" data-i18n="pqr.complaint_description">Manifiesta inconformidad con la atención o servicio recibido.</div>
                </div>
                <div class="request-card claim" data-request-type="claim">
                    <div class="request-icon">
                        <span class="material-symbols-outlined" aria-hidden="true">warning</span>
                    </div>
                    <div class="request-title" data-i18n="pqr.type_claim">Reclamo</div>
                    <div class="request-desc" data-i18n="pqr.claim_description">Exige la corrección de irregularidades o incumplimientos del servicio.</div>
                </div>
            </div>

            <div class="section-title section-title--spaced" data-i18n="pqr.applicant_data">2 - DATOS DEL SOLICITANTE</div>

            <form id="pqrForm" method="post" action="/gestion-de-pqr/crear" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <dl class="form-group pqr-account-data">
                        <dt class="pqr-account-label" data-i18n="common.name">Nombre completo</dt>
                        <dd class="pqr-account-value">@($"{Model?.Nombres} {Model?.Apellidos}".Trim())</dd>
                    </dl>
                    <dl class="form-group pqr-account-data">
                        <dt class="pqr-account-label" data-i18n="pacientes.document">Número de documento</dt>
                        <dd class="pqr-account-value">@Model?.Documento
                        @if (Model != null && ViewData["DocumentoValido"] is false)
                        {
                            <small class="pqr-field-error" role="alert">La cédula registrada debe contener hasta 10 dígitos. Solicita la corrección de tu ficha.</small>
                        }</dd>
                    </dl>
                </div>

                <div class="form-row">
                    <dl class="form-group pqr-account-data">
                        <dt class="pqr-account-label" data-i18n="pac_pqr.label_email">Correo electrónico</dt>
                        <dd class="pqr-account-value">@(string.IsNullOrWhiteSpace(Model?.Correo) ? "Sin registrar" : Model.Correo)</dd>
                    </dl>
                    <dl class="form-group pqr-account-data">
                        <dt class="pqr-account-label" data-i18n="pac_pqr.label_phone">Teléfono de contacto</dt>
                        <dd class="pqr-account-value">@(string.IsNullOrWhiteSpace(Model?.Telefono) ? "Sin registrar" : Model.Telefono)</dd>
                    </dl>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="pqrFechaServicio">Fecha del servicio (opcional)</label>
                        <input id="pqrFechaServicio" name="fechaServicio" type="date" max="@DateTime.UtcNow.AddHours(-5).ToString("yyyy-MM-dd")">
                    </div>
                    <div class="form-group">
                        <label for="pqrProfesional">Odontólogo tratante (opcional)</label>
                        <select id="pqrProfesional" name="idProfesional">
                            <option value="">Seleccionar profesional</option>
                            @foreach (var profesional in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Profesionales"]!)
                            {
                                <option value="@profesional.Value">@profesional.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="pqrAsunto" data-i18n="pac_pqr.label_subject">Asunto *</label>
                    <input type="text" id="pqrAsunto" name="asunto" minlength="3" maxlength="200" placeholder="Ej: Demora en la atención de la cita" required data-i18n-ph="pac_pqr.ph_subject">
                </div>

                <div class="form-group">
                    <label for="pqrDescripcion" data-i18n="pac_pqr.label_description">Descripción detallada *</label>
                    <textarea id="pqrDescripcion" name="descripcion" minlength="10" maxlength="1000"
                        placeholder="Describe con detalle tu solicitud, queja o reclamo. Incluye fechas, nombres y circunstancias relevantes."
                        required data-i18n-ph="pac_pqr.ph_description"></textarea>
                    <div class="char-counter">0 / 1000</div>
                </div>

                <div class="form-group">
                    <label for="fileInput" data-i18n="pac_pqr.label_attachment">Adjuntar soporte (opcional)</label>
                    <div class="file-upload" id="fileUpload" role="button" tabindex="0" aria-label="Adjuntar soporte" aria-describedby="fileInputError">
                        <div class="file-upload-content" id="fileUploadContent">
                            <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
                            <div data-i18n="pac_pqr.upload_hint">Haz clic para adjuntar un archivo (PDF, JPG, PNG — máx. 5 MB)</div>
                        </div>
                        <input type="file" id="fileInput" name="evidencia" hidden accept=".pdf,.jpg,.jpeg,.png">
                    </div>
                </div>

                <div class="submit-section">
                    @if (Model == null)
                    {
                        <p class="pqr-field-error" role="alert">Tu cuenta no tiene una ficha de paciente asociada. Contacta a recepción.</p>
                    }
                    <button type="submit" class="btn-submit" disabled="@(ViewData["DocumentoValido"] is false)">
                        <span class="material-symbols-outlined" aria-hidden="true">send</span>
                        <span data-i18n="pac_pqr.submit">Radicar solicitud</span>
                    </button>
                    <p class="terms-text" data-i18n="pac_pqr.terms">Al enviar, aceptas nuestra política de tratamiento de datos personales.</p>
                </div>
            </form>
        </div>

        <!-- Sidebar Right -->
        <div class="sidebar-right">
            <!-- Response Times -->
            <div class="info-card">
                <h3 data-i18n="pac_pqr.response_times">Tiempos de respuesta</h3>
                <div class="time-item">
                    <div class="time-label petition">
                        <span class="material-symbols-outlined" aria-hidden="true">description</span>
                        <span data-i18n="pqr.type_petition">Petición</span>
                    </div>
                    <div class="time-value" data-i18n="pac_pqr.time_petition">15 días hábiles</div>
                </div>
                <div class="time-item">
                    <div class="time-label complaint">
                        <span class="material-symbols-outlined" aria-hidden="true">forum</span>
                        <span data-i18n="pqr.type_complaint">Queja</span>
                    </div>
                    <div class="time-value" data-i18n="pac_pqr.time_complaint">10 días hábiles</div>
                </div>
                <div class="time-item">
                    <div class="time-label claim">
                        <span class="material-symbols-outlined" aria-hidden="true">warning</span>
                        <span data-i18n="pqr.type_claim">Reclamo</span>
                    </div>
                    <div class="time-value" data-i18n="pac_pqr.time_claim">5 días hábiles</div>
                </div>
            </div>

            <!-- Contact Channels -->
            <div class="info-card">
                <h3 data-i18n="pac_pqr.contact_channels">Canales de atención</h3>
                <div class="channel-item">
                    <div class="channel-label" data-i18n="pac_pqr.channel_phone_label">Línea PQR</div>
                    <div class="channel-value">01 8000 123 456</div>
                    <div class="channel-hours" data-i18n="pac_pqr.channel_phone_hours">Lun - Vie: 7 am - 6 pm</div>
                </div>
                <div class="channel-item">
                    <div class="channel-label" data-i18n="pac_pqr.channel_email_label">Correo oficial</div>
                    <div class="channel-value">pqr@smiletrack.co</div>
                    <div class="channel-hours" data-i18n="pac_pqr.channel_email_hours">Respuesta en 24 h hábiles</div>
                </div>
            </div>

            <!-- How it Works -->
            <div class="info-card how-it-works">
                <h3>
                    <span class="material-symbols-outlined" aria-hidden="true">info</span>
                    <span data-i18n="pac_pqr.how_it_works">¿Cómo funciona?</span>
                </h3>
                <div class="step">
                    <div class="step-number">01</div>
                    <div data-i18n="pac_pqr.step1">Diligencia el formulario con tu información y descripción del caso.</div>
                </div>
                <div class="step">
                    <div class="step-number">02</div>
                    <div data-i18n="pac_pqr.step2">Recibes un número de radicado en tu correo electrónico.</div>
                </div>
                <div class="step">
                    <div class="step-number">03</div>
                    <div data-i18n="pac_pqr.step3">Nuestro equipo analiza y gestiona tu solicitud.</div>
                </div>
                <div class="step">
                    <div class="step-number">04</div>
                    <div data-i18n="pac_pqr.step4">Te notificamos la respuesta según los tiempos legales.</div>
                </div>
            </div>

            <!-- Recent Requests -->
            <div class="info-card">
                <h3 class="info-card-title--split">
                    <span data-i18n="pac_pqr.recent_title">Radicados recientes</span>
                    <a href="#recentPqrList" class="info-card-link" data-i18n="pac_pqr.view_all">Ver todos</a>
                </h3>
                <div id="recentPqrList" aria-live="polite">
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001847</div>
                        <div class="recent-title">Demora en entrega de historia clínica</div>
                        <div class="recent-date">Queja — 14 Jun 2024</div>
                        <span class="badge process">En proceso</span>
                    </div>
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001621</div>
                        <div class="recent-title">Solicitud de certificado de atención</div>
                        <div class="recent-date">Petición — 02 May 2024</div>
                        <span class="badge resolved">Resuelto</span>
                    </div>
                    <div class="recent-item">
                        <div class="recent-code">PQR-2024-001380</div>
                        <div class="recent-title">Cobro incorrecto en servicio de ortodoncia</div>
                        <div class="recent-date">Reclamo — 18 Abr 2024</div>
                        <span class="badge closed">Cerrado</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@await Html.PartialAsync("~/Views/Gestion_De_PQR/_DetallePqr.cshtml")

@section Scripts {
    <script>
        window.RAZOR_MIS_PQRS = @Html.Raw(ViewData["MisPqrsJson"] ?? "[]");
    </script>
    <script src="~/js/Gestion_De_PQR/st-pac-04-nueva-pqr/script.js" asp-append-version="true" defer></script>
}
