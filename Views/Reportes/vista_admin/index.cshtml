@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.ViewModels.ReportesViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Reportes y Estadísticas";
    ViewData["Description"] = "Reportes y estadísticas administrativas de la clínica SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var maxIngreso = Model.IngresosPorProfesional.Any() ? Model.IngresosPorProfesional.Max(p => p.Monto) : 1m;
    if (maxIngreso <= 0m) maxIngreso = 1m;
    var radius = 15.9155;
    var circumference = 2 * Math.PI * radius;
    var servicioPrincipal = Model.DistribucionServicios.OrderByDescending(s => s.Porcentaje).FirstOrDefault();
    var totalPorcentaje = Model.DistribucionServicios.Sum(s => s.Porcentaje);
    var progress = 0d;
    var maxCrec = Model.CrecimientoClinica.Any()
    ? Math.Max(1d, Model.CrecimientoClinica.Max(d => Math.Max(d.ValorActual, d.ValorAnterior))) : 1d;
    var totalDist = Model.DistribucionServicios.Sum(s => s.Cantidad);
}

@section Styles {
  <link rel="stylesheet" href="~/css/Reportes/vista_admin/styles.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="reportesadmin_breadcrumb_admin">
          <span data-i18n="reportesadmin_breadcrumb_admin">Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active" data-i18n="reportesadmin_breadcrumb_current">Reportes y Estadísticas</span>
        </nav>
        <h1 class="page-title" data-i18n="nav.group_reportes_analitica">Reportes y Estadísticas</h1>
        <p class="page-subtitle">
          <span data-i18n="reportesadmin_subtitle">Indicadores administrativos y actividad de la clínica</span> ·
          <span data-i18n="reportesadmin_updated">Actualizado hace</span>
          @(Model.UltimaActualizacion <= DateTime.Now ? ((int)(DateTime.Now - Model.UltimaActualizacion).TotalMinutes) : 5)
          <span data-i18n="reportesadmin_minutes">min</span>
        </p>
      </div>
      <div class="header-actions">
        <button class="btn-secondary" id="btnPDF">
          <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
          <span data-i18n="reportesadmin_btn_pdf">Descargar PDF</span>
        </button>
        <button class="btn-secondary" id="btnCSV">
          <span class="material-symbols-outlined" aria-hidden="true">download</span>
          <span data-i18n="reportesadmin_btn_csv">Exportar CSV</span>
        </button>
      </div>
    </header>

    <!-- KPIs Grid -->
    <section class="stats-grid" aria-label="Indicadores clave" data-i18n-aria-label="reportesadmin_stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="stat-number">$@Model.IngresosTotales.ToString("N0")</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_income">Ingresos Totales</span>
        <span class="stat-sub @(Model.VariacionIngresos.GetValueOrDefault() >= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionIngresos.HasValue)
          {
            @($"{(Model.VariacionIngresos >= 0 ? "↑" : "↓")} {Math.Abs(Model.VariacionIngresos.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number">@Model.NuevosPacientes</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_patients">Nuevos Pacientes</span>
        <span class="stat-sub @(Model.VariacionPacientes.GetValueOrDefault() >= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionPacientes.HasValue)
          {
            @($"{(Model.VariacionPacientes >= 0 ? "↑" : "↓")} {Math.Abs(Model.VariacionPacientes.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number">@Model.CitasCompletadas</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_completed">Citas Completadas</span>
        <span class="stat-sub @(Model.VariacionCitas.GetValueOrDefault() >= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionCitas.HasValue)
          {
            @($"{(Model.VariacionCitas >= 0 ? "↑" : "↓")} {Math.Abs(Model.VariacionCitas.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number">@Model.TasaRetencion%</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_retention">Tasa de Retención</span>
        <span class="stat-sub @(Model.VariacionRetencion.GetValueOrDefault() >= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionRetencion.HasValue)
          {
            @($"{(Model.VariacionRetencion >= 0 ? "↑" : "↓")} {Math.Abs(Model.VariacionRetencion.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number">@Model.TasaInasistencia%</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_no_show">Tasa de Inasistencia</span>
        <span class="stat-sub @(Model.VariacionInasistencia.GetValueOrDefault() <= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionInasistencia.HasValue)
          {
            @($"{(Model.VariacionInasistencia <= 0 ? "↓" : "↑")} {Math.Abs(Model.VariacionInasistencia.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
      <div class="stat-card" data-color="teal">
        <span class="stat-number">@Model.CitasDelPeriodo</span>
        <span class="stat-label" data-i18n="reportesadmin_stat_period">Citas del periodo</span>
        <span class="stat-sub @(Model.VariacionCitasPeriodo.GetValueOrDefault() >= 0 ? "" : "stat-sub--down")">
          @if (Model.VariacionCitasPeriodo.HasValue)
          {
            @($"{(Model.VariacionCitasPeriodo >= 0 ? "↑" : "↓")} {Math.Abs(Model.VariacionCitasPeriodo.Value)}%")
            <span data-i18n="reportesadmin_trend">vs mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesadmin_no_comparison">Sin base de comparación</span>
          }
        </span>
      </div>
    </section>

    <!-- Charts Grid -->
    <section class="charts-grid">
      <!-- Growth Chart -->
      <div class="chart-card">
        <div class="chart-card__header">
          <h2 class="chart-card__title" data-i18n="reportesadmin_chart_growth">Crecimiento de la Clínica</h2>
          <div class="chart-legend">
            <span class="legend-item"><span class="legend-dot" style="background:#1a56cc"></span> <span data-i18n="reportesadmin_this_year">Este año</span></span>
            <span class="legend-item"><span class="legend-dot" style="background:#cbd5e1"></span> <span data-i18n="reportesadmin_last_year">Año pasado</span></span>
          </div>
        </div>
        <div class="bar-chart" id="barChart" role="img" aria-label="Evolución mensual del crecimiento de la clínica" data-i18n-aria-label="reportesadmin_growth_aria">
          @foreach (var dato in Model.CrecimientoClinica)
          {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var monthKey = dato.Mes switch
            {
              "Ene" => "reportesadmin_month_jan",
              "Feb" => "reportesadmin_month_feb",
              "Mar" => "reportesadmin_month_mar",
              "Abr" => "reportesadmin_month_apr",
              "May" => "reportesadmin_month_may",
              "Jun" => "reportesadmin_month_jun",
              "Jul" => "reportesadmin_month_jul",
              "Ago" => "reportesadmin_month_aug",
              "Sep" => "reportesadmin_month_sep",
              "Oct" => "reportesadmin_month_oct",
              "Nov" => "reportesadmin_month_nov",
              _ => "reportesadmin_month_dec"
            };
            var currentHeight = Math.Max(4d, dato.ValorActual / maxCrec * 100);
            var previousHeight = Math.Max(4d, dato.ValorAnterior / maxCrec * 100);
            <div class="bar-group" data-curr="@dato.ValorActual" data-prev="@dato.ValorAnterior">
              <div class="bar-group__bars">
                <div class="bar bar--prev" style="height:@previousHeight.ToString(inv)%"></div>
                <div class="bar bar--current" style="height:@currentHeight.ToString(inv)%"></div>
              </div>
              <div class="bar-group__meta">
                <span class="bar-group__label" data-i18n="@monthKey">@dato.Mes</span>
                <span class="bar-group__value">@dato.ValorActual</span>
              </div>
            </div>
          }
        </div>
      </div>

      <!-- Donut Chart -->
      <div class="chart-card">
        <h2 class="chart-card__title" data-i18n="reportesadmin_distribution">Distribución de Servicios</h2>
        <p class="chart-card__sub">
          <strong>@Model.CitasDelPeriodo</strong> <span data-i18n="reportesadmin_in_period">citas en el periodo</span>
        </p>
        <div class="donut-wrap">
          <svg viewBox="0 0 36 36" class="donut-svg" role="img" aria-label="Distribución de servicios" data-i18n-aria-label="reportesadmin_distribution_aria">
            <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#e2e8f0" stroke-width="3"/>
            @foreach (var servicio in Model.DistribucionServicios)
            {
              var segmentLength = Math.Max(1, circumference * (servicio.Porcentaje / 100d));
              var dashOffset = -progress;
              progress += segmentLength;
              <circle cx="18" cy="18" r="15.9155" fill="none"
                      stroke="@servicio.Color" stroke-width="3"
                      stroke-dasharray="@segmentLength.ToString(System.Globalization.CultureInfo.InvariantCulture) @circumference.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      stroke-dashoffset="@dashOffset.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                      stroke-linecap="round"
                      class="donut-segment"/>
            }
          </svg>
          <div class="donut-center">
            <span class="donut-total">@Model.CitasDelPeriodo</span>
            <span class="donut-sublabel" data-i18n="reportesadmin_total">Totales</span>
            @if (servicioPrincipal != null)
            {
              <span class="donut-highlight"><span data-i18n="reportesadmin_highest">Mayor</span>: @servicioPrincipal.Nombre (@servicioPrincipal.Porcentaje%)</span>
            }
          </div>
        </div>
        <div class="donut-legend">
          @foreach (var servicio in Model.DistribucionServicios)
          {
            <div class="donut-legend__item">
              <span class="legend-dot" style="background:@servicio.Color"></span>
              <span>@servicio.Nombre</span>
              <span class="donut-legend__pct">@servicio.Porcentaje%</span>
            </div>
          }
        </div>
      </div>
    </section>

    <!-- Revenue by Professional -->
    <section class="table-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="reportesadmin_professional_income">Ingresos por Profesional</h2>
      </div>
      <div class="prof-revenue-list">
        @foreach (var prof in Model.IngresosPorProfesional)
        {
          var anchoBarra = (prof.Monto / maxIngreso) * 100;
          <div class="prof-revenue-row" data-name="@prof.Nombre" data-amount="$@prof.Monto.ToString("N0")" data-share="@prof.Porcentaje%">
            <div class="prof-revenue-info">
              <span class="prof-revenue-name">@prof.Nombre</span>
              <span class="prof-revenue-value">$@prof.Monto.ToString("N0") <small>(@prof.Porcentaje%)</small></span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" style="width:@anchoBarra.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
          </div>
        }
      </div>
    </section>

    <!-- Appointment Status -->
    <section class="table-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="reportesadmin_status_title">Estado de Citas</h2>
        <span class="section-badge">@Model.EstadoCitas.Sum(e => e.Cantidad) <span data-i18n="reportesadmin_appointments">citas</span></span>
      </div>
      <div class="status-list">
        @foreach (var estado in Model.EstadoCitas)
        {
          var estadoKey = estado.Estado switch
          {
            "Completadas" => "reportesadmin_state_completed",
            "Programadas" => "reportesadmin_state_scheduled",
            "En proceso" => "reportesadmin_state_in_progress",
            "Canceladas" => "reportesadmin_state_cancelled",
            "Inasistencias" => "reportesadmin_state_no_show",
            _ => "reportesadmin_state_other"
          };
          <div class="status-row">
            <div class="status-row__info">
              <span data-i18n="@estadoKey">@estado.Estado</span>
              <strong>@estado.Porcentaje%</strong>
            </div>
            <div class="progress-track">
              <div class="progress-fill progress-fill--@estado.Estado.ToLower().Replace(" ", "")" style="width:@estado.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
          </div>
        }
      </div>
    </section>

    <!-- Procedures Table -->
    <section class="table-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="reportesadmin_procedures_title">Procedimientos Más Solicitados</h2>
        <button type="button" id="btnViewAllProcedures" class="btn-link" data-i18n="reportesadmin_view_all_procedures">Ver todo →</button>
      </div>
      <div class="table-wrap table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="reportesadmin_th_procedure">Procedimiento</th>
              <th data-i18n="reportesadmin_th_quantity">Cantidad</th>
              <th data-i18n="reportesadmin_th_income">Ingresos</th>
              <th data-i18n="reportesadmin_th_average_price">Precio Prom.</th>
              <th data-i18n="reportesadmin_th_trend">Tendencia</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var proc in Model.Procedimientos)
            {
              <tr>
                <td>
                  <div class="cell-icon-name">
                    <span class="cell-icon" data-color="blue">@proc.Icono.Substring(0, 1).ToUpper()</span>
                    @proc.Nombre
                  </div>
                </td>
                <td>@proc.Cantidad</td>
                <td>$@proc.IngresosGenerados.ToString("N0")</td>
                <td>$@proc.PrecioPromedio.ToString("N0")</td>
                <td>
                  <span class="trend @(proc.Tendencia >= 0 ? "trend--up" : "trend--down")">
                    @(proc.Tendencia >= 0 ? "↑" : "↓") @Math.Abs(proc.Tendencia)%
                  </span>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </section>

    <div class="modal-overlay" id="modalProcedimientos" role="dialog" aria-modal="true" aria-labelledby="modalProcedimientosTitle" hidden>
      <div class="modal modal--lg" role="document">
        <button type="button" class="modal-close" data-modal-close="modalProcedimientos" aria-label="Cerrar ventana" data-i18n-aria-label="reportesadmin_close">×</button>
        <h2 class="modal-title" id="modalProcedimientosTitle" data-i18n="reportesadmin_all_procedures_title">Todos los Procedimientos</h2>
        <p class="modal-desc" data-i18n="reportesadmin_all_procedures_desc">Visualiza la lista completa de procedimientos más solicitados de la clínica.</p>
        <div class="modal-body">
          <div class="table-wrap table-responsive modal-table">
            <table class="data-table">
              <thead>
                <tr>
                  <th data-i18n="reportesadmin_th_procedure">Procedimiento</th>
                  <th data-i18n="reportesadmin_th_quantity">Cantidad</th>
                  <th data-i18n="reportesadmin_th_income">Ingresos</th>
                  <th data-i18n="reportesadmin_th_average_price">Precio Prom.</th>
                  <th data-i18n="reportesadmin_th_trend">Tendencia</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var proc in Model.Procedimientos)
                {
                  <tr>
                    <td>
                      <div class="cell-icon-name">
                        <span class="cell-icon" data-color="blue">@proc.Icono.Substring(0,1).ToUpper()</span>
                        @proc.Nombre
                      </div>
                    </td>
                    <td>@proc.Cantidad</td>
                    <td>$@proc.IngresosGenerados.ToString("N0")</td>
                    <td>$@proc.PrecioPromedio.ToString("N0")</td>
                    <td>
                      <span class="trend @(proc.Tendencia >= 0 ? "trend--up" : "trend--down")">
                        @(proc.Tendencia >= 0 ? "↑" : "↓") @Math.Abs(proc.Tendencia)%
                      </span>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-modal-close="modalProcedimientos">Cerrar</button>
        </div>
      </div>
    </div>

    <!-- Recent Reports -->
    <section class="table-section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="reportesadmin_recent">Reportes Recientes</h2>
        <div class="section-header__actions">
          <button id="newReportBtn" class="btn-primary" data-i18n="reportesadmin_new">+ Nuevo Reporte</button>
          <button type="button" id="btnViewAllReports" class="btn-link" data-i18n="reportesadmin_view_all">Ver todo →</button>
        </div>
      </div>

      <!-- Category Filters -->
      <div class="filter-chips" role="group" aria-label="Filtrar reportes por categoría" data-i18n-aria-label="reportesadmin_filters_aria">
        @foreach (var categoria in new[] { "Todos", "Financiero", "Pacientes", "Operativo", "Logística" })
        {
          var catValue = categoria == "Todos" ? "todos" : categoria.ToLower();
          var catKey = categoria switch
          {
            "Todos" => "reportesadmin_cat_all",
            "Financiero" => "reportesadmin_cat_financial",
            "Pacientes" => "reportesadmin_cat_patients",
            "Operativo" => "reportesadmin_cat_operational",
            _ => "reportesadmin_cat_logistics"
          };
          <button class="chip-btn @(catValue == Model.FiltroCategoria ? "chip-btn--active" : "")"
                  data-category="@catValue" data-i18n="@catKey">
            @categoria
          </button>
        }
      </div>

      <div class="table-wrap table-responsive" id="tableWrap">
        <table class="data-table">
          <thead>
            <tr>
              <th data-i18n="reportesadmin_th_name">Nombre del Reporte</th>
              <th data-i18n="reportesadmin_th_date">Fecha Generado</th>
              <th data-i18n="reportesadmin_th_category">Categoría</th>
              <th data-i18n="reportesadmin_th_status">Estado</th>
              <th data-i18n="reportesadmin_th_action">Acción</th>
            </tr>
          </thead>
          <tbody id="reportsTableBody">
            @if (Model.ReportesRecientes.Any())
            {
              @foreach (var reporte in Model.ReportesRecientes)
              {
                <tr data-category="@reporte.Categoria.ToLower()">
                @{
                  var categoryKey = reporte.Categoria switch
                  {
                    "Financiero" => "reportesadmin_cat_financial",
                    "Pacientes" => "reportesadmin_cat_patients",
                    "Operativo" => "reportesadmin_cat_operational",
                    "Logística" => "reportesadmin_cat_logistics",
                    _ => "reportesadmin_cat_all"
                  };
                }
                  <td>
                    <div class="cell-icon-name">
                      <span class="cell-icon" data-color="@(reporte.Categoria.ToLower() == "financiero" ? "blue" : reporte.Categoria.ToLower() == "pacientes" ? "green" : reporte.Categoria.ToLower() == "logística" ? "red" : "purple")">@reporte.Icono.Substring(0, 1).ToUpper()</span>
                      @reporte.Nombre
                    </div>
                  </td>
                  <td><time data-report-date datetime="@reporte.FechaGenerado.ToString("O")">@reporte.FechaGenerado.ToString("dd MMM, yyyy")</time></td>
                  <td><span class="badge" data-i18n="@categoryKey">@reporte.Categoria</span></td>
                  <td>
                    <span class="status @(reporte.Estado == "Listo" ? "status--ready" : "status--pending")">
                      <span class="status__dot"></span> <span data-i18n="reportesadmin_ready">@reporte.Estado</span>
                    </span>
                  </td>
                  <td class="actions-cell">
                    <a href="/reportes/descargar/@reporte.Id?formato=csv" class="action-btn" title="Descargar CSV" aria-label="Descargar CSV" data-i18n-title="reportesadmin_download_csv_title" data-i18n-aria-label="reportesadmin_download_csv_title">
                        <span class="material-symbols-outlined action-icon" aria-hidden="true">download</span>
                        <span class="action-label" data-i18n="reportesadmin_download_csv">CSV</span>
                    </a>
                    <a href="/reportes/descargar/@reporte.Id?formato=pdf" class="action-btn" title="Descargar PDF" aria-label="Descargar PDF" data-i18n-title="reportesadmin_download_pdf_title" data-i18n-aria-label="reportesadmin_download_pdf_title">
                      <span class="material-symbols-outlined action-icon" aria-hidden="true">picture_as_pdf</span>
                      <span class="action-label" data-i18n="reportesadmin_download_pdf">PDF</span>
                    </a>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>

      <!-- Empty State -->
      <div id="tableEmptyState" class="empty-state" hidden>
        <div class="empty-state__icon">📄</div>
        <div class="empty-state__title" data-i18n="reportesadmin_empty_title">No se encontraron reportes</div>
        <p class="empty-state__desc" data-i18n="reportesadmin_empty_desc">Prueba con otra categoría o genera un nuevo reporte.</p>
        <button id="emptyStateNewReportBtn" class="btn-primary" data-i18n="reportesadmin_empty_action">+ Generar Reporte</button>
      </div>

      <!-- Modales de Reportes -->
      <div class="modal-overlay" id="modalNewReport" role="dialog" aria-modal="true" aria-labelledby="modalNewReportTitle" hidden>
        <div class="modal modal--lg" role="document">
          <button type="button" class="modal-close" data-modal-close="modalNewReport" aria-label="Cerrar ventana" data-i18n-aria-label="reportesadmin_close">×</button>
          <h2 class="modal-title" id="modalNewReportTitle" data-i18n="reportesadmin_modal_new_title">Nuevo Reporte</h2>
          <p class="modal-desc" data-i18n="reportesadmin_modal_new_desc">Configura los detalles del reporte para guardar una copia agregada en el historial.</p>
          <form id="formNewReport" class="modal-body" action="/reportes/generar" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
              <label class="form-label" for="reportName" data-i18n="reportesadmin_name">Nombre del reporte</label>
              <input id="reportName" name="Nombre" class="form-input" type="text" maxlength="120" placeholder="Informe de ingresos mensuales" data-i18n-ph="reportesadmin_name_ph" required />
            </div>
            <div class="form-group grid-2">
              <div class="form-group">
                <label class="form-label" for="reportCategory" data-i18n="reportesadmin_category">Categoría</label>
                <select id="reportCategory" name="Categoria" class="form-input" required>
                  <option value="Financiero" data-i18n="reportesadmin_cat_financial">Financiero</option>
                  <option value="Pacientes" data-i18n="reportesadmin_cat_patients">Pacientes</option>
                  <option value="Operativo" data-i18n="reportesadmin_cat_operational">Operativo</option>
                  <option value="Logística" data-i18n="reportesadmin_cat_logistics">Logística</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="reportPeriod" data-i18n="reportesadmin_period">Periodo</label>
                <input id="reportPeriod" name="Periodo" class="form-input" type="month" value="@DateTime.Today.ToString("yyyy-MM")" max="@DateTime.Today.ToString("yyyy-MM")" required />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="reportNotes" data-i18n="reportesadmin_notes">Notas u objetivos</label>
              <textarea id="reportNotes" name="Notas" class="form-input" rows="4" maxlength="1000" placeholder="Ej. Comparar con el trimestre anterior" data-i18n-ph="reportesadmin_notes_ph"></textarea>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn-secondary" data-modal-close="modalNewReport" data-i18n="reportesadmin_cancel">Cancelar</button>
              <button type="submit" class="btn-primary" data-i18n="reportesadmin_create">Crear Reporte</button>
            </div>
          </form>
        </div>
      </div>

      <div class="modal-overlay" id="modalViewAllReports" role="dialog" aria-modal="true" aria-labelledby="modalViewAllTitle" hidden>
        <div class="modal modal--lg" role="document">
          <button type="button" class="modal-close" data-modal-close="modalViewAllReports" aria-label="Cerrar ventana" data-i18n-aria-label="reportesadmin_close">×</button>
          <h2 class="modal-title" id="modalViewAllTitle" data-i18n="reportesadmin_modal_all_title">Todos los reportes</h2>
          <p class="modal-desc" data-i18n="reportesadmin_modal_all_desc">Accede a los reportes generados y descarga el formato que necesites.</p>
          <div class="modal-body">
            <div class="table-wrap table-responsive modal-table">
              <table class="data-table">
                <thead>
                  <tr>
                    <th data-i18n="reportesadmin_th_name">Reporte</th>
                    <th data-i18n="reportesadmin_th_date">Fecha</th>
                    <th data-i18n="reportesadmin_th_category">Categoría</th>
                    <th data-i18n="reportesadmin_th_status">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var reporte in Model.ReportesRecientes.Take(8))
                  {
                    var categoryKey = reporte.Categoria switch
                    {
                      "Financiero" => "reportesadmin_cat_financial",
                      "Pacientes" => "reportesadmin_cat_patients",
                      "Operativo" => "reportesadmin_cat_operational",
                      "Logística" => "reportesadmin_cat_logistics",
                      _ => "reportesadmin_cat_all"
                    };
                    <tr>
                      <td>@reporte.Nombre</td>
                      <td><time data-report-date datetime="@reporte.FechaGenerado.ToString("O")">@reporte.FechaGenerado.ToString("dd MMM, yyyy")</time></td>
                      <td><span data-i18n="@categoryKey">@reporte.Categoria</span></td>
                      <td><span data-i18n="reportesadmin_ready">@reporte.Estado</span></td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-modal-close="modalViewAllReports" data-i18n="reportesadmin_close">Cerrar</button>
          </div>
        </div>
      </div>

      <div class="modal-overlay" id="modalDownloadPDF" role="dialog" aria-modal="true" aria-labelledby="modalDownloadPDFTitle" hidden>
        <div class="modal" role="document">
          <button type="button" class="modal-close" data-modal-close="modalDownloadPDF" aria-label="Cerrar ventana" data-i18n-aria-label="reportesadmin_close">×</button>
          <h2 class="modal-title" id="modalDownloadPDFTitle" data-i18n="reportesadmin_pdf_title">Descargar PDF</h2>
          <p class="modal-desc" data-i18n="reportesadmin_pdf_desc">Selecciona el contenido que deseas incluir en el PDF del reporte actual.</p>
          <div class="modal-body">
            <label class="checkbox-label"><input type="checkbox" id="includeCharts" checked /> <span data-i18n="reportesadmin_pdf_metrics">Incluir indicadores y tabla de métricas</span></label>
            <label class="checkbox-label"><input type="checkbox" id="includeSummary" checked /> <span data-i18n="reportesadmin_pdf_summary">Incluir resumen ejecutivo</span></label>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-modal-close="modalDownloadPDF" data-i18n="reportesadmin_cancel">Cancelar</button>
            <button type="button" class="btn-primary" id="confirmPdfDownload" data-i18n="reportesadmin_pdf_download">Descargar PDF</button>
          </div>
        </div>
      </div>

      <div class="modal-overlay" id="modalExportCSV" role="dialog" aria-modal="true" aria-labelledby="modalExportCSVTitle" hidden>
        <div class="modal" role="document">
          <button type="button" class="modal-close" data-modal-close="modalExportCSV" aria-label="Cerrar ventana" data-i18n-aria-label="reportesadmin_close">×</button>
          <h2 class="modal-title" id="modalExportCSVTitle" data-i18n="reportesadmin_csv_title">Exportar CSV</h2>
          <p class="modal-desc" data-i18n="reportesadmin_csv_desc">Elige los datos a exportar y descarga los registros agregados en formato CSV.</p>
          <div class="modal-body">
            <label class="checkbox-label"><input type="checkbox" id="csvIncludeHeaders" checked /> <span data-i18n="reportesadmin_csv_headers">Incluir encabezados de columna</span></label>
            <label class="checkbox-label"><input type="checkbox" id="csvIncludeAll" checked /> <span data-i18n="reportesadmin_csv_all">Exportar todos los reportes</span></label>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" data-modal-close="modalExportCSV" data-i18n="reportesadmin_cancel">Cancelar</button>
            <button type="button" class="btn-primary" id="confirmCsvExport" data-i18n="reportesadmin_csv_export">Exportar CSV</button>
          </div>
        </div>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="~/js/Reportes/vista_admin/app.js" asp-append-version="true"></script>
}

