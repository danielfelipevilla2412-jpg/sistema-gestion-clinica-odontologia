@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.ViewModels.ReportesOperativosViewModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reportes Operativos";
    ViewData["UseGestionModulesDesignSystem"] = true;
    const string citas = "/gestion-de-citas/st-rec-03-gestion-citas";
    var pacientes = User.IsInRole("Recepcionista")
        ? "/gestion-de-pacientes/st-rec-pacientes"
        : "/gestion-de-pacientes/st-adm-05-gestion-pacientes";
    var fecha = (DateTime)ViewData["FechaOperativa"]!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Reportes/vista_recepcion/styles.css" asp-append-version="true" />
}

<main class="main recepcion-report" id="main-content">
    <header class="page-header">
        <div class="header-left">
            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <span data-i18n="common_role_recepcionista">Recepción</span>
                <span class="bc-sep" aria-hidden="true">›</span>
                <span class="bc-active" aria-current="page" data-i18n="nav.item_reportes_operativos">Reportes Operativos</span>
            </nav>
            <h1 class="page-title" data-i18n="nav.item_reportes_operativos">Reportes Operativos</h1>
            <p class="page-subtitle"><time datetime="@fecha.ToString("yyyy-MM-dd")">@fecha.ToString("dddd d 'de' MMMM", CultureInfo.GetCultureInfo("es-CO"))</time></p>
        </div>
    </header>

    <section class="stats-grid recepcion-report__stats" aria-label="Indicadores del día">
        @foreach (var kpi in Model.Kpis)
        {
            var color = kpi.Icon switch { "check_circle" => "green", "event_busy" => "red", _ => "blue" };
            <div class="stat-card" data-color="@color">
                <span class="material-symbols-outlined stat-icon" aria-hidden="true">@kpi.Icon</span>
                <span class="stat-number">@kpi.Value</span>
                <span class="stat-label">@kpi.Label</span>
            </div>
        }
    </section>

    <div class="recepcion-report__grid">
        <div class="recepcion-report__schedule">
            <section class="recepcion-report__card recepcion-report__agenda">
                <header>
                    <h2>Agenda de hoy</h2>
                    <a class="btn-secondary" href="@(citas)?vista=hoy">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span> Gestionar agenda
                    </a>
                </header>
                @if (Model.Agenda.Count == 0)
                {
                    <div class="recepcion-report__agenda-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">event_note</span>
                        <p>Todavía no hay citas para hoy.</p>
                    </div>
                }
                else
                {
                    <div class="recepcion-report__scroll">
                        <table aria-label="Citas de hoy">
                            <thead><tr><th scope="col">Hora</th><th scope="col">Profesional</th><th scope="col">Servicio</th><th scope="col">Estado</th><th scope="col">Detalle</th></tr></thead>
                            <tbody>
                                @foreach (var cita in Model.Agenda)
                                {
                                    <tr>
                                        <td><strong>@cita.Time</strong></td>
                                        <td>@cita.Professional</td>
                                        <td>@cita.Service</td>
                                        <td><span class="recepcion-report__status" data-status="@cita.StatusVariant">@cita.Status</span></td>
                                        <td><a href="@(citas)?verId=@cita.IdCita" aria-label="Ver cita de las @cita.Time con @cita.Professional">Ver cita</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="recepcion-report__card recepcion-report__upcoming" aria-labelledby="recepcionProximasTitulo">
                <header>
                    <h2 id="recepcionProximasTitulo">Próximas citas desde mañana</h2>
                    <a class="btn-secondary" href="@(citas)?vista=proximas">Ver agenda futura</a>
                </header>
                @if (Model.ProximasCitas.Count == 0)
                {
                    <p class="recepcion-report__empty">No hay citas futuras programadas ni confirmadas.</p>
                }
                else
                {
                    <ul class="recepcion-report__upcoming-list">
                        @foreach (var cita in Model.ProximasCitas)
                        {
                            <li>
                                <span class="material-symbols-outlined recepcion-report__avatar" aria-hidden="true">event</span>
                                <div>
                                    <strong>@cita.Time</strong>
                                    <span>@cita.Service · @cita.Professional</span>
                                </div>
                                <a class="btn-secondary" href="@(citas)?verId=@cita.IdCita" aria-label="Ver cita del @cita.Time con @cita.Professional">Ver cita</a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <aside class="recepcion-report__side" aria-label="Accesos de recepción">
            <section class="recepcion-report__card">
                <header><h2>Pacientes recientes</h2><a href="@pacientes">Ver todos</a></header>
                @if (Model.PacientesRecientes.Count == 0)
                {
                    <p class="recepcion-report__empty">Todavía no hay pacientes registrados.</p>
                }
                else
                {
                    <ul>
                        @foreach (var paciente in Model.PacientesRecientes)
                        {
                            <li>
                                <span class="recepcion-report__avatar material-symbols-outlined" aria-hidden="true">person</span>
                                <div><strong>@paciente.Name</strong><span>@paciente.ContactInfo</span></div>
                            </li>
                        }
                    </ul>
                }
            </section>
            <section class="recepcion-report__card">
                <header><h2>Facturación y pagos</h2></header>
                <a class="btn-secondary recepcion-report__billing" href="/facturacion-y-pagos/st-rec-04-generar-factura">Ir a facturación</a>
            </section>
        </aside>
    </div>
</main>
