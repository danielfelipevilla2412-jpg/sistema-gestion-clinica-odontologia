@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SmileTrack_MVC.Models.ViewModels.ReportesOperativosViewModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reportes Operativos";
    ViewData["Description"] = "Reportes para el rol de recepción en SmileTrack.";
    ViewData["UseGestionModulesDesignSystem"] = true;
    // es-CO usa "." como separador de miles (ej. $12.450).
    var moneyCulture = CultureInfo.GetCultureInfo("es-CO");
    var rutaPacientes = User.IsInRole("Recepcionista")
        ? "/gestion-de-pacientes/st-rec-pacientes"
        : "/gestion-de-pacientes/st-adm-05-gestion-pacientes";
}

@section Styles {
  <link rel="stylesheet" href="~/css/Reportes/vista_recepcion/styles.css" asp-append-version="true" />
}

<main class="main" id="main-content">

  <!-- Header -->
  <header class="page-header">
    <div class="header-left">
      <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="common.breadcrumb_nav">
        <span data-i18n="common_role_recepcionista">Recepción</span>
        <span class="bc-sep" aria-hidden="true">→</span>
        <span class="bc-active" aria-current="page" data-i18n="nav.item_reportes_operativos">Reportes Operativos</span>
      </nav>
      <h1 class="page-title" data-i18n="nav.group_reportes_analitica">Reportes Operativos</h1>
      <p class="page-subtitle" data-i18n="reportes.subtitle">Vista operativa detallada para hoy · Portal de Recepción</p>
    </div>
    <div class="header-actions">
      <button type="button" class="btn-sm js-crear-cita" data-i18n="reportes.btn_crear_cita">Crear Cita</button>
    </div>
  </header>

  <!-- KPIs Grid -->
  <section class="stats-grid" aria-label="Indicadores clave" data-i18n-aria-label="reportesadmin_stats_aria">
    @{ var kpiColors = new[] { "blue", "green", "purple", "orange", "red", "teal" }; var kpiIndex = 0; }
    @foreach (var kpi in Model.Kpis)
    {
      var color = kpi.ColorVariant switch
      {
          "error" => "red",
          "primary" => "blue",
          "secondary" => "teal",
          "tertiary" => "purple",
          _ => kpiColors[kpiIndex % kpiColors.Length]
      };
      <div class="stat-card" data-color="@color">
        <span class="stat-number">@kpi.Value</span>
        <span class="stat-label">@kpi.Label</span>
        <span class="stat-sub">@kpi.Subtitle</span>
      </div>
      kpiIndex++;
    }
  </section>

  <!-- Content Grid -->
  <div class="content-grid">

    <!-- Left Column -->
    <div class="content-grid__left">

      <!-- Agenda del Día -->
      <section class="table-section">
        <div class="section-header">
          <div>
            <h2 class="section-title" data-i18n="reportes.agenda_title">Agenda de Turnos</h2>
            <p class="section-subtitle" data-i18n="reportes.agenda_subtitle">Vista operativa detallada para hoy</p>
          </div>
          <button type="button" class="btn-sm js-crear-cita" data-i18n="reportes.btn_crear_cita">Crear Cita</button>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th data-i18n="citas.time">Hora</th>
                <th data-i18n="citas.professional">Profesional</th>
                <th data-i18n="citas.service">Servicio</th>
                <th data-i18n="reportesadmin_th_status">Estado</th>
                <th class="th-actions" data-i18n="reportes.th_acciones">Acciones</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var cita in Model.Agenda)
              {
                <tr class="@(cita.IsCancelled ? "row--cancelled" : "")">
                  <td class="cell-time">@cita.Time</td>
                  <td>@cita.Professional</td>
                  <td>@cita.Service</td>
                  <td>
                    @{
                      var pillClass = cita.StatusVariant switch
                        {
                            "neutral"   => "status-pill--neutral",
                            "secondary" => "status-pill--green",
                            "green"     => "status-pill--green",
                            "blue"      => "status-pill--blue",
                            "orange"    => "status-pill--orange",
                            "red"       => "status-pill--red",
                            "purple"    => "status-pill--purple",
                            "error"     => "status-pill--red",
                            "primary"   => "status-pill--blue",
                            _           => "status-pill--neutral"
                        };
                    }
                    <span class="status-pill @pillClass">@cita.Status</span>
                  </td>
                  <td>
                    @if (cita.IsCancelled)
                      {
                        <div class="row-actions row-actions--always">
                          <button type="button" class="btn-icon-sm js-reprogramar" title="Reprogramar" aria-label="Reprogramar"
                                  data-i18n-title="reportes.reprogramar" data-i18n-aria-label="reportes.reprogramar"
                                  data-id="@cita.IdCita" data-paciente="@cita.IdPaciente" data-profesional="@cita.IdProfesional"
                                  data-servicio="@cita.IdServicio" data-profesional-nombre="@cita.Professional" data-servicio-nombre="@cita.Service">
                            <span class="material-symbols-outlined" aria-hidden="true">event_repeat</span>
                          </button>
                        </div>
                      }
                      else
                      {
                        <div class="row-actions">
                          <button type="button" class="btn-icon-sm js-reprogramar" title="Reprogramar" aria-label="Reprogramar"
                                  data-i18n-title="reportes.reprogramar" data-i18n-aria-label="reportes.reprogramar"
                                  data-id="@cita.IdCita" data-paciente="@cita.IdPaciente" data-profesional="@cita.IdProfesional"
                                  data-servicio="@cita.IdServicio" data-profesional-nombre="@cita.Professional" data-servicio-nombre="@cita.Service">
                            <span class="material-symbols-outlined" aria-hidden="true">event_repeat</span>
                          </button>
                          <button type="button" class="btn-icon-sm btn-icon-sm--danger js-cancelar" title="Cancelar" aria-label="Cancelar"
                                  data-i18n-title="common.cancel" data-i18n-aria-label="common.cancel"
                                  data-id="@cita.IdCita" data-profesional-nombre="@cita.Professional" data-servicio-nombre="@cita.Service" data-hora="@cita.Time">
                            <span class="material-symbols-outlined" aria-hidden="true">cancel</span>
                          </button>
                        </div>
                      }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Pacientes Recientes -->
      <section class="table-section">
        <div class="section-header">
          <h2 class="section-title" data-i18n="reportes.pacientes_recientes">Pacientes Recientes</h2>
          <a href="@rutaPacientes" class="btn-link" data-i18n="reportes.ver_todos">Ver todos →</a>
        </div>
        <div class="patient-grid">
          @foreach (var p in Model.PacientesRecientes)
          {
            var avatarClass = p.AvatarColorVariant switch
            {
                "primary"   => "patient-avatar--blue",
                "secondary" => "patient-avatar--teal",
                "tertiary"  => "patient-avatar--purple",
                "error"     => "patient-avatar--red",
                "green"     => "patient-avatar--green",
                "orange"    => "patient-avatar--orange",
                "blue"      => "patient-avatar--blue",
                "purple"    => "patient-avatar--purple",
                "teal"      => "patient-avatar--teal",
                "red"       => "patient-avatar--red",
                _           => "patient-avatar--blue"
            };
            <div class="patient-card">
              <div class="patient-avatar @avatarClass">@p.Initials</div>
              <div class="patient-info">
                <span class="patient-name">@p.Name</span>
                <span class="patient-contact">@p.ContactInfo</span>
              </div>
              <button type="button" class="btn-icon-sm js-editar-paciente" title="Editar" aria-label="Editar"
                data-i18n-title="common.edit" data-i18n-aria-label="common.edit"
                data-id="@p.IdPaciente" data-nombre="@p.Name" data-contacto="@p.ContactInfo">
                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
              </button>
            </div>
          }
        </div>
      </section>

    </div>

    <!-- Right Column: Panel de Cobros -->
    <div class="cobro-card-wrapper">
      <section class="table-section">
        <div class="section-header">
          <div>
            <h2 class="section-title" data-i18n="reportes.cobros_title">Registro de Cobros</h2>
            <p class="section-subtitle" data-i18n="reportes.cobros_subtitle">Últimos movimientos del turno</p>
          </div>
        </div>

        <div class="cobro-list">
          @foreach (var cobro in Model.Cobros)
          {
            var iconColorClass = cobro.IconColorVariant switch
            {
                "green"   => "cobro-method__icon--green",
                "blue"    => "cobro-method__icon--blue",
                "primary" => "cobro-method__icon--blue",
                "purple"  => "cobro-method__icon--purple",
                "orange"  => "cobro-method__icon--orange",
                _         => "cobro-method__icon--blue"
            };
            var cobroIcono = cobro.Method == "Tarjeta" ? "credit_card" : "payments";
            <div class="cobro-item">
              <div class="cobro-item__top">
                <span class="cobro-method">
                  <span class="cobro-method__icon @iconColorClass material-symbols-outlined" aria-hidden="true">@cobroIcono</span>
                  @cobro.Method
                </span>
                <span class="cobro-amount">$@cobro.Amount.ToString("N0", moneyCulture)</span>
              </div>
              <div class="cobro-item__bottom">
                <div>
                  <p class="cobro-patient">@cobro.PatientName</p>
                  <p class="cobro-folio"><span data-i18n="reportes.folio">Folio:</span> @cobro.Folio</p>
                </div>
                <span class="cobro-time">@cobro.Time</span>
              </div>
            </div>
          }

          <!-- Morosos -->
          <div class="morosos-section">
            <h3 class="morosos-title">
              <span class="material-symbols-outlined" aria-hidden="true">warning</span>
              <span data-i18n="reportes.saldos_titulo">Saldos Pendientes Hoy</span>
            </h3>
            <div class="morosos-list">
              @foreach (var saldo in Model.SaldosPendientes)
              {
                <div class="moroso-row">
                  <div class="moroso-row__info">
                    <span class="patient-name">@saldo.PatientName</span>
                    <p class="moroso-amount">-$@saldo.Amount.ToString("N0", moneyCulture)</p>
                  </div>
                  <a href="/facturacion-y-pagos/st-rec-04-generar-factura" class="btn-collect" data-i18n="reportes.cobrar">Cobrar</a>
                </div>
              }
            </div>
          </div>
        </div>

        <!-- Cierre parcial de caja -->
        <div class="caja-footer">
          <div class="caja-footer__row">
            <span class="caja-footer__label" data-i18n="reportes.cierre_label">Cierre parcial caja</span>
            <span class="caja-footer__total">$@Model.CierreParcialCaja.ToString("N0", moneyCulture)</span>
          </div>
          <button type="button" class="btn-secondary--teal btn-primary--full js-conciliar" data-i18n="reportes.conciliar_turno">Conciliar Turno Mañana</button>
        </div>
      </section>
    </div>

  </div>

  <!-- Modal: Crear Cita (real, POST a /gestion-de-citas/guardar-cita) -->
  <div class="modal-overlay" id="modalCrearCita" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalCrearCitaTitle">
    <div class="modal">
      <button type="button" class="modal-close" data-modal-close="modalCrearCita" aria-label="Cerrar" data-i18n-aria-label="reportesadmin_close">&times;</button>
      <h3 class="modal-title" id="modalCrearCitaTitle" data-i18n="reportes.modal_cita_title">Crear nueva cita</h3>
      <p class="modal-desc" data-i18n="reportes.modal_cita_desc">Se guardará directamente en la agenda.</p>
      <form method="post" action="/gestion-de-citas/guardar-cita">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="/reportes/vista-recepcion" />
        <div class="modal-body">
          <div class="form-group">
            <label for="ccPaciente" data-i18n="citas.patient">Paciente</label>
            <select class="form-input" id="ccPaciente" name="IdPaciente" required>
              <option value="" data-i18n="reportes.select_paciente">Selecciona un paciente...</option>
              @foreach (var p in Model.PacientesDisponibles)
              {
                <option value="@p.Id">@p.Nombre</option>
              }
            </select>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label for="ccProfesional" data-i18n="citas.professional">Profesional</label>
              <select class="form-input" id="ccProfesional" name="IdProfesional" required>
                <option value="" data-i18n="reportes.select">Selecciona...</option>
                @foreach (var p in Model.ProfesionalesDisponibles)
                {
                  <option value="@p.Id">@p.Nombre</option>
                }
              </select>
            </div>
            <div class="form-group">
              <label for="ccServicio" data-i18n="citas.service">Servicio</label>
              <select class="form-input" id="ccServicio" name="IdServicio">
                <option value="" data-i18n="reportes.select">Selecciona...</option>
                @foreach (var s in Model.ServiciosDisponibles)
                {
                  <option value="@s.Id">@s.Nombre</option>
                }
              </select>
            </div>
          </div>
          <div class="grid-2">
            <div class="form-group">
              <label for="ccFecha" data-i18n="citas.date">Fecha</label>
              <input class="form-input" id="ccFecha" name="Fecha" type="date" required>
            </div>
            <div class="form-group">
              <label for="ccHora" data-i18n="citas.time">Hora</label>
              <input class="form-input" id="ccHora" name="HoraInicio" type="time" required>
            </div>
          </div>
          <div class="form-group">
            <label for="ccNotas" data-i18n="reportes.form_notas">Notas (opcional)</label>
            <input class="form-input" id="ccNotas" name="Notas" type="text" maxlength="500">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-modal-close="modalCrearCita" data-i18n="common.cancel">Cancelar</button>
          <button type="submit" class="btn-primary" data-i18n="reportes.btn_guardar_cita">Guardar cita</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Reprogramar (real, POST a /gestion-de-citas/guardar-cita en modo actualización) -->
  <div class="modal-overlay" id="modalReprogramar" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalReprogramarTitle">
    <div class="modal">
      <button type="button" class="modal-close" data-modal-close="modalReprogramar" aria-label="Cerrar" data-i18n-aria-label="reportesadmin_close">&times;</button>
      <h3 class="modal-title" id="modalReprogramarTitle" data-i18n="reportes.modal_reprogramar_title">Reprogramar cita</h3>
      <p class="modal-desc" id="reprogramarDesc" data-i18n="reportes.reprogramar_desc">Elige la nueva fecha y hora.</p>
      <form method="post" action="/gestion-de-citas/guardar-cita" id="formReprogramar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="/reportes/vista-recepcion" />
        <input type="hidden" name="IdCita" id="rpIdCita">
        <input type="hidden" name="IdPaciente" id="rpIdPaciente">
        <input type="hidden" name="IdProfesional" id="rpIdProfesional">
        <input type="hidden" name="IdServicio" id="rpIdServicio">
        <div class="modal-body">
          <div class="grid-2">
            <div class="form-group">
              <label for="rpFecha" data-i18n="reportes.form_nueva_fecha">Nueva fecha</label>
              <input class="form-input" id="rpFecha" name="Fecha" type="date" required>
            </div>
            <div class="form-group">
              <label for="rpHora" data-i18n="reportes.form_nueva_hora">Nueva hora</label>
              <input class="form-input" id="rpHora" name="HoraInicio" type="time" required>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-modal-close="modalReprogramar" data-i18n="common.cancel">Cancelar</button>
          <button type="submit" class="btn-primary" data-i18n="reportes.btn_guardar_cambios">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Cancelar (real, POST a /gestion-de-citas/eliminar-cita) -->
  <div class="modal-overlay" id="modalCancelar" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalCancelarTitle">
    <div class="modal">
      <button type="button" class="modal-close" data-modal-close="modalCancelar" aria-label="Cerrar" data-i18n-aria-label="reportesadmin_close">&times;</button>
      <h3 class="modal-title" id="modalCancelarTitle" data-i18n="reportes.modal_cancelar_title">Cancelar cita</h3>
      <p class="modal-desc modal-desc--danger" id="cancelarDesc" data-i18n="reportes.cancelar_desc">¿Seguro que deseas cancelar esta cita? Esta acción no se puede deshacer.</p>
      <form method="post" action="/gestion-de-citas/eliminar-cita">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="/reportes/vista-recepcion" />
        <input type="hidden" name="IdCita" id="cnIdCita">
        <div class="modal-footer">
          <button type="button" class="btn-secondary" data-modal-close="modalCancelar" data-i18n="reportes.btn_volver">Volver</button>
          <button type="submit" class="btn-primary btn-primary--danger" data-i18n="reportes.btn_si_cancelar">Sí, cancelar cita</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Conciliar turno (confirmación visual, no persiste en BD) -->
  <div class="modal-overlay" id="modalConciliar" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalConciliarTitle">
    <div class="modal">
      <button type="button" class="modal-close" data-modal-close="modalConciliar" aria-label="Cerrar" data-i18n-aria-label="reportesadmin_close">&times;</button>
      <h3 class="modal-title" id="modalConciliarTitle" data-i18n="reportes.modal_conciliar_title">Conciliar turno</h3>
      <p class="modal-desc">
        <span data-i18n="reportes.conciliar_desc">Vas a cerrar el turno actual con un total recaudado de</span>
        <strong>$@Model.CierreParcialCaja.ToString("N0", moneyCulture)</strong>.
        <span data-i18n="reportes.conciliar_nota">Verifica que el efectivo y los pagos con tarjeta coincidan con este monto antes de confirmar.</span>
      </p>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" data-modal-close="modalConciliar" data-i18n="common.cancel">Cancelar</button>
        <button type="button" class="btn-primary" id="btnConfirmarConciliar" data-i18n="reportes.btn_si_conciliar">Sí, conciliar turno</button>
      </div>
    </div>
  </div>

  <!-- Modal: Editar paciente (informativo, con link a la gestión completa) -->
  <div class="modal-overlay" id="modalEditarPaciente" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalEditarPacienteTitle">
    <div class="modal">
      <button type="button" class="modal-close" data-modal-close="modalEditarPaciente" aria-label="Cerrar" data-i18n-aria-label="reportesadmin_close">&times;</button>
      <h3 class="modal-title" id="modalEditarPacienteTitle" data-i18n="reportes.modal_paciente_title">Datos del paciente</h3>
      <div class="modal-body">
        <div class="form-group">
          <label data-i18n="common.name">Nombre</label>
          <div class="form-input form-input--readonly" id="epNombre"></div>
        </div>
        <div class="form-group">
          <label data-i18n="reportes.lbl_contacto">Contacto</label>
          <div class="form-input form-input--readonly" id="epContacto"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" data-modal-close="modalEditarPaciente" data-i18n="common.close">Cerrar</button>
        <a class="btn-primary" href="@rutaPacientes" data-i18n="reportes.btn_editar_gestion">Editar en Gestión de Pacientes</a>
      </div>
    </div>
  </div>

</main>

@section Scripts {
  @if (TempData["ErrorValidacion"] != null)
  {
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        window.ToastService?.error(
          window.I18N?.t('common.error') || 'Error',
          @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorValidacion"]?.ToString()))
        );
      });
    </script>
  }
  <script src="~/js/Reportes/vista_recepcion/main.js" asp-append-version="true" defer></script>
}
