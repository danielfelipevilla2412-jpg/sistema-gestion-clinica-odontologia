@model SmileTrack_MVC.Models.ViewModels.ReportesProfesionalViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reportes Profesional";
    ViewData["Description"] = "Indicadores de actividad del profesional autenticado.";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Reportes/vista_prof/styles.css" asp-append-version="true" />
}

<main class="main professional-reports" id="main-content">

  <header class="page-header">
    <nav class="breadcrumb" aria-label="Navegación de ruta" data-i18n-aria-label="common.breadcrumb_nav">
      <a href="/gestion-de-profesionales/st-odo-01-dashboard" data-i18n="reportesprof.breadcrumb_professional">Profesional</a>
      <span class="bc-sep" aria-hidden="true">→</span>
      <span class="bc-active" aria-current="page" data-i18n="reportesprof.breadcrumb_current">Reportes y estadísticas</span>
    </nav>
    <div class="page-header-content">
      <div class="page-header-title">
        <h1 class="page-title" data-i18n="reportesprof.title">Reportes y estadísticas</h1>
        <p class="page-subtitle" data-i18n="reportesprof.subtitle">Actividad clínica del mes actual y citas recientes.</p>
      </div>
      <div class="page-header-actions">
        <a class="btn-primary" href="/gestion-de-citas/st-odo-02-agenda" data-i18n="reportesprof.open_schedule">Ir a mi agenda</a>
        <button type="button" class="btn-secondary" id="btnDescargarPdf" data-i18n="reportesprof.download_pdf">Imprimir / guardar PDF</button>
      </div>
    </div>
  </header>

  <section class="stats-grid" aria-label="Indicadores clave" data-i18n-aria-label="reportesprof.stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" data-target="@Model.TotalCitas">@Model.TotalCitas</span>
        <span class="stat-label" data-i18n="reportesprof.appointments_month">Citas del mes</span>
        <span class="stat-sub">
          @if (Model.TendenciaCitas.HasValue)
          {
            <span>@(Model.TendenciaCitas.Value.ToString("+0.0;-0.0;0.0"))%</span>
            <span data-i18n="reportesprof.vs_previous_month">vs. mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesprof.no_previous_period">Sin periodo anterior comparable</span>
          }
        </span>
      </div>

      <div class="stat-card" data-color="green">
        <span class="stat-number">@Model.Ingresos.ToString("C0", System.Globalization.CultureInfo.CurrentCulture)</span>
        <span class="stat-label" data-i18n="reportesprof.paid_income_month">Ingresos pagados del mes</span>
        <span class="stat-sub">
          @if (Model.TendenciaIngresos.HasValue)
          {
            <span>@(Model.TendenciaIngresos.Value.ToString("+0.0;-0.0;0.0"))%</span>
            <span data-i18n="reportesprof.vs_previous_month">vs. mes anterior</span>
          }
          else
          {
            <span data-i18n="reportesprof.no_previous_period">Sin periodo anterior comparable</span>
          }
        </span>
      </div>

      <div class="stat-card" data-color="purple">
        <span class="stat-number" data-target="@Model.PacientesUnicos">@Model.PacientesUnicos</span>
        <span class="stat-label" data-i18n="reportesprof.patients_month">Pacientes del mes</span>
        <span class="stat-sub" data-i18n="reportesprof.unique_patients_month">Pacientes únicos con cita</span>
      </div>

      <div class="stat-card" data-color="red">
        <span class="stat-number" data-target="@Model.Cancelaciones">@Model.Cancelaciones</span>
        <span class="stat-label" data-i18n="reportesprof.cancellations_month">Cancelaciones del mes</span>
        <span class="stat-sub">@Model.TasaCancelacion.ToString("0.0")% <span data-i18n="reportesprof.cancellation_rate">de las citas del mes</span></span>
      </div>
  </section>

  <div class="professional-reports__panels">
    <section class="professional-reports__panel" aria-labelledby="treatmentsTitle">
      <header class="professional-reports__panel-header">
        <h2 id="treatmentsTitle" data-i18n="reportesprof.treatments_title">Tratamientos atendidos este mes</h2>
      </header>
      @if (Model.Tratamientos.Count == 0)
      {
        <div class="empty-state" role="status">
          <span class="material-symbols-outlined" aria-hidden="true">clinical_notes</span>
          <h3 data-i18n="reportesprof.no_treatments_title">Sin tratamientos registrados</h3>
          <p data-i18n="reportesprof.no_treatments_desc">No hay citas atendidas este mes.</p>
        </div>
      }
      else
      {
        <div class="professional-reports__treatments">
          @foreach (var tratamiento in Model.Tratamientos)
          {
            <button type="button" class="professional-reports__treatment"
                    data-treatment-name="@tratamiento.Nombre"
                    data-treatment-count="@tratamiento.Cantidad"
                    data-treatment-percent="@tratamiento.Porcentaje.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)">
              <span class="professional-reports__treatment-heading">
                <span class="professional-reports__treatment-name">@tratamiento.Nombre</span>
                <span class="professional-reports__treatment-count">
                  @tratamiento.Cantidad <span data-i18n="reportesprof.appointments">citas</span>
                  (@tratamiento.Porcentaje.ToString("0.#")%)
                </span>
              </span>
              <span class="professional-reports__progress-track" aria-hidden="true">
                <span class="professional-reports__progress-fill" style="width:@tratamiento.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
              </span>
            </button>
          }
        </div>
      }
    </section>

    <section class="professional-reports__panel" aria-labelledby="frequentPatientsTitle">
      <header class="professional-reports__panel-header">
        <h2 id="frequentPatientsTitle" data-i18n="reportesprof.frequent_patients_title">Pacientes con más citas (6 meses)</h2>
      </header>
      @if (Model.PacientesFrecuentes.Count == 0)
      {
        <div class="empty-state" role="status">
          <span class="material-symbols-outlined" aria-hidden="true">groups</span>
          <h3 data-i18n="reportesprof.no_patients_title">Sin actividad reciente</h3>
          <p data-i18n="reportesprof.no_patients_desc">No hay citas de pacientes en los últimos seis meses.</p>
        </div>
      }
      else
      {
        <ul class="professional-reports__patients">
          @foreach (var paciente in Model.PacientesFrecuentes)
          {
            <li class="professional-reports__patient">
              <span class="patient-avatar" data-color="@paciente.Color" aria-hidden="true">@paciente.Iniciales</span>
              <span class="professional-reports__patient-name">@paciente.Nombre</span>
              <span class="professional-reports__patient-count">
                @paciente.Citas <span data-i18n="reportesprof.appointments">citas</span>
              </span>
            </li>
          }
        </ul>
      }
    </section>
  </div>

  <section class="professional-reports__panel" aria-labelledby="upcomingTitle">
    <header class="professional-reports__panel-header">
      <h2 id="upcomingTitle" data-i18n="reportesprof.upcoming_title">Próximos días</h2>
      <span class="professional-reports__panel-subtitle" data-i18n="reportesprof.upcoming_subtitle">Citas de los próximos tres días</span>
    </header>
    <div class="professional-reports__days">
      @foreach (var dia in Model.ProximosDias)
      {
        <article class="professional-reports__day" data-color="@(dia.EsHoy ? "blue" : "teal")">
          <span class="professional-reports__day-name" data-i18n="@dia.ClaveDia">@dia.DiaNombre</span>
          <span class="professional-reports__day-count">@dia.CantidadCitas</span>
          <span class="professional-reports__day-date">@dia.Fecha</span>
        </article>
      }
    </div>
  </section>

  <section class="professional-reports__panel" aria-labelledby="recentTitle">
    <header class="professional-reports__panel-header">
      <h2 id="recentTitle" data-i18n="reportesprof.recent_title">Citas recientes</h2>
      <a href="/historia-clinica/st-odo-03-historial" class="btn-link" data-i18n="reportesprof.history_link">Ir al historial clínico</a>
    </header>
    <div class="table-wrap">
      <table class="professional-reports__table">
        <thead>
          <tr>
            <th scope="col" data-i18n="reportesprof.patient">Paciente</th>
            <th scope="col" data-i18n="reportesprof.service">Servicio</th>
            <th scope="col" data-i18n="reportesprof.time">Hora</th>
            <th scope="col" data-i18n="reportesprof.status">Estado</th>
            <th scope="col" data-i18n="reportesprof.action">Acción</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.UltimasCitas.Count == 0)
          {
            <tr>
              <td colspan="5">
                <div class="empty-state" role="status">
                  <span class="material-symbols-outlined" aria-hidden="true">event_busy</span>
                  <h3 data-i18n="reportesprof.no_recent_title">Sin citas recientes</h3>
                  <p data-i18n="reportesprof.no_recent_desc">Cuando tengas citas registradas, aparecerán aquí.</p>
                </div>
              </td>
            </tr>
          }
          else
          {
            @foreach (var cita in Model.UltimasCitas)
            {
              var iniciales = string.Concat(cita.NombrePaciente.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                  .Take(2).Select(parte => parte[0])).ToUpperInvariant();
              <tr>
                <td>
                  <div class="professional-reports__patient-cell">
                    <span class="patient-avatar" data-color="blue" aria-hidden="true">@(string.IsNullOrWhiteSpace(iniciales) ? "P" : iniciales)</span>
                    <span>@cita.NombrePaciente</span>
                  </div>
                </td>
                <td>@cita.Servicio</td>
                <td>@cita.Hora</td>
                <td>
                  <span class="badge-estado status-badge @cita.EstadoClase" data-i18n="@cita.ClaveEstado">@cita.Estado</span>
                </td>
                <td>
                  <button type="button" class="action-btn"
                          aria-label="Ver detalle de la cita"
                          data-i18n-aria-label="reportesprof.view_appointment"
                          title="Ver detalle de la cita"
                          data-i18n-title="reportesprof.view_appointment"
                          data-appointment-name="@cita.NombrePaciente"
                          data-appointment-service="@cita.Servicio"
                          data-appointment-time="@cita.Hora"
                          data-appointment-status="@cita.Estado"
                          data-dialog-open="modalDetalleCita">
                    <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                  </button>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </section>

  <dialog class="professional-reports__dialog" id="modalDetalleCita" aria-labelledby="detalleCitaTitle">
    <div class="professional-reports__dialog-header">
      <h2 id="detalleCitaTitle" data-i18n="reportesprof.appointment_detail">Detalle de la cita</h2>
      <button type="button" class="action-btn" data-dialog-close aria-label="Cerrar"
              data-i18n-aria-label="common.close" title="Cerrar" data-i18n-title="common.close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <dl class="professional-reports__details">
      <div><dt data-i18n="reportesprof.patient">Paciente</dt><dd id="detalleCitaPaciente"></dd></div>
      <div><dt data-i18n="reportesprof.service">Servicio</dt><dd id="detalleCitaServicio"></dd></div>
      <div><dt data-i18n="reportesprof.time">Hora</dt><dd id="detalleCitaHora"></dd></div>
      <div><dt data-i18n="reportesprof.status">Estado</dt><dd id="detalleCitaEstado"></dd></div>
    </dl>
    <div class="professional-reports__dialog-actions">
      <button type="button" class="btn-secondary" data-dialog-close data-i18n="common.close">Cerrar</button>
    </div>
  </dialog>

  <dialog class="professional-reports__dialog" id="modalDetalleTratamiento" aria-labelledby="detalleTratamientoTitle">
    <div class="professional-reports__dialog-header">
      <h2 id="detalleTratamientoTitle" data-i18n="reportesprof.treatment_detail">Detalle del tratamiento</h2>
      <button type="button" class="action-btn" data-dialog-close aria-label="Cerrar"
              data-i18n-aria-label="common.close" title="Cerrar" data-i18n-title="common.close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </div>
    <dl class="professional-reports__details">
      <div><dt data-i18n="reportesprof.service">Servicio</dt><dd id="detalleTratNombre"></dd></div>
      <div><dt data-i18n="reportesprof.appointments">Citas</dt><dd id="detalleTratCantidad"></dd></div>
      <div><dt data-i18n="reportesprof.share_of_treatments">% de tratamientos atendidos</dt><dd id="detalleTratPorcentaje"></dd></div>
    </dl>
    <div class="professional-reports__dialog-actions">
      <button type="button" class="btn-secondary" data-dialog-close data-i18n="common.close">Cerrar</button>
    </div>
  </dialog>
</main>

@section Scripts {
  <script src="~/js/Reportes/vista_prof/main.js" asp-append-version="true"></script>
}

