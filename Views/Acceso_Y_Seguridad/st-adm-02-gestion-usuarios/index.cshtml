@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Usuarios";
    ViewData["Description"] = "Gestión de usuarios y roles del sistema SmileTrack";
    ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Acceso_Y_Seguridad/st-adm-02-gestion-usuarios/styles.css" asp-append-version="true" />
}

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="nav.sidebar_label">
          <span data-i18n="nav.group_acceso">Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active" data-i18n="nav.gestion_usuarios">Gestión de Usuarios</span>
        </nav>
        <h1 class="page-title" data-i18n="nav.gestion_usuarios">Gestión de Usuarios</h1>
        <p class="page-subtitle" data-i18n="gestionusuarios_subtitle">Administra usuarios y roles del sistema SmileTrack</p>
      </div>
      <button type="button" class="btn-primary" id="btnAddUser" aria-label="Crear nuevo usuario" data-i18n-aria-label="gestionusuarios_btn_nuevo_aria">
        <span class="material-symbols-outlined" aria-hidden="true">add</span>
        <span data-i18n="gestionusuarios_btn_nuevo">Nuevo usuario</span>
      </button>
    </header>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Estadísticas de usuarios" data-i18n-aria-label="gestionusuarios_stats_aria">
      <div class="stat-card" data-color="blue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">groups</span>
        <span class="stat-number" id="statTotal" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestionusuarios_stat_total">Total usuarios</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">person_check</span>
        <span class="stat-number" id="statActive" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.active">Activos</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">block</span>
        <span class="stat-number" id="statBlocked" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.blocked">Bloqueados</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">person_off</span>
        <span class="stat-number" id="statInactive" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="status.inactive">Inactivos</span>
      </div>
    </section>

    <!-- Filtros -->
    <section class="filters-section" aria-label="Filtros de búsqueda" data-i18n-aria-label="gestionusuarios_filters_aria">
      <form class="filters-row" id="userFiltersForm" role="search">
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <input type="search" id="searchUser" class="search-input" placeholder="Buscar por nombre o correo..."
            aria-label="Buscar usuario" data-i18n-ph="gestionusuarios_search_ph" data-i18n-aria-label="gestionusuarios_search_aria">
        </div>
        <div class="filter-wrap">
          <label for="filterRole" class="visually-hidden" data-i18n="gestionusuarios_filter_role_label">Filtrar por rol</label>
          <select id="filterRole" class="status-select" aria-label="Filtrar usuarios por rol" data-i18n-aria-label="gestionusuarios_filter_role_label">
            <option value="" data-i18n="gestionusuarios_filter_role_all">Todos los roles</option>
            <option value="Administrador" data-i18n="login.role_admin">Administrador</option>
            <option value="Recepcionista" data-i18n="login.role_recepcionista">Recepcionista</option>
            <option value="Profesional" data-i18n="login.role_profesional">Profesional</option>
            <option value="Auxiliar" data-i18n="login.role_auxiliar">Auxiliar</option>
            <option value="Paciente" data-i18n="login.role_paciente">Paciente</option>
          </select>
        </div>
        <div class="filter-wrap">
          <label for="filterStatus" class="visually-hidden" data-i18n="gestionusuarios_filter_status_label">Filtrar por estado</label>
          <select id="filterStatus" class="status-select" aria-label="Filtrar usuarios por estado" data-i18n-aria-label="gestionusuarios_filter_status_label">
            <option value="" data-i18n="gestionusuarios_filter_status_all">Todos los estados</option>
            <option value="Activo" data-i18n="status.active">Activo</option>
            <option value="Inactivo" data-i18n="status.inactive">Inactivo</option>
            <option value="Bloqueado" data-i18n="status.blocked">Bloqueado</option>
          </select>
        </div>
        <button class="btn-primary" id="btnApplyFilters" type="submit" aria-label="Aplicar los filtros de usuarios" data-i18n-aria-label="gestionusuarios_btn_buscar_aria">
          <span class="material-symbols-outlined" aria-hidden="true">search</span>
          <span data-i18n="gestionusuarios_btn_buscar">Buscar</span>
        </button>
        <button class="btn-secondary" id="btnClearFilters" type="button" aria-label="Limpiar los filtros de usuarios" data-i18n-aria-label="gestionusuarios_btn_limpiar_aria">
          <span class="material-symbols-outlined" aria-hidden="true">filter_alt_off</span>
          <span data-i18n="gestionusuarios_btn_limpiar">Limpiar filtros</span>
        </button>
      </form>
    </section>

    <!-- Tabla de usuarios -->
    <section class="table-card" aria-labelledby="usersTitle">
      <h2 class="visually-hidden" id="usersTitle">Lista de usuarios</h2>
      <div class="table-wrap">
        <table id="usersTable" class="table-base" aria-label="Tabla de usuarios del sistema" data-i18n-aria-label="gestionusuarios_table_aria">
          <thead>
            <tr>
              <th scope="col" data-i18n="common.name">USUARIO</th>
              <th scope="col" data-i18n="common.email">CORREO</th>
              <th scope="col" data-i18n="gestionusuarios_th_role">ROL</th>
              <th scope="col" data-i18n="status.active">ESTADO</th>
              <th scope="col" data-i18n="common.last_visit">ÚLTIMO ACCESO</th>
              <th scope="col" data-i18n="table.actions">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="usersTbody" aria-live="polite">
            <!-- Filas inyectadas por JS -->
          </tbody>
        </table>
      </div>

      <!-- Paginación -->
      <div class="pagination" role="navigation" aria-label="Paginación de usuarios" data-i18n-aria-label="gestionusuarios_pagination_aria">
        <span class="pagination-info" id="paginationInfo" aria-live="polite">Mostrando 0-0 de 0 usuarios</span>
        <div class="pagination-buttons" id="paginationButtons">
          <!-- Botones generados por JS -->
        </div>
      </div>
    </section>

  </main>

  <!-- Modal: Crear/Editar Usuario -->
  <div class="modal-overlay" id="modalAddUser" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button type="button" class="btn-icon modal-close" id="modalClose" aria-label="Cerrar ventana" data-i18n-aria-label="common.close">
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
      <h2 class="modal-title" id="modalTitle">Crear Nuevo Usuario</h2>
      <form id="formAddUser" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" id="userId" value="">

        <div id="userModalInfo">
          Las cuentas de Profesional y Paciente se crean desde sus módulos para mantener la vinculación con sus perfiles.
        </div>

        <div class="form-group">
          <label class="form-label" for="userName">Nombres</label>
          <input type="text" id="userName" class="form-input" required placeholder="Ej. Andrés">
        </div>
        <div class="form-group">
          <label class="form-label" for="userLastName">Apellidos</label>
          <input type="text" id="userLastName" class="form-input" required placeholder="Ej. Beltrán García">
        </div>
        <div class="form-group">
          <label class="form-label" for="userEmail">Correo Electrónico</label>
          <input type="email" id="userEmail" class="form-input" required placeholder="Ej. usuario@smiletrack.co">
        </div>
        <div class="form-group">
          <label class="form-label" for="userPassword">Contraseña inicial / nueva contraseña</label>
          <input type="password" id="userPassword" class="form-input" minlength="8" placeholder="Mínimo 8 caracteres, letra, número y símbolo">
          <small id="userPasswordHelp">Obligatoria al crear. Déjala vacía al editar para conservar la actual.</small>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="userRole">Rol</label>
            <select id="userRole" class="form-input" required>
              <option value="">Seleccionar rol...</option>
              <option value="Administrador">Administrador</option>
              <option value="Recepcionista">Recepcionista</option>
              <option value="Auxiliar">Auxiliar</option>
              <option value="Profesional">Profesional</option>
              <option value="Paciente">Paciente</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="userStatus">Estado</label>
            <select id="userStatus" class="form-input" required>
              <option value="Activo">Activo</option>
              <option value="Inactivo">Inactivo</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalCancel">Cancelar</button>
          <button type="submit" class="btn-primary" id="btnSaveUser">Crear usuario</button>
        </div>
      </form>
    </div>
  </div>

@section Scripts {
  <script>
    window.RAZOR_USERS = @Html.Raw(ViewData["UsuariosJson"] ?? "[]");
  </script>
  <script src="~/js/Acceso_Y_Seguridad/st-adm-02-gestion-usuarios/script.js" asp-append-version="true" defer></script>
}

