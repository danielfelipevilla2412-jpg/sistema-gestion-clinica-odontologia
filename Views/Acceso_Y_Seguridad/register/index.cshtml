@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.BodyTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Crear cuenta en SmileTrack - Sistema de Gestión Clínica Odontológica" />
    <title>Crear cuenta — SmileTrack</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@400;500;700,FILL@0..1&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/css/Acceso_Y_Seguridad/register/register.css")" rel="stylesheet" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: '#1E88E5',
                        accent: '#43A047',
                        background: '#FFFFFF',
                        surface: '#F5F7FA',
                        'text-primary': '#212121',
                        'text-secondary': '#1E88E5',
                        success: '#43A047',
                        error: '#E53935',
                        warning: '#FBC02D',
                        info: '#42A5F5'
                    },
                    fontFamily: {
                        title: ['Montserrat', 'sans-serif'],
                        body: ['Roboto', 'sans-serif']
                    }
                }
            }
        };
    </script>
</head>
<body class="min-h-screen bg-background font-body text-text-primary antialiased flex items-center justify-center p-6">
    <div class="fixed inset-0 z-0">
        <img alt="Clínica Dental" class="h-full w-full object-cover" src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1600&q=80" />
        <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(0, 53, 95, 0.85) 0%, rgba(25, 28, 30, 0.7) 100%);"></div>
    </div>

    <main class="relative z-10 w-full max-w-2xl">
        <div class="overflow-hidden rounded-3xl border border-white/20 bg-[#1a3150]/95 shadow-2xl backdrop-blur-md">
            <div class="space-y-4 p-6 text-center">
                <div class="mb-4 flex justify-center">
                    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="Logo SmileTrack" class="h-24 w-auto object-contain drop-shadow-md" />
                </div>
                <h1 class="font-title text-3xl font-bold tracking-tight text-white">SmileTrack</h1>
                <p class="font-body text-sm text-white/80">Únete a la red dental profesional</p>
            </div>

            <form id="registerForm" class="space-y-6 px-6 pb-8 md:px-10" action="/acceso-y-seguridad/register" method="post">
                @Html.AntiForgeryToken()

                <fieldset class="space-y-3 rounded-2xl border border-white/10 p-4 md:p-5">
                    <legend class="mb-2 block px-2 font-title text-lg font-semibold text-white">Datos Personales</legend>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="space-y-2">
                            <label for="first-name" class="block text-sm font-medium uppercase tracking-wide text-white/80">Nombres</label>
                            <input id="first-name" name="Nombre" type="text" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="Ej: Juan Carlos" />
                        </div>
                        <div class="space-y-2">
                            <label for="last-name" class="block text-sm font-medium uppercase tracking-wide text-white/80">Apellidos</label>
                            <input id="last-name" name="Apellidos" type="text" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="Ej: Pérez García" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="space-y-3 rounded-2xl border border-white/10 p-4 md:p-5">
                    <legend class="mb-2 block px-2 font-title text-lg font-semibold text-white">Documentación</legend>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="space-y-2">
                            <label for="doc-type" class="block text-sm font-medium uppercase tracking-wide text-white/80">Tipo Documento</label>
                            <select id="doc-type" name="TipoDocumento" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none focus:border-white focus:ring-2 focus:ring-white/30">
                                <option value="" class="text-gray-500">Seleccionar tipo...</option>
                                <option value="dni" class="text-black">Cédula de ciudadanía</option>
                                <option value="tarjetaidentidad" class="text-black">Tarjeta de identidad</option>
                                <option value="cedulaextranjeria" class="text-black">Cédula de extranjería</option>
                                <option value="pasaporte" class="text-black">Pasaporte</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label for="doc-num" class="block text-sm font-medium uppercase tracking-wide text-white/80">Número Documento</label>
                            <input id="doc-num" name="NumeroDocumento" type="text" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="Ej: 12345678" />
                        </div>
                    </div>
                </fieldset>
                
                <fieldset class="space-y-3 rounded-2xl border border-white/10 p-4 md:p-5">
                    <legend class="mb-2 block px-2 font-title text-lg font-semibold text-white">Contacto</legend>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="space-y-2">
                            <label for="email" class="block text-sm font-medium uppercase tracking-wide text-white/80">Correo Electrónico</label>
                            <input id="email" name="Correo" type="email" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="odontologo@clinicadental.com" />
                        </div>
                        <div class="space-y-2">
                            <label for="phone" class="block text-sm font-medium uppercase tracking-wide text-white/80">Teléfono</label>
                            <input id="phone" name="Telefono" type="tel" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="+57 300 123 456" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="space-y-3 rounded-2xl border border-white/10 p-4 md:p-5">
                    <legend class="mb-2 block px-2 font-title text-lg font-semibold text-white">Seguridad</legend>
                    <div class="grid gap-4 md:grid-cols-2">
                        <div class="space-y-2">
                            <label for="password" class="block text-sm font-medium uppercase tracking-wide text-white/80">Contraseña</label>
                            <div class="relative">
                                <input id="password" name="Contrasena" type="password" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 pr-12 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="Mínimo 8 caracteres" />
                                <button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-white/60 transition hover:text-white" aria-label="Mostrar contraseña" aria-pressed="false">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                            </div>
                            <div id="passwordStrength" class="mt-3 h-2 w-full overflow-hidden rounded-full bg-white/10 hidden"></div>
                            <div class="mt-3 grid gap-2 text-sm text-white/70">
                                <p id="passwordCriterionLength">• Mínimo 8 caracteres</p>
                                <p id="passwordCriterionUpper">• Al menos una letra mayúscula</p>
                                <p id="passwordCriterionNumber">• Al menos un número</p>
                                <p id="passwordCriterionSymbol">• Al menos un símbolo especial</p>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label for="confirm-password" class="block text-sm font-medium uppercase tracking-wide text-white/80">Confirmar Contraseña</label>
                            <input id="confirm-password" name="ConfirmarContrasena" type="password" required class="w-full rounded-xl border border-white/20 bg-[#0f1f33]/80 px-4 py-3 text-white outline-none placeholder:text-white/40 focus:border-white focus:ring-2 focus:ring-white/30" placeholder="Repite tu contraseña" />
                        </div>
                    </div>
                </fieldset>

                <label for="terms" class="flex items-start rounded-xl border border-white/20 bg-[#0f1f33]/50 p-3 transition hover:border-white cursor-pointer">
                    <div class="mr-3 mt-0.5 flex-shrink-0">
                        <input id="terms" name="terms" type="checkbox" required class="sr-only peer" />
                        <div class="flex h-5 w-5 items-center justify-center rounded border border-white/20 bg-[#0f1f33] transition peer-checked:bg-[#a0c9ff] peer-checked:border-[#a0c9ff]">
                            <span class="material-symbols-outlined text-[14px] text-[#00355f] opacity-0 transition duration-200 peer-checked:opacity-100" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">check</span>
                        </div>
                    </div>
                    <span class="text-sm leading-relaxed text-white/80 mb-0">
                        Acepto los <a href="/terminos" class="font-semibold hover:underline">Términos de Servicio</a> y <a href="/privacidad" class="font-semibold hover:underline">Política de Privacidad</a> de SmileTrack.
                    </span>
                </label>

                <button id="registerBtn" type="submit" class="flex w-full items-center justify-center gap-3 rounded-2xl bg-[#a0c9ff] py-4 text-lg font-bold text-[#00355f] shadow-xl transition hover:bg-white hover:shadow-2xl" aria-disabled="false">
                    Crear cuenta
                </button>

                <noscript>
                    <div class="mt-4 rounded-2xl border border-yellow-400/30 bg-yellow-500/10 p-4 text-sm text-yellow-700" role="alert">
                        JavaScript está deshabilitado en tu navegador. El formulario puede enviarse, pero algunas validaciones y la experiencia mejorada no estarán disponibles.
                    </div>
                </noscript>

                <div id="registerGlobalError" class="hidden mt-4 rounded-2xl border border-red-400/30 bg-red-500/10 p-4 text-sm text-red-700" role="alert"></div>

                <div class="border-t border-white/20 pt-6 text-center">
                    <p class="text-sm text-white/80">
                        ¿Ya tienes cuenta?
                        <a href="/acceso-y-seguridad/login" class="ml-1 font-semibold text-[#a0c9ff] hover:underline">Inicia sesión aquí</a>
                    </p>
                </div>
            </form>
        </div>

        <footer class="mt-6 text-center">
            <p class="text-sm uppercase tracking-wider text-white/70">Portal Clínico Seguro • v2.4.0</p>
        </footer>
    </main>

    <script src="@Url.Content("~/js/shared/validation-utils.js")"></script>
    <script src="@Url.Content("~/js/Acceso_Y_Seguridad/register/register.js")"></script>
  @{ await Html.RenderPartialAsync("~/Views/shared/_Toasts.cshtml"); }
  @{ await Html.RenderPartialAsync("~/Views/shared/_ConfirmModal.cshtml"); }
</body>
</html>


