@model IReadOnlyList<SmileTrack_MVC.Models.Entities.Rol>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Routing
@inject EndpointDataSource Rutas

@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestión de Roles";
    ViewData["UseGestionModulesDesignSystem"] = true;
    var acciones = new[]
    {
        ("Acceso y Seguridad", "Gestionar usuarios", "GET", "acceso-y-seguridad/st-adm-02-gestion-usuarios"),
        ("Pacientes", "Abrir Gestión de Pacientes", "GET", "gestion-de-pacientes/st-adm-05-gestion-pacientes"),
        ("Citas", "Consultar la agenda de la clínica", "GET", "gestion-de-citas/st-adm-08-agenda"),
        ("Citas", "Abrir Gestión Integral de Citas", "GET", "gestion-de-citas/st-adm-09-citas"),
        ("Citas", "Abrir Mis citas", "GET", "gestion-de-citas/st-pac-01-mis-citas"),
        ("Historia Clínica", "Abrir el historial administrativo", "GET", "historia-clinica/st-adm-historial"),
        ("Reportes", "Abrir Reportes Clínicos", "GET", "gestion-de-profesionales/st-adm-14-reportes-clinicos"),
        ("PQR", "Radicar una solicitud o reporte", "POST", "gestion-de-pqr/crear"),
        ("PQR", "Responder solicitudes", "POST", "gestion-de-pqr/api/pqr/{id:int}/responder"),
        ("Servicios", "Abrir el catálogo administrativo", "GET", "servicios-y-recursos/st-adm-10-servicios"),
        ("Configuración", "Guardar configuración general", "PUT", "servicios-y-recursos/api/configuracion-general")
    };
    var endpoints = Rutas.Endpoints.OfType<RouteEndpoint>().ToList();
    var roles = Model.OrderBy(r => r.IdRol).ToList();
    var permisos = ViewData["PermisosRecepcion"] as IReadOnlyDictionary<string, bool>;
    var profesionalReagenda = ViewData["ProfesionalReagenda"] is true;
}

@section Styles {
    <style>
        #main-content .table-base tbody .role-matrix-action {
            background: transparent;
            color: var(--text, #1e293b);
            font-size: inherit;
            text-transform: none;
            letter-spacing: normal;
        }

        .role-matrix-badge {
            display: inline-block;
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .75rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .role-matrix-badge.is-enabled { background: #dcfce7; color: #166534; }
        .role-matrix-badge.is-revoked { background: #fee2e2; color: #991b1b; }
        .role-matrix-badge.is-denied { background: #f1f5f9; color: #475569; }
        .role-matrix-badge.is-unknown { background: #fef3c7; color: #92400e; }
    </style>
}

<main class="main" id="main-content">
    <header class="page-header">
        <div class="header-left">
            <h1 class="page-title">Gestión de Roles</h1>
            <p class="page-subtitle">Consulta los roles habilitados para las principales acciones de SmileTrack.</p>
        </div>
    </header>

    <section class="table-card" aria-labelledby="permisoReagendarTitle" style="padding:16px;margin-bottom:16px">
        <h2 id="permisoReagendarTitle" class="card-title">Permisos de Citas · Recepción</h2>
        @if (TempData["PermisoReagendarMensaje"] is string mensaje)
        {
            <p role="status">@mensaje</p>
        }
        @if (permisos is not null)
        {
            foreach (var (accion, permitido) in permisos)
            {
                <form method="post" action="/acceso-y-seguridad/gestion-roles/recepcion-permiso" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-block:12px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accion" value="@accion">
                    <label for="permiso-@accion">Permiso para @accion citas</label>
                    <select id="permiso-@accion" name="permitido" class="filter-select">
                        <option value="true" selected="@(permitido ? "selected" : null)">Permitir</option>
                        <option value="false" selected="@(!permitido ? "selected" : null)">Revocar</option>
                    </select>
                    <button type="submit" class="btn-primary">Aplicar</button>
                </form>
            }
        }
    </section>

    <section class="table-card" aria-labelledby="permisoProfesionalTitle" style="padding:16px;margin-bottom:16px">
        <h2 id="permisoProfesionalTitle" class="card-title">Permisos de Citas · Profesional</h2>
        <form method="post" action="/acceso-y-seguridad/gestion-roles/recepcion-permiso" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="accion" value="reagendar">
            <input type="hidden" name="profesional" value="true">
            <label for="permisoProfesionalReagenda">Reagendar citas asignadas</label>
            <select id="permisoProfesionalReagenda" name="permitido" class="filter-select">
                <option value="true" selected="@(profesionalReagenda ? "selected" : null)">Permitir</option>
                <option value="false" selected="@(!profesionalReagenda ? "selected" : null)">Revocar</option>
            </select>
            <button type="submit" class="btn-primary">Aplicar</button>
        </form>
    </section>

    <section class="table-card" aria-labelledby="rolesTitle">
        <h2 id="rolesTitle" class="card-title" style="padding: 16px 16px 0">Acceso por acción</h2>
        <p style="padding: 0 16px 16px">Esta matriz indica qué roles pueden abrir cada vista o ejecutar cada acción. Cada módulo verifica qué registros puede consultar la cuenta.</p>
        <div class="table-wrap" role="region" aria-label="Matriz de roles por acción" tabindex="0">
            <table class="table-base">
                <thead>
                    <tr>
                        <th scope="col">Módulo</th>
                        <th scope="col">Acción</th>
                        @foreach (var rol in roles)
                        {
                            <th scope="col">@rol.NombreRol</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (modulo, accion, metodo, ruta) in acciones)
                    {
                        var endpoint = endpoints.FirstOrDefault(e =>
                            string.Equals(e.RoutePattern.RawText?.Trim('/'), ruta, StringComparison.OrdinalIgnoreCase)
                            && e.Metadata.GetMetadata<IHttpMethodMetadata>()?.HttpMethods.Contains(metodo) == true);
                        var reglas = endpoint?.Metadata.GetOrderedMetadata<IAuthorizeData>();
                        var verificable = reglas is { Count: > 0 }
                            && endpoint?.Metadata.GetMetadata<IAllowAnonymous>() == null
                            && reglas.All(r => string.IsNullOrWhiteSpace(r.Policy))
                            && reglas.Any(r => !string.IsNullOrWhiteSpace(r.Roles));
                        <tr>
                            <td>@modulo</td>
                            <th scope="row" class="role-matrix-action">@accion</th>
                            @foreach (var rol in roles)
                            {
                                var habilitado = verificable && reglas!.All(r => string.IsNullOrWhiteSpace(r.Roles)
                                    || r.Roles.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                                        .Contains(rol.NombreRol, StringComparer.Ordinal));
                                <td><span class="role-matrix-badge @(verificable ? (habilitado ? "is-enabled" : "is-denied") : "is-unknown")">@(verificable ? (habilitado ? "Habilitado" : "Sin acceso") : "Por verificar")</span></td>
                            }
                        </tr>
                    }
                    @if (permisos is not null)
                    {
                        foreach (var (accion, permitido) in permisos)
                        {
                            <tr>
                                <td>Citas</td>
                                <th scope="row" class="role-matrix-action">@accion.Substring(0, 1).ToUpperInvariant()@accion.Substring(1) citas</th>
                                @foreach (var rol in roles)
                                {
                                    <td>
                                        @if (rol.NombreRol == "Recepcionista")
                                        {
                                            <span class="role-matrix-badge @(permitido ? "is-enabled" : "is-revoked")">@(permitido ? "Habilitado" : "Revocado")</span>
                                        }
                                        else if (rol.NombreRol == "Profesional" && accion == "reagendar")
                                        {
                                            <span class="role-matrix-badge @(profesionalReagenda ? "is-enabled" : "is-revoked")">@(profesionalReagenda ? "Habilitado" : "Revocado")</span>
                                        }
                                        else
                                        {
                                            <span aria-label="Permiso configurable para otro rol">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
