  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>
  @* 
  Partial de navegación del administrador.
  WHY: evita duplicar la estructura común del sidebar en
  cada vista administrativa.
  *@
  @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
    <div class="nav-group">
