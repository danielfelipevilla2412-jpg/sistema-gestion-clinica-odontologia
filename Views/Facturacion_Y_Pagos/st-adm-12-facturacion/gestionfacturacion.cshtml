</aside>



  <!--
  =========================================================
  NAVEGACIÓN MÓVIL — HAMBURGER
  =========================================================
  El botón permite abrir o cerrar el menú lateral en
  pantallas pequeñas. El overlay facilita cerrar o
  identificar visualmente el menú abierto.
  =========================================================
  -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!--
  =========================================================
  CONTENIDO PRINCIPAL
  =========================================================
  Agrupa todo el contenido funcional de la página de
  Gestión de Facturación y utiliza main-content como
  destino del enlace de accesibilidad.
  =========================================================
  -->
  <main class="main" id="main-content">

    <!--
    HEADER DE FACTURACIÓN
    Muestra la ruta de navegación y el título principal
    de la vista administrativa.
    -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Facturación</span>
        </nav>
        <h1 class="page-title">Facturación</h1>
        <p class="page-subtitle">Ingresos y cobros</p>
      </div>
    </header>

    <!--
    =====================================================
    INDICADORES DE FACTURACIÓN (KPI)
    =====================================================
    Muestra un resumen de la situación de facturación:
    - Total de facturas.
    - Valores pendientes por cobrar.
    - Facturas pagadas durante el día.
    - Facturas anuladas.

    WHY: estos indicadores permiten al administrador
    identificar rápidamente el estado general de los cobros.
    Los atributos aria-live permiten comunicar cambios
    dinámicos a tecnologías de asistencia.
    =====================================================
    -->
    <section class="stats-grid" aria-label="Resumen de facturación">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statTotal" data-target="1248" aria-live="polite">0</span>
        <span class="stat-label">Total Facturas</span>
        <span class="stat-sub">Este año fiscal</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statPending" data-target="4200000" aria-live="polite">$0</span>
        <span class="stat-label">Por Cobrar</span>
        <span class="stat-sub">↑ 8% vs mes anterior</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statPaidToday" data-target="12" aria-live="polite">0</span>
        <span class="stat-label">Pagadas Hoy</span>
        <span class="stat-sub">Actualizado hace 5 min</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="statCancelled" data-target="3" aria-live="polite">0</span>
        <span class="stat-label">Anuladas</span>
        <span class="stat-sub">Últimas 24 horas</span>
      </div>
    </section>

    <!--
    =====================================================
    BÚSQUEDA Y FILTROS
    =====================================================
    Permite localizar facturas mediante texto y reducir
    los resultados utilizando el estado y el mes.

    El botón "Nueva factura" inicia el flujo de creación
    de una nueva factura mediante el modal correspondiente.
    =====================================================
    -->
    <section class="controls-section">
      <div class="filters-wrap">
        <div class="search-wrap">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <!-- Búsqueda rápida por número de factura o nombre del paciente. -->
          <input type="search" id="searchInvoices" class="search-input" placeholder="Buscar por N° o Paciente..."
            aria-label="Buscar factura">
        </div>
        <select id="filterStatus" class="filter-select" aria-label="Filtrar por estado">
          <option value="">Todos los Estados</option>
          <option value="pagada">Pagada</option>
          <option value="pendiente">Pendiente</option>
          <option value="parcial">Parcial</option>
          <option value="anulada">Anulada</option>
        </select>
        <select id="filterMonth" class="filter-select" aria-label="Filtrar por mes">
          <option value="">Todos los meses</option>
          <option value="2026-05">Mayo 2026</option>
          <option value="2026-04">Abril 2026</option>
          <option value="2026-03">Marzo 2026</option>
        </select>
        <!-- Abre el formulario modal para registrar una nueva factura. -->
        <button class="btn-primary" id="btnNewInvoice" aria-label="Crear nueva factura">
          ➕ Nueva factura
        </button>
      </div>
    </section>

    <!--
    =====================================================
    TABLA DE FACTURAS
    =====================================================
    Presenta los registros de facturación y sus principales
    datos: número, paciente, fecha, total, pendiente,
    estado y acciones disponibles.

    WHY: el cuerpo de la tabla se encuentra preparado para
    recibir las filas generadas dinámicamente mediante JS.
    =====================================================
    -->
    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle">Lista de facturas</h2>

      <!--
      Cabecera accesible de la tabla.
      Los roles de columna permiten identificar cada dato
      ante tecnologías de asistencia.
      -->
      <div class="table-header" role="row">
        <div class="table-col col-numero" role="columnheader">N° Factura</div>
        <div class="table-col col-paciente" role="columnheader">Paciente</div>
        <div class="table-col col-fecha" role="columnheader">Fecha</div>
        <div class="table-col col-total" role="columnheader">Total</div>
        <div class="table-col col-pendiente" role="columnheader">Pendiente</div>
        <div class="table-col col-estado text-center" role="columnheader">Estado</div>
        <div class="table-col col-acciones text-right" role="columnheader">Acciones</div>
      </div>

      <!--
      Cuerpo dinámico de la tabla.
      Las filas son inyectadas por JavaScript en este
      contenedor. aria-live permite anunciar los cambios.
      -->
      <div id="invoicesBody" class="table-body" role="rowgroup" aria-live="polite">
          <!-- Filas de facturas generadas dinámicamente por JavaScript. -->
      </div>

      <!--
      Paginación de resultados.
      Permite dividir la información mostrada y proporciona
      una navegación accesible entre las páginas disponibles.
      -->
      <footer class="table-footer" aria-label="Navegación de páginas">
        <span>Mostrando <strong id="pageShowing">10</strong> de <strong id="pageTotal">45</strong> registros</span>
        <nav class="pagination" aria-label="Páginas de resultados">
          <button class="pagination-btn active" aria-current="page" aria-label="Página 1">1</button>
        </nav>
      </footer>
    </section>

  </main>

  <!--
  =========================================================
  DRAWER — DETALLE DE FACTURA
  =========================================================
  Panel lateral utilizado para mostrar rápidamente el
  estado y el resumen económico de una factura seleccionada.

  Desde este panel el usuario puede:
  - Consultar el detalle completo.
  - Registrar un pago.
  =========================================================
  -->
  <div class="drawer-overlay" id="drawerOverlay" role="dialog" aria-modal="true" aria-labelledby="drawerTitle"
    aria-hidden="true" inert>
    <div class="drawer-panel" id="drawerPanel">
      <header class="drawer-header">
        <h3 class="drawer-title" id="drawerTitle">Detalle de Factura</h3>
        <button class="drawer-close" id="drawerClose" aria-label="Cerrar panel">×</button>
      </header>
      <div class="drawer-content" role="document">
        <div class="invoice-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span id="drawerStatus" class="status-label">Pago Pendiente</span>
        </div>
        <div class="invoice-summary">
          <div class="summary-row">
            <span>Subtotal:</span>
            <strong id="drawerSubtotal">$0</strong>
          </div>
          <div class="summary-row">
            <span>IVA (19%):</span>
            <strong id="drawerTax">$0</strong>
          </div>
          <div class="summary-row summary-total">
            <span>Total:</span>
            <strong id="drawerTotal">$0</strong>
          </div>
        </div>
      </div>
      <footer class="drawer-footer">
        <button class="btn-secondary" id="btnViewDetails">Ver detalle</button>
        <button class="btn-secondary" id="btnCancelInvoice" style="color: var(--red, #dc2626);">Anular</button>
        <!-- Inicia el proceso para registrar el pago de la factura seleccionada. -->
        <button class="btn-primary" id="btnRegisterPayment">Registrar Pago</button>
      </footer>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — DETALLE COMPLETO
  =========================================================
  Muestra información detallada de la factura seleccionada:
  paciente, documento, fecha, servicio, estado, total y
  valor pendiente.
  =========================================================
  -->
  <div class="invoice-details-overlay" id="invoiceDetailsOverlay" role="dialog" aria-modal="true"
    aria-labelledby="invoiceDetailsTitle" aria-hidden="true" inert>
    <div class="invoice-details-modal">
      <header class="invoice-details-header">
        <h3 class="invoice-details-title" id="invoiceDetailsTitle">Detalle de factura</h3>
        <button class="invoice-details-close" id="invoiceDetailsClose" type="button" aria-label="Cerrar detalle">×</button>
      </header>
      <div class="invoice-details-content">
        <div class="invoice-details-number" id="invoiceDetailsNumber"></div>
        <dl class="invoice-details-list">
          <div><dt>Paciente</dt><dd id="invoiceDetailsPatient"></dd></div>
          <div><dt>Documento</dt><dd id="invoiceDetailsDocument"></dd></div>
          <div><dt>Fecha</dt><dd id="invoiceDetailsDate"></dd></div>
          <div><dt>Servicio</dt><dd id="invoiceDetailsService"></dd></div>
          <div><dt>Estado</dt><dd id="invoiceDetailsStatus"></dd></div>
          <div><dt>Total</dt><dd id="invoiceDetailsTotal"></dd></div>
          <div><dt>Pendiente</dt><dd id="invoiceDetailsPending"></dd></div>
        </dl>
      </div>
      <footer class="invoice-details-footer">
        <button class="btn-primary" id="invoiceDetailsConfirm" type="button">Cerrar</button>
      </footer>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — CONFIRMACIÓN DE PAGO
  =========================================================
  Informa al usuario cuando el registro del pago se ha
  realizado correctamente y permite cerrar el mensaje.
  =========================================================
  -->
  <div class="payment-success-overlay" id="paymentSuccessOverlay" role="dialog" aria-modal="true"
    aria-labelledby="paymentSuccessTitle" aria-describedby="paymentSuccessMessage" aria-hidden="true" inert>
    <div class="payment-success-modal">
      <button class="payment-success-close" id="paymentSuccessClose" type="button" aria-label="Cerrar confirmación">×</button>
      <div class="payment-success-icon" aria-hidden="true">✓</div>
      <h3 class="payment-success-title" id="paymentSuccessTitle">Registro exitoso</h3>
      <p class="payment-success-message" id="paymentSuccessMessage">El pago se registró correctamente.</p>
      <button class="btn-primary payment-success-button" id="paymentSuccessConfirm" type="button">Aceptar</button>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — NUEVA FACTURA
  =========================================================
  Formulario utilizado para generar una nueva factura.
  Solicita los datos mínimos del paciente, documento,
  fecha, servicio y valor total a cobrar.

  WHY: mantener el formulario dentro de un modal permite
  crear la factura sin abandonar la pantalla principal.
  =========================================================
  -->
  <div class="new-invoice-overlay" id="newInvoiceOverlay" role="dialog" aria-modal="true"
    aria-labelledby="newInvoiceTitle" aria-hidden="true" inert>
    <div class="new-invoice-modal">
      <header class="new-invoice-header">
        <h3 class="new-invoice-title" id="newInvoiceTitle">Nueva factura</h3>
        <button class="new-invoice-close" id="newInvoiceClose" type="button" aria-label="Cerrar formulario">×</button>
      </header>
      <!-- Formulario de creación de factura. La validación requerida se realiza sobre sus campos. -->
        <form id="newInvoiceForm" class="new-invoice-form">
        <p class="new-invoice-required">Completa los datos para generar la factura.</p>
        <div class="invoice-form-grid">
          <label class="invoice-form-field">
            <span>Nombre del paciente *</span>
            <input id="invoicePatient" name="patient" type="text" required maxlength="100" autocomplete="name" placeholder="Ej. Ana Gómez">
          </label>
          <label class="invoice-form-field">
            <span>Documento *</span>
            <input id="invoiceDocument" name="document" type="text" required maxlength="30" placeholder="Ej. 1020304050">
          </label>
          <label class="invoice-form-field">
            <span>Fecha de factura *</span>
            <input id="invoiceDate" name="date" type="date" required>
          </label>
          <label class="invoice-form-field">
            <span>Servicio o concepto *</span>
            <select id="invoiceService" name="service" required>
              <option value="" selected disabled>Selecciona un servicio</option>
              <option value="Limpieza dental">Limpieza dental</option>
              <option value="Blanqueamiento">Blanqueamiento</option>
              <option value="Ortodoncia">Ortodoncia</option>
              <option value="Endodoncia">Endodoncia</option>
              <option value="Implantes">Implantes</option>
              <option value="Odontopediatra">Odontopediatra</option>
              <option value="Ortodoncia - consulta">Ortodoncia - consulta</option>
              <option value="Implante dental">Implante dental</option>
            </select>
          </label>
          <label class="invoice-form-field invoice-form-field--full">
            <span>Total a cobrar (COP) *</span>
            <!-- El valor se recibe en pesos colombianos (COP) y debe ser mayor que cero. -->
            <input id="invoiceTotal" name="total" type="number" required min="1" step="100" inputmode="numeric" placeholder="Ej. 150000">
          </label>
        </div>
        <footer class="new-invoice-footer">
          <button class="btn-secondary" id="newInvoiceCancel" type="button">Cancelar</button>
          <button class="btn-primary" type="submit">Generar factura</button>
        </footer>
      </form>
    </div>
  </div>

  <!--
  =========================================================
  NAVEGACIÓN INFERIOR PARA DISPOSITIVOS MÓVILES
  =========================================================
  Proporciona accesos rápidos a las secciones principales
  cuando la aplicación se visualiza desde pantallas pequeñas.
  =========================================================
  -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="/acceso-y-seguridad/st-adm-02-gestion-usuarios" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Usuarios</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">💳</span>
      <span>Facturación</span>
    </a>
      <a href="/servicios-y-recursos/st-adm-16-configuracion-general" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">⚙️</span>
      <span>Config</span>
    </a>
  </nav>

  <!--
  =========================================================
  SISTEMA DE NOTIFICACIONES TOAST
  =========================================================
  Contenedor utilizado para mostrar mensajes temporales
  al usuario sin interrumpir el flujo principal de la vista.

  aria-live permite que el mensaje sea anunciado por
  lectores de pantalla.
  =========================================================
  -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!--
  =========================================================
  ESTILOS DE ACCESIBILIDAD
  =========================================================
  Estas reglas permiten ocultar visualmente ciertos
  elementos sin eliminarlos del árbol de accesibilidad.
  También controlan la posición del enlace "Saltar al
  contenido principal" cuando recibe el foco.
  =========================================================
  -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

