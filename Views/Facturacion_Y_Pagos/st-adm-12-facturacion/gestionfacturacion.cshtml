@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
  Layout = "_Layout";
  ViewData["Title"] = "Facturación";
  ViewData["Description"] = "Gestiona facturas, cobros y estados de pago en SmileTrack.";
  ViewData["UseGestionModulesDesignSystem"] = true;
}

@section Styles {
  <link rel="stylesheet" href="~/css/Facturacion_Y_Pagos/st-adm-12-facturacion/gestionfacturacion.css" asp-append-version="true" />
}

  <!--
  =========================================================
  CONTENIDO PRINCIPAL
  =========================================================
  Agrupa todo el contenido funcional de la página de
  Gestión de Facturación y utiliza main-content como
  destino del enlace de accesibilidad.
  =========================================================
  -->
  <main class="main billing-page" id="main-content">

    <!--
    HEADER DE FACTURACIÓN
    Muestra la ruta de navegación y el título principal
    de la vista administrativa.
    -->
    <header class="page-header">
      <nav class="breadcrumb" aria-label="Ruta de navegación" data-i18n-aria-label="layout_breadcrumb_aria">
        <a href="/gestion-de-citas/st-adm-01-dashboard" data-i18n="common_bc_administracion">Administración</a>
        <span class="bc-sep" aria-hidden="true">›</span>
        <span aria-current="page" data-i18n="gestion_facturacion_title">Facturación</span>
      </nav>
      <div class="page-header-content">
        <div class="page-header-title">
          <h1 class="page-title" data-i18n="gestion_facturacion_title">Facturación</h1>
          <p class="page-subtitle" data-i18n="gestion_facturacion_subtitle">Ingresos y cobros</p>
        </div>
      </div>
    </header>

    <!--
    =====================================================
    INDICADORES DE FACTURACIÓN (KPI)
    =====================================================
    Muestra un resumen de la situación de facturación:
    - Total de facturas.
    - Valores pendientes por cobrar.
    - Facturas pagadas durante el día.
    - Facturas anuladas.

    WHY: estos indicadores permiten al administrador
    identificar rápidamente el estado general de los cobros.
    Los atributos aria-live permiten comunicar cambios
    dinámicos a tecnologías de asistencia.
    =====================================================
    -->
    <section class="stats-grid" aria-label="Resumen de facturación" data-i18n-aria-label="billing.summary">
      <div class="stat-card" data-color="blue">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">receipt_long</span>
        <span class="stat-number" id="statTotal" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestion_facturacion_kpi_total_facturas">Total Facturas</span>
        <span class="stat-sub" data-i18n="gestion_facturacion_kpi_anio_fiscal">Este año fiscal</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">payments</span>
        <span class="stat-number" id="statPending" data-target="0" aria-live="polite">$0</span>
        <span class="stat-label" data-i18n="gestion_facturacion_kpi_por_cobrar">Por Cobrar</span>
        <span class="stat-sub" data-i18n="gestion_facturacion_kpi_vs_mes_anterior_up">↑ 8% vs mes anterior</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">today</span>
        <span class="stat-number" id="statPaidToday" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestion_facturacion_kpi_pagadas_hoy">Pagadas Hoy</span>
        <span class="stat-sub" data-i18n="gestion_facturacion_kpi_actualizado_hace">Actualizado hace 5 min</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="material-symbols-outlined stat-icon" aria-hidden="true">block</span>
        <span class="stat-number" id="statCancelled" data-target="0" aria-live="polite">0</span>
        <span class="stat-label" data-i18n="gestion_facturacion_kpi_anuladas">Anuladas</span>
        <span class="stat-sub" data-i18n="gestion_facturacion_kpi_ultimas_24h">Últimas 24 horas</span>
      </div>
    </section>

    <!--
    =====================================================
    BÚSQUEDA Y FILTROS
    =====================================================
    Permite localizar facturas mediante texto y reducir
    los resultados utilizando el estado y el mes.

    El botón "Nueva factura" inicia el flujo de creación
    de una nueva factura mediante el modal correspondiente.
    =====================================================
    -->
    <section class="filters-section controls-section" aria-label="Filtros de facturas" data-i18n-aria-label="billing.filters">
      <div class="filters-row billing-filters">
        <div class="search-wrap">
          <span class="material-symbols-outlined search-icon" aria-hidden="true">search</span>
          <!-- Búsqueda rápida por número de factura o nombre del paciente. -->
          <input type="search" id="searchInvoices" class="search-input" placeholder="Buscar por N° o Paciente..."
            aria-label="Buscar por número o paciente" data-i18n-ph="billing.search_placeholder" data-i18n-aria-label="billing.search_aria">
        </div>
        <select id="filterStatus" class="filter-select" aria-label="Filtrar por estado" data-i18n-aria-label="billing.filter_status">
          <option value="" data-i18n="billing.all_statuses">Todos los estados</option>
          <option value="pagada" data-i18n="billing.status_paid">Pagada</option>
          <option value="pendiente" data-i18n="billing.status_pending">Pendiente</option>
          <option value="parcial" data-i18n="billing.status_partial">Parcial</option>
          <option value="anulada" data-i18n="billing.status_voided">Anulada</option>
        </select>
        <select id="filterMonth" class="filter-select" aria-label="Filtrar por mes" data-i18n-aria-label="billing.filter_month">
          <option value="" data-i18n="billing.all_months">Todos los meses</option>
        </select>
        <!-- Abre el formulario modal para registrar una nueva factura. -->
        <button type="button" class="btn-primary" id="btnNewInvoice" aria-label="Crear nueva factura" data-i18n-aria-label="billing.create_invoice">
          <span class="material-symbols-outlined" aria-hidden="true">add</span>
          <span data-i18n="billing.create_invoice">Nueva factura</span>
        </button>
      </div>
    </section>

    <!--
    =====================================================
    TABLA DE FACTURAS
    =====================================================
    Presenta los registros de facturación y sus principales
    datos: número, paciente, fecha, total, pendiente,
    estado y acciones disponibles.

    WHY: el cuerpo de la tabla se encuentra preparado para
    recibir las filas generadas dinámicamente mediante JS.
    =====================================================
    -->
    <div class="table-wrap billing-table-wrap">
    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle" data-i18n="billing.invoice_list">Lista de facturas</h2>

      <!--
      Cabecera accesible de la tabla.
      Los roles de columna permiten identificar cada dato
      ante tecnologías de asistencia.
      -->
      <div class="table-header" role="row">
        <div class="table-col col-numero" role="columnheader" data-i18n="billing.invoice_number">N° Factura</div>
        <div class="table-col col-paciente" role="columnheader" data-i18n="citas.patient">Paciente</div>
        <div class="table-col col-fecha" role="columnheader" data-i18n="facturacion.date">Fecha</div>
        <div class="table-col col-total" role="columnheader" data-i18n="facturacion.total">Total</div>
        <div class="table-col col-pendiente" role="columnheader" data-i18n="billing.pending_amount">Pendiente</div>
        <div class="table-col col-estado text-center" role="columnheader" data-i18n="facturacion.status">Estado</div>
        <div class="table-col col-acciones text-right" role="columnheader" data-i18n="table.actions">Acciones</div>
      </div>

      <!--
      Cuerpo dinámico de la tabla.
      Las filas son inyectadas por JavaScript en este
      contenedor. aria-live permite anunciar los cambios.
      -->
      <div id="invoicesBody" class="table-body" role="rowgroup" aria-live="polite">
          <!-- Filas de facturas generadas dinámicamente por JavaScript. -->
      </div>

      <!--
      Paginación de resultados.
      Permite dividir la información mostrada y proporciona
      una navegación accesible entre las páginas disponibles.
      -->
      <footer class="table-footer" aria-label="Navegación de páginas">
        <span>
          <span data-i18n="billing.pagination_showing">Mostrando</span>
          <strong id="pageShowing">0</strong>
          <span data-i18n="billing.pagination_of">de</span>
          <strong id="pageTotal">0</strong>
          <span data-i18n="billing.pagination_records">registros</span>
        </span>
        <nav class="pagination" id="invoicePagination" aria-label="Páginas de resultados" data-i18n-aria-label="billing.pagination">
        </nav>
      </footer>
    </section>
    </div>

  </main>

  <!--
  =========================================================
  DRAWER — DETALLE DE FACTURA
  =========================================================
  Panel lateral utilizado para mostrar rápidamente el
  estado y el resumen económico de una factura seleccionada.

  Desde este panel el usuario puede:
  - Consultar el detalle completo.
  - Registrar un pago.
  =========================================================
  -->
  <div class="drawer-overlay" id="drawerOverlay" role="dialog" aria-modal="true" aria-labelledby="drawerTitle"
    aria-hidden="true" inert>
    <div class="drawer-panel" id="drawerPanel">
      <header class="drawer-header">
        <h3 class="drawer-title" id="drawerTitle" data-i18n="billing.invoice_details">Detalle de factura</h3>
        <button class="drawer-close" id="drawerClose" type="button" aria-label="Cerrar panel" data-i18n-aria-label="billing.close_panel">×</button>
      </header>
      <div class="drawer-content" role="document">
        <div class="invoice-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span id="drawerStatus" class="status-label" data-i18n="billing.status_pending">Pendiente</span>
        </div>
        <div class="invoice-summary">
          <div class="summary-row">
            <span data-i18n="facturacion.subtotal">Subtotal:</span>
            <strong id="drawerSubtotal">$0</strong>
          </div>
          <div class="summary-row">
            <span data-i18n="billing.tax_19">IVA (19%):</span>
            <strong id="drawerTax">$0</strong>
          </div>
          <div class="summary-row summary-total">
            <span data-i18n="facturacion.total">Total:</span>
            <strong id="drawerTotal">$0</strong>
          </div>
        </div>
      </div>
      <footer class="drawer-footer">
        <button type="button" class="btn-secondary" id="btnViewDetails" data-i18n="billing.view_details">Ver detalle</button>
        <button type="button" class="btn-danger" id="btnCancelInvoice" data-i18n="billing.void_invoice">Anular</button>
        <!-- Inicia el proceso para registrar el pago de la factura seleccionada. -->
        <button type="button" class="btn-primary" id="btnRegisterPayment" data-i18n="facturacion.register_payment">Registrar pago</button>
      </footer>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — DETALLE COMPLETO
  =========================================================
  Muestra información detallada de la factura seleccionada:
  paciente, documento, fecha, servicio, estado, total y
  valor pendiente.
  =========================================================
  -->
  <div class="invoice-details-overlay" id="invoiceDetailsOverlay" role="dialog" aria-modal="true"
    aria-labelledby="invoiceDetailsTitle" aria-hidden="true" inert>
    <div class="invoice-details-modal">
      <header class="invoice-details-header">
        <h3 class="invoice-details-title" id="invoiceDetailsTitle" data-i18n="billing.invoice_details">Detalle de factura</h3>
        <button class="invoice-details-close" id="invoiceDetailsClose" type="button" aria-label="Cerrar detalle" data-i18n-aria-label="billing.close_details">×</button>
      </header>
      <div class="invoice-details-content">
        <div class="invoice-details-number" id="invoiceDetailsNumber"></div>
        <dl class="invoice-details-list">
          <div><dt data-i18n="citas.patient">Paciente</dt><dd id="invoiceDetailsPatient"></dd></div>
          <div><dt data-i18n="billing.document">Documento</dt><dd id="invoiceDetailsDocument"></dd></div>
          <div><dt data-i18n="facturacion.date">Fecha</dt><dd id="invoiceDetailsDate"></dd></div>
          <div><dt data-i18n="billing.service">Servicio</dt><dd id="invoiceDetailsService"></dd></div>
          <div><dt data-i18n="facturacion.status">Estado</dt><dd id="invoiceDetailsStatus"></dd></div>
          <div><dt data-i18n="facturacion.total">Total</dt><dd id="invoiceDetailsTotal"></dd></div>
          <div><dt data-i18n="billing.paid_amount">Pagado</dt><dd id="invoiceDetailsPaid"></dd></div>
          <div><dt data-i18n="billing.pending_amount">Pendiente</dt><dd id="invoiceDetailsPending"></dd></div>
        </dl>
        <section class="invoice-payment-history" aria-labelledby="invoicePaymentHistoryTitle">
          <h4 id="invoicePaymentHistoryTitle" data-i18n="billing.payment_history">Historial de transacciones</h4>
          <ol id="invoicePaymentHistory" aria-live="polite"></ol>
        </section>
      </div>
      <footer class="invoice-details-footer">
        <button class="btn-primary" id="invoiceDetailsConfirm" type="button" data-i18n="common.close">Cerrar</button>
      </footer>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — CONFIRMACIÓN DE PAGO
  =========================================================
  Informa al usuario cuando el registro del pago se ha
  realizado correctamente y permite cerrar el mensaje.
  =========================================================
  -->
  <div class="payment-success-overlay" id="paymentSuccessOverlay" role="dialog" aria-modal="true"
    aria-labelledby="paymentSuccessTitle" aria-describedby="paymentSuccessMessage" aria-hidden="true" inert>
    <div class="payment-success-modal">
      <button class="payment-success-close" id="paymentSuccessClose" type="button" aria-label="Cerrar confirmación" data-i18n-aria-label="billing.close_confirmation">×</button>
      <div class="payment-success-icon" aria-hidden="true">✓</div>
      <h3 class="payment-success-title" id="paymentSuccessTitle" data-i18n="billing.payment_success_title">Registro exitoso</h3>
      <p class="payment-success-message" id="paymentSuccessMessage" data-i18n="billing.payment_success_message">El pago se registró correctamente.</p>
      <button class="btn-primary payment-success-button" id="paymentSuccessConfirm" type="button" data-i18n="common.accept">Aceptar</button>
    </div>
  </div>

  <!--
  =========================================================
  MODAL — NUEVA FACTURA
  =========================================================
  Formulario utilizado para generar una nueva factura.
  Solicita los datos mínimos del paciente, documento,
  fecha, servicio y valor total a cobrar.

  WHY: mantener el formulario dentro de un modal permite
  crear la factura sin abandonar la pantalla principal.
  =========================================================
  -->
  <div class="new-invoice-overlay" id="newInvoiceOverlay" role="dialog" aria-modal="true"
    aria-labelledby="newInvoiceTitle" aria-hidden="true" inert>
    <div class="new-invoice-modal">
      <header class="new-invoice-header">
        <h3 class="new-invoice-title" id="newInvoiceTitle" data-i18n="facturacion.new_invoice">Nueva factura</h3>
        <button class="new-invoice-close" id="newInvoiceClose" type="button" aria-label="Cerrar formulario" data-i18n-aria-label="billing.close_form">×</button>
      </header>
      <!-- Formulario de creación de factura. La validación requerida se realiza sobre sus campos. -->
        <form id="newInvoiceForm" class="new-invoice-form">
        @Html.AntiForgeryToken()
        <p class="new-invoice-required" data-i18n="billing.invoice_required_note">Completa los datos para generar la factura.</p>
        <div class="invoice-form-grid">
          <label class="invoice-form-field invoice-form-field--full">
            <span data-i18n="billing.select_registered_patient">Seleccionar paciente registrado *</span>
            <select id="invoicePatientSelect" name="idPaciente" required>
              <option value="" data-i18n="billing.select_patient_required">-- Seleccionar un paciente --</option>
              @if (ViewData["Pacientes"] is List<SmileTrack_MVC.Models.Entities.Paciente> listaPacientes)
              {
                foreach (var p in listaPacientes)
                {
                  <option value="@p.IdPaciente" data-nombre="@p.Nombres @p.Apellidos" data-doc="@p.Documento">@p.Nombres @p.Apellidos (@p.TipoDocumento @p.Documento)</option>
                }
              }
            </select>
          </label>
          <label class="invoice-form-field">
            <span data-i18n="billing.patient_name_required">Nombre del paciente *</span>
            <input id="invoicePatient" name="patient" type="text" required maxlength="100" autocomplete="name" readonly aria-readonly="true" placeholder="Ej. Ana Gómez" data-i18n-ph="billing.patient_name_example">
          </label>
          <label class="invoice-form-field">
            <span data-i18n="billing.document_required">Documento *</span>
            <input id="invoiceDocument" name="document" type="text" required maxlength="30" readonly aria-readonly="true" placeholder="Ej. 1020304050" data-i18n-ph="billing.document_example">
          </label>
          <label class="invoice-form-field">
            <span data-i18n="billing.invoice_date_auto">Fecha de factura (automática)</span>
            <input id="invoiceDate" type="date" readonly aria-readonly="true">
          </label>
          <label class="invoice-form-field">
            <span data-i18n="billing.service_required">Servicio o concepto *</span>
            <select id="invoiceService" name="service" required>
              <option value="" selected disabled data-i18n="billing.select_service">Selecciona un servicio</option>
              @if (ViewData["Servicios"] is List<SmileTrack_MVC.Models.Entities.Servicio> listaServicios && listaServicios.Any())
              {
                foreach (var s in listaServicios)
                {
                  <option value="@s.Nombre" data-id="@s.IdServicio" data-price="@s.Precio">@s.Nombre - $@s.Precio.ToString("N0")</option>
                }
              }
              else
              {
                <option value="Limpieza dental" data-price="150000" data-i18n="billing.fallback_service_cleaning">Limpieza dental ($150.000)</option>
                <option value="Blanqueamiento" data-price="350000" data-i18n="billing.fallback_service_whitening">Blanqueamiento ($350.000)</option>
                <option value="Ortodoncia" data-price="800000" data-i18n="billing.fallback_service_orthodontics">Ortodoncia ($800.000)</option>
                <option value="Endodoncia" data-price="450000" data-i18n="billing.fallback_service_root_canal">Endodoncia ($450.000)</option>
                <option value="Implantes" data-price="1200000" data-i18n="billing.fallback_service_implants">Implantes ($1.200.000)</option>
                <option value="Odontopediatra" data-price="120000" data-i18n="billing.fallback_service_pediatric">Odontopediatra ($120.000)</option>
                <option value="Ortodoncia - consulta" data-price="90000" data-i18n="billing.fallback_service_orthodontic_visit">Ortodoncia - consulta ($90.000)</option>
                <option value="Implante dental" data-price="1500000" data-i18n="billing.fallback_service_dental_implant">Implante dental ($1.500.000)</option>
              }
            </select>
          </label>
          <label class="invoice-form-field invoice-form-field--full">
            <span data-i18n="billing.total_cop_required">Total a cobrar (COP) *</span>
            <!-- El valor se recibe en pesos colombianos (COP) y debe ser mayor que cero. -->
            <input id="invoiceTotal" name="total" type="number" required min="1" step="100" inputmode="numeric" placeholder="Ej. 150000" data-i18n-ph="billing.amount_example">
          </label>
        </div>
        <footer class="new-invoice-footer">
          <button class="btn-secondary" id="newInvoiceCancel" type="button" data-i18n="common.cancel">Cancelar</button>
          <button class="btn-primary" type="submit" data-i18n="billing.generate_invoice">Generar factura</button>
        </footer>
      </form>
    </div>
  </div>

@section Scripts {
  <script>
    window.RAZOR_INVOICES = @Html.Raw(ViewData["FacturasJson"] ?? "[]");
  </script>
  <script src="~/js/lib/apiRequest.js" asp-append-version="true"></script>
  <script src="~/js/Facturacion_Y_Pagos/st-adm-12-facturacion/gestionfacturacion.js" asp-append-version="true"></script>
}
