# ================================================================
# SmileTrack — Variables de entorno para PRODUCCIÓN
# ================================================================
# INSTRUCCIONES:
#   1. Copia este archivo al servidor como: .env
#   2. Rellena TODOS los valores
#   3. NUNCA subas el .env real a Git
# ================================================================

# ── Base de datos ────────────────────────────────────────────────
# Contraseña de SQL Server. Mínimo 8 chars, mayúscula, número y símbolo.
MSSQL_SA_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

# ── JWT (sesiones y tokens) ──────────────────────────────────────
# Clave secreta para firmar tokens JWT. Mínimo 32 caracteres aleatorios.
# Genera una con: openssl rand -base64 32
JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Imagen publicada de la aplicación (usuario/repositorio:tag de Docker Hub).
WEB_IMAGE=johanmaa2/smiletrack-web:latest

# ── Correo SMTP ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
# Usa una "contraseña de aplicación" de Gmail, NO tu contraseña real.
# Google → Cuenta → Seguridad → Verificación en dos pasos → Contraseñas de apps
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
